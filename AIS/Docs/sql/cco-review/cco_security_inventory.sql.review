-- READ ONLY. DBA-run inventory; does not install, compile or grant anything.
-- Supply uppercase security owner and actual runtime login (not a proxy label).
DEFINE security_owner = 'REPLACE_SECURITY_OWNER'
DEFINE runtime_user = 'REPLACE_RUNTIME_USER'
SELECT owner,object_name,object_type,status FROM dba_objects
WHERE object_name IN ('T_CCO_SCOPE_ENTITIES_GTT','PKG_CCO_SCOPE','V_CCO_AUTHORIZED_ENTITIES','PKG_CCO_REPORTING') ORDER BY owner,object_name,object_type;
SELECT namespace,schema,package,type FROM dba_context WHERE namespace='IAS_CCO_CTX';
SELECT owner,table_name,temporary,duration FROM dba_tables
WHERE owner='&security_owner' AND table_name='T_CCO_SCOPE_ENTITIES_GTT';
-- Expect TEMPORARY=Y, DURATION=SYS$TRANSACTION.
SELECT owner,table_name,column_name,data_type,data_length,nullable,column_id FROM dba_tab_columns
WHERE owner='&security_owner' AND table_name IN ('T_CCO_SCOPE_ENTITIES_GTT','V_CCO_AUTHORIZED_ENTITIES') ORDER BY table_name,column_id;
SELECT owner,constraint_name,constraint_type,status,validated FROM dba_constraints
WHERE owner='&security_owner' AND table_name='T_CCO_SCOPE_ENTITIES_GTT';
SELECT owner,name,type,line,text FROM dba_source
WHERE owner='&security_owner' AND name IN ('PKG_CCO_SCOPE','PKG_CCO_REPORTING') ORDER BY name,type,line;
SELECT DBMS_METADATA.GET_DDL('VIEW','V_CCO_AUTHORIZED_ENTITIES','&security_owner') FROM dual;
SELECT owner,name,type,line,position,text FROM dba_errors
WHERE owner='&security_owner' AND name IN ('PKG_CCO_SCOPE','PKG_CCO_REPORTING','V_CCO_AUTHORIZED_ENTITIES') ORDER BY name,sequence;
SELECT owner,synonym_name,table_owner,table_name,db_link FROM dba_synonyms
WHERE owner IN ('&runtime_user','PUBLIC') AND synonym_name IN ('PKG_CCO_SCOPE','V_CCO_AUTHORIZED_ENTITIES','PKG_CCO_REPORTING','T_CCO_SCOPE_ENTITIES_GTT');
-- Include all nested roles, even non-default roles, and PUBLIC.
WITH principals AS (
 SELECT '&runtime_user' principal FROM dual UNION SELECT 'PUBLIC' FROM dual UNION
 SELECT granted_role FROM dba_role_privs START WITH grantee IN ('&runtime_user','PUBLIC') CONNECT BY NOCYCLE PRIOR granted_role=grantee
)
SELECT p.grantee,p.owner,p.table_name,p.privilege,p.grantable FROM dba_tab_privs p
WHERE p.grantee IN (SELECT principal FROM principals) AND p.owner='&security_owner' ORDER BY p.grantee,p.table_name,p.privilege;
WITH principals AS (
 SELECT '&runtime_user' principal FROM dual UNION SELECT 'PUBLIC' FROM dual UNION
 SELECT granted_role FROM dba_role_privs START WITH grantee IN ('&runtime_user','PUBLIC') CONNECT BY NOCYCLE PRIOR granted_role=grantee
)
SELECT p.grantee,p.privilege,p.admin_option FROM dba_sys_privs p
WHERE p.grantee IN (SELECT principal FROM principals) ORDER BY p.grantee,p.privilege;
-- Review ANY TABLE/PROCEDURE/CONTEXT, DBA and equivalent powers; owner must differ
-- from runtime. Review column-level DML too, and executable definer-rights wrappers.
SELECT grantee,owner,table_name,column_name,privilege FROM dba_col_privs
WHERE owner='&security_owner' AND table_name='T_CCO_SCOPE_ENTITIES_GTT';
-- Missing catalog visibility is UNKNOWN, never PASS. Inventory alone does not
-- prove session revocation, transaction completion, pool isolation or API grants.
