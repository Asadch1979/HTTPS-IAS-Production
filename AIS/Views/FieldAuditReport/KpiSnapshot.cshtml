@model AIS.Models.FieldAuditReport.FieldAuditInputSectionViewModel
@using System
@using System.Linq

@{
    ViewData["Title"] = "KPI Snapshot";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    ViewData["IsReadOnly"] = Model?.IsReadOnly ?? false;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">KPI Snapshot</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ReportActionsNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to work with KPI snapshot data.</div>
    }

    @if (TempData["FieldAuditReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["FieldAuditReportMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">This report is FINAL and cannot be edited.</div>
    }

    @if (hasEngagement)
    {
        <form method="post" asp-action="SaveFieldAuditInputs">
            <input type="hidden" name="EngagementId" value="@Model.EngagementId" />
            <input type="hidden" name="EntityId" value="@Model.EntityId" />
            <input type="hidden" name="SectionCode" value="@Model.SectionCode" />
            <input type="hidden" name="returnAction" value="KpiSnapshot" />

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle" id="kpi-preview-table"></table>
            </div>

            <div class="card mb-4">
                <div class="card-header">Saved Data (Read-only)</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="kpi-snapshot-saved-table">
                            <thead>
                                <tr>
                                    <th>KPI Label</th>
                                    <th>Period End</th>
                                    <th>Actual</th>
                                    <th>Target</th>
                                    <th>Unit</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>KPI Snapshot (Entry)</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="add-kpi-snapshot-row" @(Model.IsReadOnly ? "disabled" : string.Empty)>
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="kpi-snapshot-entry-table">
                            <thead>
                                <tr>
                                    <th>KPI Label</th>
                                    <th>Period End</th>
                                    <th>Actual Value</th>
                                    <th>Target Value</th>
                                    <th>Unit</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary" id="save-kpi-snapshot" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save KPI Snapshot</button>
                        <span class="text-muted" id="kpi-snapshot-status"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("StaffSnapshot")">Back</a>
                <button type="submit" class="btn btn-primary" name="submitAction" value="save" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Draft</button>
                <button type="submit" class="btn btn-outline-success" name="submitAction" value="complete" @(Model.IsReadOnly ? "disabled" : string.Empty)>Mark Section Complete</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("NplSnapshot")">Next Section</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const engId = @Model.EngagementId;
            const entryTableBody = document.querySelector('#kpi-snapshot-entry-table tbody');
            const savedTableBody = document.querySelector('#kpi-snapshot-saved-table tbody');
            const addButton = document.getElementById('add-kpi-snapshot-row');
            const saveButton = document.getElementById('save-kpi-snapshot');
            const statusEl = document.getElementById('kpi-snapshot-status');
            const kpiOptions = [];
            const previewTable = document.getElementById('kpi-preview-table');
            let savedRows = [];
            let isEditing = false;

            if (!entryTableBody || !savedTableBody || !engId) {
                return;
            }

            const formatDate = (value) => {
                if (!value) {
                    return '';
                }
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) {
                    return '';
                }
                return date.toISOString().slice(0, 10);
            };

            const formatValue = (value) => {
                if (value === null || value === undefined || value === '') {
                    return '-';
                }
                return value;
            };

            const renderPreviewTable = (rows = []) => {
                if (!previewTable) {
                    return;
                }

                previewTable.innerHTML = '';
                if (!rows.length) {
                    previewTable.innerHTML = '<tbody><tr><td class="text-muted">No saved KPI snapshot data.</td></tr></tbody>';
                    return;
                }

                const periodMap = new Map();
                rows.forEach(row => {
                    const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                    const formatted = formatDate(periodEnd) || '';
                    if (!formatted) {
                        return;
                    }
                    if (!periodMap.has(formatted)) {
                        const dateValue = new Date(periodEnd);
                        periodMap.set(formatted, {
                            key: formatted,
                            sortValue: Number.isNaN(dateValue.getTime()) ? null : dateValue.getTime()
                        });
                    }
                });

                const periods = Array.from(periodMap.values())
                    .sort((a, b) => {
                        if (a.sortValue !== null && b.sortValue !== null) {
                            return a.sortValue - b.sortValue;
                        }
                        return a.key.localeCompare(b.key);
                    })
                    .map(item => item.key);

                const kpiMap = new Map();
                rows.forEach(row => {
                    const kpiLabel = row.kpiLabel ?? row.KpiLabel ?? '';
                    const periodEnd = formatDate(row.periodEnd ?? row.PeriodEnd ?? '') || '';
                    if (!kpiLabel || !periodEnd) {
                        return;
                    }
                    if (!kpiMap.has(kpiLabel)) {
                        kpiMap.set(kpiLabel, new Map());
                    }
                    kpiMap.get(kpiLabel).set(periodEnd, {
                        actualValue: row.actualValue ?? row.ActualValue ?? null,
                        targetValue: row.targetValue ?? row.TargetValue ?? null
                    });
                });

                const thead = document.createElement('thead');
                const headerRow = document.createElement('tr');
                const subHeaderRow = document.createElement('tr');
                const kpiHeader = document.createElement('th');
                kpiHeader.rowSpan = 2;
                kpiHeader.textContent = 'KPI';
                headerRow.appendChild(kpiHeader);

                periods.forEach(period => {
                    const th = document.createElement('th');
                    th.colSpan = 3;
                    th.textContent = period;
                    headerRow.appendChild(th);
                    ['Actual', 'Target', '%age'].forEach(label => {
                        const sub = document.createElement('th');
                        sub.textContent = label;
                        subHeaderRow.appendChild(sub);
                    });
                });

                thead.appendChild(headerRow);
                thead.appendChild(subHeaderRow);
                previewTable.appendChild(thead);

                const tbody = document.createElement('tbody');
                Array.from(kpiMap.keys()).forEach(kpiLabel => {
                    const row = document.createElement('tr');
                    const labelCell = document.createElement('td');
                    labelCell.textContent = kpiLabel;
                    row.appendChild(labelCell);

                    periods.forEach(period => {
                        const data = kpiMap.get(kpiLabel)?.get(period);
                        const actualValue = data?.actualValue;
                        const targetValue = data?.targetValue;
                        const actualCell = document.createElement('td');
                        const targetCell = document.createElement('td');
                        const percentCell = document.createElement('td');
                        actualCell.textContent = formatValue(actualValue);
                        targetCell.textContent = formatValue(targetValue);
                        let percentText = '-';
                        const actualNumber = Number(actualValue);
                        const targetNumber = Number(targetValue);
                        if (!Number.isNaN(actualNumber) && !Number.isNaN(targetNumber) && targetNumber !== 0) {
                            percentText = `${((actualNumber / targetNumber) * 100).toFixed(2)}%`;
                        }
                        percentCell.textContent = percentText;
                        row.appendChild(actualCell);
                        row.appendChild(targetCell);
                        row.appendChild(percentCell);
                    });

                    tbody.appendChild(row);
                });

                previewTable.appendChild(tbody);
            };

            const renderSavedRows = (rows = []) => {
                savedRows = rows;
                savedTableBody.innerHTML = '';
                if (!rows.length) {
                    const emptyRow = document.createElement('tr');
                    emptyRow.innerHTML = '<td colspan="6" class="text-muted">No saved data.</td>';
                    savedTableBody.appendChild(emptyRow);
                    return;
                }

                rows.forEach((row, index) => {
                    const kpiLabel = row.kpiLabel ?? row.KpiLabel ?? '';
                    const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                    const actualValue = row.actualValue ?? row.ActualValue ?? '';
                    const targetValue = row.targetValue ?? row.TargetValue ?? '';
                    const unit = row.unit ?? row.Unit ?? '';
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${kpiLabel || '-'}</td>
                        <td>${formatDate(periodEnd) || '-'}</td>
                        <td>${actualValue ?? ''}</td>
                        <td>${targetValue ?? ''}</td>
                        <td>${unit || '-'}</td>
                        <td><button type="button" class="btn btn-sm btn-outline-secondary kpi-edit" data-index="${index}">Update</button></td>
                    `;
                    savedTableBody.appendChild(tr);
                });

                savedTableBody.querySelectorAll('.kpi-edit').forEach(button => {
                    button.addEventListener('click', (event) => {
                        const index = Number(event.currentTarget.dataset.index);
                        const row = savedRows[index];
                        if (!row) {
                            return;
                        }
                        entryTableBody.innerHTML = '';
                        addRow(row);
                        isEditing = true;
                        saveButton.textContent = 'Update KPI Snapshot';
                        addButton?.setAttribute('disabled', 'disabled');
                    });
                });
            };

            const createKpiSelect = (selectedCode = '', selectedLabel = '') => {
                const select = document.createElement('select');
                select.className = 'form-select';
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'Select KPI';
                select.appendChild(placeholder);

                kpiOptions.forEach(option => {
                    const opt = document.createElement('option');
                    opt.value = option.kpiCode;
                    opt.textContent = option.kpiLabel;
                    opt.dataset.unit = option.unit ?? '';
                    if (option.kpiCode === selectedCode || option.kpiLabel === selectedLabel) {
                        opt.selected = true;
                    }
                    select.appendChild(opt);
                });

                return select;
            };

            const addRow = (row = {}) => {
                const kpiCode = row.kpiCode ?? row.KpiCode ?? '';
                const kpiLabel = row.kpiLabel ?? row.KpiLabel ?? '';
                const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                const actualValue = row.actualValue ?? row.ActualValue ?? '';
                const targetValue = row.targetValue ?? row.TargetValue ?? '';
                const unit = row.unit ?? row.Unit ?? '';
                const tr = document.createElement('tr');
                const kpiCell = document.createElement('td');
                const select = createKpiSelect(kpiCode, kpiLabel);
                const unitInput = document.createElement('input');
                unitInput.className = 'form-control';
                unitInput.value = unit;

                select.addEventListener('change', (event) => {
                    const selected = event.target.selectedOptions[0];
                    const selectedUnit = selected?.dataset?.unit ?? '';
                    if (selectedUnit) {
                        unitInput.value = selectedUnit;
                    }
                });

                kpiCell.appendChild(select);
                tr.appendChild(kpiCell);
                const periodCell = document.createElement('td');
                const periodInput = document.createElement('input');
                periodInput.className = 'form-control';
                periodInput.type = 'date';
                periodInput.value = formatDate(periodEnd);
                periodCell.appendChild(periodInput);
                tr.appendChild(periodCell);

                const actualCell = document.createElement('td');
                const actualInput = document.createElement('input');
                actualInput.className = 'form-control';
                actualInput.type = 'number';
                actualInput.step = 'any';
                actualInput.value = actualValue;
                actualCell.appendChild(actualInput);
                tr.appendChild(actualCell);

                const targetCell = document.createElement('td');
                const targetInput = document.createElement('input');
                targetInput.className = 'form-control';
                targetInput.type = 'number';
                targetInput.step = 'any';
                targetInput.value = targetValue;
                targetCell.appendChild(targetInput);
                tr.appendChild(targetCell);
                const unitCell = document.createElement('td');
                unitCell.appendChild(unitInput);
                tr.appendChild(unitCell);
                entryTableBody.appendChild(tr);
            };

            const loadKpiRows = () => {
                statusEl.textContent = 'Loading...';
                fetch(`/FieldAuditReport/GetKpiSnapshotRows?engId=${engId}`)
                    .then(response => response.json())
                    .then(data => {
                        const rows = data?.rows ?? [];
                        renderSavedRows(rows);
                        renderPreviewTable(rows);
                        entryTableBody.innerHTML = '';
                        addRow();
                        statusEl.textContent = '';
                    })
                    .catch(() => {
                        statusEl.textContent = 'Unable to load KPI snapshot rows.';
                    });
            };

            const collectKpiRows = () => {
                return Array.from(entryTableBody.querySelectorAll('tr')).map(row => {
                    const kpiSelect = row.querySelector('select');
                    const cells = row.querySelectorAll('input');
                    const kpiCode = kpiSelect?.value?.trim() ?? '';
                    const kpiLabel = kpiSelect?.selectedOptions[0]?.textContent?.trim() ?? '';
                    const periodEnd = cells[0]?.value;
                    const actualValue = cells[1]?.value;
                    const targetValue = cells[2]?.value;
                    const unit = cells[3]?.value?.trim() ?? '';
                    return {
                        kpiCode,
                        kpiLabel,
                        periodEnd: periodEnd === '' ? null : periodEnd,
                        actualValue: actualValue === '' ? null : Number(actualValue),
                        targetValue: targetValue === '' ? null : Number(targetValue),
                        unit
                    };
                });
            };

            const saveKpiRows = () => {
                if (saveButton?.disabled) {
                    return;
                }
                statusEl.textContent = 'Saving...';
                fetch(`/FieldAuditReport/SaveKpiSnapshotRows?engId=${engId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(collectKpiRows())
                })
                    .then(response => response.json())
                    .then(data => {
                        if (!data?.success) {
                            statusEl.textContent = data?.message ?? 'Unable to save KPI snapshot rows.';
                            return;
                        }
                        statusEl.textContent = data.message ?? 'Saved.';
                        const rows = data?.rows ?? [];
                        renderSavedRows(rows);
                        renderPreviewTable(rows);
                        if (isEditing) {
                            isEditing = false;
                            saveButton.textContent = 'Save KPI Snapshot';
                            addButton?.removeAttribute('disabled');
                        }
                        entryTableBody.innerHTML = '';
                        addRow();
                    })
                    .catch(() => {
                        statusEl.textContent = 'Unable to save KPI snapshot rows.';
                    });
            };

            addButton?.addEventListener('click', () => addRow());
            saveButton?.addEventListener('click', saveKpiRows);
            fetch(`/FieldAuditReport/GetKpiOptions?engId=${engId}`)
                .then(response => response.json())
                .then(data => {
                    kpiOptions.length = 0;
                    (data?.items ?? []).forEach(item => {
                        if (!item) {
                            return;
                        }
                        kpiOptions.push({
                            kpiCode: item.kpiCode ?? item.KpiCode ?? '',
                            kpiLabel: item.kpiLabel ?? item.KpiLabel ?? '',
                            unit: item.unit ?? item.Unit ?? ''
                        });
                    });
                    loadKpiRows();
                })
                .catch(() => {
                    statusEl.textContent = 'Unable to load KPI options.';
                    loadKpiRows();
                });
        })();
    </script>
}
