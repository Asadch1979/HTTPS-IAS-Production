@model AIS.Models.FieldAuditReport.FieldAuditReportOverviewViewModel
@using System.Linq

@{
    ViewData["Title"] = "Field Audit Report Overview";
    Layout = "_Layout";

    string FormatDate(DateTime? value) => value?.ToString("dd-MMM-yyyy") ?? "-";
    string FormatRange(DateTime? start, DateTime? end) => $"{FormatDate(start)} to {FormatDate(end)}";
    string FormatText(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string FormatNumber(int? value) => value.HasValue ? value.Value.ToString() : "-";
    string FormatTeamMember(AIS.Models.GetTeamDetailsModel member)
    {
        if (member == null)
        {
            return "-";
        }

        var name = string.IsNullOrWhiteSpace(member.MEMBER_NAME) ? string.Empty : member.MEMBER_NAME.Trim();
        var ppNo = string.IsNullOrWhiteSpace(member.MEMBER_PPNO) ? string.Empty : member.MEMBER_PPNO.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.IsNullOrWhiteSpace(ppNo) ? "-" : ppNo;
        }
        return string.IsNullOrWhiteSpace(ppNo) ? name : $"{name} ({ppNo})";
    }

    string GetTeamLeadName()
    {
        var lead = Model?.AuditTeam?.FirstOrDefault(member =>
            string.Equals(member?.ISTEAMLEAD, "Y", StringComparison.OrdinalIgnoreCase));
        return FormatTeamMember(lead);
    }

    IEnumerable<string> GetTeamMembers()
    {
        return Model?.AuditTeam?
            .Where(member => member != null && !string.Equals(member.ISTEAMLEAD, "Y", StringComparison.OrdinalIgnoreCase))
            .Select(FormatTeamMember)
            .Where(item => !string.IsNullOrWhiteSpace(item) && item != "-")
            ?? Enumerable.Empty<string>();
    }
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    ViewData["IsFinal"] = Model?.IsFinal ?? false;
    ViewData["CanFinalize"] = Model?.CanFinalize ?? false;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Field Audit Report - Overview</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ReportActionsNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to view the Field Audit Report overview.</div>
    }

    @if (TempData["FieldAuditReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["FieldAuditReportMessage"]</div>
    }

    @if (hasEngagement)
    {
        <div class="card mb-4">
            <div class="card-header">Report Summary</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <strong>Audit Year / Period:</strong> @FormatText(Model.Overview.AUDIT_YEAR)
                    </div>
                    <div class="col-md-4">
                        <strong>Reporting Office:</strong> @FormatText(Model.Overview.REPORTING_OFFICE)
                    </div>
                    <div class="col-md-4">
                        <strong>Entity Name:</strong> @FormatText(Model.Overview.ENTITY_NAME)
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <strong>Operation Period:</strong> @FormatRange(Model.Overview.OPERATION_STARTDATE, Model.Overview.OPERATION_ENDDATE)
                    </div>
                    <div class="col-md-6">
                        <strong>Team Exist Audit:</strong> @FormatRange(Model.Overview.AUDIT_STARTED_ON, Model.Overview.TEAM_EXIST)
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <strong>Total Members:</strong> @FormatNumber(Model.Overview.TOTAL_MEMBERS)
                    </div>
                    <div class="col-md-6">
                        <strong>Team Lead:</strong> @FormatText(Model.Overview.TEAM_LEAD)
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <strong>Audited Team Lead:</strong> @GetTeamLeadName()
                    </div>
                    <div class="col-md-6">
                        <strong>Audited Team Members:</strong>
                        @{
                            var members = GetTeamMembers().ToList();
                        }
                        @if (members.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var member in members)
                                {
                                    <li>@member</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted">No audit team data available.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Completion Checklist</div>
            <div class="card-body">
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        KPI Snapshot
                        <span class="text-@((Model.Checklist.HasKpiSnapshot ? "success" : "danger"))">
                            <i class="fa-solid @(Model.Checklist.HasKpiSnapshot ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        NPL Snapshot
                        <span class="text-@((Model.Checklist.HasNplSnapshot ? "success" : "danger"))">
                            <i class="fa-solid @(Model.Checklist.HasNplSnapshot ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Staff Snapshot
                        <span class="text-@((Model.Checklist.HasStaffSnapshot ? "success" : "danger"))">
                            <i class="fa-solid @(Model.Checklist.HasStaffSnapshot ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Mandatory Narrative Sections
                        <span class="text-@((Model.Checklist.MandatoryNarrativesComplete ? "success" : "danger"))">
                            <i class="fa-solid @(Model.Checklist.MandatoryNarrativesComplete ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        </span>
                    </li>
                </ul>
            </div>
        </div>

    }
</div>
