@model AIS.Models.FieldAuditReport.NarrativeSectionsViewModel
@using System
@using System.Linq

@{
    ViewData["Title"] = "Field Audit Report";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    var reportYear = string.IsNullOrWhiteSpace(Model?.Overview?.AUDIT_YEAR) ? "202X" : Model.Overview.AUDIT_YEAR;
    ViewData["IsReadOnly"] = Model?.IsReadOnly ?? false;
}

@functions {
    private string FieldValue(string key)
        {
        return Model?.Fields != null && Model.Fields.TryGetValue(key, out var value) ? value : string.Empty;
        }

    private string FormatDate(DateTime? value)
        {
        return value?.ToString("dd-MMM-yyyy") ?? "-";
        }

    private string FormatRange(DateTime? start, DateTime? end)
        {
        return $"{FormatDate(start)} to {FormatDate(end)}";
        }

    private string FormatText(string value)
        {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
        }

    private string FormatNumber(int? value)
        {
        return value.HasValue ? value.Value.ToString() : "-";
        }

    private AIS.Models.FieldAuditReport.FieldAuditPdfStatisticsRowModel FindStatisticsRow(string riskLevel)
        {
        return Model?.StatisticsRows?.FirstOrDefault(row =>
            string.Equals(row.RiskLevel, riskLevel, StringComparison.OrdinalIgnoreCase));
        }

    private string FormatParaNo(int? paraNo)
        {
        return paraNo.HasValue && paraNo.Value > 0 ? paraNo.Value.ToString("D2") : "--";
        }

    private string FormatReadOnlyNarrative(string value)
        {
        return string.IsNullOrWhiteSpace(value) ? "Not available" : value;
        }
}

<style>
    .section-title {
        font-size: 14px;
        font-weight: 700;
        margin: 18px 0 10px 0;
        padding: 8px 10px;
        border-left: 4px solid #111;
        background: #f6f8fa;
    }

    .rich-text-block .richText,
    .rich-text-block .richText .richText-editor {
        width: 100%;
    }

    .rich-text-block .richText {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        background-color: #fff;
    }

    .rich-text-block .richText .richText-editor {
        min-height: 180px;
        border: 1px solid #ced4da;
    }

    .rich-text-readonly .richText-editor {
        background-color: #f8f9fa;
    }

    .read-only-text {
        white-space: pre-line;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Field Audit Report</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ReportActionsNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to work with the Field Audit Report.</div>
    }

    @if (TempData["FieldAuditReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["FieldAuditReportMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">This report is FINAL and cannot be edited.</div>
    }

    @if (hasEngagement)
    {
        <div class="card mb-4">
            <div class="card-header">Report Summary</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <strong>Audit Year / Period:</strong> @FormatText(Model.Overview.AUDIT_YEAR)
                    </div>
                    <div class="col-md-4">
                        <strong>Reporting Office:</strong> @FormatText(Model.Overview.REPORTING_OFFICE)
                    </div>
                    <div class="col-md-4">
                        <strong>Entity Name:</strong> @FormatText(Model.Overview.ENTITY_NAME)
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <strong>Operation Period:</strong> @FormatRange(Model.Overview.OPERATION_STARTDATE, Model.Overview.OPERATION_ENDDATE)
                    </div>
                    <div class="col-md-6">
                        <strong>Team Exist Audit:</strong> @FormatRange(Model.Overview.AUDIT_STARTED_ON, Model.Overview.TEAM_EXIST)
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <strong>Total Members:</strong> @FormatNumber(Model.Overview.TOTAL_MEMBERS)
                    </div>
                    <div class="col-md-6">
                        <strong>Team Lead:</strong> @FormatText(Model.Overview.TEAM_LEAD)
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="SaveFieldAuditInputs">
            <input type="hidden" name="EngagementId" value="@Model.EngagementId" />
            <input type="hidden" name="EntityId" value="@Model.EntityId" />
            <input type="hidden" name="SectionCode" value="@Model.SectionCode" />
            <input type="hidden" name="returnAction" value="NarrativeSections" />

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <tbody>
                        <tr>
                            <td>
                                <div>@Model.ReportStatus</div>
                                <div>INTERNAL AUDIT REPORT-@reportYear</div>
                            </td>
                            <td>
                                <div>
                                    Branch @FormatText(Model.Overview.ENTITY_NAME) [Code: @FormatText(Model.Overview.EntityCode)]
                                </div>
                                <div>
                                    Audit Date: @FormatDate(Model.Overview.AUDIT_STARTED_ON)
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div>
                                    Audit Start Date: @FormatDate(Model.Overview.OPERATION_STARTDATE)
                                </div>
                                <div>
                                    Audit Completion Date: @FormatDate(Model.Overview.TEAM_EXIST)
                                </div>
                                <div>
                                    Audit Period: @FormatRange(Model.Overview.OPERATION_STARTDATE, Model.Overview.OPERATION_ENDDATE)
                                </div>
                                <div>AUDIT CONDUCTED BY:</div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div>NOTE:</div>
                                <div>This audit report is highly confidential, therefore, not to be shared with any third party without approval of IAD at H.O.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Name and Grade</th>
                            <th>PP NO</th>
                            <th>Designation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AuditTeam.Any())
                        {
                            foreach (var member in Model.AuditTeam)
                            {
                                <tr>
                                    <td>@member.MEMBER_NAME</td>
                                    <td>@member.MEMBER_PPNO</td>
                                    <td>@(member.ISTEAMLEAD == "Y" ? "Audit Team Leader" : "Audit Team Member")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-muted">No audit team data available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th colspan="3">Para No</th>
                            <th>Gist of the Para</th>
                            <th>Nature of Para (repeated / new)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5">IAS procedure will provide the data</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="section-title">4. Statistics of Current Audit Report</div>
            <div class="table-responsive mb-2" id="statisticsBlock">
                <table class="table table-bordered align-middle" id="statisticsTable">
                    <thead>
                        <tr>
                            <th>Nature of Paras</th>
                            <th>Reported</th>
                            <th>Rectified</th>
                            <th>Outstanding</th>
                            <th>Remarks, if any</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-nature="Fraud &amp; Forgery (if any)">
                            <td>Fraud &amp; Forgery (if any)</td>
                            <td><input class="form-control stats-reported" type="number" min="0" /></td>
                            <td><input class="form-control stats-rectified" type="number" min="0" /></td>
                            <td><input class="form-control stats-outstanding" type="number" min="0" /></td>
                            <td><input class="form-control stats-remarks" /></td>
                        </tr>
                        <tr data-nature="High Risk Paras">
                            <td>High Risk Paras</td>
                            <td><input class="form-control stats-reported" type="number" min="0" /></td>
                            <td><input class="form-control stats-rectified" type="number" min="0" /></td>
                            <td><input class="form-control stats-outstanding" type="number" min="0" /></td>
                            <td><input class="form-control stats-remarks" /></td>
                        </tr>
                        <tr data-nature="Medium Risk Paras">
                            <td>Medium Risk Paras</td>
                            <td><input class="form-control stats-reported" type="number" min="0" /></td>
                            <td><input class="form-control stats-rectified" type="number" min="0" /></td>
                            <td><input class="form-control stats-outstanding" type="number" min="0" /></td>
                            <td><input class="form-control stats-remarks" /></td>
                        </tr>
                        <tr data-nature="Low Risk Paras">
                            <td>Low Risk Paras</td>
                            <td><input class="form-control stats-reported" type="number" min="0" /></td>
                            <td><input class="form-control stats-rectified" type="number" min="0" /></td>
                            <td><input class="form-control stats-outstanding" type="number" min="0" /></td>
                            <td><input class="form-control stats-remarks" /></td>
                        </tr>
                        <tr data-nature="Total">
                            <td>Total</td>
                            <td><input class="form-control stats-reported" type="number" min="0" /></td>
                            <td><input class="form-control stats-rectified" type="number" min="0" /></td>
                            <td><input class="form-control stats-outstanding" type="number" min="0" /></td>
                            <td><input class="form-control stats-remarks" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button type="button" class="btn btn-primary" id="saveStatisticsBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Statistics</button>
                <button type="button" class="btn btn-outline-primary d-none" id="updateStatisticsBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Update Statistics</button>
            </div>
            <div class="form-text mb-4" id="statisticsMessage"></div>

            <div class="section-title">5. Summary of leakage of income / identified from sample of transactions</div>
            <div class="table-responsive mb-2" id="incomeLeakageBlock">
                <table class="table table-bordered align-middle" id="incomeLeakageTable">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Area</th>
                            <th>Amount (Rs.)</th>
                            <th class="text-center" style="width:80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2">Total</th>
                            <th id="incomeLeakageTotal">0</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button type="button" class="btn btn-outline-secondary" id="addIncomeLeakageRowBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Add Row</button>
                <button type="button" class="btn btn-primary" id="saveIncomeLeakageBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Income Leakage</button>
                <button type="button" class="btn btn-outline-primary d-none" id="updateIncomeLeakageBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Update Income Leakage</button>
            </div>
            <div class="form-text mb-4" id="incomeLeakageMessage"></div>

            <div class="section-title">6. Overall Audit Conclusion</div>
            <div id="overallConclusionBlock">
                <div class="mb-3 rich-text-block">
                    <label class="form-label" for="overallConclusionEditor">Overall Audit Conclusion</label>
                    <textarea id="overallConclusionEditor" class="form-control"></textarea>
                </div>
                <div class="mb-3 rich-text-block">
                    <label class="form-label" for="nonAddressableEditor">a) Non-Addressable Findings/Exceptions</label>
                    <textarea id="nonAddressableEditor" class="form-control"></textarea>
                </div>
                <div class="mb-3 rich-text-block">
                    <label class="form-label" for="fraudProneEditor">b) Fraud Prone Indicators</label>
                    <textarea id="fraudProneEditor" class="form-control"></textarea>
                </div>
                <div class="mb-3 rich-text-block">
                    <label class="form-label" for="regulatoryEditor">c) Exceptions related to Regulatory Violations</label>
                    <textarea id="regulatoryEditor" class="form-control"></textarea>
                </div>
                <div class="mb-3 rich-text-block">
                    <label class="form-label" for="safetySecurityEditor">d) Comments on Safety &amp; Security</label>
                    <textarea id="safetySecurityEditor" class="form-control"></textarea>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-primary" id="saveConclusionBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Conclusion</button>
                    <button type="button" class="btn btn-outline-primary d-none" id="updateConclusionBtn" @(Model.IsReadOnly ? "disabled" : string.Empty)>Update Conclusion</button>
                </div>
                <div class="form-text mb-4" id="conclusionMessage"></div>
            </div>

            @for (var index = 0; index < Model.ObservationCount; index++)
            {
                var observation = Model.Observations != null && index < Model.Observations.Count
                    ? Model.Observations[index]
                    : null;
                var paraLabel = FormatParaNo(observation?.ParaNo);
                var isParaFinalized = observation?.IsFinalized ?? false;
                var isParaLocked = Model.IsReadOnly || isParaFinalized;
                <div class="table-responsive mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Para No @paraLabel:</h5>
                        @if (isParaFinalized)
                        {
                            <span class="badge bg-success">Finalized</span>
                        }
                    </div>
                    <table class="table table-bordered align-middle mb-0" data-para-id="@(observation?.ParaId ?? 0)">
                        <tbody>
                            <tr>
                                <th>Risk Level of Para</th>
                                <td>@(observation?.Risk ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>Annexure Code</th>
                                <td>@(observation?.AnnexureCode ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>Annexure Description</th>
                                <td>@(observation?.AnnexureDescription ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>Target Rectification Date</th>
                                <td>(Input by Auditee)</td>
                            </tr>
                            <tr>
                                <th>Instances Involved</th>
                                <td>@(observation?.InstancesInvolved ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>Amount Involved</th>
                                <td>@(observation?.AmountInvolved ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>Rectification Status</th>
                                <td>Outstanding</td>
                            </tr>
                            <tr>
                                <th>Gist of Para</th>
                                <td>@(observation?.GistOfPara ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>PARA Detail</th>
                                <td>@Html.Raw(observation?.ParaDetail ?? string.Empty)</td>
                            </tr>
                            <tr>
                                <th>IMPLICATIONS</th>
                                <td>
                                    <textarea class="form-control w-100"
                                              data-field="Implications"
                                              data-label="IMPLICATIONS"
                                              rows="4"
                                              @(isParaLocked ? "disabled" : string.Empty)>@observation?.Implications</textarea>
                                </td>
                            </tr>
                            <tr>
                                <th>RECOMMENDATIONS</th>
                                <td>
                                    <div class="form-control-plaintext read-only-text"
                                         data-field="Recommendations"
                                         data-label="RECOMMENDATIONS"
                                         data-value="@observation?.Recommendations">
                                        @FormatReadOnlyNarrative(observation?.Recommendations)
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>MANAGEMENT / BRANCH COMMENTS</th>
                                <td>
                                    <div class="form-control-plaintext read-only-text"
                                         data-field="ManagementComments"
                                         data-label="MANAGEMENT / BRANCH COMMENTS"
                                         data-value="@observation?.ManagementComments">
                                        @FormatReadOnlyNarrative(observation?.ManagementComments)
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>AUDITOR’S FURTHER COMMENTS</th>
                                <td>
                                    <div class="form-control-plaintext read-only-text"
                                         data-field="AuditorFurtherComments"
                                         data-label="AUDITOR’S FURTHER COMMENTS"
                                         data-value="@observation?.AuditorFurtherComments">
                                        @FormatReadOnlyNarrative(observation?.AuditorFurtherComments)
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>REMARKS OF SVP / INCHARGE</th>
                                <td>
                                    <div class="form-control-plaintext read-only-text"
                                         data-field="SvpRemarks"
                                         data-label="REMARKS OF SVP / INCHARGE"
                                         data-value="@observation?.SvpRemarks">
                                        @FormatReadOnlyNarrative(observation?.SvpRemarks)
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    @if (!Model.IsReadOnly && observation?.ParaId > 0)
                    {
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            @if (isParaFinalized)
                            {
                                <button type="button" class="btn btn-outline-warning"
                                        onclick="submitParaAction(@observation.ParaId, 'UPDATE_REQUIRED')">
                                    Update Required
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary"
                                        onclick="submitParaAction(@observation.ParaId, 'FINALIZE')">
                                    Save/Finalize Para
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("ReportOverview")">Back</a>
                <button type="submit" class="btn btn-primary" name="submitAction" value="save" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Draft</button>
                <button type="submit" class="btn btn-outline-success" name="submitAction" value="complete" @(Model.IsReadOnly ? "disabled" : string.Empty)>Mark Section Complete</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("StaffSnapshot")">Next Section</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const engagementId = @Model.EngagementId;
            const reportVersionRaw = '@(Model.Overview?.VersionNo ?? string.Empty)';
            const reportVersion = parseInt(reportVersionRaw || '1', 10) || 1;
            const isReadOnly = @Model.IsReadOnly.ToString().ToLowerInvariant();
            const urls = {
                getStatistics: '@Url.Action("GetPdfStatistics")',
                saveStatistics: '@Url.Action("SavePdfStatistics")',
                getIncomeLeakage: '@Url.Action("GetIncomeLeakage")',
                saveIncomeLeakage: '@Url.Action("SaveIncomeLeakage")',
                getConclusion: '@Url.Action("GetOverallConclusion")',
                saveConclusion: '@Url.Action("SaveOverallConclusion")'
            };

            if (!engagementId || engagementId <= 0) {
                return;
            }

            const statisticsMessage = document.getElementById('statisticsMessage');
            const incomeLeakageMessage = document.getElementById('incomeLeakageMessage');
            const conclusionMessage = document.getElementById('conclusionMessage');
            const saveStatisticsBtn = document.getElementById('saveStatisticsBtn');
            const updateStatisticsBtn = document.getElementById('updateStatisticsBtn');
            const saveIncomeLeakageBtn = document.getElementById('saveIncomeLeakageBtn');
            const updateIncomeLeakageBtn = document.getElementById('updateIncomeLeakageBtn');
            const addIncomeLeakageRowBtn = document.getElementById('addIncomeLeakageRowBtn');
            const saveConclusionBtn = document.getElementById('saveConclusionBtn');
            const updateConclusionBtn = document.getElementById('updateConclusionBtn');
            const incomeLeakageTotal = document.getElementById('incomeLeakageTotal');

            const conclusionEditors = [
                { id: 'overallConclusionEditor', key: 'overallConclusionHtml' },
                { id: 'nonAddressableEditor', key: 'nonAddressableHtml' },
                { id: 'fraudProneEditor', key: 'fraudProneHtml' },
                { id: 'regulatoryEditor', key: 'regulatoryHtml' },
                { id: 'safetySecurityEditor', key: 'safetySecurityHtml' }
            ];

            function setMessage(element, message, isError) {
                if (!element) {
                    return;
                }
                element.textContent = message || '';
                element.classList.remove('text-success', 'text-danger');
                element.classList.add(isError ? 'text-danger' : 'text-success');
            }

            function setStatisticsLocked(locked) {
                const disabled = locked || isReadOnly;
                document.querySelectorAll('#statisticsTable input').forEach((input) => {
                    input.disabled = disabled;
                });
                if (updateStatisticsBtn) {
                    updateStatisticsBtn.classList.toggle('d-none', !locked || isReadOnly);
                }
            }

            function setIncomeLeakageLocked(locked) {
                const disabled = locked || isReadOnly;
                document.querySelectorAll('#incomeLeakageTable input').forEach((input) => {
                    input.disabled = disabled;
                });
                document.querySelectorAll('#incomeLeakageTable button[data-action="remove"]').forEach((button) => {
                    button.disabled = disabled;
                    button.classList.toggle('d-none', disabled);
                });
                if (addIncomeLeakageRowBtn) {
                    addIncomeLeakageRowBtn.disabled = disabled;
                }
                if (updateIncomeLeakageBtn) {
                    updateIncomeLeakageBtn.classList.toggle('d-none', !locked || isReadOnly);
                }
            }

            function setConclusionLocked(locked) {
                const disabled = locked || isReadOnly;
                conclusionEditors.forEach((editor) => {
                    setEditorReadOnly(editor.id, disabled);
                });
                if (updateConclusionBtn) {
                    updateConclusionBtn.classList.toggle('d-none', !locked || isReadOnly);
                }
            }

            function parseNumeric(value) {
                if (value === null || value === undefined || value === '') {
                    return null;
                }
                const number = Number(value);
                return Number.isNaN(number) ? null : number;
            }

            function collectStatisticsRows() {
                const rows = [];
                document.querySelectorAll('#statisticsTable tbody tr').forEach((row) => {
                    const nature = row.dataset.nature || '';
                    const reported = parseNumeric(row.querySelector('.stats-reported')?.value);
                    const rectified = parseNumeric(row.querySelector('.stats-rectified')?.value);
                    const outstanding = parseNumeric(row.querySelector('.stats-outstanding')?.value);
                    const remarks = row.querySelector('.stats-remarks')?.value || '';
                    rows.push({
                        nature,
                        reported,
                        rectified,
                        outstanding,
                        remarks
                    });
                });
                return rows;
            }

            function applyStatisticsRows(rows) {
                (rows || []).forEach((row) => {
                    const match = document.querySelector(`#statisticsTable tbody tr[data-nature="${CSS.escape(row.nature || '')}"]`);
                    if (!match) {
                        return;
                    }
                    const setValue = (selector, value) => {
                        const input = match.querySelector(selector);
                        if (input) {
                            input.value = value === null || value === undefined ? '' : value;
                        }
                    };
                    setValue('.stats-reported', row.reported);
                    setValue('.stats-rectified', row.rectified);
                    setValue('.stats-outstanding', row.outstanding);
                    setValue('.stats-remarks', row.remarks || '');
                });
            }

            function updateIncomeLeakageTotal() {
                let total = 0;
                document.querySelectorAll('#incomeLeakageTable tbody tr').forEach((row) => {
                    const amountValue = row.querySelector('[data-field="amount"]')?.value;
                    const amount = parseFloat(amountValue);
                    if (!Number.isNaN(amount)) {
                        total += amount;
                    }
                });
                if (incomeLeakageTotal) {
                    incomeLeakageTotal.textContent = total.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                }
            }

            function createIncomeLeakageRow(row = {}) {
                const tbody = document.querySelector('#incomeLeakageTable tbody');
                if (!tbody) {
                    return;
                }
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><input class="form-control" data-field="description" value="${row.description || ''}" /></td>
                    <td><input class="form-control" data-field="area" value="${row.area || ''}" /></td>
                    <td><input class="form-control" data-field="amount" type="number" step="0.01" min="0" value="${row.amount ?? ''}" /></td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-action="remove">Remove</button></td>
                `;
                tbody.appendChild(tr);

                tr.querySelectorAll('input').forEach((input) => {
                    input.addEventListener('input', updateIncomeLeakageTotal);
                });
                tr.querySelector('[data-action="remove"]')?.addEventListener('click', () => {
                    tr.remove();
                    updateIncomeLeakageTotal();
                });
                updateIncomeLeakageTotal();
            }

            function collectIncomeLeakageRows() {
                const rows = [];
                document.querySelectorAll('#incomeLeakageTable tbody tr').forEach((row) => {
                    const description = row.querySelector('[data-field="description"]')?.value || '';
                    const area = row.querySelector('[data-field="area"]')?.value || '';
                    const amountValue = row.querySelector('[data-field="amount"]')?.value;
                    const amount = parseNumeric(amountValue);
                    rows.push({ description, area, amount });
                });
                return rows;
            }

            function setEditorHtml(textareaId, html) {
                const $textarea = $('#' + textareaId);
                const $editor = $textarea.closest('.richText').find('.richText-editor');
                if ($editor.length) {
                    $editor.html(html || '');
                } else {
                    $textarea.val(html || '');
                }
            }

            function getEditorHtml(textareaId) {
                const $textarea = $('#' + textareaId);
                const $editor = $textarea.closest('.richText').find('.richText-editor');
                if ($editor.length) {
                    return $editor.html() || '';
                }
                return $textarea.val() || '';
            }

            function setEditorReadOnly(textareaId, readOnly) {
                const $textarea = $('#' + textareaId);
                const $wrapper = $textarea.closest('.richText');
                const $editor = $wrapper.find('.richText-editor');
                const $toolbar = $wrapper.find('.richText-toolbar');
                $editor.attr('contenteditable', !readOnly);
                if (readOnly) {
                    $toolbar.hide();
                    $wrapper.addClass('rich-text-readonly');
                } else {
                    $toolbar.show();
                    $wrapper.removeClass('rich-text-readonly');
                }
            }

            async function fetchJson(url, options) {
                const response = await fetch(url, options);
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data?.message || 'Request failed');
                }
                return data;
            }

            async function loadStatistics() {
                try {
                    const data = await fetchJson(`${urls.getStatistics}?engId=${engagementId}&reportVersion=${reportVersion}`);
                    applyStatisticsRows(data.rows || []);
                    setStatisticsLocked(data.locked);
                } catch (error) {
                    setMessage(statisticsMessage, error.message || 'Unable to load statistics.', true);
                }
            }

            async function loadIncomeLeakage() {
                const tbody = document.querySelector('#incomeLeakageTable tbody');
                if (tbody) {
                    tbody.innerHTML = '';
                }
                try {
                    const data = await fetchJson(`${urls.getIncomeLeakage}?engId=${engagementId}&reportVersion=${reportVersion}`);
                    const rows = data.rows || [];
                    if (rows.length === 0) {
                        createIncomeLeakageRow();
                    } else {
                        rows.forEach((row) => createIncomeLeakageRow(row));
                    }
                    setIncomeLeakageLocked(data.locked);
                } catch (error) {
                    createIncomeLeakageRow();
                    setMessage(incomeLeakageMessage, error.message || 'Unable to load income leakage.', true);
                }
            }

            async function loadConclusion() {
                try {
                    const data = await fetchJson(`${urls.getConclusion}?engId=${engagementId}&reportVersion=${reportVersion}`);
                    const model = data.model || {};
                    conclusionEditors.forEach((editor) => {
                        setEditorHtml(editor.id, model[editor.key] || '');
                    });
                    setConclusionLocked(data.locked);
                } catch (error) {
                    setMessage(conclusionMessage, error.message || 'Unable to load conclusion.', true);
                }
            }

            async function saveStatistics() {
                setMessage(statisticsMessage, '', false);
                const rows = collectStatisticsRows();
                const hasNegative = rows.some((row) =>
                    (row.reported !== null && row.reported < 0)
                    || (row.rectified !== null && row.rectified < 0)
                    || (row.outstanding !== null && row.outstanding < 0));
                if (hasNegative) {
                    setMessage(statisticsMessage, 'Statistics values cannot be negative.', true);
                    return;
                }

                try {
                    const response = await fetchJson(urls.saveStatistics, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ engId: engagementId, reportVersion, rows })
                    });
                    setMessage(statisticsMessage, response.message || 'Saved successfully.', false);
                    setStatisticsLocked(true);
                } catch (error) {
                    setMessage(statisticsMessage, error.message || 'Unable to save statistics.', true);
                }
            }

            async function saveIncomeLeakage() {
                setMessage(incomeLeakageMessage, '', false);
                const rows = collectIncomeLeakageRows();
                const hasNegative = rows.some((row) => row.amount !== null && row.amount < 0);
                if (hasNegative) {
                    setMessage(incomeLeakageMessage, 'Income leakage amount cannot be negative.', true);
                    return;
                }

                try {
                    const response = await fetchJson(urls.saveIncomeLeakage, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ engId: engagementId, reportVersion, rows })
                    });
                    setMessage(incomeLeakageMessage, response.message || 'Saved successfully.', false);
                    setIncomeLeakageLocked(true);
                } catch (error) {
                    setMessage(incomeLeakageMessage, error.message || 'Unable to save income leakage.', true);
                }
            }

            async function saveConclusion() {
                setMessage(conclusionMessage, '', false);
                const payload = { engId: engagementId, reportVersion };
                conclusionEditors.forEach((editor) => {
                    payload[editor.key] = getEditorHtml(editor.id);
                });
                try {
                    const response = await fetchJson(urls.saveConclusion, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    setMessage(conclusionMessage, response.message || 'Saved successfully.', false);
                    setConclusionLocked(true);
                } catch (error) {
                    setMessage(conclusionMessage, error.message || 'Unable to save conclusion.', true);
                }
            }

            $(document).ready(function () {
                $('.rich-text-block textarea').each(function () {
                    $(this).richText({
                        imageUpload: false,
                        fileUpload: false,
                        videoEmbed: false,
                        urls: false
                    });
                });

                addIncomeLeakageRowBtn?.addEventListener('click', () => createIncomeLeakageRow());
                saveStatisticsBtn?.addEventListener('click', saveStatistics);
                updateStatisticsBtn?.addEventListener('click', () => setStatisticsLocked(false));
                saveIncomeLeakageBtn?.addEventListener('click', saveIncomeLeakage);
                updateIncomeLeakageBtn?.addEventListener('click', () => setIncomeLeakageLocked(false));
                saveConclusionBtn?.addEventListener('click', saveConclusion);
                updateConclusionBtn?.addEventListener('click', () => setConclusionLocked(false));

                loadStatistics();
                loadIncomeLeakage();
                loadConclusion();

                if (isReadOnly) {
                    setStatisticsLocked(true);
                    setIncomeLeakageLocked(true);
                    setConclusionLocked(true);
                }
            });
        })();

        function findParaContainer(paraId) {
            return document.querySelector(`table[data-para-id='${paraId}']`);
        }

        function collectParaFields(container) {
            const fields = {};
            const missing = [];
            container.querySelectorAll('[data-field]').forEach((element) => {
                const fieldName = element.dataset.field;
                const label = element.dataset.label || fieldName;
                const value = element.dataset.value ?? element.value ?? element.textContent ?? '';
                fields[fieldName] = value;
                if (!value.trim()) {
                    missing.push(label);
                }
            });

            return { fields, missing };
        }

        async function submitParaAction(paraId, action) {
            const container = findParaContainer(paraId);
            if (!container) {
                alert('Unable to locate para details.');
                return;
            }

            const { fields, missing } = collectParaFields(container);
            if (action === 'FINALIZE' && missing.length > 0) {
                alert(`${missing[0]} is required.`);
                return;
            }

            const payload = new FormData();
            payload.append('ParaId', paraId);
            payload.append('Implications', fields.Implications || '');
            payload.append('Recommendations', fields.Recommendations || '');
            payload.append('ManagementComments', fields.ManagementComments || '');
            payload.append('AuditorFurtherComments', fields.AuditorFurtherComments || '');
            payload.append('SvpRemarks', fields.SvpRemarks || '');
            payload.append('Action', action);

            try {
                const response = await fetch('@Url.Action("SaveNarrativePara")', {
                    method: 'POST',
                    body: payload
                });
                const result = await response.json();
                if (!response.ok || !result.Status) {
                    alert(result.Message || 'Unable to save para.');
                    return;
                }
                alert(result.Message || 'Para updated successfully.');
                window.location.reload();
            } catch (error) {
                alert('Unable to save para. Please try again.');
            }
        }
    </script>
}
