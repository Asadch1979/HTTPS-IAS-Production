@model AIS.Models.FieldAuditReport.FieldAuditInputSectionViewModel
@using System
@using System.Linq

@{
    ViewData["Title"] = "NPL Snapshot";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    ViewData["IsReadOnly"] = Model?.IsReadOnly ?? false;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">NPL Snapshot</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ReportActionsNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to work with NPL snapshot data.</div>
    }

    @if (TempData["FieldAuditReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["FieldAuditReportMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">This report is FINAL and cannot be edited.</div>
    }

    @if (hasEngagement)
    {
        <form method="post" asp-action="SaveFieldAuditInputs">
            <input type="hidden" name="EngagementId" value="@Model.EngagementId" />
            <input type="hidden" name="EntityId" value="@Model.EntityId" />
            <input type="hidden" name="SectionCode" value="@Model.SectionCode" />
            <input type="hidden" name="returnAction" value="NplSnapshot" />

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle" id="npl-preview-table"></table>
            </div>

            <div class="card mb-4">
                <div class="card-header">Saved Data (Read-only)</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="npl-snapshot-saved-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Period End</th>
                                    <th class="num-right">Cases</th>
                                    <th class="num-right">Outstanding</th>
                                    <th class="num-right">Provision</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>NPL Snapshot (Entry)</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="add-npl-snapshot-row" @(Model.IsReadOnly ? "disabled" : string.Empty)>
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="npl-snapshot-entry-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Period End</th>
                                    <th class="num-right">Case Count</th>
                                    <th class="num-right">Outstanding Amount</th>
                                    <th class="num-right">Provision Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary" id="save-npl-snapshot" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save NPL Snapshot</button>
                        <span class="text-muted" id="npl-snapshot-status"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("KpiSnapshot")">Back</a>
                <button type="submit" class="btn btn-primary" name="submitAction" value="save" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Draft</button>
                <button type="submit" class="btn btn-outline-success" name="submitAction" value="complete" @(Model.IsReadOnly ? "disabled" : string.Empty)>Mark Section Complete</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("FinalizeReport")">Next Section</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        const nplCategoryOptions = [];
        const nplCategoryLookup = new Map();
        const previewTable = document.getElementById('npl-preview-table');
        let savedRows = [];
        let isEditing = false;
        const operationDates = [
            '@(Model.Overview?.OPERATION_STARTDATE?.ToString("yyyy-MM-dd") ?? string.Empty)',
            '@(Model.Overview?.OPERATION_ENDDATE?.ToString("yyyy-MM-dd") ?? string.Empty)'
        ].filter(value => value);

        const populateCategorySelect = (select, selectedValue = '') => {
            select.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select category';
            select.appendChild(placeholder);

            nplCategoryOptions.forEach(option => {
                const opt = document.createElement('option');
                opt.value = option.code;
                opt.textContent = option.label;
                if (option.code === selectedValue) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
        };

        const createCategorySelect = (selectedValue = '') => {
            const select = document.createElement('select');
            select.className = 'form-select';
            select.dataset.nplCategorySelect = 'true';
            populateCategorySelect(select, selectedValue);
            return select;
        };

        const formatDate = (value) => {
            if (!value) {
                return '';
            }
            const normalized = `${value}`;
            return normalized.length >= 10 ? normalized.slice(0, 10) : normalized;
        };

        const formatValue = (value) => {
            if (value === null || value === undefined || value === '') {
                return '-';
            }
            return value;
        };

        const normalizeText = (value) => (value ?? '').toString().trim().toLowerCase();

        const renderPreviewTable = (rows = []) => {
            if (!previewTable) {
                return;
            }

            previewTable.innerHTML = '';
            if (!rows.length) {
                previewTable.innerHTML = '<tbody><tr><td class="text-muted">No saved NPL snapshot data.</td></tr></tbody>';
                return;
            }

            const periodMap = new Map();
            rows.forEach(row => {
                const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                const formatted = formatDate(periodEnd) || '';
                if (!formatted) {
                    return;
                }
                if (!periodMap.has(formatted)) {
                    periodMap.set(formatted, formatted);
                }
            });

            const periods = Array.from(periodMap.values()).sort((a, b) => a.localeCompare(b));

            const categoryOrder = ['oaem', 'substandard', 'doubtful', 'loss'];
            const categoryMap = new Map();
            rows.forEach(row => {
                const category = row.category ?? row.Category ?? '';
                const label = nplCategoryLookup.get(category) ?? category;
                const normalized = normalizeText(label);
                const periodEnd = formatDate(row.periodEnd ?? row.PeriodEnd ?? '') || '';
                if (!label || !periodEnd) {
                    return;
                }
                if (!categoryMap.has(normalized)) {
                    categoryMap.set(normalized, { label, periods: new Map() });
                }
                categoryMap.get(normalized).periods.set(periodEnd, {
                    caseCount: row.caseCount ?? row.CaseCount ?? null,
                    outstandingAmount: row.outstandingAmount ?? row.OutstandingAmount ?? null,
                    provisionAmount: row.provisionAmount ?? row.ProvisionAmount ?? null
                });
            });

            const orderedCategories = Array.from(categoryMap.entries()).sort((a, b) => {
                const indexA = categoryOrder.indexOf(a[0]);
                const indexB = categoryOrder.indexOf(b[0]);
                if (indexA === -1 && indexB === -1) {
                    return a[1].label.localeCompare(b[1].label);
                }
                if (indexA === -1) {
                    return 1;
                }
                if (indexB === -1) {
                    return -1;
                }
                return indexA - indexB;
            });

            const thead = document.createElement('thead');
            const headerRow = document.createElement('tr');
            const subHeaderRow = document.createElement('tr');
            const categoryHeader = document.createElement('th');
            categoryHeader.rowSpan = 2;
            categoryHeader.textContent = 'NPL Portfolio';
            headerRow.appendChild(categoryHeader);

            periods.forEach(period => {
                const th = document.createElement('th');
                th.colSpan = 3;
                th.textContent = period;
                headerRow.appendChild(th);
                ['Cases', 'Outstanding', 'Provision'].forEach(label => {
                    const sub = document.createElement('th');
                    sub.textContent = label;
                    sub.classList.add('num-right');
                    subHeaderRow.appendChild(sub);
                });
            });

            thead.appendChild(headerRow);
            thead.appendChild(subHeaderRow);
            previewTable.appendChild(thead);

            const tbody = document.createElement('tbody');
            orderedCategories.forEach(([, data]) => {
                const row = document.createElement('tr');
                const labelCell = document.createElement('td');
                labelCell.textContent = data.label;
                row.appendChild(labelCell);

                periods.forEach(period => {
                    const entry = data.periods.get(period);
                    const casesCell = document.createElement('td');
                    const outstandingCell = document.createElement('td');
                    const provisionCell = document.createElement('td');
                    casesCell.classList.add('num-right');
                    outstandingCell.classList.add('num-right');
                    provisionCell.classList.add('num-right');
                    casesCell.textContent = formatValue(entry?.caseCount);
                    outstandingCell.textContent = formatValue(entry?.outstandingAmount);
                    provisionCell.textContent = formatValue(entry?.provisionAmount);
                    row.appendChild(casesCell);
                    row.appendChild(outstandingCell);
                    row.appendChild(provisionCell);
                });

                tbody.appendChild(row);
            });

            previewTable.appendChild(tbody);
        };

        const loadNplRows = () => {
            const engId = @Model.EngagementId;
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            const savedTableBody = document.querySelector('#npl-snapshot-saved-table tbody');
            const statusEl = document.getElementById('npl-snapshot-status');
            if (!entryTableBody || !savedTableBody || !engId) {
                return;
            }

            statusEl.textContent = 'Loading...';
                fetch(`/FieldAuditReport/GetNplSnapshotRows?engId=${engId}`)
                    .then(response => response.json())
                    .then(data => {
                        const rows = data?.rows ?? [];
                        renderSavedRows(rows);
                        renderPreviewTable(rows);
                        entryTableBody.innerHTML = '';
                        addNplRow();
                        statusEl.textContent = '';
                })
                .catch(() => {
                    statusEl.textContent = 'Unable to load NPL snapshot rows.';
                });
        };

        const renderSavedRows = (rows = []) => {
            const savedTableBody = document.querySelector('#npl-snapshot-saved-table tbody');
            if (!savedTableBody) {
                return;
            }
            savedRows = rows;
            savedTableBody.innerHTML = '';
            if (!rows.length) {
                const emptyRow = document.createElement('tr');
                emptyRow.innerHTML = '<td colspan="6" class="text-muted">No saved data.</td>';
                savedTableBody.appendChild(emptyRow);
                return;
            }

            rows.forEach((row, index) => {
                const category = row.category ?? row.Category ?? '';
                const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                const caseCount = row.caseCount ?? row.CaseCount ?? '';
                const outstandingAmount = row.outstandingAmount ?? row.OutstandingAmount ?? '';
                const provisionAmount = row.provisionAmount ?? row.ProvisionAmount ?? '';
                const categoryLabel = nplCategoryLookup.get(category) ?? category;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${categoryLabel || '-'}</td>
                    <td>${formatDate(periodEnd) || '-'}</td>
                    <td class="num-right">${caseCount ?? ''}</td>
                    <td class="num-right">${outstandingAmount ?? ''}</td>
                    <td class="num-right">${provisionAmount ?? ''}</td>
                    <td><button type="button" class="btn btn-sm btn-outline-secondary npl-edit" data-index="${index}">Update</button></td>
                `;
                savedTableBody.appendChild(tr);
            });

            savedTableBody.querySelectorAll('.npl-edit').forEach(button => {
                button.addEventListener('click', (event) => {
                    const index = Number(event.currentTarget.dataset.index);
                    const row = savedRows[index];
                    if (!row) {
                        return;
                    }
                    const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
                    if (!entryTableBody) {
                        return;
                    }
                    entryTableBody.innerHTML = '';
                    addNplRow(row);
                    isEditing = true;
                    const saveButton = document.getElementById('save-npl-snapshot');
                    const addButton = document.getElementById('add-npl-snapshot-row');
                    saveButton.textContent = 'Update NPL Snapshot';
                    addButton?.setAttribute('disabled', 'disabled');
                });
            });
        };

        const addNplRow = (row = {}) => {
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            if (!entryTableBody) {
                return;
            }
            const category = row.category ?? row.Category ?? '';
            const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
            const caseCount = row.caseCount ?? row.CaseCount ?? '';
            const outstandingAmount = row.outstandingAmount ?? row.OutstandingAmount ?? '';
            const provisionAmount = row.provisionAmount ?? row.ProvisionAmount ?? '';

            const tr = document.createElement('tr');
            const categoryCell = document.createElement('td');
            const categorySelect = createCategorySelect(category);
            categoryCell.appendChild(categorySelect);
            tr.appendChild(categoryCell);

            const periodCell = document.createElement('td');
            const periodSelect = document.createElement('select');
            periodSelect.className = 'form-select';
            periodSelect.dataset.periodSelect = 'true';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select date';
            periodSelect.appendChild(placeholder);
            operationDates.forEach(date => {
                const option = document.createElement('option');
                option.value = date;
                option.textContent = date;
                if (formatDate(periodEnd) === date) {
                    option.selected = true;
                }
                periodSelect.appendChild(option);
            });
            periodCell.appendChild(periodSelect);
            tr.appendChild(periodCell);

            const casesCell = document.createElement('td');
            const casesInput = document.createElement('input');
            casesInput.className = 'form-control num-right';
            casesInput.type = 'number';
            casesInput.dataset.field = 'caseCount';
            casesInput.value = caseCount;
            casesCell.appendChild(casesInput);
            tr.appendChild(casesCell);

            const outstandingCell = document.createElement('td');
            const outstandingInput = document.createElement('input');
            outstandingInput.className = 'form-control num-right';
            outstandingInput.type = 'number';
            outstandingInput.step = 'any';
            outstandingInput.dataset.field = 'outstandingAmount';
            outstandingInput.value = outstandingAmount;
            outstandingCell.appendChild(outstandingInput);
            tr.appendChild(outstandingCell);

            const provisionCell = document.createElement('td');
            const provisionInput = document.createElement('input');
            provisionInput.className = 'form-control num-right';
            provisionInput.type = 'number';
            provisionInput.step = 'any';
            provisionInput.dataset.field = 'provisionAmount';
            provisionInput.value = provisionAmount;
            provisionCell.appendChild(provisionInput);
            tr.appendChild(provisionCell);

            entryTableBody.appendChild(tr);
        };

        const collectNplRows = () => {
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            if (!entryTableBody) {
                return [];
            }

            return Array.from(entryTableBody.querySelectorAll('tr')).map(row => {
                const categorySelect = row.querySelector('select');
                const category = categorySelect?.value?.trim() ?? '';
                const periodEnd = row.querySelector('[data-period-select="true"]')?.value;
                const caseCount = row.querySelector('[data-field="caseCount"]')?.value;
                const outstandingAmount = row.querySelector('[data-field="outstandingAmount"]')?.value;
                const provisionAmount = row.querySelector('[data-field="provisionAmount"]')?.value;
                return {
                    category,
                    periodEnd: periodEnd === '' ? null : periodEnd,
                    caseCount: caseCount === '' ? null : Number(caseCount),
                    outstandingAmount: outstandingAmount === '' ? null : Number(outstandingAmount),
                    provisionAmount: provisionAmount === '' ? null : Number(provisionAmount)
                };
            });
        };

        const saveNplRows = () => {
            const engId = @Model.EngagementId;
            const statusEl = document.getElementById('npl-snapshot-status');
            const saveButton = document.getElementById('save-npl-snapshot');
            if (!engId || saveButton?.disabled) {
                return;
            }

            statusEl.textContent = 'Saving...';
            fetch(`/FieldAuditReport/SaveNplSnapshotRows?engId=${engId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(collectNplRows())
            })
                .then(response => response.json())
                .then(data => {
                    if (!data?.success) {
                        statusEl.textContent = data?.message ?? 'Unable to save NPL snapshot rows.';
                        return;
                    }
                    statusEl.textContent = data.message ?? 'Saved.';
                    const rows = data?.rows ?? [];
                    renderSavedRows(rows);
                    renderPreviewTable(rows);
                    if (isEditing) {
                        isEditing = false;
                        saveButton.textContent = 'Save NPL Snapshot';
                        document.getElementById('add-npl-snapshot-row')?.removeAttribute('disabled');
                    }
                    const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
                    if (entryTableBody) {
                        entryTableBody.innerHTML = '';
                        addNplRow();
                    }
                })
                .catch(() => {
                    statusEl.textContent = 'Unable to save NPL snapshot rows.';
                });
        };

        document.getElementById('add-npl-snapshot-row')?.addEventListener('click', () => addNplRow());
        document.getElementById('save-npl-snapshot')?.addEventListener('click', saveNplRows);
        const engId = @Model.EngagementId;
        fetch(`/FieldAuditReport/GetNplCategoryOptions?engId=${engId}`)
            .then(response => response.json())
            .then(data => {
                nplCategoryOptions.length = 0;
                nplCategoryLookup.clear();
                (data?.items ?? []).forEach(option => {
                    if (!option) {
                        return;
                    }
                    const code = option.code ?? option.Code ?? '';
                    const label = option.label ?? option.Label ?? code;
                    nplCategoryOptions.push({ code, label });
                    if (code) {
                        nplCategoryLookup.set(code, label);
                    }
                });
                loadNplRows();
            })
            .catch(() => {
                document.getElementById('npl-snapshot-status').textContent = 'Unable to load NPL categories.';
                loadNplRows();
            });
    </script>
}
