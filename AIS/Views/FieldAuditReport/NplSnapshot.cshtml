@model AIS.Models.FieldAuditReport.FieldAuditInputSectionViewModel
@using System

@{
    ViewData["Title"] = "NPL Snapshot";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">NPL Snapshot</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to work with NPL snapshot data.</div>
    }

    @if (TempData["FieldAuditReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["FieldAuditReportMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">This report is FINAL and cannot be edited.</div>
    }
    else if (Model.IsSectionComplete)
    {
        <div class="alert alert-info">This section is marked complete. Entry grids are read-only.</div>
    }

    @if (hasEngagement)
    {
        var isEntryLocked = Model.IsReadOnly || Model.IsSectionComplete;

        <form method="post" asp-action="SaveFieldAuditInputs">
            <input type="hidden" name="EngagementId" value="@Model.EngagementId" />
            <input type="hidden" name="EntityId" value="@Model.EntityId" />
            <input type="hidden" name="SectionCode" value="@Model.SectionCode" />
            <input type="hidden" name="returnAction" value="NplSnapshot" />

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle" id="npl-preview-table">
                    <thead></thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="card mb-4">
                <div class="card-header">Saved Data (Read-only)</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="npl-snapshot-saved-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Period End</th>
                                    <th>Cases</th>
                                    <th>Outstanding</th>
                                    <th>Provision</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>NPL Snapshot (Entry)</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="add-npl-snapshot-row" @(isEntryLocked ? "disabled" : string.Empty)>
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="npl-snapshot-entry-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Period End</th>
                                    <th>Case Count</th>
                                    <th>Outstanding Amount</th>
                                    <th>Provision Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary" id="save-npl-snapshot" @(isEntryLocked ? "disabled" : string.Empty)>Save NPL Snapshot</button>
                        <span class="text-muted" id="npl-snapshot-status"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("KpiSnapshot")">Back</a>
                <button type="submit" class="btn btn-primary" name="submitAction" value="save" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Draft</button>
                <button type="submit" class="btn btn-outline-success" name="submitAction" value="complete" @(Model.IsReadOnly ? "disabled" : string.Empty)>Mark Section Complete</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("FinalizeReport")">Next Section</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        const nplCategoryOptions = [];
        const nplCategoryLookup = new Map();

        const populateCategorySelect = (select, selectedValue = '') => {
            select.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select category';
            select.appendChild(placeholder);

            nplCategoryOptions.forEach(option => {
                const opt = document.createElement('option');
                opt.value = option.code;
                opt.textContent = option.label;
                if (option.code === selectedValue) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
        };

        const createCategorySelect = (selectedValue = '') => {
            const select = document.createElement('select');
            select.className = 'form-select';
            select.dataset.nplCategorySelect = 'true';
            populateCategorySelect(select, selectedValue);
            return select;
        };

        const formatDate = (value) => {
            if (!value) {
                return '';
            }
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return '';
            }
            return date.toISOString().slice(0, 10);
        };

        const loadNplRows = () => {
            const engId = @Model.EngagementId;
            const isEntryLocked = @((Model.IsReadOnly || Model.IsSectionComplete).ToString().ToLower());
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            const savedTableBody = document.querySelector('#npl-snapshot-saved-table tbody');
            const previewTable = document.getElementById('npl-preview-table');
            const previewHead = previewTable?.querySelector('thead');
            const previewBody = previewTable?.querySelector('tbody');
            const statusEl = document.getElementById('npl-snapshot-status');
            if (!entryTableBody || !savedTableBody || !previewHead || !previewBody || !engId) {
                return;
            }

            statusEl.textContent = 'Loading...';
            fetch(`/FieldAuditReport/GetNplSnapshotRows?engId=${engId}`)
                .then(response => response.json())
                .then(data => {
                    renderSavedRows(data?.rows ?? []);
                    renderPreviewRows(data?.rows ?? [], previewHead, previewBody);
                    entryTableBody.innerHTML = '';
                    addNplRow({}, isEntryLocked);
                    statusEl.textContent = '';
                })
                .catch(() => {
                    statusEl.textContent = 'Unable to load NPL snapshot rows.';
                });
        };

        const renderSavedRows = (rows = []) => {
            const savedTableBody = document.querySelector('#npl-snapshot-saved-table tbody');
            if (!savedTableBody) {
                return;
            }
            savedTableBody.innerHTML = '';
            if (!rows.length) {
                const emptyRow = document.createElement('tr');
                emptyRow.innerHTML = '<td colspan="5" class="text-muted">No saved data.</td>';
                savedTableBody.appendChild(emptyRow);
                return;
            }

            rows.forEach(row => {
                const category = row.category ?? row.Category ?? '';
                const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
                const caseCount = row.caseCount ?? row.CaseCount ?? '';
                const outstandingAmount = row.outstandingAmount ?? row.OutstandingAmount ?? '';
                const provisionAmount = row.provisionAmount ?? row.ProvisionAmount ?? '';
                const categoryLabel = nplCategoryLookup.get(category) ?? category;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${categoryLabel || '-'}</td>
                    <td>${formatDate(periodEnd) || '-'}</td>
                    <td>${caseCount === null || caseCount === undefined || caseCount === '' ? '-' : caseCount}</td>
                    <td>${outstandingAmount === null || outstandingAmount === undefined || outstandingAmount === '' ? '-' : outstandingAmount}</td>
                    <td>${provisionAmount === null || provisionAmount === undefined || provisionAmount === '' ? '-' : provisionAmount}</td>
                `;
                savedTableBody.appendChild(tr);
            });
        };

        const renderPreviewRows = (rows = [], previewHead, previewBody) => {
            if (!previewHead || !previewBody) {
                return;
            }
            previewHead.innerHTML = '';
            previewBody.innerHTML = '';

            if (!rows.length) {
                const emptyRow = document.createElement('tr');
                emptyRow.innerHTML = '<td class="text-muted">No NPL snapshot data available.</td>';
                previewBody.appendChild(emptyRow);
                return;
            }

            const periodMap = new Map();
            const categoryMap = new Map();

            rows.forEach(row => {
                const category = row.category ?? row.Category ?? '';
                const categoryLabel = nplCategoryLookup.get(category) ?? category || '-';
                const periodEnd = row.periodEnd ?? row.PeriodEnd ?? null;
                const periodKey = formatDate(periodEnd) || 'UNKNOWN';
                if (!periodMap.has(periodKey)) {
                    const periodDate = periodEnd ? new Date(periodEnd) : null;
                    periodMap.set(periodKey, {
                        key: periodKey,
                        label: periodKey === 'UNKNOWN' ? 'Unknown Period' : formatDate(periodEnd),
                        date: periodDate
                    });
                }
                if (!categoryMap.has(categoryLabel)) {
                    categoryMap.set(categoryLabel, new Map());
                }
                categoryMap.get(categoryLabel).set(periodKey, {
                    cases: row.caseCount ?? row.CaseCount ?? null,
                    outstanding: row.outstandingAmount ?? row.OutstandingAmount ?? null,
                    provision: row.provisionAmount ?? row.ProvisionAmount ?? null
                });
            });

            const periods = Array.from(periodMap.values()).sort((a, b) => {
                if (!a.date && !b.date) {
                    return a.label.localeCompare(b.label);
                }
                if (!a.date) {
                    return 1;
                }
                if (!b.date) {
                    return -1;
                }
                return a.date - b.date;
            });

            const headerRow = document.createElement('tr');
            const subHeaderRow = document.createElement('tr');
            const categoryHeader = document.createElement('th');
            categoryHeader.rowSpan = 2;
            categoryHeader.textContent = 'NPL Portfolio';
            headerRow.appendChild(categoryHeader);

            periods.forEach(period => {
                const th = document.createElement('th');
                th.colSpan = 3;
                th.textContent = period.label;
                headerRow.appendChild(th);
                ['Cases', 'Outstanding Principal (Rs.)', 'Provision Amount (Rs.)'].forEach(label => {
                    const subTh = document.createElement('th');
                    subTh.textContent = label;
                    subHeaderRow.appendChild(subTh);
                });
            });

            previewHead.appendChild(headerRow);
            previewHead.appendChild(subHeaderRow);

            Array.from(categoryMap.keys()).sort().forEach(categoryLabel => {
                const row = document.createElement('tr');
                const labelCell = document.createElement('td');
                labelCell.textContent = categoryLabel || '-';
                row.appendChild(labelCell);

                const periodValues = categoryMap.get(categoryLabel);
                periods.forEach(period => {
                    const values = periodValues?.get(period.key) ?? {};
                    const cases = values.cases === null || values.cases === undefined ? '-' : values.cases;
                    const outstanding = values.outstanding === null || values.outstanding === undefined ? '-' : values.outstanding;
                    const provision = values.provision === null || values.provision === undefined ? '-' : values.provision;
                    [cases, outstanding, provision].forEach(value => {
                        const cell = document.createElement('td');
                        cell.textContent = value;
                        row.appendChild(cell);
                    });
                });

                previewBody.appendChild(row);
            });
        };

        const addNplRow = (row = {}, isEntryLocked = false) => {
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            if (!entryTableBody) {
                return;
            }
            const category = row.category ?? row.Category ?? '';
            const periodEnd = row.periodEnd ?? row.PeriodEnd ?? '';
            const caseCount = row.caseCount ?? row.CaseCount ?? '';
            const outstandingAmount = row.outstandingAmount ?? row.OutstandingAmount ?? '';
            const provisionAmount = row.provisionAmount ?? row.ProvisionAmount ?? '';

            const tr = document.createElement('tr');
            const categoryCell = document.createElement('td');
            const categorySelect = createCategorySelect(category);
            if (isEntryLocked) {
                categorySelect.disabled = true;
            }
            categoryCell.appendChild(categorySelect);
            tr.appendChild(categoryCell);

            const periodCell = document.createElement('td');
            const periodInput = document.createElement('input');
            periodInput.className = 'form-control';
            periodInput.type = 'date';
            if (isEntryLocked) {
                periodInput.disabled = true;
            }
            periodInput.value = formatDate(periodEnd);
            periodCell.appendChild(periodInput);
            tr.appendChild(periodCell);

            const casesCell = document.createElement('td');
            const casesInput = document.createElement('input');
            casesInput.className = 'form-control';
            casesInput.type = 'number';
            if (isEntryLocked) {
                casesInput.disabled = true;
            }
            casesInput.value = caseCount;
            casesCell.appendChild(casesInput);
            tr.appendChild(casesCell);

            const outstandingCell = document.createElement('td');
            const outstandingInput = document.createElement('input');
            outstandingInput.className = 'form-control';
            outstandingInput.type = 'number';
            outstandingInput.step = 'any';
            if (isEntryLocked) {
                outstandingInput.disabled = true;
            }
            outstandingInput.value = outstandingAmount;
            outstandingCell.appendChild(outstandingInput);
            tr.appendChild(outstandingCell);

            const provisionCell = document.createElement('td');
            const provisionInput = document.createElement('input');
            provisionInput.className = 'form-control';
            provisionInput.type = 'number';
            provisionInput.step = 'any';
            if (isEntryLocked) {
                provisionInput.disabled = true;
            }
            provisionInput.value = provisionAmount;
            provisionCell.appendChild(provisionInput);
            tr.appendChild(provisionCell);

            entryTableBody.appendChild(tr);
        };

        const collectNplRows = () => {
            const entryTableBody = document.querySelector('#npl-snapshot-entry-table tbody');
            if (!entryTableBody) {
                return [];
            }

            return Array.from(entryTableBody.querySelectorAll('tr')).map(row => {
                const categorySelect = row.querySelector('select');
                const cells = row.querySelectorAll('input');
                const category = categorySelect?.value?.trim() ?? '';
                const periodEnd = cells[0]?.value;
                const caseCount = cells[1]?.value;
                const outstandingAmount = cells[2]?.value;
                const provisionAmount = cells[3]?.value;
                return {
                    category,
                    periodEnd: periodEnd === '' ? null : periodEnd,
                    caseCount: caseCount === '' ? null : Number(caseCount),
                    outstandingAmount: outstandingAmount === '' ? null : Number(outstandingAmount),
                    provisionAmount: provisionAmount === '' ? null : Number(provisionAmount)
                };
            });
        };

        const saveNplRows = () => {
            const engId = @Model.EngagementId;
            const statusEl = document.getElementById('npl-snapshot-status');
            const saveButton = document.getElementById('save-npl-snapshot');
            if (!engId || saveButton?.disabled) {
                return;
            }

            statusEl.textContent = 'Saving...';
            fetch(`/FieldAuditReport/SaveNplSnapshotRows?engId=${engId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(collectNplRows())
            })
                .then(response => response.json())
                .then(data => {
                    if (!data?.success) {
                        statusEl.textContent = data?.message ?? 'Unable to save NPL snapshot rows.';
                        return;
                    }
                    statusEl.textContent = data.message ?? 'Saved.';
                    renderSavedRows(data?.rows ?? []);
                    const previewTable = document.getElementById('npl-preview-table');
                    renderPreviewRows(data?.rows ?? [], previewTable?.querySelector('thead'), previewTable?.querySelector('tbody'));
                })
                .catch(() => {
                    statusEl.textContent = 'Unable to save NPL snapshot rows.';
                });
        };

        document.getElementById('add-npl-snapshot-row')?.addEventListener('click', () => {
            const isEntryLocked = @((Model.IsReadOnly || Model.IsSectionComplete).ToString().ToLower());
            if (isEntryLocked) {
                return;
            }
            addNplRow({}, isEntryLocked);
        });
        document.getElementById('save-npl-snapshot')?.addEventListener('click', saveNplRows);
        const engId = @Model.EngagementId;
        fetch(`/FieldAuditReport/GetNplCategoryOptions?engId=${engId}`)
            .then(response => response.json())
            .then(data => {
                nplCategoryOptions.length = 0;
                nplCategoryLookup.clear();
                (data?.items ?? []).forEach(option => {
                    if (!option) {
                        return;
                    }
                    const code = option.code ?? option.Code ?? '';
                    const label = option.label ?? option.Label ?? code;
                    nplCategoryOptions.push({ code, label });
                    if (code) {
                        nplCategoryLookup.set(code, label);
                    }
                });
                loadNplRows();
            })
            .catch(() => {
                document.getElementById('npl-snapshot-status').textContent = 'Unable to load NPL categories.';
                loadNplRows();
            });
    </script>
}
