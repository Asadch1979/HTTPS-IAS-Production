@model IEnumerable<AIS.Models.FrptEngagementListRow>

@{
    ViewData["Title"] = "FRPT PDF Engagements";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-3">FRPT PDF Engagements</h2>
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Reporting Office</th>
                        <th>Entity Name</th>
                        <th>Audit Start</th>
                        <th>Audit End</th>
                        <th>Status</th>
                        <th style="width:140px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.ReportingOffice</td>
                                <td>@row.EntityName</td>
                                <td>@(row.AuditStartDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>@(row.AuditEndDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>@(row.ReportStatus == "FINAL" ? "Finalized" : "In progress")</td>
                                <td>
                                    <a class="btn btn-sm btn-primary" title="Generate Report"
                                       href="/FieldAuditReport/GeneratePdf?engId=@row.EngId">
                                        Generate Report
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
