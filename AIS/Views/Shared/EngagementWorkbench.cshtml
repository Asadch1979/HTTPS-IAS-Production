@model System.Collections.Generic.List<AIS.Models.HeadAuditEngagement>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Head Audit Department | Audit Teams Monitoring";
    string Value(string value) => string.IsNullOrWhiteSpace(value) ? "N/A" : value;
}
<link rel="stylesheet" href="~/css/engagement-workbench.css" asp-append-version="true" />
<section class="engagement-workbench wb-redesigned" aria-labelledby="workbench-title">
    <div class="wb-appbar">
        <div class="wb-brand"><span class="wb-brand-icon" aria-hidden="true">IAS</span>
            <span><strong>ZTBL · Internal Audit</strong><small>TeamMate-inspired Engagement Workspace</small></span></div>
        <span class="wb-appbar-meta">HEAD AUDIT DEPARTMENT · READ-ONLY</span>
    </div>
    <header class="wb-hero">
        <div class="dashboard-title"><span class="wb-eyebrow">HEAD AUDIT DEPARTMENT</span>
            <h1 id="workbench-title">Audit Teams Monitoring</h1>
            <p>@ViewData["ScopeLabel"]</p></div>
        <div class="wb-hero-meta"><strong>@Model.Count.ToString("N0")</strong><span>Ongoing engagements</span>
            <a class="wb-step-link" href="@Url.Action("AuditTeamsMonitoring")">Refresh saved information</a></div>
    </header>
    <div class="wb-kpis" aria-label="Department audit overview">
        <article class="wb-stat wb-stat-blue"><span>Teams conducting audits</span>
            <strong>@Model.Where(e => e.TeamId.HasValue).Select(e => e.TeamId).Distinct().Count().ToString("N0")</strong>
            <small>Distinct assigned IAS team IDs</small></article>
        <article class="wb-stat wb-stat-violet"><span>Active audit engagements</span><strong>@Model.Count.ToString("N0")</strong>
            <small>Authorized ongoing IAS engagements</small></article>
        <article class="wb-stat wb-stat-amber"><span>Approaching completion date</span>
            <strong>@Model.Count(e => e.DaysToEnd >= 0 && e.DaysToEnd < 7).ToString("N0")</strong>
            <small>Scheduled audit end within the next 7 days</small></article>
        <article class="wb-stat wb-stat-teal"><span>Observations awaiting review</span>
            <strong>@Model.Sum(e => e.AwaitingReview).ToString("N0")</strong>
            <small>IAS status 3 · V2 workpapers in review: @(Model.Count > 0 && Model.All(e => e.WorkpapersAwaitingReview.HasValue) ? Model.Sum(e => e.WorkpapersAwaitingReview.Value).ToString("N0") : "N/A")</small></article>
    </div>
    <section class="wb-process" aria-labelledby="stages-title">
        <div class="wb-section-heading"><div><span class="wb-eyebrow">LIVE IAS WORKFLOW</span>
            <h2 id="stages-title">Engagement stages</h2></div></div>
        <div class="wb-stage-ribbon">
            @foreach (var stage in Model.GroupBy(e => new { e.StatusId, e.Status }).OrderBy(g => g.Key.StatusId))
            {
                <span class="wb-ribbon-step"><b>@stage.Count()</b>@Value(stage.Key.Status) <small>IAS @stage.Key.StatusId</small></span>
            }
        </div>
    </section>
    <section class="wb-overview" aria-labelledby="register-title">
        <div class="wb-section-heading"><div><span class="wb-eyebrow">AUTHORIZED DEPARTMENT PORTFOLIO</span>
            <h2 id="register-title">Ongoing engagement register</h2></div></div>
        <div class="wb-panel wb-register"><div class="wb-table" role="region" aria-label="Ongoing engagements" tabindex="0">
            <table><thead><tr><th>Audit entity / team</th><th>Audit period / dates</th><th>Current stage / progress</th><th>Observations / reporting</th><th>Review</th></tr></thead>
                <tbody>@foreach (var e in Model)
                {
                    <tr><td><strong>@Value(e.Entity)</strong><small>@Value(e.Department) · Engagement #@e.EngagementId</small>
                        <small>@Value(e.Team) · Team ID @(e.TeamId?.ToString() ?? "N/A")</small><small>@Value(e.Members)</small></td>
                        <td>@Value(e.Period)<small>@(e.Start?.ToString("dd MMM yyyy") ?? "N/A") – @(e.End?.ToString("dd MMM yyyy") ?? "N/A")</small></td>
                        <td><span class="wb-state-badge">@Value(e.Status) · @e.StatusId</span><small>@Value(e.TaskProgress)</small>
                            <small>@Value(e.WorkpaperProgress)</small></td>
                        <td>@Value(e.ObservationCounts)<small>Saved reports: @e.Reports · @Value(e.ReportStatus)</small></td>
                        <td><a class="wb-table-action" href="@Url.Action("Review", new { engId = e.EngagementId })">Open Engagement / Review Work →</a></td></tr>
                }</tbody>
            </table>
            @if (Model.Count == 0) { <p class="wb-lane-empty">No ongoing engagements in your authorized department.</p> }
        </div></div>
    </section>
</section>

<partial name="_DashboardExportAssets" />
