@model AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var useFieldAuditReportQuerySelection = string.Equals(currentController, "FieldAuditReport", StringComparison.OrdinalIgnoreCase);
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-2">
                <label class="form-label mb-0"><strong>Engagement:</strong></label>
            </div>
            <div class="col-md-7">
                @if (Model?.HasActiveEngagement ?? false)
                {
                    <input class="form-control" value="@Model.ActiveEngagementLabel" disabled />
                }
                else
                {
                    @if (useFieldAuditReportQuerySelection)
                    {
                        <form method="get" action="@Context.Request.Path" id="frptEngagementForm">
                            @foreach (var queryItem in Context.Request.Query)
                            {
                                if (!string.Equals(queryItem.Key, "engId", StringComparison.OrdinalIgnoreCase))
                                {
                                    foreach (var value in queryItem.Value)
                                    {
                                        <input type="hidden" name="@queryItem.Key" value="@value" />
                                    }
                                }
                            }
                            <select name="engId" class="form-select" data-onchange="return validateEngagementSelection(this);">
                                <option value="0">--Select Engagement--</option>
                                @if (Model?.Options != null)
                                {
                                    foreach (var option in Model.Options)
                                    {
                                        <option value="@option.EngagementId">@option.EngagementId | @option.EntityName | @option.AuditPeriod</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="SetActiveEngagement" id="frptEngagementForm">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <select name="engagementId" class="form-select" data-onchange="return validateEngagementSelection(this);">
                                <option value="0">--Select Engagement--</option>
                                @if (Model?.Options != null)
                                {
                                    foreach (var option in Model.Options)
                                    {
                                        <option value="@option.EngagementId">@option.EngagementId | @option.EntityName | @option.AuditPeriod</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                }
            </div>
            <div class="col-md-3 text-md-end">
                @if (Model?.HasActiveEngagement ?? false)
                {
                    <form method="post" asp-action="ClearEngagement" class="d-inline">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-outline-danger"
                                data-onclick="return confirm('Changing the engagement will clear the current Field Audit Report context. Do you want to continue?');">
                            Change Engagement
                        </button>
                    </form>
                }
            </div>
        </div>
        @if (Model?.HasActiveEngagement == true && Model.HasExistingData)
        {
            <small class="text-muted d-block mt-2">Engagement selection is locked because report data already exists.</small>
        }
    </div>
</div>


<script src="~/js/csp/Views_Shared__GetEngagementSelector.js?v=1"></script>
