@{
    ViewData["Title"] = "Entities Audit/Compliance Office Management";
    Layout = "_Layout";

}



<div class="row col-md-12 mt-3">
    <h3 style=" display:block;color: #be0e43">Entites Audit/Compliance Office Management</h3>
</div>
<div class="row col-md-12 mt-1">
    <div class="col-md-2">
        <h5>Relationship Type</h5>
    </div>
    <div class="col-md-4">
        <select id="RelationshipField" onchange="getrelation();" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Relationship Type--</option>
            @{
                if (ViewData["Userrelationship"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["Userrelationship"]))
                    {
                            <option value="@item.ENTITY_REALTION_ID" id="@item.ENTITY_REALTION_ID">@item.FIELD_NAME</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <h5>Controlling/Reporting Office</h5>
    </div>
    <div class="col-md-4">
        <select id="controlingsearch" onchange="getplacepost();" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Controlling/Reporting Office--</option>
        </select>
    </div>
</div>
<div class="row col-md-12 mt-3">
    <table id="childposting" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important;">
            <tr>
                <th>Sr. No</th>
                <th>Entity Name</th>
                <th>COMPLICE UNIT</th>
                <th>AUDIT ZONE</th>
                <th class="text-center"> <input id="selectAllMainBox" onclick="selectAllCheckboxes();" type="checkbox" name="selectAll" /> </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>


<div id="complianceUnitArea" class="row col-md-12 mt-3 d-none">
    <div class="col-md-2">
        <h5>Compliance Units</h5>
    </div>
    <div class="col-md-4">
        <select id="ComplianceUnitField" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Compliance Units--</option>
            @{
                if (ViewData["ComplianceUnitsList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["ComplianceUnitsList"]))
                    {
                            <option value="@item.COM_BY" id="@item.COM_BY">@item.NAME</option>
                    }
                }
            }
        </select>
    </div>
</div>


<div id="AZOfficeArea" class="row col-md-12 mt-3 d-none">
    <div class="col-md-2">
        <h5>Audit Cluster</h5>
    </div>
    <div class="col-md-4">
        <select id="AZOfficeField" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Audit Cluster--</option>
            @{
                if (ViewData["AZOfficeList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["AZOfficeList"]))
                    {
                            <option value="@item.ID" id="@item.ID">@item.ZONENAME</option>
                    }
                }
            }
        </select>
    </div>
</div>

<div class="row col-md-12 mr-3">
    <button onclick="updateComplianceOffice();" class="btn btn-danger offset-md-10 col-md-2">Update</button>
</div>

<script src="~/js/csp/Views_AdministrationPanel_entity_gm_reporting_div_management.js?v=1"></script>
