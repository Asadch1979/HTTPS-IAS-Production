@{
    ViewData["Title"] = "Manage Entity Audit Department";
    Layout = "_Layout";

}




<div class="mt-3 mb-4">
    <h3 style="color: #be0e43">Manage Entity Audit Department</h3>
</div>
<div class="row col-md-12">
    <button onclick="addNewEntAuditDept();" class="btn btn-primary offset-md-9 col-md-3">Add New Audit Department</button>
</div>
<div class="mt-3">
    <div class="col-md-12 px-0">
        <input class="form-control alnum-only" id="searchTableRecord" type="text" placeholder="Search.." data-allow-amp="true" data-allow-question="true" data-maxlen="150">
    </div>
</div>

<div class="row col-md-12 mt-3">
    <table id="manageEntityAuditDeptGrid" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important; ">
            <tr>
                <th class="col-md-auto text-center">Sr. No.</th>
                <th class="col-md-auto">ENTITY ID</th>
                <th class="col-md-auto">DEPARTMENT ID</th>
                <th class="col-md-auto">DEPARTMENT CODE</th>
                <th class="col-md-auto">CBASE CODE</th>
                <th class="col-md-auto">DEPARTMENT NAME</th>
                <th class="col-md-auto">AUDIT DEPARTMENT ID</th>
                <th class="col-md-auto">AUDITOR</th>
                <th class="col-md-auto">STATUS</th>
                <th class="col-md-auto"></th>


            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

</div>



<div id="updateManageEntityAuditDepartment" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Add Checklist Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">


                <div class="form-group">
                    <label>Entity Id</label>
                        <input id="modalentityid" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="20" />
                </div>
                <div class="form-group">
                    <label>Department Id</label>
                        <input id="modaldepartmentid" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="20" />
                </div>
                <div class="form-group">
                    <label>Department Code</label>
                        <input id="modaldepartmentCode" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="50" />
                </div>
                    <div class="form-group">
                        <label>CBAS Code</label>
                        <input id="modalcbasecode" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="50" />
                    </div>
               
                <div class="form-group">
                    <label>Department Name</label>
                    <input id="modaldepartmentname" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="150" />
                </div>
              
                <div class="form-group">
                    <label>Audit Department Id</label>
                    <input id="modalauditdepartmentid" type="text" class="form-control alnum-only" data-allow-amp="true" data-allow-question="true" data-maxlen="20" />
                </div>
            
                <div class="form-group">
                    <label>Auditor</label>
                    <select class="form-control" id="modalauditor">
                        <option value="N">N</option>
                        <option value="Y">Y</option>
                    </select>
                    
                </div>
              
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-control" id="modalstatus">
                        <option value="N">N</option>
                        <option value="Y">Y</option>
                    </select>
                   
                </div>

          
          

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button onclick="saveChangesManageEntityAuditDepartment();" type="button" data-bs-dismiss="modal" class="btn btn-success">Save Changes</button>

            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_AdministrationPanel_manage_ent_audit_dept.js?v=1"></script>
