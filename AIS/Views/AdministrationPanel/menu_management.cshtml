
﻿@{
    ViewData["Title"] = "Main Menu Management";
    Layout = ViewData.ContainsKey("Layout") ? ViewData["Layout"] as string : "_Layout";
}


<div class="row mt-3">
    <h2 style="color: #be0e43">Menu Page Management</h2>
</div>

<div class="row col-md-12 mt-3">
    <button data-click="setupNewMenu();" class="btn btn-danger offset-md-10 col-md-2">Add New</button>
</div>


`
<div class="row col-md-12 mt-3">
    <button data-click="getMenuPages();"  class="btn btn-primary offset-md-10 col-md-2">Find</button>
</div>

<div class="row col-md-12 mt-3">
    <table id="listOfMenuPages" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important;">
            <tr>
                <th class="col-md-1">Sr No.</th>
                <th class="col-md-1">Menu Name</th>
                <th class="col-md-1">Menu Description</th>
                <th class="col-md-1">Menu Order</th>
                <th class="col-md-1">Action</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>



<div id="menuDetailModel" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-scrollable modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Menu Page Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>         
                                      
                    <div class="form-group">
                        <label>Menu Name</label>
                        <input class="form-control alnum-only" id="menu_name_field" data-allow-amp="true" data-allow-question="true" data-maxlen="100" />
                    </div>
                    <div class="form-group">
                        <label>Menu Description</label>
                        <input class="form-control" id="menu_desc_field" data-validate="plain-text" />
                    </div>
                      <div class="form-group">
                        <label>Menu Order</label>
                        <input class="form-control alnum-only" id="menu_order_field" data-allow-amp="false" data-allow-question="false" data-maxlen="5" />
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <input class="form-control alnum-only" id="menu_status_field" data-allow-amp="false" data-allow-question="false" data-maxlen="10" />
                    </div>
                    
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" data-click="publishUpdateMenuChanges();" class="btn btn-danger">Save Changes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_AdministrationPanel_menu_management.js?v=1"></script>
