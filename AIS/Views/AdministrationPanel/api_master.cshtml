@{
    ViewData["Title"] = "API Master";
    Layout = ViewData.ContainsKey("Layout") ? ViewData["Layout"] as string : "_Layout";
    var isAdvanced = (ViewData["IsAdvancedUser"] as bool?) ?? false;
    var menuList = ViewData["MenuList"];
}

@if (!isAdvanced)
    {
    <div class="alert alert-warning mb-0">
        Only Super Admins can manage API Master.
    </div>
    }
else
    {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">API Definitions</h5>
        <button class="btn btn-primary js-api-master-add" type="button">Add API</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped" id="apiMasterTable">
            <thead>
                <tr>
                    <th>API Name</th>
                    <th>Path</th>
                    <th>Method</th>
                    <th>Active</th>
                    <th style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="modal fade" id="apiMasterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">API Master</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="apiMasterId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiNameInput">API Name</label>
                            <input class="form-control" id="apiNameInput" type="text" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="controllerNameInput">Controller Name</label>
                            <select class="form-select" id="controllerNameInput">
                                <option value="">-- Select Controller --</option>
                            </select>
                            <div class="invalid-feedback" id="controllerNameValidation">Controller Name is required.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiPathInput">API Path</label>
                            <input class="form-control" id="apiPathInput" type="text" placeholder="/ApiCalls/" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiMethodInput">HTTP Method</label>
                            <select class="form-select" id="apiMethodInput">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="BOTH">BOTH</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiIsActiveInput">Active</label>
                            <select class="form-select" id="apiIsActiveInput">
                                <option value="Y">Enabled</option>
                                <option value="N">Disabled</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiMenuInput">Menu</label>
                            <select class="form-select" id="apiMenuInput">
                                <option value="0">-- Select Menu --</option>
                                @if (menuList != null)
                                {
                                    foreach (var item in (dynamic)menuList)
                                    {
                                        <option value="@item.Menu_Id">@item.Menu_Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiSubMenuInput">Sub Menu</label>
                            <select class="form-select" id="apiSubMenuInput">
                                <option value="0">-- Select Sub Menu --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="apiPageIdInput">Page id</label>
                            <select class="form-select" id="apiPageIdInput">
                                <option value="">-- Select Page --</option>
                            </select>
                            <div class="invalid-feedback" id="apiPageValidation">Page is required.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary js-api-master-save">Save</button>
                </div>
            </div>
        </div>
    </div>

    
    }
<script src="~/js/csp/Views_AdministrationPanel_api_master.js?v=4"></script>
