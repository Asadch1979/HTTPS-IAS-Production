@model AIS.Models.WorkflowDashboard.WorkflowDashboardViewModel
@{
    ViewData["Title"] = "Entity Management";
    Layout = "_Layout";
    var readEnabled = ViewData["EntityReadEnabled"] is bool enabled && enabled;
    var sections = new[] { "Overview", "Entity Master", "Organization & Mapping", "Bulk Management", "Movements & Engagements", "Closure & Para History", "Authorizations & Audit Trail", "Data Quality" };
}
<link rel="stylesheet" href="@Url.Content("~/css/entity-management.css")" />
<main id="entityWorkspace" class="entity-workspace" data-read-url="@Url.Action("Entity_Dashboard", "AdministrationPanel")" data-read-enabled="@(readEnabled ? "true" : "false")">
<header class="d-flex justify-content-between mb-3 align-items-center flex-wrap gap-2">
    <div><h1>Entity Management</h1><p class="text-muted mb-0">IAS Administration &amp; Governance</p></div>
    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Home")">Home</a>
</header>
<partial name="DashboardPartials/_EntityAdministrationLinks" />
@if (readEnabled)
{
    <div class="alert alert-info" role="status">Read-only Super User evaluation. Data is loaded directly from the deployed Oracle package. Save, bulk apply, approval, closure and restoration remain disabled. Wider entity-scope authorization requires a separate approved design.</div>
}
else
{
    <div class="alert alert-warning" role="status">Live entity readers are currently restricted to Super Users. Your existing authorized administration operations remain available above. No entity data has been loaded.</div>
}
<div id="entityReadError" class="alert alert-danger d-none" role="alert"></div>
<div class="row g-3 mb-4">
@foreach (var metric in new[] { ("Active Entities", "active"), ("Mapping Exceptions", "exceptions"), ("Pending Approvals", "approvals"), ("Unassigned GM", "gm"), ("Inactive Entities", "inactive"), ("Recent Changes", "changes") })
{
    <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">@metric.Item1</div>
    <strong class="d-block my-2" id="entityMetric-@metric.Item2">@(readEnabled && (metric.Item2 == "active" || metric.Item2 == "inactive") ? "Loading..." : "Unavailable")</strong>
    <small class="text-muted">@(metric.Item2 == "active" || metric.Item2 == "inactive" ? (readEnabled ? "Oracle entity master" : "Authorized reader required") : "Approved aggregate reader required")</small>
    </div></div></div>
}
</div>
<section class="card mb-3"><div class="card-body">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2>Entity register</h2><span class="text-muted small">Server-side Oracle search · up to 50 records per page</span>
    </div>
    <div class="row g-3">
        <div class="col-md-3"><label for="entityQuery">Entity ID, Code or Name</label>
            <input id="entityQuery" class="form-control" maxlength="120" placeholder="Search entities" disabled="@(!readEnabled)" />
        </div>
        <div class="col-md-2"><label for="entityTypeFilter">Entity Type</label>
            <select id="entityTypeFilter" class="form-select" disabled="@(!readEnabled)"><option value="">All entity types</option></select>
        </div>
        <div class="col-md-2"><label for="entityGroupFilter">Group / Division</label><select id="entityGroupFilter" class="form-select" disabled><option>Awaiting scoped filter reader</option></select></div>
        <div class="col-md-2"><label for="entityReportingFilter">Reporting Office</label><select id="entityReportingFilter" class="form-select" disabled><option>Awaiting scoped filter reader</option></select></div>
        <div class="col-md-1"><label for="entityGmFilter">GM Office</label><select id="entityGmFilter" class="form-select" disabled><option>Pending</option></select></div>
        <div class="col-md-2"><label for="entityStatusFilter">Status</label>
            <select id="entityStatusFilter" class="form-select" disabled="@(!readEnabled)">
                <option value="ALL">All</option><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-end mt-3"><button type="button" class="btn btn-success btn-sm" id="entitySearchButton" disabled="@(!readEnabled)">Search / Refresh</button></div>
    <div class="table-responsive mt-3">
        <table class="table table-hover table-striped align-middle">
            <thead><tr><th>ID</th><th>Code</th><th>Name</th><th>Type</th><th>Audit Cluster</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="entityRegisterRows"><tr><td colspan="7" class="text-center text-muted">@(readEnabled ? "Loading authorized entity records..." : "Search not enabled for this session.")</td></tr></tbody>
        </table>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" id="entityPrevious" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
        <button type="button" id="entityNext" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        <span id="entityRegisterStatus" class="text-muted small">No records loaded</span>
    </div>
</div></section>
<div class="entity-context mb-3" role="status" aria-live="polite">Selected entity: <strong id="selectedEntityLabel">No entity selected</strong> <span class="text-muted">· Shared across all sections</span></div>
<nav class="entity-tabs" role="tablist" aria-label="Entity management sections">
@for (var i = 0; i < sections.Length; i++)
{
    <button type="button" id="entity-tab-@i" role="tab" aria-controls="entity-panel-@i" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")" data-entity-tab="@i">@sections[i]</button>
}
</nav>
@for (var i = 0; i < sections.Length; i++)
{
<section id="entity-panel-@i" role="tabpanel" aria-labelledby="entity-tab-@i" tabindex="0" hidden="@(i != 0)" class="card mt-3"><div class="card-body">
<h2>@sections[i]</h2>
@switch (i)
{
case 0:
    <p class="text-muted">Select an entity in the register to review its live Oracle profile, existing organizational mappings and governance information.</p>
    <table class="table table-sm"><tbody id="entityOverviewRows"><tr><td>Select an entity above.</td></tr></tbody></table>
    break;
case 1:
    <p class="text-muted">Live source: <code>T_AUDITEE_ENTITIES</code>. Editing is disabled pending approved write procedures.</p>
    <table class="table table-sm table-striped"><tbody id="entityMasterRows"><tr><td>Select an entity to view master fields.</td></tr></tbody></table>
    <button type="button" class="btn btn-secondary" disabled>Add Entity</button>
    <button type="button" class="btn btn-secondary" disabled>Save Changes</button>
    break;
case 2:
    <p class="text-muted">Current mapping records from <code>T_AUDITEE_ENTITIES_MAPING</code>. Multiple mappings are displayed separately; GM Office uses the stored mapping value.</p>
    <div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>Parent ID</th><th>Parent name</th><th>Child name</th><th>Parent type</th><th>Child type</th><th>Mapping AUDITEDBY</th><th>GM Office</th><th>Reporting</th><th>Division</th><th>Group</th></tr></thead><tbody id="entityMappingRows"><tr><td colspan="10">Select an entity to view its mappings.</td></tr></tbody></table></div>
    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "OrganizationStructure")">Organization Structure (separately authorized)</a>
    break;
case 3:
    <partial name="DashboardPartials/_EntityBulkDraft" />
    break;
case 4:
    <p>Organizational movement, entity succession, engagement shifting and reversal are separate operations. Existing screens retain their own permissions and behavior.</p>
    <a class="btn btn-outline-secondary btn-sm mb-2" href="@Url.Action("Index", "OrganizationStructure")">Organizational Movement</a>
    @foreach (var step in Model.VisibleSteps.Where(s => s.StepKey == "ENTITY_SHIFTING" || s.StepKey == "SETUP_ENGAGEMENT_REVERSAL" || s.StepKey == "ENGAGEMENT_SHIFTING"))
    {
        <a class="btn btn-outline-secondary btn-sm mb-2" href="@Url.Action("Entity_Dashboard", "AdministrationPanel", new { stepKey = step.StepKey })">@step.StepTitle</a>
    }
    break;
case 5:
    <p class="text-muted">Preliminary, read-only impact. This is not authorization to close or settle observations.</p>
    <table class="table table-sm table-striped"><tbody id="entityClosureRows"><tr><td>Select an entity to preview closure impact.</td></tr></tbody></table>
    <button class="btn btn-secondary btn-sm" type="button" disabled>Submit Closure</button>
    <button class="btn btn-secondary btn-sm" type="button" disabled>Execute Closure</button>
    <button class="btn btn-secondary btn-sm" type="button" disabled>Restore</button>
    <h3 class="mt-4">Historical para archive</h3>
    <div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>COM_ID</th><th>Para number</th><th>Status</th><th>Added</th><th>Settled</th><th>Cycle</th><th>Archived</th><th>Closure event</th></tr></thead><tbody id="entityArchiveRows"><tr><td colspan="8">Select an entity to view archive records.</td></tr></tbody></table></div>
    break;
case 6:
    <p class="text-muted">Read-only change log. New request and approval actions remain unavailable.</p>
    <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Recorded</th><th>Action</th><th>Status</th><th>Actor</th><th>Reason</th><th>Request</th><th>Batch</th></tr></thead><tbody id="entityHistoryRows"><tr><td colspan="7">Select an entity to view its recorded changes.</td></tr></tbody></table></div>
    <button class="btn btn-secondary btn-sm" type="button" disabled>Approve</button>
    <button class="btn btn-secondary btn-sm" type="button" disabled>Reject</button>
    break;
case 7:
    <p>Data-quality investigation is read-only and requires approved aggregate/scoped readers. The existing profile retains all mapping records to expose possible duplicates.</p>
    <table class="table table-sm"><tbody>@foreach (var issue in new[] { "Missing mapping", "Conflicting mapping", "Inactive entity with mapping", "Unassigned GM", "Missing reporting assignment", "Orphan references", "Self-parent hierarchy exception", "Unusual para status" }) { <tr><th>@issue</th><td>Approved investigation reader required</td></tr> }</tbody></table>
    break;
}
</div></section>
}
</main>
<script src="@Url.Content("~/js/administration-entity-dashboard.js")" asp-append-version="true"></script>
