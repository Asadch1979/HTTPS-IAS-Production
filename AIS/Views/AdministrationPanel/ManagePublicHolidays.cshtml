@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewBag.Title = "Manage Public Holidays";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Manage Public Holidays</h2>

<div class="row">
    <div class="col-md-6">
        <form id="holidayForm">
            <div class="form-group">
                <label>Date</label>
                <input type="date" data-allow-future="true" class="form-control" id="holidayDate" required />
            </div>
            <div class="form-group">
                <label>Type</label>
                <select class="form-control" id="holidayType">
                    <option value="Holiday">Holiday</option>
                    <option value="Weekend">Weekend</option>
                </select>
            </div>
            <div class="form-group">
                <label>Holiday Name (optional)</label>
                <input type="text" class="form-control" id="holidayName" />
            </div>
            <button type="submit" class="btn btn-primary">Add/Mark</button>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Public Holidays</h4>
        <table class="table table-bordered" id="holidaysTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<script src="~/js/csp/Views_AdministrationPanel_ManagePublicHolidays.js?v=1"></script>
