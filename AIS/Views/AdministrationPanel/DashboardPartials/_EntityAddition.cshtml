@{ Layout = null; }

<div class="row col-md-12">
    <h3 style=" display:block;color: #be0e43">Entity Addition</h3>
</div>

<div class="col-md-12 row mt-3">
    <h3 class="text-center" style="display:block;color:chocolate ;">HR Entities</h3>
</div>

<div class="row col-md-12 mt-3">
    <div class="col-md-6">
        <div class="col-md-12 row">
            <div class="col-md-3">
                <label>Entity Name</label>
            </div>
            <div class="col-md-7">
                <input class="form-control alnum-only" id="entityNameTextBar" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="150" />
            </div>
            <div class="col-md-2">
                <button data-onclick="getEntityDetailsByName();" class="btn btn-danger w-100"> Find</button>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="col-md-12 row">
            <div class="col-md-3">
                <label>Entity Code</label>
            </div>
            <div class="col-md-7">
                <input id="entityCodeTextBar" class="form-control alnum-only" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="50" />
            </div>
            <div class="col-md-2">
                <button data-onclick="getEntityDetailsByCode();" class="btn btn-danger w-100"> Find</button>
            </div>
        </div>
    </div>


    <div class="mt-3 col-md-12">
        <table id="entity_find_panel" class="table table-hover table-bordered table-hover mt-3 table-striped">
            <thead style="background-color: #19875478 !important;">
                <tr>
                    <th class="col-md-auto">Sr. No.</th>
                    <th class="col-md-auto">Reporting Office Code</th>
                    <th class="col-md-auto ">Reporting Office Name </th>
                    <th class="col-md-auto">Reporting Office Status</th>
                    <th class="col-md-auto">Reporting Office Indicator</th>
                    <th class="col-md-auto">Entity Code</th>
                    <th class="col-md-auto">Entity Name </th>
                    <th class="col-md-auto">Entity Status</th>
                    <th class="col-md-auto">Entity Indicator</th>
                    <th class="col-md-auto"></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <button data-onclick="clearHREntitiesPanel();" class="btn btn-sm btn-success offset-md-11 col-md-1 mt-1"> Clear Table</button>
    </div>


    <div class="col-md-12 row mt-3">
        <button data-onclick="AddNewAISEntity();" class="btn btn-danger col-md-3"> Add New Entity in AIS</button>

    </div>
    <div class="col-md-12 row mt-3">
        <h3 class="text-center" style=" display:block;color:chocolate ;">AIS Entities</h3>


    </div>




    <div class="row col-md-12 mt-3">
        <div class="col-md-6">
            <div class="col-md-12 row">
                <div class="col-md-3">
                    <label>Entity Name</label>
                </div>
                <div class="col-md-7">
                    <input class="form-control alnum-only" id="AISentityNameTextBar" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="150" />
                </div>
                <div class="col-md-2">
                    <button data-onclick="getAISEntityDetailsByName();" class="btn btn-danger w-100"> Find</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="col-md-12 row">
                <div class="col-md-3">
                    <label>Entity Code</label>
                </div>
                <div class="col-md-7">
                    <input id="AISentityCodeTextBar" class="form-control alnum-only" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="50" />
                </div>
                <div class="col-md-2">
                    <button data-onclick="getAISEntityDetailsByCode();" class="btn btn-danger w-100"> Find</button>
                </div>
            </div>
        </div>

        <div class="mt-3 col-md-12">
            <table id="ais_entity_find_panel" class="table table-hover table-bordered table-hover mt-3 table-striped">
                <thead style="background-color: #19875478 !important;">
                    <tr>
                        <th class="col-md-auto">Sr. No.</th>
                        <th class="col-md-auto">Entity ID</th>
                        <th class="col-md-auto">Entity Code</th>
                        <th class="col-md-auto">Entity Name </th>
                        <th class="col-md-auto">Entity Type ID</th>
                        <th class="col-md-auto">Audit By</th>
                        <th class="col-md-auto">Auditable</th>
                        <th class="col-md-auto">Status</th>
                        <th class="col-md-auto"></th>
                        <th class="col-md-auto"></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
            <button data-onclick="clearAISEntitiesPanel();" class="btn btn-sm btn-success offset-md-11 col-md-1 mt-1"> Clear Table</button>
        </div>


    </div>

</div>


<div id="updateEntityModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" style="min-width:90%" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Update AIS Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Entity Type</label>
                        </div>
                        <div class="row col-md-8">
                            <select id="entTypeField" class="form-select form-control">
                                <option value="0" id="0" selected>--Select Entity--</option>
                                @{
                                    if (ViewData["AuditEntitiesType"] != null)
                                    {
                                        foreach (var item in (dynamic)(ViewData["AuditEntitiesType"]))
                                        {
                                                                                            <option value="@item.AUTID">@item.ENTITYTYPEDESC</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Entity Code</label>
                        </div>
                        <div class="row col-md-8">
                            <input id="entCodeField" class="form-control alnum-only" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="50" />
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Entity Name</label>
                        </div>
                        <div class="row col-md-8">
                            <input id="entNameField" class="form-control alnum-only" type="text" data-allow-amp="true" data-allow-question="true" data-maxlen="150" />
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Entity Description</label>
                        </div>
                        <div class="row col-md-8">
                            <textarea class="form-control" id="entDescField" data-validate="plain-text"> </textarea>
                        </div>
                    </div>

                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Is Active</label>
                        </div>
                        <div class="row col-md-8">
                            <select id="entActiveField" class="form-control">
                                <option value="Y">Yes</option>
                                <option value="N">No</option>
                            </select>

                        </div>
                    </div>

                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Auditable</label>
                        </div>
                        <div class="row col-md-8">
                            <select id="entAuditableField" class="form-control">
                                <option value="Y">Yes</option>
                                <option value="N">No</option>
                            </select>

                        </div>
                    </div>

                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Audit By</label>
                        </div>
                        <div class="row col-md-8">
                            <select id="entAuditbyField" class="form-control">
                                <option value="0" id="0" selected>--Select Entity--</option>
                                @{
                                    if (ViewData["Audit_By"] != null)
                                    {
                                        foreach (var item in (dynamic)(ViewData["Audit_By"]))
                                        {
                                                                                            <option value="@item.AUTID">@item.ENTITYTYPEDESC</option>
                                        }
                                    }
                                }

                            </select>

                        </div>
                    </div>



                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button data-onclick="saveUpdateChangesInAISEntity();" type="button" data-bs-dismiss="modal" class="btn btn-success">Save Changes</button>

            </div>
        </div>
    </div>
</div>


