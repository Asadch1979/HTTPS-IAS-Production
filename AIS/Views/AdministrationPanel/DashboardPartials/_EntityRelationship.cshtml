@{ Layout = null; }

<div class="col-md-12" style="margin-top:20px;">
    <h3 style="display:block;color: #be0e43">Entity Mapping / Relationship Update</h3>

    <div class="row col-md-12 mt-3 align-items-center">
        <div class="col-md-2">
            <label>Relationship Type</label>
        </div>
        <div class="col-md-10">
            <select id="RelationshipField" data-onchange="getrelation();" class="form-control form-select">
                <option id="0" value="0" selected="selected">--Select Relationship Type--</option>


                @{
                    if (ViewData["Userrelationship"] != null)
                    {
                        foreach (var item in (dynamic)(ViewData["Userrelationship"]))
                        {
                            <option value="@item.ENTITY_REALTION_ID" id="@item.ENTITY_REALTION_ID">@item.FIELD_NAME</option>
                        }
                    }
                }



            </select>
        </div>
    </div>

    <div class="row col-md-12 mt-3 align-items-center">
        <div class="col-md-2">
            <label>Controlling/Reporting Office</label>
        </div>
        <div class="col-md-10">
            <select id="controlingsearch" data-onchange="getplacepost();" class="form-control form-select">
                <option id="0" value="0" selected="selected">--Select Controlling/Reporting Office--</option>
            </select>
        </div>
    </div>

    <div class="row col-md-12 mt-3">
        <div class="col-md-12">
            <h5 style="color:chocolate;">Related Place of Posting</h5>
            <div class="table-responsive">
                <table id="entityRelationshipPostingGrid" class="table table-hover table-bordered mt-2 table-striped">
                    <thead style="background-color: #19875478 !important;">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Entity ID</th>
                            <th>Place of Posting</th>
                            <th>Entity Type</th>
                            <th>Audit By</th>
                            <th>GM Office</th>
                            <th>Reporting Office</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="entity-relationship-empty-row">
                            <td colspan="8" class="text-center text-muted">Select a Controlling/Reporting Office to load Place of Posting records.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</div>
<partial name="~/Views/AdministrationPanel/DashboardPartials/_EntityMappingModal.cshtml" />
<script src="~/js/csp/Views_AdministrationPanel_entity_relationship.js?v=1"></script>
<script src="~/js/csp/Views_AdministrationPanel_entity_addition.js?v=1"></script>
