@{ Layout = null; }

<div class="row col-md-12 mt-3">
    <h3 style=" display:block;color: #be0e43">Manage Users</h3>
</div>

<div class="row col-md-12 mt-1">
    <div class="col-md-2">
        <label>Relationship Type</label>
    </div>
    <div class="col-md-10">
        <select id="RelationshipField" data-onchange="getrelation();" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Relationship Type--</option>

            @{
                if (ViewData["Userrelationship"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["Userrelationship"]))
                    {
                            <option value="@item.ENTITY_REALTION_ID" id="@item.ENTITY_REALTION_ID">@item.FIELD_NAME</option>
                    }
                }
            }



        </select>
    </div>
</div>

<div class="row col-md-12 mt-1">
    <div class="col-md-2">
        <label>Controlling/Reporting Office</label>
    </div>
    <div class="col-md-4">
        <select id="controlingsearch" data-onchange="getplacepost();" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Controlling/Reporting Office--</option>
        </select>
    </div>


    <div class="col-md-2">
        <label>Place of Posting</label>
    </div>
    <div class="col-md-4">
        <select id="childposting" class="form-control form-select">
            <option id="0" value="0" selected="selected">--Select Place of Posting--</option>

        </select>
    </div>
</div>

<div id="searchFieldsContainer">
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>P.P.No.</label>
        </div>
        <div class="col-md-4">
            <input id="ppnoSearchField" type="text" class="form-control" placeholder="P.P.Number" aria-label="P.P.Number" aria-describedby="basic-addon2">
        </div>
        <div class="col-md-2">
            <label>login Name</label>
        </div>
        <div class="col-md-4">
            <input id="loginSearchField" autocomplete="false" readonly onfocus="this.removeAttribute('readonly');" class="form-control" type="text" />
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Email</label>
        </div>
        <div class="col-md-10">
            <input id="emailSearchField" class="form-control" type="text" />
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Group/Role</label>
        </div>
        <div class="col-md-10">
            <select id="roleSearchField" class="form-control form-select">
                <option id="0" value="0" selected="selected">--Select Group--</option>
                @{
                    if (ViewData["GroupList"] != null)
                    {
                        foreach (var item in (dynamic)(ViewData["GroupList"]))
                        {
                                <option value="@item.GROUP_CODE" id="@item.GROUP_CODE">@item.GROUP_NAME</option>
                        }
                    }
                }
            </select>
        </div>
    </div>

    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Is Active</label>
        </div>
        <div class="col-md-10">
            <input id="isActiveSearchField" type="checkbox" />
        </div>
    </div>
</div>

<div id="saveChangesFieldsContainer" class="d-none">
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>P.P.No.</label>
        </div>
        <div class="col-md-4">
            <input id="ppnoSaveField" type="text" class="form-control" placeholder="P.P.Number" aria-label="P.P.Number" aria-describedby="basic-addon2">
        </div>
        <div class="col-md-2">
            <label>login Name</label>
        </div>
        <div class="col-md-4">
            <input id="loginSaveField" autocomplete="false" class="form-control" type="text" />
        </div>
    </div>

    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Password</label>
        </div>
        <div class="col-md-4">
            <input id="passSaveField" autocomplete="false" type="password" class="form-control" />
        </div>
        <div class="col-md-2">
            <label>Confirm Password</label>
        </div>
        <div class="col-md-4">
            <input id="conPassSaveField" autocomplete="false" class="form-control" type="password" />
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Email</label>
        </div>
        <div class="col-md-10">
            <input id="emailSaveField" class="form-control" type="text" />
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Group/Role</label>
        </div>
        <div class="col-md-10">
            <div class="row col-md-12 w-100 m-0 p-0">
                <select id="roleSaveField" class="form-control form-select">
                 
                    @{
                        if (ViewData["GroupList"] != null)
                        {
                            foreach (var item in (dynamic)(ViewData["GroupList"]))
                            {
                                    <option value="@item.GROUP_CODE" id="@item.GROUP_CODE">@item.GROUP_NAME</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Is Active</label>
        </div>
        <div class="col-md-10">
            <input id="isActiveSaveField" type="checkbox" />
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Default Context</label>
        </div>
        <div class="col-md-10">
            <input id="defaultAssignmentSaveField" type="checkbox" />
            <small class="text-muted d-block">Use this role and posting as the default context when the user has multiple assignments.</small>
        </div>
    </div>
    <div class="row col-md-12 mt-1">
        <div class="col-md-2">
            <label>Reset Password</label>
        </div>
        <div class="col-md-10">
            <input id="resetpassword" type="checkbox" data-onclick="checkBoxClicked()"/>
        </div>
    </div>
    <div class="row col-md-12 mt-3">
        <div class="col-md-2">
            <label>Assignments</label>
        </div>
        <div class="col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="text-muted small">
                            Build one role and posting context with the selectors above, then add it to the list below.
                        </div>
                        <button id="addAssignmentButton" type="button" class="btn btn-outline-secondary btn-sm">Add Assignment</button>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-bordered table-sm align-middle mb-0" id="userContextTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:90px;">Default</th>
                                    <th style="width:80px;">Active</th>
                                    <th>Role</th>
                                    <th>Controlling/Reporting Office</th>
                                    <th>Place of Posting</th>
                                    <th>Relationship</th>
                                    <th style="width:90px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="userContextTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row col-md-12 mt-1">
    <button id="findButton" data-onclick="findButtonClickHandler();" class="btn btn-danger col-md-2" style="margin-left:auto;">Find</button>
    <button id="saveChangesButton" data-onclick="saveButtonClickHandler();" class="btn btn-success col-md-2 d-none" style="margin-left:auto;">Save Changes</button>
    <button id="addNewUserChangesButton" data-onclick="addNewUserButtonClickHandler();" class="btn btn-success col-md-2 d-none" style="margin-left:auto;">Add New User</button>

</div>
<div class="mt-1">
    <table class="table table-bordered mb-0 mt-3 bg-white table-hover table-striped" id="userListTable">
        <thead>
            <tr>
                <td style="text-align:left;"><h6>User Name</h6></td>
                <td style="text-align:left;"><h6>P.P. No.</h6></td>
                <td style="text-align:left;"><h6>Controlling/Reporting Office</h6></td>
                <td style="text-align:left;"><h6>Current Place of Posting</h6></td>
                <td style="text-align:left;"><h6>Email</h6></td>
                <td style="text-align:left;"><h6>Group/Role</h6></td>
                <td style="text-align:left;"><h6>Contexts</h6></td>
                <td style="text-align:left;"><h6>Is Active</h6></td>
                <td style="text-align:left;"></td>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>






<script src="~/js/csp/Views_AdministrationPanel_manage_user.js?v=1"></script>
