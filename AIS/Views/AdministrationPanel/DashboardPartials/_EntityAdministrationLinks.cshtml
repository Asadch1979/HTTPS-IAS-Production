@using AIS.Models.WorkflowDashboard
@{
    var links = ViewData["EntityAdministrationLinks"] as IEnumerable<WorkflowDashboardStepModel> ?? Enumerable.Empty<WorkflowDashboardStepModel>();
}
<aside class="card mb-3" aria-label="Existing administration functions">
<div class="card-body"><h2 class="h6">Existing administration functions</h2><p class="small text-muted">Authorized working screens remain available during migration. Each destination retains its own permission checks.</p>
<div class="d-flex flex-wrap gap-2">
@foreach (var link in links) { <a class="btn btn-sm btn-outline-secondary" href="@Url.Content("~" + link.LegacyPath)">@link.StepTitle</a> }
</div><div class="mt-3"><a href="@Url.Action("Entity_Dashboard", "AdministrationPanel")">Working Entity Dashboard</a> · <a href="@Url.Action("Entity_Dashboard", "AdministrationPanel", new { workspacePreview = true })">Preview eight-tab workspace (incomplete)</a></div>
</div></aside>
