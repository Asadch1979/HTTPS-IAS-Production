@model AIS.Models.WorkflowDashboard.WorkflowDashboardViewModel
@{
    ViewData["Title"] = "User & Access Administration Workspace";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(step => step.StepKey == currentStep.StepKey) + 1;
}

<div class="planning-nav-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm planning-nav-card mb-0">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <a class="navbar-brand fw-bold text-decoration-none mb-1 d-inline-block" href="/Home/Index">IAS</a>
                    <h4 class="mb-0">User &amp; Access Administration Workspace</h4>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="/Home/Index">Home</a>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <strong id="userDashboardStepCounter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                <span class="text-muted small">Click any step to load it inside the workspace.</span>
            </div>

            <div id="userDashboardStepper" class="mt-2"></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body workflow-dashboard-compact">
        <div id="userDashboardStepHost"
             data-load-url="@Url.Action("LoadUserDashboardStep", "AdministrationPanel")"
             data-base-url="@Url.Action("User_Dashboard", "AdministrationPanel")"
             data-step-key="@Model.CurrentStepKey">
            <div class="alert alert-secondary mb-0">Loading workflow content...</div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css" />
<script src="~/js/fieldAudit/stepper-theme.js"></script>
<script>
    window.userDashboardStepData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(visibleSteps.Select(step => new
    {
        stepCode = step.StepKey,
        stepNo = step.StepNo,
        stepTitle = step.StepTitle,
        isCompleted = step.IsCompleted,
        isSaved = step.IsSaved,
        legacyPath = step.LegacyPath
    })));
</script>
<script src="~/js/administration-user-dashboard.js?v=1"></script>

<style>
    .workflow-dashboard-compact {
        padding: .9rem;
    }

    .workflow-dashboard-compact #userDashboardStepHost > *:first-child {
        margin-top: 0 !important;
    }
</style>
