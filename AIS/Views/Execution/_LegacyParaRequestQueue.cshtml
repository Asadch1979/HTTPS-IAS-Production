<div class="card mt-3"><div class="card-body">
    <div class="input-group mb-3"><input id="legacySearch" class="form-control" placeholder="Search entity, heading, para number, request or status" aria-label="Search requests" /><button id="legacyRefresh" type="button" class="btn btn-outline-primary">Search / Refresh</button></div>
    <div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Request ID</th><th>Entity</th><th>Audit Year</th><th>Para Number</th><th>Observation</th><th>Risk</th><th>Requested By</th><th>Requested On</th><th>Status</th><th>Action</th></tr></thead><tbody id="legacyRequests"></tbody></table></div>
    <div class="d-flex gap-2"><button id="legacyPrevious" type="button" class="btn btn-outline-secondary">Previous</button><button id="legacyNext" type="button" class="btn btn-outline-secondary">Next</button></div>
</div></div>
<div id="legacyPreview" class="modal fade" tabindex="-1" aria-labelledby="legacyPreviewTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h4 id="legacyPreviewTitle" class="modal-title">Legacy Para Request</h4><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><dl id="legacyPreviewAttributes" class="row"></dl>
        <h5>Complete Observation</h5><iframe id="legacyObservationPreview" title="Complete formatted observation" sandbox="" referrerpolicy="no-referrer" class="w-100 border rounded" height="440"></iframe>
        <h5 class="mt-3">Responsible Persons</h5><div id="legacyPreviewPersons" class="table-responsive"></div>
        <h5 class="mt-3">Attachments</h5><div id="legacyPreviewAttachments"></div>
        <h5 class="mt-3">Request History</h5><div id="legacyPreviewHistory" class="table-responsive"></div>
        <div id="legacyDecisionPanel" class="d-none mt-3"><label for="legacyRemarks" class="form-label">Remarks (required for return or rejection)</label><textarea id="legacyRemarks" class="form-control" maxlength="2000" rows="3"></textarea>
        <div class="d-flex gap-2 mt-3"><button type="button" id="legacyAuthorize" class="btn btn-success">Authorize</button><button type="button" id="legacyReturn" class="btn btn-warning">Return for Correction</button><button type="button" id="legacyReject" class="btn btn-danger">Reject</button></div></div>
        <button type="button" id="legacyCorrect" class="btn btn-primary d-none mt-3">Correct Returned Request</button>
    </div>
</div></div></div>
