@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Add Legacy Para";
    Layout = "_Layout";
    ViewData["LegacyParaEditor"] = true;
    var enabled = Configuration.GetValue<bool>("LegacyParaAddition:Enabled");
}
<div id="legacyParaWorkspace" class="container-fluid mt-3" data-mode="maker" data-audit-by="@ViewData["LegacyAuditById"]" data-enabled="@enabled.ToString().ToLowerInvariant()" data-api="@Url.Content("~/ApiCalls/LegacyPara")">
    @Html.AntiForgeryToken()
    <h3>Add Legacy Para</h3>
    <p class="text-muted">Submit a missing historical observation for Audit Cluster authorization.</p>
    @if (!enabled) { <div class="alert alert-warning">This module is not activated. Entry and request actions are unavailable.</div> }
    <div id="legacyMessage" role="status" class="alert d-none"></div>
    <fieldset disabled="@(!enabled)">
        <div class="card mb-3"><div class="card-body row g-3">
            <input id="legacyRequestId" type="hidden" value="0" /><input id="legacyVersion" type="hidden" value="0" />
            <div class="col-md-12"><label for="relationshipSelectField" class="form-label">Relationship Type</label>
                <select id="relationshipSelectField" class="form-select"><option value="">--Select Relationship Type--</option>
                    @if (ViewData["Userrelationship"] != null)
                    {
                        foreach (var item in (IEnumerable<AIS.Models.UserRelationshipModel>)ViewData["Userrelationship"])
                        {
                            <option value="@item.ENTITY_REALTION_ID">@item.FIELD_NAME</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6"><label for="reportingOfficeSelectField" class="form-label">Controlling/Reporting Office</label>
                <select id="reportingOfficeSelectField" class="form-select"><option value="">--Select Controlling/Reporting Office--</option></select>
            </div>
            <div class="col-md-6"><label for="entitySelectField" class="form-label">Place of Posting</label>
                <select id="entitySelectField" class="form-select"><option value="">--Select Place of Posting--</option></select>
                <input id="legacyEntityTypeId" type="hidden" value="" />
            </div>
            <div class="col-md-4"><label for="natureSelectField" class="form-label">Audit Nature</label><select id="natureSelectField" class="form-select"><option value="">Select nature</option>
                @if (ViewData["AuditNatureList"] != null) { foreach (var item in (dynamic)ViewData["AuditNatureList"]) { <option value="@item.N_ID">@item.DESCRIPTION</option> } }
            </select></div>
            <div class="col-md-4"><label for="yearSelectField" class="form-label">Historical Audit Year (through 2025)</label><select id="yearSelectField" class="form-select"><option value="">Select year</option>
                @if (ViewData["AuditYearList"] != null) { foreach (var item in (dynamic)ViewData["AuditYearList"]) { <option value="@item.AUDITPERIODID">@item.DESCRIPTION</option> } }
            </select></div>
            <div class="col-md-4"><label for="paraNoField" class="form-label">Original Para Number</label><input id="paraNoField" class="form-control" maxlength="100" /></div>
        </div></div>
        <div class="card mb-3"><div class="card-body">
            <label for="legacyGist">Gist of Para</label><textarea id="legacyGist" class="form-control" maxlength="4000" rows="3" required></textarea>
            <label for="legacyAnnexureDetails">Historical Annexure Details</label><textarea id="legacyAnnexureDetails" class="form-control" maxlength="4000" rows="2"></textarea>
        </div></div>
        <div class="card"><div class="card-body"><partial name="_CauObservationEditor" /></div></div>
        <button id="legacyNewRequest" type="button" class="btn btn-outline-secondary mt-3">Start New Request</button>
    </fieldset>
    <p class="text-muted mt-3">Submitted requests are sent to the authorized checker for review.</p>
</div>
<script type="application/json" id="legacy-page-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { AnnexList = ViewData["AnnexList"] }))</script>
<script src="~/js/obsreference.js" asp-append-version="true"></script>
<script src="~/js/Execution/legacy-para-requests.js" asp-append-version="true"></script>
<script src="~/js/Execution/Views_Execution_Add_Legacy_Para.js" asp-append-version="true"></script>
