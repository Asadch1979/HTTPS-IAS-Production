@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Authorize Legacy Para Addition";
    Layout = "_Layout";
    var enabled = Configuration.GetValue<bool>("LegacyParaAddition:Enabled");
}
<div id="legacyParaWorkspace" class="container-fluid mt-3" data-mode="checker" data-enabled="@enabled.ToString().ToLowerInvariant()" data-api="@Url.Content("~/LegacyParaRequests/")">
    @Html.AntiForgeryToken()
    <h3>Authorize Legacy Para Addition</h3><p class="text-muted">Review complete observations and history. Pending requests appear first.</p>
    @if (!enabled) { <div class="alert alert-warning">This module is not activated. Request actions are unavailable.</div> }
    <div id="legacyMessage" role="status" class="alert d-none"></div><partial name="_LegacyParaRequestQueue" />
</div>
<script src="~/js/Execution/legacy-para-requests.js" asp-append-version="true"></script>
<script src="~/js/Execution/Views_Execution_Authorize_Adding_Legacy_Para.js" asp-append-version="true"></script>
