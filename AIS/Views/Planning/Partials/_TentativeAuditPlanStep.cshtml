@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
}


<style type="text/css">
    .container {
        max-width: 100%;
    }

    .card-header {
        background-color: transparent !important;
        font-size: 20px;
        height: 100px;
    }

    .icon-card {
        margin: 10px;
    }
</style>


<div class="row col-md-12 mt-3">
    <h3 style="color: #be0e43">Tentative Audit Plan </h3>
</div>
<div>
    
        <div class="row col-md-12">
            <input class="form-control" id="searchTableRecord" type="text" placeholder="Search..">
        </div>
 
    <br>
    <div class="row col-md-12 mt-3">
        <table  id="tentative_plan_list" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important; ">
            <tr>
                <th width="80" style="font-size:large">Sr No</th>                
                <th width="150" style="font-size:large">Audit Period</th>
                <th width="150" style="font-size:large">Nature of Audit</th>
                <th width="250" style="font-size:large">Reporting/Controlling Office</th>
                <th width="150" style="font-size:large">Entity Name</th>
                <th width="150" style="font-size:large">Type</th>
                <th width="150" style="font-size:large">Entity Size</th>
                <th width="80" style="font-size:large">Risk</th>
                <th width="100" style="font-size:large">Frequency</th>
                <th width="150" style="font-size:large">No. of Days</th>
                <th width="100" style="font-size:large">Actions</th>
            </tr>
            </thead>
            <tbody style="font-size:85% !important;">
                @{
                    if (ViewData["TentativePlansList"] != null)
                    {
                        int sr = 1;
                        
                        foreach (var item in (dynamic)(ViewData["TentativePlansList"]))
                        {
                                <tr @item.PLAN_ID>
                                    <td align="center">@sr</td>
                                    <td align="center">@item.PERIOD_NAME</td>
                                    <td align="center">@item.NATURE_OF_AUDIT</td>
                                    <td align="left">@item.REPORTING_OFFICE</td>
                                     <td align="left">@item.ENTITY_NAME</td>
                                     <td align="left">@item.ENT_TYPE</td>                                    
                                    <td align="center">@item.BR_SIZE</td>
                                    <td align="center">@item.RISK</td>
                                    <td align="center">@item.FREQUENCY_DESCRIPTION</td>
                                    <td align="center">@item.NO_OF_DAYS</td>
                                <td align="center">
                                    @if (item.DELETION_PENDING)
                                    {
                                        <span class="badge bg-warning text-dark">Deletion Pending</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-primary js-create-audit-engagement"
                                                data-plan-id="@item.PLAN_ID" data-name="@item.ENTITY_NAME"
                                                data-size="@item.BR_SIZE" data-risk="@item.RISK"
                                                data-freq="@item.FREQUENCY_DESCRIPTION" data-days="@item.NO_OF_DAYS"
                                                data-period="@item.PERIOD_NAME" data-period-id="@item.AUDIT_PERIOD_ID"
                                                data-code="@item.CODE" data-zone-id="@item.AUDITEDBY"
                                                data-entity-id="@item.ENTITY_ID" data-entity-type="@item.ENTITY_TYPE_ID">
                                            Create
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-request-plan-deletion"
                                                data-plan-id="@item.PLAN_ID" data-entity-name="@item.ENTITY_NAME"
                                                data-period-name="@item.PERIOD_NAME">
                                            Request Deletion
                                        </button>
                                    }
                                </td>
                                </tr>
                            sr = sr + 1;
                        }

                    }
                }
            </tbody>
        </table>
        <div class="row w-100 mt-3 d-none">
            <h4>Audit Cluster Head Remarks</h4>
            <select id="deptSelectionBox" class="form-select form-control" aria-label="Default select example">
                <option value="0" selected>Remarks</option>
                <option value="1">1. Recommended for Approval</option>
                <option value="2">2. Refer back for changes in the above marked plans</option>
            </select>
        </div>
        <div class="row w-100 col-md-12 mt-3 d-none">
            <div class="col-md-6 mt-5">
                <button data-onclick="window.location.href = '';" class="btn-primary">Submit</button>
            </div>
            <div class="col-md-6 mt-5">
                <button data-onclick="window.location.href = '';" class="btn-primary">Refer Back</button>
            </div>
        </div>
    </div>
</div>

@if (TempData["PlanDeletionMessage"] != null)
{
    <div class="alert alert-success" role="status">@TempData["PlanDeletionMessage"]</div>
}
@if (TempData["PlanDeletionError"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["PlanDeletionError"]</div>
}
<dialog id="planDeletionDialog" aria-labelledby="planDeletionDialogTitle" class="rounded border p-4" style="max-width: 520px; width: 90%;">
    <h4 id="planDeletionDialogTitle">Request Audit Plan Deletion</h4>
    <p id="planDeletionSummary" class="small text-muted"></p>
    <form id="planDeletionRequestForm" method="post" action="@Url.Action("RequestAuditPlanDeletion", "Planning")">
        @Html.AntiForgeryToken()
        <input type="hidden" id="planDeletionPlanId" name="PlanId" />
        <label for="planDeletionReason" class="form-label">Reason for deletion (required)</label>
        <textarea id="planDeletionReason" name="Reason" class="form-control" rows="4"
                  required minlength="10" maxlength="2000" aria-required="true"></textarea>
        <div id="planDeletionValidation" class="text-danger small mt-1" aria-live="polite"></div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" id="cancelPlanDeletion" class="btn btn-outline-secondary">Cancel</button>
            <button type="submit" id="submitPlanDeletion" class="btn btn-danger">Submit Request</button>
        </div>
    </form>
</dialog>
<script src="~/js/csp/Views_Planning_tentative_audit_plan.js?v=3"></script>
