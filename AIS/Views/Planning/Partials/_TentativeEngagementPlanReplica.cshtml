@{
    Layout = null;
}

<input type="hidden" id="planningPlanId" value="@(ViewData["PlanningPlanId"] ?? string.Empty)" />
<input type="hidden" id="planningPeriodId" value="@(ViewData["PlanningPeriodId"] ?? string.Empty)" />
<input type="hidden" id="planningEntityType" value="@(ViewData["PlanningEntityType"] ?? string.Empty)" />
<input type="hidden" id="planningZoneId" value="@(ViewData["PlanningZoneId"] ?? string.Empty)" />
<input type="hidden" id="planningEntityId" value="@(ViewData["PlanningEntityId"] ?? string.Empty)" />
<input type="hidden" id="planningEntityName" value="@(ViewData["PlanningEntityName"] ?? string.Empty)" />
<input type="hidden" id="planningCode" value="@(ViewData["PlanningCode"] ?? string.Empty)" />
<input type="hidden" id="planningPeriodName" value="@(ViewData["PlanningPeriodName"] ?? string.Empty)" />
<input type="hidden" id="planningRisk" value="@(ViewData["PlanningRisk"] ?? string.Empty)" />
<input type="hidden" id="planningSize" value="@(ViewData["PlanningSize"] ?? string.Empty)" />
<input type="hidden" id="planningFrequency" value="@(ViewData["PlanningFrequency"] ?? string.Empty)" />
<input type="hidden" id="planningDays" value="@(ViewData["PlanningDays"] ?? string.Empty)" />

<div class="row mt-3 col-md-12">
    <h3 style="color: #be0e43">Tentative Engagement Plan</h3>
</div>
<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>Audit Period</h5>
    </div>
    <div class="col-md-9">
       <label id="auditperiod_label"></label>
    </div>
</div>
<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>Audit Entity</h5>
    </div>
    <div class="col-md-9">
        <label id="auditentity_label"></label>
    </div>
</div>
<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>Entity Risk</h5>
    </div>
    <div class="col-md-9">
        <label id="risk_label"></label>
    </div>
</div>
<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>Entity Size</h5>
    </div>
    <div class="col-md-9">
        <label id="size_label"></label>
    </div>
</div>

<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>No of Days</h5>
    </div>
    <div class="col-md-9">
        <label id="days_label"></label>
    </div>
</div>
<div class="row col-md-12  mt-3">
    <div class="col-md-3">
        <h5>Frequency</h5>
    </div>
    <div class="col-md-9">
        <label id="frequency_label"></label>
    </div>
</div>.

<div class="row col-md-12 mt-3">
    <div class="col-md-3">
        <h5>Start Date</h5>
    </div>
    <div class="col-md-9">
        <input id="startplan_date" type="date" data-allow-future="true" class="form-control form-select">
    </div>
</div>
<div id="travellingDayWrapper" class="row col-md-12 mt-3 d-none">
    <div class="col-md-3">
        <h5>Travelling Day</h5>
    </div>
    <div class="col-md-9">
        <select id="travellingDaysSelectField" type="date" class="form-control form-select">
            <option selected="selected" value="0">-- Not Required --</option>
            <option value="1">1 Day</option>
        </select>
    </div>
</div>
<div id="revenueCollWrapper" class="row col-md-12 mt-3 d-none">
    <div class="col-md-3">
        <h5>Revenue Record/ Utilization / Contact With Defaulter</h5>
    </div>
    <div class="col-md-9">
        <select id="revenueDaysSelectField" type="date" class=" form-control form-select">
            <option selected="selected" value="0">-- Not Required --</option>
            <option value="1">1 Day</option>
            <option value="2">2 Days</option>
            <option value="3">3 Days</option>
            <option value="4">4 Days</option>
            <option value="5">5 Days</option>
            <option value="6">6 Days</option>
        </select>
    </div>
</div>
<div id="discussionDayWrapper" class="row col-md-12 mt-3 d-none">
    <div class="col-md-3">
        <h5>Discussion Day</h5>
    </div>
    <div class="col-md-6">
        <select id="discussionDaysSelectField" type="date" class="form-control form-select">
            <option selected="selected" value="0">-- Not Required --</option>
            <option value="1">1 Day</option>
        </select>
    </div>
    <div class="col-md-3"></div>
</div>

<div class="row col-md-12 mt-3">
    <div class="col-md-9"></div>
    <div class="col-md-3">
        <button id="btnCalcEndDate" type="button" class="btn btn-primary btn-sm w-100">Calculate Audit End Date</button>
    </div>
</div>

<div class="row col-md-12 mt-3">
    <div class="col-md-3">
        <h5>End Date</h5>
    </div>
    <div class="col-md-9">
        <input disabled="disabled" id="endplan_date" type="date"  class="form-control form-select">
    </div>
</div>
<div class="row col-md-12 mt-3">
    <div class="col-md-3">
        <h5>Operational Period Start Date</h5>
    </div>
    <div class="col-md-9">
        <input id="startop_date"  type="date" class="form-control form-select">
    </div>
</div>
<div class="row col-md-12 mt-3">
    <div class="col-md-3">
        <h5>Operational Period End Date</h5>
    </div>
    <div class="col-md-9">
        <input id="endop_date"  type="date" class="form-control form-select">
    </div>
</div>

<div class="row col-md-12 mt-3">
    <div class="col-md-3">
        <h5>Team Assigned</h5>
    </div>
    <div class="col-md-9">
        <select id="auditTeam_box" data-onchange="previewSelectedTeaM();" class="form-select form-control">
            <option value="0" id="0" selected>Select Audit Team</option>
            @{
                if (ViewData["AuditTeamsList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["AuditTeamsList"]))
                    {
                        if (item.IS_TEAMLEAD == "Y" && item.STATUS == "Y")
                        {
                            <option value="@item.T_ID" id="@item.T_ID">@item.NAME</option>
                        }
                    }
                }
            }

        </select>
        <div id="teamPreview" class="w-100 d-none mt-3">
            <h5 style="color: #be0e43">Team Formation</h5>
            <table id="listOfEmployeeTeam" class="table table-hover table-bordered table-hover mt-3 table-striped">
                <thead style="background-color: #19875478 !important; ">
                    <tr>
                        <th class="col-md-auto">Team Name</th>
                        <th class="col-md-auto">Team Lead</th>
                        <th class="col-md-auto">Team Members</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="row col-md-12 mt-4">
   <button data-onclick="publishNewAuditPlanChanges();" class="col-md-2 btn btn-success">Save Changes</button>
  </div>

<script src="~/js/csp/Views_Planning_tentative_engagement_plan.js?v=3"></script>
