@model AIS.Models.Planning.PlanningWorkflowViewModel
@{
    ViewData["Title"] = "Planning";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="mb-0">Planning Workflow</h4>
            <span class="text-muted small">Unified planning and engagement workflow</span>
        </div>

        @if (!visibleSteps.Any())
            {
            <div class="alert alert-warning mt-3 mb-0">You do not currently have access to any planning workflow stages.</div>
            }
        else
            {
            <div class="planning-stepper mt-3">
                @foreach (var step in visibleSteps)
                    {
                    var isActive = currentStep != null && step.StepCode == currentStep.StepCode;
                    var stepCss = isActive ? "planning-step active" : "planning-step";
                    if (step.IsCompleted)
                        {
                        stepCss += " completed";
                        }
                    if (!step.IsSaved)
                        {
                        stepCss += " not-saved";
                        }

                    <a class="@stepCss" href="@Url.Action("Planning", "Planning", new { stepCode = step.StepCode, contextId = Model.ContextId, contextSecondaryId = Model.ContextSecondaryId })">
                        <div class="step-title"><span class="step-no">@(step.StepNo).</span> @(step.StepTitle)</div>
                        <span class="badge @(step.IsCompleted ? "bg-success" : "bg-secondary")">@(step.StatusText)</span>
                    </a>
                    }
            </div>
            }
    </div>
</div>

@if (currentStep != null)
    {
    <div class="card">
        <div class="card-body">
            @await Html.PartialAsync(currentStep.PartialViewName)
        </div>
    </div>
    }

<style>
    .planning-stepper {
        display: grid;
        grid-template-columns: repeat(4, minmax(220px, 1fr));
        gap: .5rem;
    }

    .planning-step {
        border: 1px solid #ced4da;
        border-radius: .5rem;
        padding: .5rem .75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: #212529;
        background: #fff;
    }

    .planning-step.active {
        border-color: #0d6efd;
        box-shadow: 0 0 0 2px rgba(13,110,253,.15);
    }

    .planning-step.completed {
        background: #ecf9f0;
        border-color: #198754;
    }

    .planning-step.not-saved {
        background: #fff5f5;
        border-color: #dc3545;
    }

    .step-no {
        font-weight: 700;
    }

    .step-title {
        font-size: .88rem;
        padding-right: .5rem;
    }

    <text>@media (max-width: 991px) {
        .planning-stepper {
            grid-template-columns: repeat(2, minmax(220px, 1fr));
        }
    }

    @media (max-width: 575px) {
        .planning-stepper {
            grid-template-columns: 1fr;
        }
    }</text>
</style>
