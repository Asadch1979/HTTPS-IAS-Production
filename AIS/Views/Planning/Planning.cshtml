@model AIS.Models.Planning.PlanningWorkflowViewModel
@{ 
    ViewData["Title"] = "Planning";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<div class="planning-nav-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm planning-nav-card mb-0">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <strong class="planning-step-counter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                <span class="text-muted small">Click any step to navigate</span>
            </div>

            @if (!visibleSteps.Any())
                {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any planning workflow stages.</div>
                }
            else
                {
                <div id="planningStepper" class="mt-2"></div>
                }
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css" />
<script src="~/js/fieldAudit/stepper-theme.js"></script>
<script>
    window.planningStepperData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(visibleSteps.Select(step => new
    {
        stepCode = step.StepCode,
        stepNo = step.StepNo,
        stepTitle = step.StepTitle,
        isCompleted = step.IsCompleted,
        isSaved = step.IsSaved
    })));
    window.planningStepperCurrentStepCode = "@Model.CurrentStepCode";
    window.planningStepperUrlTemplate = "@Html.Raw(Url.Action("Planning", "Planning", new { stepCode = "__STEP_CODE__", contextId = Model.ContextId, contextSecondaryId = Model.ContextSecondaryId }))";
</script>
<script>
    (function () {
        if (!window.fieldAuditStepperTheme || !window.fieldAuditStepperTheme.render) {
            return;
        }

        window.fieldAuditStepperTheme.render({
            containerId: 'planningStepper',
            steps: window.planningStepperData || [],
            currentStepCode: window.planningStepperCurrentStepCode || '',
            linkMode: 'link',
            urlTemplate: window.planningStepperUrlTemplate || '#'
        });
    })();
</script>
@if (currentStep != null)
    {
    <div class="card">
        <div class="card-body">
            @await Html.PartialAsync(currentStep.PartialViewName)
        </div>
    </div>
    }


