@model AIS.Models.Planning.PlanningWorkflowViewModel
@{ 
    ViewData["Title"] = "Planning";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<div class="planning-nav-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm planning-nav-card mb-0">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <strong class="planning-step-counter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                <span class="text-muted small">Click any step to navigate</span>
            </div>

            @if (!visibleSteps.Any())
                {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any planning workflow stages.</div>
                }
            else
                {
                <div class="planning-stepper mt-2">
                    @foreach (var step in visibleSteps)
                        {
                        var isActive = currentStep != null && step.StepCode == currentStep.StepCode;
                        var stepCss = isActive ? "planning-step active" : "planning-step";
                        if (step.IsCompleted)
                            {
                            stepCss += " completed";
                            }
                        if (!step.IsSaved)
                            {
                            stepCss += " not-saved";
                            }
                        var statusBadgeCss = step.IsSaved ? "bg-success" : "bg-secondary";

                        <a class="@stepCss" href="@Url.Action("Planning", "Planning", new { stepCode = step.StepCode, contextId = Model.ContextId, contextSecondaryId = Model.ContextSecondaryId })">
                            <div class="step-title"><span class="step-no">@(step.StepNo).</span> @(step.StepTitle)</div>
                            <span class="step-state ms-2 badge @statusBadgeCss">@(step.StatusText)</span>
                        </a>
                        }
                </div>
                }
        </div>
    </div>
</div>

@if (currentStep != null)
    {
    <div class="card">
        <div class="card-body">
            @await Html.PartialAsync(currentStep.PartialViewName)
        </div>
    </div>
    }

<style>
    .planning-nav-wrap {
        z-index: 1020;
    }

    .planning-nav-card {
        border: 1px solid #ced4da;
    }

    .planning-step-counter {
        font-size: 1rem;
    }

    .planning-stepper {
        display: grid;
        grid-template-columns: repeat(4, minmax(220px, 1fr));
        gap: .4rem;
        overflow: auto;
    }

    .planning-step {
        border: 1px solid #ced4da;
        border-radius: .5rem;
        padding: .45rem .65rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: #212529;
        background: #f8f9fa;
        text-align: left;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease, transform .15s ease;
    }

    .planning-step:hover {
        color: #212529;
    }

    .planning-step.active {
        transform: translateY(-1px);
    }

    .planning-step.completed {
        background: #ecf9f0;
        border-color: #77c59a;
        color: #125132;
    }

    .planning-step.completed:hover {
        background: #dff3e8;
        border-color: #57b684;
    }

    .planning-step.completed.active {
        background: #198754;
        border-color: #157347;
        color: #ffffff;
        box-shadow: 0 0 0 2px rgba(25, 135, 84, .22);
        font-weight: 600;
    }

    .planning-step.not-saved {
        background: #fff2f3;
        border-color: #efb7bd;
        color: #7b1f29;
    }

    .planning-step.not-saved:hover {
        background: #ffe4e7;
        border-color: #e68e98;
    }

    .planning-step.not-saved.active {
        background: #dc3545;
        border-color: #b02a37;
        color: #ffffff;
        box-shadow: 0 0 0 2px rgba(220, 53, 69, .2);
        font-weight: 600;
    }

    .planning-step:not(.completed):not(.not-saved) {
        background: #f8f9fa;
        border-color: #ced4da;
    }

    .planning-step:not(.completed):not(.not-saved).active {
        border-color: #495057;
        box-shadow: 0 0 0 2px rgba(73, 80, 87, .15);
        font-weight: 600;
    }

    .step-no {
        font-weight: 700;
    }

    .step-title {
        font-size: .88rem;
        padding-right: .5rem;
    }

    .step-state {
        font-size: .68rem;
        vertical-align: middle;
    }

    <text>@@media (max-width: 991px) {
        .planning-stepper {
            grid-template-columns: repeat(2, minmax(220px, 1fr));
        }
    }

    @@media (max-width: 575px) {
        .planning-stepper {
            grid-template-columns: 1fr;
        }
    }</text>
</style>
