@model AIS.Models.Planning.PlanningWorkflowViewModel
@{ 
    ViewData["Title"] = "Planning";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css?v=1" />

<div class="workflow-stepper-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm workflow-nav-card mb-0">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <strong class="workflow-step-counter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                <span class="text-muted small">Click any step to navigate</span>
            </div>

            @if (!visibleSteps.Any())
                {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any planning workflow stages.</div>
                }
            else
                {
                <div id="planningStepper" class="workflow-stepper mt-2">
                    @foreach (var step in visibleSteps)
                        {
                        var isActive = currentStep != null && step.StepCode == currentStep.StepCode;
                        var stepCss = isActive ? "workflow-step-pill active" : "workflow-step-pill";
                        if (step.IsCompleted)
                            {
                            stepCss += " completed";
                            }
                        if (!step.IsSaved)
                            {
                            stepCss += " not-saved";
                            }

                        <a class="@stepCss" href="@Url.Action("Planning", "Planning", new { stepCode = step.StepCode, contextId = Model.ContextId, contextSecondaryId = Model.ContextSecondaryId })" data-step-code="@step.StepCode" data-step-no="@step.StepNo" data-step-title="@step.StepTitle">
                            <div class="workflow-step-title"><span class="num">@(step.StepNo).</span> @(step.StepTitle)</div>
                        </a>
                        }
                </div>
                }
        </div>
    </div>
</div>

@if (currentStep != null)
    {
    <div class="card">
        <div class="card-body">
            @await Html.PartialAsync(currentStep.PartialViewName)
        </div>
    </div>
    }

<script src="~/js/fieldaudit-stepper-theme.js?v=1"></script>
<script>
    window.WorkflowStepperTheme && window.WorkflowStepperTheme.init({
        stepperSelector: '#planningStepper',
        counterSelector: '.workflow-step-counter',
        bindClicks: false
    });
</script>

