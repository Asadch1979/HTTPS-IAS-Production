@model AIS.Models.Planning.PlanningWorkflowViewModel
@{ 
    ViewData["Title"] = "Planning";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<div class="planning-nav-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm planning-nav-card mb-0">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <a class="navbar-brand fw-bold text-decoration-none" href="@Url.Action("Index", "Home")">IAS</a>
                <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Index", "Home")">Home</a>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <strong class="planning-step-counter" id="planningStepCounter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                <span class="text-muted small">Click any step to navigate</span>
            </div>

            @if (!visibleSteps.Any())
                {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any planning workflow stages.</div>
                }
            else
                {
                <div id="planningStepper" class="mt-2"></div>
                }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" id="planningStepHost"
         data-load-url="@Url.Action("LoadPlanningStep", "Planning")"
         data-step-code="@Model.CurrentStepCode"
         data-context-id="@Model.ContextId"
         data-context-secondary-id="@Model.ContextSecondaryId">
        @if (currentStep != null)
        {
            <div class="alert alert-secondary mb-0">Loading workflow content...</div>
        }
        else
        {
            <div class="alert alert-info mb-0">Select a workflow step to load planning content.</div>
        }
    </div>
</div>

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css" />
<script src="~/js/fieldAudit/stepper-theme.js"></script>
<script>
    window.planningStepperData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(visibleSteps.Select(step => new
    {
        stepCode = step.StepCode,
        stepNo = step.StepNo,
        stepTitle = step.StepTitle,
        isCompleted = step.IsCompleted,
        isSaved = step.IsSaved
    })));
</script>
<script src="~/js/planning/dashboard.js?v=1"></script>
