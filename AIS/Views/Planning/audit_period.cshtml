@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "Audit Period";
    Layout = "_Layout";
}


<div class="row mt-3">
    <div class="row col-md-12">
        <div class="col-md-6" style="padding-left:0px;">
            <h2 style="color: #be0e43">Audit Period</h2>
        </div>
        <div class="col-md-6">
            <button data-onclick="setupNewAuditPeriod();" class="btn btn-danger" style="float:right;">Add New Period</button>
        </div>
    </div>
</div>
<div id="listOfAuditPeriodsContainer" class="row mt-3">

    <br />
    <table id="listOfAuditPeriods" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important;">
            <tr>
                <th class="col-md-1">Sr No.</th>
                <th class="col-md-4">Description</th>
                <th class="col-md-2">Start Date</th>
                <th class="col-md-2">End Date</th>
                <th class="col-md-1">Status</th>
                <th class="col-md-1"></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<div id="setupAuditPeriod" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">New Audit Period</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <label for="periodDescriptionModalField">Description<span class="text-danger">*</span> <small class="text-muted">(A-Z, 0-9, space, &amp;, ?)</small></label>
                        <input required type="text" class="form-control alnum-only" id="periodDescriptionModalField" aria-describedby="brcode" placeholder="Description (Alphabets, numbers, spaces, ampersand (&amp;), comma (,), and question mark (?) only)" data-allow-space="true" data-allow-amp="true" maxlength="100" title="Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?)">
                        <small class="form-text text-muted">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</small>
                        <div class="invalid-feedback">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</div>
                    </div>
                    <div class="form-group">
                        <label for="periodStartModalField">Start Date<span class="text-danger">*</span></label>
                        <input required type="date" data-allow-future="true" class="form-control" id="periodStartModalField" aria-describedby="brcode" placeholder="Start Date">
                    </div>
                    <div class="form-group">
                        <label for="periodEndModalField">End Date<span class="text-danger">*</span></label>
                        <input required type="date" data-allow-future="true" class="form-control" id="periodEndModalField" aria-describedby="brcode" placeholder="End Date">
                    </div>
                    <div class="d-none">
                        @{
                            <h5 for="periodEndModalField">Audit Conducted By<span class="text-danger">*</span></h5>
                            if (ViewData["AuditDepartments"] != null)
                            {
                                foreach (var item in (dynamic)(ViewData["AuditDepartments"]))
                                {
                                    <div class="form-group">
                                        <div class="row w-100 col-md-12">
                                            <div class="col-md-10">
                                                <small for="checkbox_@item.CODE">@item.NAME</small>
                                            </div>
                                            <div class="col-md-2">
                                                <input type="checkbox" class="deptCheckBoxes" dept-id="@item.CODE" id="checkbox_@item.CODE" style="float:right;" value="@item.CODE" aria-label="...">
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button data-onclick="publishNewAuditPeriodChanges();" type="button" class="btn btn-danger">Save changes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



<div id="updateAuditPeriodModel" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Update Audit Period</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>

                    <div class="form-group">
                        <label for="periodStartModalField">Status<span class="text-danger">*</span></label>
                        <select id="auditPeriodStatus_forUpdate" class="form-control">
                            <option value="0">--Select Period Stauts--</option>
                            @if (ViewData["AuditPeriodStatus"] != null)
                            {
                                foreach (var item in (dynamic)(ViewData["AuditPeriodStatus"]))
                                {
                                    <option value="@item.STATUS_ID">@item.STATUS</option>
                                }
                            }
                        </select>

                    </div>


                </form>
            </div>
            <div class="modal-footer">
                <button data-onclick="publishUpdateAuditPeriodChanges();" type="button" class="btn btn-danger">Save changes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/csp/Views_Planning_audit_period.js?v=1"></script>
