@{
    ViewData["Title"] = "Special Assignment";
    Layout = "_Layout";
}

<style type="text/css">
    .container {
        max-width: 95%;
    }

    .card-header {
        background-color: transparent !important;
        font-size: 20px;
        height: 100px;
    }

    .icon-card {
        margin: 10px;
    }
</style>



<div class="row col-md-12 mt-3">
    <h3 style="color: #be0e43">Special Asignment</h3>


</div>
<!--<div class="panel panel-default">
    Default panel contents
