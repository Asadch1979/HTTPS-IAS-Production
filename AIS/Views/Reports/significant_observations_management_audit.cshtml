@{
    ViewData["Title"] = "Significant Findings";
    Layout = "_Layout";
}






<div class="mt-3 mb-4">
    <h3 style=" display:block;color: #be0e43">Significant Observations of Management Audit</h3>
</div>



<div class="row col-md-12 mt-3">
    
        <label>Select Department</label>
        <select id="entity" data-onchange="ShowDepartmentAuditPeriods();" class="form-select form-control">
            <option value="112248" id="1">Information Systems Audit Department</option>
            <option value="112242" id="2">Corporate Audit Department</option>
        </select>
</div>
<div class="row mt-3 col-md-12">
    <div class="row col-md-6">
        <label>Start Date:</label>
        <input class="form-control" type="date" />
    </div>
    <div class="row col-md-6">
        <label>End Date:</label>
        <input class="form-control" type="date" />
    </div>
</div>


<div class="row col-md-12 w-100 mt-3">
        <button class="btn btn-primary">Search</button>
</div>

<div class="row col-md-12 mt-4">
    <table id="Risk wise observation" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important; ">
            <tr>
                <th class="col-md-auto">Sr. No.</th>
                <th class="col-md-auto">COSO ERM Components</th>
                <th class="col-md-auto">No. of Observation</th>               
                
            </tr>
        </thead>
        <tbody>
         
        </tbody>
    </table>
</div>


<script src="~/js/csp/Views_Reports_significant_observations_management_audit.js?v=1"></script>
