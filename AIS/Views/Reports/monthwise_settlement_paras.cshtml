@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "monthwise_settlement_paras";
    Layout = "_Layout";
}




<div class="mt-3 mb-4">
    <h3 style="color: #be0e43">Monthwise Settlement Of Audit Paras</h3>


</div>

<div class="row col-md-12">


    <label>Audit Cluster</label>
        <select id="auditZoneSelectionBox" data-change="ShowSelectedZonesBranches();" class="form-select form-control" aria-label="Default select example">
            <option value="0" id="0" selected>--Select Zone--</option>
            @{
                if (ViewData["AuditZonesList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["AuditZonesList"]))
                    {
                        <option value="@item.ZONECODE" id="@item.ZONECODE">@item.ZONENAME</option>
                    }
                }
            }
        </select>
   
</div>





