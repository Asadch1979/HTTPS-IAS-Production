@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "audit_report";
    Layout = "_Layout";
}




<div class="mt-3 mb-4">
    <h3 style="color: #be0e43">Position of Audit of Branches (Report)</h3>


</div>


<div class="row col-md-12 mt-3">

    <div class="row col-md-6 mr-2 mt-3">
        <label>Select Audit Period</label>
        <select id="A_period" data-onchange="ShowSelectedZonesBranches();" class="form-select form-control" aria-label="Default select example">
            <option value="0" id="0" selected>--Select Audit Period--</option>

        </select>
    </div>
    



    <div class="row col-md-6 mt-3">
        <label>Select Audit Cluster</label>
        <select id="auditZoneSelectionBox" data-onchange="ShowSelectedZonesBranches();" class="form-select form-control" aria-label="Default select example">
            <option value="0" id="0" selected>--Select Cluster--</option>
            @{
                if (ViewData["AuditZonesList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["AuditZonesList"]))
                    {
                        <option value="@item.ZONECODE" id="@item.ZONECODE">@item.ZONENAME</option>
                    }
                }
            }
        </select>
    </div>

</div>







<div class="row col-md-12 w-100 mt-3">
    <button class="btn btn-primary">Find</button>
</div>
