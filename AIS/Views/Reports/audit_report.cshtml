@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "audit_report";
    Layout = "_Layout";
}

<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        color: #111;
        margin: 22px;
    }

    h1,
    h2,
    h3 {
        margin: 0;
    }

    .section-block {
        margin-bottom: 18px;
    }

    .page-break {
        page-break-before: always;
        break-before: page;
    }

    .avoid-break {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .cover {
        text-align: center;
        margin-top: 40px;
    }

    .cover-logo {
        text-align: left;
    }

    .cover img.logo {
        height: 70px;
        margin-bottom: 16px;
    }

    .cover h1 {
        font-size: 20px;
        font-weight: 700;
    }

    .cover h2 {
        font-size: 15px;
        margin-top: 6px;
    }

    .cover-box {
        border: 1px solid #111;
        padding: 16px;
        margin-top: 30px;
        display: inline-block;
        min-width: 60%;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        padding: 8px 12px;
        border-left: 5px solid #111;
        background: #f6f8fa;
        margin: 20px 0 12px;
    }

    .exec-summary {
        line-height: 1.7;
        text-align: justify;
    }

    .dashboard-row {
        display: block;
        margin: 12px 0;
    }

    .chart-block {
        margin-bottom: 12px;
        text-align: center;
    }

    .chart-img {
        width: 100%;
        max-height: 260px;
        margin: 8px 0;
    }

    .grid {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 10px;
    }

    .grid th {
        background: #f2f4f7;
        font-weight: 700;
        text-align: center;
    }

    .grid th,
    .grid td {
        border: 1px solid #111;
        padding: 6px;
        font-size: 12px;
    }

    .para-box {
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 12px 14px;
        margin: 12px 0;
        background: #fff;
    }

    .para-title {
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .para-body {
        line-height: 1.6;
        text-align: justify;
    }

    .para-box::after {
        content: "";
        display: block;
        border-top: 1px solid #e5e7eb;
        margin-top: 12px;
    }

    .annexure-title {
        font-size: 14px;
        font-weight: 700;
        margin: 16px 0 10px;
    }

    .annexure-note {
        font-size: 11px;
        color: #444;
        margin-bottom: 8px;
    }

    hr.section-sep {
        border: 0;
        border-top: 1px solid #d0d7de;
        margin: 16px 0;
    }
</style>







<div class="row">
    <div class="col-md-4 offset-md-8">
        <button class="btn btn-danger" style="float:right; margin-bottom:10px; " data-onclick="CreatePDFfromHTML();">Download Report</button>
    </div>
</div>



<div class="WordSection1">
    <div class="cover section-block">
        <div class="cover-logo">
            <img class="logo" src="~/Images/ztbllogo.png" alt="ZTBL logo" />
        </div>
        <h1>ZARAI TARAQIATI BANK LIMITED</h1>
        <h2>Internal Audit Division</h2>
        <div class="cover-box">
            <div><strong>Internal Audit Report</strong></div>
            <div>ZTBL (branch name) (Operational Zone)</div>
            <div>For the period from (mm dd, yyyy) to (mm dd, yyyy)</div>
            <div>Report Issuance Date: (mm dd, yyyy)</div>
        </div>
    </div>

    <div class="para-box section-block">
        <div class="para-title">Restriction Clause</div>
        <div class="para-body">
            Please note that confidentiality of the report must be maintained and it must not be
            distributed to third parties unless otherwise approved by Chief Internal Auditor or
            required by any regulation.
        </div>
    </div>

    <div class="section-block">
        <h3>Audit Zone ____________</h3>
        <h3>Internal Audit Division</h3>
    </div>
</div>
    
      

