@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "Account Transaction Master";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/sampling.css" />

<div class="container-fluid mt-4">
    <div class="card card-sample shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Account Transaction Master</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="biomet_sample_list" class="table table-hover table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Sr No</th>
                            <th>Account No</th>
                            <th>Account Title</th>
                            <th>Customer Name</th>
                            <th>DOB</th>
                            <th>Cell</th>
                            <th>CNIC</th>
                            <th>CNIC Expiry</th>
                            <th>Account Type</th>
                            <th>Account Category</th>
                            <th>Transaction Master Code</th>
                            <th>Transaction Master Desc</th>
                            <th colspan="3"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_Sampling_account_transaction_master.js?v=1"></script>
