@model IEnumerable<AIS.Models.SM.ExceptionMonitorModel>
@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    var titleFromQuery = Context.Request.Query["title"].ToString();
    var descriptionFromQuery = Context.Request.Query["desc"].ToString();

    ViewData["Title"] = string.IsNullOrWhiteSpace(titleFromQuery) ? "Monitoring of Exception Reports" : titleFromQuery;

    if (!string.IsNullOrWhiteSpace(descriptionFromQuery))
    {
        ViewData["Description"] = descriptionFromQuery;
    }

    Layout = "_Layout";
    var engId = ViewBag.EngId ?? 0;
}

<link rel="stylesheet" href="~/css/sampling.css" />
<div id="exceptionMonitoringPage" class="container-fluid mt-4" data-default-engagement-id="@(ViewBag.EngId ?? 0)">
        <div id="wait" style="display:none;"></div>
        <div class="card card-sample shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                @if (ViewData["Description"] != null)
                    {
                    <p class="mb-0 text-muted">@ViewData["Description"]</p>
                    }
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Entity:</label>
                    <select id="entitySelectField" class="form-select form-control">
                        <option value="0" id="0" selected>--Select Entity Name--</option>
                    </select>
                </div>
                <div class="table-responsive">
                    <table id="exceptionDetailsTable" class="table table-hover table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="col-md-auto">Sr No</th>
                                <th class="col-md-auto">Report Title</th>
                                <th class="col-md-auto">Execution Dates</th>
                                <th class="col-md-auto">Reporting Period</th>
                                <th class="col-md-auto">Exception Count</th>
                                <th class="col-md-auto text-center">View</th>
                                <th class="col-md-auto text-center">Regenerate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="7" class="text-center">Please select an entity to view exception data.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div id="exception-toast-container" class="mt-3"></div>
            </div>
        </div>
    </div>

<script src="~/js/csp/Views_Sampling_ExceptionMonitoring.js?v=1"></script>

