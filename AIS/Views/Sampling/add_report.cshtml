@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "Manage Exception Reports";
    Layout = "_Layout";
}


<link rel="stylesheet" href="~/css/sampling.css" />
<div class="container-fluid mt-4">
    <div class="card card-sample shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Exception Reports</h4>
            <button class="btn btn-success btn-sm" data-onclick="openAddModal()">Add</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="reportList" class="table table-hover table-bordered table-striped">
                    <thead>
                        <tr>
                            <th class="col-md-auto">Sr. No.</th>
                            <th class="col-md-auto">Report Name List</th>
                            <th class="col-md-auto">Things to be checked</th>
                            <th class="col-md-auto text-center">Update</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="addReportModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Exception Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Report Name List <small class="text-muted">(A-Z, 0-9, space, &amp;, ?)</small></label>
                    <input id="reportName" type="text" class="form-control alnum-only" maxlength="100" pattern="^[A-Za-z0-9 &,?]+$" title="Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?)" data-allow-amp="true" required placeholder="Report name (Alphabets, numbers, spaces, ampersand (&amp;), comma (,), and question mark (?) only)" />
                    <small class="form-text text-muted">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</small>
                    <div class="invalid-feedback">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Things to be checked</label>
                    <textarea id="thingsCheck" class="form-control" rows="4"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Report Type</label>
                    <select id="reportType" class="form-select">
                        <option value="L">Loan</option>
                        <option value="A">Account</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Loan Status</label>
                    <select id="loanStatus" class="form-select">
                        @{
                            if (ViewData["LoanStatusList"] != null)
                            {
                                foreach (var st in (dynamic)(ViewData["LoanStatusList"]))
                                {
                                    <option value="@st.CODE">@st.NAME</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" data-onclick="saveReport()">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_Sampling_add_report.js?v=1"></script>
