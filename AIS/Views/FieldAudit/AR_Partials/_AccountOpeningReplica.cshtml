@model AIS.Models.FieldAuditWorkflow.FieldAuditGridReplicaViewModel
<div id="fieldAuditAccountOpeningReplica" data-eng-id="@Model.EngagementId">
    <div class="d-flex justify-content-between align-items-center mb-2 mt-2">
        <h5 class="mb-0">Working Paper - Account Opening</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" id="openAccountOpeningReplicaBtn" class="rounded-circle btn btn-danger btn-sm" aria-label="Add account opening">
                <i class="fa fa-plus text-white"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_VOUCHER')">Back</button>
        </div>
    </div>
    <table id="fieldAuditAccountOpeningTable" class="table table-hover table-bordered table-striped"><thead><tr><th>Sr No</th><th>Voucher No</th><th>Nature</th><th>Observation</th><th>Memo/Para No</th></tr></thead><tbody></tbody></table>
    <div class="mt-3 d-flex justify-content-end gap-2"><button class="btn btn-success" type="button" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_FIXED_ASSETS')">Fixed Assets</button></div>
</div>

<div id="fieldAuditAccountOpeningDialog" class="modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-xl modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">New Account Opening Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="fieldAuditAccountOpeningForm">
                    <div class="form-group">
                        <label for="fieldAuditAccountNumber">Voucher / Account Number</label>
                        <input type="text" class="form-control" id="fieldAuditAccountNumber" />
                    </div>
                    <div class="form-group">
                        <label for="fieldAuditAccountNature">Nature of Account</label>
                        <select class="form-control" id="fieldAuditAccountNature">
                            <option value="">--Select Account Nature--</option>
                            <option value="Individual">Individual</option>
                            <option value="Sole Proprietorship">Sole Proprietorship</option>
                            <option value="Company">Company</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="fieldAuditAccountObservation">Observation (if any)</label>
                        <textarea class="form-control" id="fieldAuditAccountObservation"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="fieldAuditAccountParaNo">Para No (if any)</label>
                        <input type="text" class="form-control" id="fieldAuditAccountParaNo" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="addAccountOpeningReplicaBtn" class="btn btn-danger">Add New</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/fieldAudit/accountOpeningReplica.js?v=3"></script>
