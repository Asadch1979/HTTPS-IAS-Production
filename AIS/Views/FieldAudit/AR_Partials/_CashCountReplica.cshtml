@model AIS.Models.FieldAuditWorkflow.FieldAuditGridReplicaViewModel
<div id="fieldAuditCashCountReplica" data-eng-id="@Model.EngagementId">
    <div class="d-flex justify-content-between align-items-center mb-2 mt-2">
        <h5 class="mb-0">Working Paper - Cash Count</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" id="openCashCountReplicaBtn" class="rounded-circle btn btn-danger btn-sm" aria-label="Add cash count entry">
                <i class="fa fa-plus text-white"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_FIXED_ASSETS')">Back</button>
        </div>
    </div>
    <table id="fieldAuditCashCountTable" class="table table-hover table-bordered table-striped"><thead><tr><th>Sr No</th><th>D Vault</th><th>No Vault</th><th>Total Vault</th><th>D Safe</th><th>No Safe</th><th>Total Safe</th><th>Diff</th></tr></thead><tbody></tbody></table>
</div>

<div id="fieldAuditCashCountDialog" class="modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-xl modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">New Cash Count Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="fieldAuditCashCountForm">
                    <hr />
                    <h5 class="text-center">Cash Found in Vault</h5>
                    <hr />
                    <div class="row col-md-12">
                        <div class="form-group col-md-12">
                            <label for="fieldAuditVaultDenomination">Denomination</label>
                            <input type="text" class="form-control" id="fieldAuditVaultDenomination" />
                        </div>
                        <div class="form-group col-md-12">
                            <label for="fieldAuditVaultCurrencyNotes">No of Currency Notes</label>
                            <input type="text" class="form-control" id="fieldAuditVaultCurrencyNotes" />
                        </div>
                        <div class="form-group col-md-12">
                            <label for="fieldAuditVaultTotalAmount">Total Amount</label>
                            <input type="text" class="form-control" id="fieldAuditVaultTotalAmount" />
                        </div>
                    </div>

                    <hr />
                    <h5 class="text-center">Cash as per Night Save Vault</h5>
                    <hr />
                    <div class="row col-md-12">
                        <div class="form-group col-md-12">
                            <label for="fieldAuditSafeDenomination">Denomination</label>
                            <input type="text" class="form-control" id="fieldAuditSafeDenomination" />
                        </div>
                        <div class="form-group col-md-12">
                            <label for="fieldAuditSafeCurrencyNotes">No of Currency Notes</label>
                            <input type="text" class="form-control" id="fieldAuditSafeCurrencyNotes" />
                        </div>
                        <div class="form-group col-md-12">
                            <label for="fieldAuditSafeTotalAmount">Total Amount</label>
                            <input type="text" class="form-control" id="fieldAuditSafeTotalAmount" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="fieldAuditCashCountDifference">Difference</label>
                        <input type="text" class="form-control" id="fieldAuditCashCountDifference" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="addCashCountReplicaBtn" class="btn btn-danger">Add New</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/fieldAudit/cashCountReplica.js?v=3"></script>
