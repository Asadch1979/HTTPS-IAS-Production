@model AIS.Models.FieldAuditWorkflow.FieldAuditJoinReplicaViewModel
@{
    var join = Model.JoiningDetails ?? new AIS.Models.JoiningModel();
    var startDate = join.START_DATE.HasValue ? join.START_DATE.Value.ToString("dd/MM/yyyy") : "-";
    var endDate = join.END_DATE.HasValue ? join.END_DATE.Value.ToString("dd/MM/yyyy") : "-";
    var completionIso = Model.CompletionDate.ToString("yyyy-MM-dd");
}

<style>
    #fieldAuditJoinReplica .join-card {
        border: 1px solid #e9edf3;
        border-radius: 12px;
        background: #fff;
        padding: 1rem 1.25rem;
        box-shadow: 0 2px 8px rgba(17, 24, 39, 0.05);
    }

    #fieldAuditJoinReplica .join-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.85rem;
    }

    #fieldAuditJoinReplica .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem 1rem;
    }

    #fieldAuditJoinReplica .summary-item {
        border: 1px solid #f1f5f9;
        border-radius: 8px;
        padding: .6rem .75rem;
        background: #fcfdff;
    }

    #fieldAuditJoinReplica .summary-item--full {
        grid-column: 1 / -1;
    }

    #fieldAuditJoinReplica .summary-label {
        display: block;
        font-size: .76rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .02em;
        color: #64748b;
        margin-bottom: .2rem;
    }

    #fieldAuditJoinReplica .summary-value {
        font-size: .95rem;
        color: #1f2937;
        font-weight: 500;
    }

    #fieldAuditJoinReplica .join-confirmation {
        margin-top: .9rem;
        padding: .75rem .9rem;
        border-radius: 8px;
        background: #fff6db;
        border: 1px solid #fde68a;
        color: #92400e;
    }

    #fieldAuditJoinReplica .join-actions {
        margin-top: .9rem;
    }

    @@media (max-width: 767px) {
        #fieldAuditJoinReplica .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div id="fieldAuditJoinReplica"
     data-eng-id="@Model.EngagementId"
     data-completion-date="@completionIso"
     data-is-submitted="@(Model.IsSubmitted ? "true" : "false")">
    <div class="join-card mt-2">
        <h4 class="join-title">Joining Report</h4>

        <div class="summary-grid">
            <div class="summary-item summary-item--full">
                <span class="summary-label">Entity</span>
                <span class="summary-value">@(string.IsNullOrWhiteSpace(join.ENTITY_NAME) ? "-" : join.ENTITY_NAME)</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Start Date</span>
                <span class="summary-value">@startDate</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">End Date</span>
                <span class="summary-value">@endDate</span>
            </div>
        </div>

        <div class="join-confirmation">
            Mr. @Model.CurrentMemberName would you like to submit joining as @Model.MemberRoleLabel in @Model.EntityDisplayName on Date @Model.SystemDateDisplay.
        </div>

        <div id="joinReplicaStatus" class="mt-3"></div>

        <div class="join-actions">
            <button id="joinReplicaSubmitBtn" class="btn btn-primary btn-sm" @(Model.IsSubmitted ? "disabled" : string.Empty)>Submit</button>
            @if (Model.IsSubmitted)
            {
                <span class="ms-2 text-success">Joining already submitted for this engagement.</span>
            }
        </div>
    </div>
</div>

<script src="~/js/fieldAudit/joinReplica.js?v=2"></script>
