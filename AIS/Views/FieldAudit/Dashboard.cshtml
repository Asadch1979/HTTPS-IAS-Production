@model AIS.Models.FieldAuditWorkflow.FieldAuditWorkflowViewModel
@{
    ViewData["Title"] = "Field Audit Dashboard";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<link rel="stylesheet" href="~/css/classic-wizard-navigation.css" />

<div class="classic-wizard-nav-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm classic-wizard-card mb-0">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-6 col-lg-5">
                    <label for="engagementSelector" class="form-label fw-semibold mb-1">Engagement</label>
                    <select id="engagementSelector" class="form-select" data-dashboard-base-url="@Url.Action("Dashboard", "FieldAudit")">
                        <option value="">-- Select Engagement --</option>
                        @foreach (var engagement in Model.AvailableEngagements)
                        {
                            @if (Model.SelectedEngagementId == engagement.EngagementId)
                            {
                                <option value="@engagement.EngagementId" selected>@engagement.Label</option>
                            }
                            else
                            {
                                <option value="@engagement.EngagementId">@engagement.Label</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Engagement list uses the same task assignment source as the Engagement task list.</small>
                </div>
                <div class="col-md-6 col-lg-7 text-md-end">
                    <strong class="classic-wizard-step-counter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                    <div class="text-muted small">Click any step to navigate</div>
                </div>
            </div>

            @if (!Model.HasEngagementSelection)
            {
                <div class="alert alert-warning mb-3">Please select an engagement to begin the Field Audit workflow.</div>
            }

            @if (!visibleSteps.Any())
            {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any Field Audit workflow stages.</div>
            }
            else
            {
                <div class="classic-wizard-stepper classic-wizard-stepper--field-audit mt-2">
                    @foreach (var step in visibleSteps)
                    {
                        var isActive = currentStep != null && step.StepCode == currentStep.StepCode;
                        var stepCss = isActive ? "classic-wizard-step active" : "classic-wizard-step";
                        if (step.IsCompleted)
                        {
                            stepCss += " completed";
                        }
                        if (!step.IsSaved)
                        {
                            stepCss += " not-saved";
                        }
                        if (!Model.HasEngagementSelection)
                        {
                            stepCss += " disabled";
                        }
                        var statusBadgeCss = step.IsSaved ? "bg-success" : "bg-secondary";
                        var href = Model.HasEngagementSelection
                            ? Url.Action("Dashboard", "FieldAudit", new { stepCode = step.StepCode, engId = Model.SelectedEngagementId })
                            : "javascript:void(0);";

                        <a class="@stepCss" href="@href">
                            <div class="classic-wizard-step-title"><span class="classic-wizard-step-no">@(step.StepNo).</span> @(step.StepTitle)</div>
                            <span class="classic-wizard-step-state ms-2 badge @statusBadgeCss">@(step.StatusText)</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" id="fieldAuditStepHost" data-load-url="@Url.Action("LoadStep", "FieldAudit")" data-step-code="@Model.CurrentStepCode" data-eng-id="@Model.SelectedEngagementId">
        @if (!Model.HasEngagementSelection)
        {
            <div class="alert alert-info mb-0">Select an engagement from the dropdown above to load workflow content.</div>
        }
        else if (currentStep != null)
        {
            @await Html.PartialAsync(currentStep.PartialViewName, Model.CurrentStepContext)
        }
    </div>
</div>

<script src="~/js/fieldAudit/dashboard.js"></script>


