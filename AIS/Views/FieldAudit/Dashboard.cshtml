@model AIS.Models.FieldAuditWorkflow.FieldAuditWorkflowViewModel
@{
    ViewData["Title"] = "Field Audit Dashboard";
    Layout = "_Layout";
    var visibleSteps = Model.VisibleSteps.ToList();
    var currentStep = Model.CurrentStep;
    var currentStepIndex = currentStep == null ? 0 : visibleSteps.FindIndex(s => s.StepCode == currentStep.StepCode) + 1;
}

<form id="fieldAuditCsrfForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="stepper-wrap sticky-top bg-white py-2 mb-3">
    <div class="card shadow-sm planning-nav-card mb-0">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-lg-7">
                    <div class="row g-2 align-items-center">
                        <div class="col-sm-auto">
                            <label for="engagementSelector" class="form-label fw-semibold mb-0">Engagement</label>
                        </div>
                        <div class="col-sm">
                            <select id="engagementSelector" class="form-select" data-dashboard-base-url="@Url.Action("Dashboard", "FieldAudit")">
                        <option value="">-- Select Engagement --</option>
                        @foreach (var engagement in Model.AvailableEngagements)
                        {
                            @if (Model.SelectedEngagementId == engagement.EngagementId)
                            {
                                <option value="@engagement.EngagementId" selected>@engagement.Label</option>
                            }
                            else
                            {
                                <option value="@engagement.EngagementId">@engagement.Label</option>
                            }
                        }
                            </select>
                        </div>
                    </div>
                    <small class="text-muted">Engagement list uses the same task assignment source as the Engagement task list.</small>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <strong id="stepCounter">Step @(currentStepIndex > 0 ? currentStepIndex : 1) of @visibleSteps.Count</strong>
                    <span class="text-muted small">Click any step to navigate</span>
                </div>
            </div>

            <div id="engagementRequiredAlert" class="alert alert-warning mb-3 @(Model.HasEngagementSelection ? "d-none" : string.Empty)">Please select an engagement to begin the Field Audit workflow.</div>

            @if (!visibleSteps.Any())
            {
                <div class="alert alert-warning mt-2 mb-0">You do not currently have access to any Field Audit workflow stages.</div>
            }
            else
            {
                <div id="wizardStepper" class="wizard-stepper mt-2">
                    @foreach (var step in visibleSteps)
                    {
                        var isActive = currentStep != null && step.StepCode == currentStep.StepCode;
                        var stepCss = isActive ? "step-pill active" : "step-pill";
                        if (step.IsCompleted)
                        {
                            stepCss += " completed";
                        }
                        if (!step.IsSaved)
                        {
                            stepCss += " not-saved";
                        }
                        if (!Model.HasEngagementSelection)
                        {
                            stepCss += " disabled";
                        }
                        <a class="@stepCss"
                           href="javascript:void(0);"
                           data-step-code="@step.StepCode"
                           data-step-no="@step.StepNo"
                           data-step-title="@step.StepTitle">
                            <div class="step-title"><span class="num">@(step.StepNo).</span> @(step.StepTitle)</div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body field-audit-compact"
         data-mark-complete-url="@Url.Action("MarkStepCompleted", "FieldAudit")"
         data-open-audit-report-url="@Url.Action("OpenAuditReport", "FieldAudit")">
        <div id="fieldAuditStepHost"
             data-load-url="@Url.Action("LoadStep", "FieldAudit")"
             data-step-code="@Model.CurrentStepCode"
             data-eng-id="@Model.SelectedEngagementId">
            @if (!Model.HasEngagementSelection)
            {
                <div class="alert alert-info mb-0">Select an engagement from the dropdown above to load workflow content.</div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">Loading workflow content...</div>
            }
        </div>
        <div class="field-audit-step-footer border-top mt-3 pt-3 d-flex justify-content-end">
            <button type="button" id="fieldAuditMarkCompletedBtn" class="btn btn-outline-success">Mark as Saved</button>
        </div>
    </div>
</div>

<script src="~/js/fieldAudit/dashboard.js?v=4"></script>

<style>
    .stepper-wrap { z-index: 1020; }
    .planning-nav-card { border: 1px solid #ced4da; }
    .wizard-stepper {
        display: grid;
        grid-template-columns: repeat(8, minmax(150px, 1fr));
        gap: .4rem;
        overflow: auto;
    }
    .step-pill {
        border: 1px solid #ced4da;
        background: #fff;
        border-radius: .5rem;
        padding: .45rem .65rem;
        text-align: left;
        text-decoration: none;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease, transform .15s ease;
    }
    .step-pill:hover { color: #212529; }
    .step-pill.active { transform: translateY(-1px); }

    .step-pill.completed {
        background: #ecf9f0;
        border-color: #77c59a;
        color: #125132;
    }
    .step-pill.completed:hover { background: #dff3e8; border-color: #57b684; }
    .step-pill.completed.active {
        background: #198754;
        border-color: #157347;
        color: #ffffff;
        box-shadow: 0 0 0 2px rgba(25, 135, 84, .22);
        font-weight: 600;
    }

    .step-pill.not-saved {
        background: #fff2f3;
        border-color: #efb7bd;
        color: #7b1f29;
    }
    .step-pill.not-saved:hover { background: #ffe4e7; border-color: #e68e98; }
    .step-pill.not-saved.active {
        background: #dc3545;
        border-color: #b02a37;
        color: #ffffff;
        box-shadow: 0 0 0 2px rgba(220, 53, 69, .2);
        font-weight: 600;
    }

    .step-pill:not(.completed):not(.not-saved) {
        background: #f8f9fa;
        border-color: #ced4da;
    }
    .step-pill:not(.completed):not(.not-saved).active {
        border-color: #495057;
        box-shadow: 0 0 0 2px rgba(73, 80, 87, .15);
        font-weight: 600;
    }

    .step-pill.disabled { pointer-events: none; opacity: .6; }
    .step-pill .num { font-weight: 700; margin-right: .35rem; }
    .step-title { font-size: .88rem; width: 100%; line-height: 1.25; }
    .snap-label { color: #6c757d; }
    .snap-value { font-weight: 600; }
    .help-text { font-size: .8rem; color: #6c757d; }
    .validation-summary { font-size: .9rem; }

    .field-audit-compact {
        padding: .9rem;
    }
    .field-audit-compact #fieldAuditStepHost > *:first-child {
        margin-top: 0 !important;
    }
    .field-audit-compact #fieldAuditStepHost h3:not(.modal-title),
    .field-audit-compact #fieldAuditStepHost h4:not(.modal-title),
    .field-audit-compact #fieldAuditStepHost h5:not(.modal-title),
    .field-audit-compact #fieldAuditStepHost .card-header h4,
    .field-audit-compact #fieldAuditStepHost .card-header h5 {
        font-size: 1.05rem;
        font-weight: 500;
        margin-top: 0 !important;
        margin-bottom: .45rem !important;
        line-height: 1.3;
    }
    .field-audit-compact #fieldAuditStepHost .card,
    .field-audit-compact #fieldAuditStepHost .card-sample {
        box-shadow: none !important;
    }
    .field-audit-compact #fieldAuditStepHost .card-header {
        padding: .55rem .8rem;
    }
    .field-audit-compact #fieldAuditStepHost .card-body {
        padding: .75rem .8rem;
    }
    .field-audit-compact #fieldAuditStepHost .row.mt-3,
    .field-audit-compact #fieldAuditStepHost .col-md-12.mt-3,
    .field-audit-compact #fieldAuditStepHost .mt-3 {
        margin-top: .7rem !important;
    }
    .field-audit-compact #fieldAuditStepHost .mb-3,
    .field-audit-compact #fieldAuditStepHost .mb-2 {
        margin-bottom: .6rem !important;
    }
    .field-audit-compact #fieldAuditStepHost .dataTables_filter,
    .field-audit-compact #fieldAuditStepHost .dataTables_length {
        display: none !important;
    }
</style>
