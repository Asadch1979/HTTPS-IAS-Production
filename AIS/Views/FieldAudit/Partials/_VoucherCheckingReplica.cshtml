@model AIS.Models.FieldAuditWorkflow.FieldAuditGridReplicaViewModel
<div id="fieldAuditVoucherReplica" data-eng-id="@Model.EngagementId">
    <div class="d-flex justify-content-between align-items-center mb-2 mt-2"><h5 class="mb-0">Working Paper - Voucher Checking</h5><button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadStepContent('WORKING_PAPER', 4)">Back to Working Paper</button></div>
    <table id="fieldAuditVoucherTable" class="table table-hover table-bordered table-striped"><thead><tr><th>Sr No</th><th>Voucher /Account No</th><th>Discrepency/Observation</th><th>Memo/Para No</th></tr></thead><tbody></tbody></table>
    <div class="mt-3 d-flex justify-content-end gap-2"><button class="btn btn-success" type="button" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_ACCOUNT_OPENING')">Account Opening Form</button></div>
</div>
<script src="~/js/fieldAudit/voucherReplica.js?v=1"></script>
