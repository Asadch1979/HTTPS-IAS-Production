@model AIS.Models.FieldAuditWorkflow.FieldAuditGridReplicaViewModel
<div id="fieldAuditAccountOpeningReplica" data-eng-id="@Model.EngagementId">
    <div class="d-flex justify-content-between align-items-center mb-2 mt-2"><h5 class="mb-0">Working Paper - Account Opening</h5><button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_VOUCHER')">Back</button></div>
    <table id="fieldAuditAccountOpeningTable" class="table table-hover table-bordered table-striped"><thead><tr><th>Sr No</th><th>Voucher No</th><th>Nature</th><th>Observation</th><th>Memo/Para No</th></tr></thead><tbody></tbody></table>
    <div class="mt-3 d-flex justify-content-end gap-2"><button class="btn btn-success" type="button" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('WP_FIXED_ASSETS')">Fixed Assets</button></div>
</div>
<script src="~/js/fieldAudit/accountOpeningReplica.js?v=1"></script>
