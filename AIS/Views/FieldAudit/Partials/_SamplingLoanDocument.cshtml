@model AIS.Models.FieldAuditWorkflow.FieldAuditGridReplicaViewModel
<div id="fieldAuditSamplingLoanDocument" data-eng-id="@Model.EngagementId" data-disb-id="@(ViewData["DisbId"] ?? 0)" data-sample-id="@(ViewData["SampleId"] ?? 0)" data-loan-status="@(ViewData["LoanStatus"] ?? 0)" data-sample-type="@(ViewData["SampleType"] ?? string.Empty)">
    <div class="d-flex justify-content-between align-items-center mb-2 mt-2">
        <h5 class="mb-0">Loan Documents List <span class="text-danger fw-bold" id="fieldAuditLoanDocSampleType"></span></h5>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.fieldAuditDashboard && window.fieldAuditDashboard.loadNestedView('SAMPLING_LOANS',{ sampleId: '@(ViewData["SampleId"] ?? 0)', loanStatus: '@(ViewData["LoanStatus"] ?? 0)', sampleType: '@(ViewData["SampleType"] ?? string.Empty)' })">Back</button>
    </div>
    <link rel="stylesheet" href="~/css/sampling.css" />
    <div class="table-responsive">
        <table id="fieldAuditLoanDocumentList" class="table table-hover table-bordered table-striped">
            <thead><tr><th>Sr No</th><th>Branch Code</th><th>Loan Case</th><th>Customer Name</th><th>Document Name</th><th>Action</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<script src="~/js/fieldAudit/samplingLoanDocumentReplica.js?v=1"></script>
