<div class="commercial-audit-step" data-step="om-register">
    <div class="card commercial-audit-card shadow-sm">
        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="mb-1">OM Register</h4>
                <small class="text-muted">Review every saved OM and jump back into the entry step for updates.</small>
            </div>
            <button type="button"
               class="btn btn-outline-success commercial-audit-step-target"
               data-step="om-entry"
               data-step-key="om-entry">
                Create or Edit OM
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblCommercialOm" class="table table-bordered table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Audit Year</th>
                            <th>OM No</th>
                            <th>Gist</th>
                            <th>Management Response</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
