@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/commercial-audit.css" />

<div class="container-fluid mt-4 commercial-audit-page" data-stage="om">
    <partial name="_CommercialAuditNav" />

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="card commercial-audit-card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-1" id="omFormTitle">Create OM</h4>
                    <small class="text-muted">Stage 1 captures Office Memorandums with their core response context.</small>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="omAuditYear" class="form-label">Audit Year</label>
                        <select id="omAuditYear" class="form-select">
                            <option value="">-- Select Audit Year --</option>
                            @{
                                if (ViewData["AuditYearList"] != null)
                                {
                                    foreach (var year in (dynamic)ViewData["AuditYearList"])
                                    {
                                        <option value="@year.AUDITPERIODID">@year.DESCRIPTION</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="omNo" class="form-label">OM No</label>
                        <input id="omNo" type="text" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="omGist" class="form-label">Gist of OM</label>
                        <textarea id="omGist" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="omBody" class="form-label">Body of OM</label>
                        <textarea id="omBody" class="form-control" rows="6" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="omManagementResponse" class="form-label">Management Response</label>
                        <textarea id="omManagementResponse" class="form-control" rows="4" maxlength="4000"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btnSaveOm" type="button" class="btn btn-success">Save OM</button>
                        <button id="btnCancelOmEdit" type="button" class="btn btn-secondary d-none">Cancel Edit</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card commercial-audit-card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-1">OM Register</h4>
                    <small class="text-muted">Review the stage list and load any record back into the form for update.</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tblCommercialOm" class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Audit Year</th>
                                    <th>OM No</th>
                                    <th>Gist</th>
                                    <th>Management Response</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/csp/Views_CAU_commercial_audit.js?v=1"></script>
