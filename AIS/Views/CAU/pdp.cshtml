@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/commercial-audit.css" />

<div class="container-fluid mt-4 commercial-audit-page" data-stage="pdp">
    <partial name="_CommercialAuditNav" />

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="card commercial-audit-card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-1" id="pdpFormTitle">Create PDP</h4>
                    <small class="text-muted">Stage 2 supports a single PDP linked with multiple OMs.</small>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="pdpAuditYear" class="form-label">Audit Year</label>
                        <select id="pdpAuditYear" class="form-select">
                            <option value="">-- Select Audit Year --</option>
                            @{
                                if (ViewData["AuditYearList"] != null)
                                {
                                    foreach (var year in (dynamic)ViewData["AuditYearList"])
                                    {
                                        <option value="@year.AUDITPERIODID">@year.DESCRIPTION</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="pdpNo" class="form-label">PDP No</label>
                        <input id="pdpNo" type="text" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="pdpGist" class="form-label">Gist of PDP</label>
                        <textarea id="pdpGist" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="pdpBody" class="form-label">Body of PDP</label>
                        <textarea id="pdpBody" class="form-control" rows="5" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="pdpManagementResponse" class="form-label">Management Response</label>
                        <textarea id="pdpManagementResponse" class="form-control" rows="4" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="pdpDacRecommendations" class="form-label">DAC Recommendations</label>
                        <textarea id="pdpDacRecommendations" class="form-control" rows="4" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="pdpUpdatedStatus" class="form-label">Updated Status</label>
                        <input id="pdpUpdatedStatus" type="text" class="form-control" maxlength="200" />
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btnSavePdp" type="button" class="btn btn-success">Save PDP</button>
                        <button id="btnCancelPdpEdit" type="button" class="btn btn-secondary d-none">Cancel Edit</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card commercial-audit-card shadow-sm mb-4">
                <div class="card-header">
                    <h4 class="mb-1">Link OMs</h4>
                    <small id="pdpMappingHint" class="text-muted">Save or select a PDP first, then choose one or more OMs to link.</small>
                </div>
                <div class="card-body">
                    <fieldset id="pdpOmMappingFieldset" disabled>
                        <div class="table-responsive commercial-audit-scroll">
                            <table id="tblPdpOmLookup" class="table table-sm table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th class="text-center">Link</th>
                                        <th>Audit Year</th>
                                        <th>OM No</th>
                                        <th>Gist</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button id="btnSavePdpMappings" type="button" class="btn btn-outline-success">Save Linked OMs</button>
                            <span id="pdpSelectedSummary" class="small text-muted align-self-center">No OMs selected</span>
                        </div>
                    </fieldset>
                </div>
            </div>

            <div class="card commercial-audit-card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-1">PDP Register</h4>
                    <small class="text-muted">Load an existing PDP and its linked OMs from the same workflow screen.</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tblCommercialPdp" class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Audit Year</th>
                                    <th>PDP No</th>
                                    <th>Gist</th>
                                    <th>Updated Status</th>
                                    <th>Linked OMs</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/csp/Views_CAU_commercial_audit.js?v=1"></script>
