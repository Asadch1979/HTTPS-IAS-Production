@{
    var omAuditYears = ViewData["OmAuditYearList"] ?? ViewData["AuditYearList"];
    var workflowHostPath = ViewData["CommercialAuditHostPath"] as string ?? Url.Action("workflow", "CAU");
}

<div class="commercial-audit-step" data-step="om-entry">
    <div class="card commercial-audit-card shadow-sm">
        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="mb-1" id="omFormTitle">Create OM</h4>
                <small class="text-muted">Maintain the OM narrative in a focused editor before moving to the register.</small>
            </div>
            <a href="@(workflowHostPath + "?stepKey=om-register")"
               class="btn btn-outline-success commercial-audit-step-target"
               data-step-key="om-register">
                Open OM Register
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4">
                    <label for="omAuditYear" class="form-label">Audit Year</label>
                    <select id="omAuditYear" class="form-select">
                        <option value="">-- Select Audit Year --</option>
                        @{
                            if (omAuditYears != null)
                            {
                                foreach (var year in (dynamic)omAuditYears)
                                {
                                    <option value="@year.AUDITPERIODID">@year.DESCRIPTION</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-4">
                    <label for="omNo" class="form-label">OM No</label>
                    <input id="omNo" type="text" class="form-control" maxlength="100" />
                </div>
                <div class="col-12">
                    <label for="omGist" class="form-label">Gist of OM</label>
                    <textarea id="omGist" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <label for="omBody" class="form-label">Body of OM</label>
                    <textarea id="omBody" class="form-control commercial-audit-richtext-target" rows="12" maxlength="4000"></textarea>
                </div>
                <div class="col-12">
                    <label for="omManagementResponse" class="form-label">Management Response</label>
                    <textarea id="omManagementResponse" class="form-control commercial-audit-richtext-target" rows="10" maxlength="4000"></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-4">
                <button id="btnSaveOm" type="button" class="btn btn-success">Save OM</button>
                <button id="btnCancelOmEdit" type="button" class="btn btn-secondary d-none">Cancel Edit</button>
            </div>
        </div>
    </div>
</div>
