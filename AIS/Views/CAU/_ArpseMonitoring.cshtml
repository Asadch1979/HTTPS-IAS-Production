@{
    var workflowHostPath = ViewData["CommercialAuditHostPath"] as string ?? Url.Action("workflow", "CAU");
}

<div class="commercial-audit-step" data-step="arpse-monitoring">
    <div class="card commercial-audit-card shadow-sm">
        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="mb-1">ARPSE Monitoring</h4>
                <small class="text-muted">Select a header, then manage DAC and PAC follow-up in compact workflow panels.</small>
            </div>
            <a href="@(workflowHostPath + "?stepKey=arpse-header")"
               class="btn btn-outline-success commercial-audit-step-target"
               data-step-key="arpse-header">
                Edit ARPSE Header
            </a>
        </div>
        <div class="card-body">
            <div class="commercial-audit-section">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">ARPSE Register</h5>
                        <p class="text-muted mb-0">Select a header to load its DAC and PAC follow-up history below.</p>
                    </div>
                    <span id="arpseSelectedHeaderLabel" class="commercial-audit-selection-pill">No ARPSE header selected</span>
                </div>
                <div class="table-responsive">
                    <table id="tblCommercialArpse" class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ARPSE Year</th>
                                <th>Para No</th>
                                <th>Gist</th>
                                <th>Management Response</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <fieldset id="arpseChildrenFieldset" disabled>
                <div class="commercial-audit-section mt-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                        <div>
                            <h5 class="mb-1" id="arpseDacTitle">DAC Entries</h5>
                            <p class="text-muted mb-0">Track DAC recommendations for the selected ARPSE header.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="arpseDacRecommendation" class="form-label">DAC Recommendation</label>
                            <textarea id="arpseDacRecommendation" class="form-control commercial-audit-richtext-target" rows="10" maxlength="4000"></textarea>
                        </div>
                        <div class="col-lg-4">
                            <label for="arpseDacDate" class="form-label">DAC Date</label>
                            <input id="arpseDacDate" type="date" class="form-control" />
                        </div>
                        <div class="col-lg-8">
                            <label for="arpseDacUpdatedStatus" class="form-label">Updated Status</label>
                            <input id="arpseDacUpdatedStatus" type="text" class="form-control" maxlength="200" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button id="btnSaveArpseDac" type="button" class="btn btn-success">Add DAC</button>
                        <button id="btnCancelArpseDacEdit" type="button" class="btn btn-secondary d-none">Cancel Edit</button>
                    </div>
                    <div class="table-responsive mt-4">
                        <table id="tblArpseDac" class="table table-sm table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Recommendation</th>
                                    <th>Date</th>
                                    <th>Updated Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="commercial-audit-section mt-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                        <div>
                            <h5 class="mb-1" id="arpsePacTitle">PAC Entries</h5>
                            <p class="text-muted mb-0">Track PAC directives for the selected ARPSE header.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="arpsePacDirective" class="form-label">PAC Directive</label>
                            <textarea id="arpsePacDirective" class="form-control commercial-audit-richtext-target" rows="10" maxlength="4000"></textarea>
                        </div>
                        <div class="col-lg-4">
                            <label for="arpsePacDate" class="form-label">PAC Date</label>
                            <input id="arpsePacDate" type="date" class="form-control" />
                        </div>
                        <div class="col-lg-8">
                            <label for="arpsePacUpdatedStatus" class="form-label">Updated Status</label>
                            <input id="arpsePacUpdatedStatus" type="text" class="form-control" maxlength="200" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button id="btnSaveArpsePac" type="button" class="btn btn-success">Add PAC</button>
                        <button id="btnCancelArpsePacEdit" type="button" class="btn btn-secondary d-none">Cancel Edit</button>
                    </div>
                    <div class="table-responsive mt-4">
                        <table id="tblArpsePac" class="table table-sm table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Directive</th>
                                    <th>Date</th>
                                    <th>Updated Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>
