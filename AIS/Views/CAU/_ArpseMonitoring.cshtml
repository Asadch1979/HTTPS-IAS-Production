<div class="commercial-audit-step" data-step="arpse-monitoring">
    <div class="card commercial-audit-card shadow-sm">
        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="mb-1">ARPSE Monitoring</h4>
                <small class="text-muted">Use Manage to continue to ARPSE Follow-up for the selected para.</small>
            </div>
            <button type="button"
               class="btn btn-outline-success commercial-audit-step-target"
               data-step="arpse-header"
               data-step-key="arpse-header">
                Edit ARPSE Header
            </button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-lg-4">
                    <label for="arpseMonitoringYear" class="form-label">Year <span class="text-danger">*</span></label>
                    <select id="arpseMonitoringYear" class="form-select" required>
                        <option value="">-- Select Year --</option>
                        @{ var isFirstArpseMonitoringYear = true; }
                        @foreach (var year in ((ViewData["CommercialAuditLinkingYearList"] as IEnumerable<AIS.Models.CAU.ARPSEYearDropdownVM>) ?? Enumerable.Empty<AIS.Models.CAU.ARPSEYearDropdownVM>()).OrderByDescending(item => item.ARPSEYear))
                        {
                            <option value="@year.ARPSEYear" selected="@(isFirstArpseMonitoringYear ? "selected" : null)">@(string.IsNullOrWhiteSpace(year.DisplayText) ? year.ARPSEYear.ToString() : year.DisplayText)</option>
                            isFirstArpseMonitoringYear = false;
                        }
                    </select>
                </div>
            </div>
            <div class="commercial-audit-section">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">ARPSE Register</h5>
                        <p class="text-muted mb-0">Use Manage against any ARPSE para to continue to step 8 for DAC and PAC follow-up.</p>
                    </div>
                    <span id="arpseSelectedHeaderLabel" class="commercial-audit-selection-pill">No ARPSE header selected</span>
                </div>
                <div class="table-responsive">
                    <table id="tblCommercialArpse" class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ARPSE Year</th>
                                <th>Para No</th>
                                <th>Gist</th>
                                <th>Management Response</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
