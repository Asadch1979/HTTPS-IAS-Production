@model AIS.Models.CAU.CommercialAuditWorkflowViewModel
@using AIS.Models
@using System.Linq
@{
    Layout = "_Layout";
    ViewData["CommercialAuditWorkflowModel"] = Model;
    var auditYearList = (ViewData["AuditYearList"] as IEnumerable<AuditPeriodModel>) ?? Enumerable.Empty<AuditPeriodModel>();
    var omAuditYearList = (ViewData["OmAuditYearList"] as IEnumerable<AuditPeriodModel>) ?? auditYearList;
    var arpseYearList = (ViewData["ArpseYearList"] as IEnumerable<AuditPeriodModel>) ?? Enumerable.Empty<AuditPeriodModel>();
    var commercialAuditYearLookups = new
    {
        om = omAuditYearList.Select(item => new { id = item.AUDITPERIODID, text = item.DESCRIPTION }).ToList(),
        pdp = auditYearList.Select(item => new { id = item.AUDITPERIODID, text = item.DESCRIPTION }).ToList(),
        arpse = arpseYearList.Select(item => new { id = item.AUDITPERIODID, text = item.DESCRIPTION }).ToList()
    };
}

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css" />
<link rel="stylesheet" href="~/css/commercial-audit.css" />

<div class="container-fluid mt-4 commercial-audit-page commercial-audit-workflow"
     data-current-step="@Model?.CurrentStepKey"
     data-load-url="@Url.Action("LoadStepPartial", "CAU")">
    <partial name="_CommercialAuditNav" />

    <div class="card shadow-sm commercial-audit-shell-card">
        <div class="card-body commercial-audit-shell-body">
            <div id="commercialAuditStepMessage" class="alert d-none"></div>

            <div id="commercialAuditStepHost" class="commercial-audit-step-host">
                <div class="alert alert-secondary mb-0">Loading workflow content...</div>
            </div>
        </div>
    </div>
</div>

<script>
    window.commercialAuditWorkflowSteps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model?.Steps ?? new System.Collections.Generic.List<AIS.Models.CAU.CommercialAuditWorkflowStep>())
            .Select(step => new
            {
                stepKey = step.StepKey,
                stepNo = step.StepNo,
                stageKey = step.StageKey,
                title = step.Title,
                description = step.Description
            })));
    window.commercialAuditYearLookups = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(commercialAuditYearLookups));
</script>
<script src="~/js/csp/Views_CAU_commercial_audit.js?v=7"></script>
