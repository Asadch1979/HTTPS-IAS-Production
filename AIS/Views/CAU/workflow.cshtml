@using AIS.Models.CAU
@{
    Layout = "_Layout";
    var stages = ViewData["WorkflowStages"] as List<CommercialAuditWorkflowStage> ?? new List<CommercialAuditWorkflowStage>();
}

<link rel="stylesheet" href="~/css/commercial-audit.css" />

<div class="container-fluid mt-4 commercial-audit-page" data-stage="workflow">
    <partial name="_CommercialAuditNav" />

    <div class="row g-4">
        @foreach (var stage in stages.Where(item => item.Key != "workflow"))
        {
            var actionName = stage.Key == "om" ? "om_creation" : stage.Key == "pdp" ? "om_reply" : "monitoring_oms";
            <div class="col-lg-4">
                <div class="card commercial-audit-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="commercial-audit-badge mb-3">@stage.Title</div>
                        <h4 class="mb-2">@stage.Title</h4>
                        <p class="text-muted flex-grow-1">@stage.Description</p>
                        <a asp-controller="CAU" asp-action="@actionName" class="btn btn-success">Open @stage.Title</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
