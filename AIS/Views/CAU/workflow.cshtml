@model AIS.Models.CAU.CommercialAuditWorkflowViewModel
@using System.Linq
@{
    Layout = "_Layout";
    var currentStep = Model?.Steps?.FirstOrDefault(step => step.StepKey == Model.CurrentStepKey)
        ?? Model?.Steps?.FirstOrDefault();
    var workflowHostPath = ViewData["CommercialAuditHostPath"] as string ?? Context?.Request?.Path.Value ?? Url.Action("workflow", "CAU");
    ViewData["CommercialAuditWorkflowModel"] = Model;
}

<link rel="stylesheet" href="~/css/fieldaudit-stepper-theme.css" />
<link rel="stylesheet" href="~/css/commercial-audit.css" />

<div class="container-fluid mt-4 commercial-audit-page commercial-audit-workflow"
     data-current-step="@Model?.CurrentStepKey"
     data-load-url="@Url.Action("LoadStep", "CAU")"
     data-workflow-url="@workflowHostPath">
    <partial name="_CommercialAuditNav" />

    <div class="card shadow-sm commercial-audit-shell-card">
        <div class="card-body commercial-audit-shell-body">
            <div id="commercialAuditStepMessage" class="alert d-none"></div>

            <div id="commercialAuditStepHost" class="commercial-audit-step-host">
                @if (currentStep != null)
                {
                    @await Html.PartialAsync(currentStep.PartialViewName)
                }
                else
                {
                    <div class="alert alert-warning mb-0">No Commercial Audit steps are available.</div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    window.commercialAuditWorkflowSteps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model?.Steps ?? new System.Collections.Generic.List<AIS.Models.CAU.CommercialAuditWorkflowStep>())
            .Select(step => new
            {
                stepKey = step.StepKey,
                stepNo = step.StepNo,
                stageKey = step.StageKey,
                title = step.Title,
                description = step.Description
            })));
</script>
<script src="~/js/csp/Views_CAU_commercial_audit.js?v=3"></script>
