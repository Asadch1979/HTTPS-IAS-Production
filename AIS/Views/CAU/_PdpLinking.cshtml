<div class="commercial-audit-step" data-step="pdp-linking">
    <div class="card commercial-audit-card shadow-sm">
        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="mb-1">PDP Linking and Register</h4>
                <small class="text-muted">Choose a PDP from the register, then link one or more OMs in the same wide workspace.</small>
            </div>
            <button type="button"
               class="btn btn-outline-success commercial-audit-step-target"
               data-step="pdp-entry"
               data-step-key="pdp-entry">
                Edit PDP Header
            </button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-lg-4">
                    <label for="pdpLinkingYear" class="form-label">Year <span class="text-danger">*</span></label>
                    <select id="pdpLinkingYear" class="form-select" required>
                        <option value="">-- Select Year --</option>
                        @{ var isFirstPdpLinkingYear = true; }
                        @foreach (var year in ((ViewData["CommercialAuditLinkingYearList"] as IEnumerable<AIS.Models.CAU.ARPSEYearDropdownVM>) ?? Enumerable.Empty<AIS.Models.CAU.ARPSEYearDropdownVM>()).OrderByDescending(item => item.ARPSEYear))
                        {
                            <option value="@year.ARPSEYear" selected="@(isFirstPdpLinkingYear ? "selected" : null)">@(string.IsNullOrWhiteSpace(year.DisplayText) ? year.ARPSEYear.ToString() : year.DisplayText)</option>
                            isFirstPdpLinkingYear = false;
                        }
                    </select>
                </div>
                <div class="col-lg-8">
                    <label for="pdpLinkingSearch" class="form-label">Search</label>
                    <input id="pdpLinkingSearch" type="search" class="form-control" placeholder="Search PDP and OM records..." autocomplete="off" />
                </div>
            </div>
            <div class="commercial-audit-section">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">PDP Register</h5>
                        <p class="text-muted mb-0">Select a PDP to manage its linked OMs. Use the PDP Entry step to edit the narrative fields.</p>
                    </div>
                    <span id="pdpSelectedPdpLabel" class="commercial-audit-selection-pill">No PDP selected</span>
                </div>
                <div class="table-responsive">
                    <table id="tblCommercialPdp" class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Audit Year</th>
                                <th>PDP No</th>
                                <th>Gist</th>
                                <th>Update Management Response</th>
                                <th>Linked OMs</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="commercial-audit-section mt-4">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">Link OMs</h5>
                        <p id="pdpMappingHint" class="text-muted mb-0">Save or select a PDP first, then choose one or more OMs to link.</p>
                    </div>
                    <span id="pdpSelectedSummary" class="small text-muted">No OMs selected</span>
                </div>
                <fieldset id="pdpOmMappingFieldset" disabled>
                    <div class="table-responsive commercial-audit-scroll">
                        <table id="tblPdpOmLookup" class="table table-sm table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th class="text-center">Link</th>
                                    <th>Audit Year</th>
                                    <th>OM No</th>
                                    <th>Gist</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button id="btnSavePdpMappings" type="button" class="btn btn-outline-success">Save Linked OMs</button>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
</div>
