@{
    var page_id = ViewData["PageId"] as int? ?? 0;
    ViewData["Title"] = "Department-wise Observation Risk Summary";
    Layout = "_Layout";
}

<div class="row col-md-12">
    <div class="col-md-12">
        <h3 style="color: #be0e43;">Department-wise Observation Summary with Risk Status</h3>
        <p class="text-muted mb-3">
            Scope: @(ViewData["UserEntityName"] ?? string.Empty)
        </p>

        <ul class="nav nav-tabs" id="observationCycleTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active"
                   id="over-three-tab"
                   data-bs-toggle="tab"
                   href="#over-three-panel"
                   role="tab"
                   aria-controls="over-three-panel"
                   aria-selected="true">
                    Observations with COM_CYCLE &gt; 3
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link"
                   id="zero-cycle-tab"
                   data-bs-toggle="tab"
                   href="#zero-cycle-panel"
                   role="tab"
                   aria-controls="zero-cycle-panel"
                   aria-selected="false">
                    Observations with COM_CYCLE = 0
                </a>
            </li>
        </ul>

        <div class="tab-content pt-3" id="observationCycleTabContent">
            <div class="tab-pane fade show active"
                 id="over-three-panel"
                 role="tabpanel"
                 aria-labelledby="over-three-tab">
                <div class="table-responsive">
                    <table id="overThreeObservationTable" class="table table-hover table-bordered table-striped">
                        <thead style="background-color: #19875478 !important;">
                            <tr>
                                <th>Sr. No.</th>
                                <th>Department</th>
                                <th class="text-center">Total Observations</th>
                                <th class="text-center">High</th>
                                <th class="text-center">Medium</th>
                                <th class="text-center">Low</th>
                                <th class="text-center">Unrated</th>
                                <th class="text-center">Risk Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade"
                 id="zero-cycle-panel"
                 role="tabpanel"
                 aria-labelledby="zero-cycle-tab">
                <div class="table-responsive">
                    <table id="zeroCycleObservationTable" class="table table-hover table-bordered table-striped">
                        <thead style="background-color: #19875478 !important;">
                            <tr>
                                <th>Sr. No.</th>
                                <th>Department</th>
                                <th class="text-center">Total Observations</th>
                                <th class="text-center">High</th>
                                <th class="text-center">Medium</th>
                                <th class="text-center">Low</th>
                                <th class="text-center">Unrated</th>
                                <th class="text-center">Risk Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/csp/Views_Dashboard_head_observation_risk_summary.js?v=1"></script>
