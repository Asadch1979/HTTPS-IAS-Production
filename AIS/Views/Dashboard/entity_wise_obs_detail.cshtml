@{
    var page_id = ViewData["PageId"] as int? ?? 0;
}

@{
    ViewData["Title"] = "Functional Para View";
    Layout = "_Layout";
}


<div class="row col-md-12">
    <h3 style="color: #be0e43;">Entity / Field Functionaries Wise Observation Details</h3>
</div>



<style type="text/css">
    .para-detail-field {
        margin-top: 1rem;
    }

    .para-detail-label {
        font-weight: 600;
        margin-bottom: .35rem;
    }
</style>

<div class="row col-md-12">
    <div class="mt-3 col-md-12">
        <table id="entitywise_panel" class="table table-hover table-bordered table-hover mt-3 table-striped">
            <thead style="background-color: #19875478 !important; ">
                <tr>
                    <th class="col-md-auto text-light">Sr. No.</th>
                    <th class="col-md-auto text-light">Entity Name</th>
                    <th class="col-md-auto text-center text-light">Audit Period</th>
                    <th class="col-md-auto text-center text-light">Para No</th>
                    <th class="col-md-auto text-center text-light">Gist of ParaS</th>
                    <th class="col-md-auto text-center text-light">Risk</th>
                    <th class="col-md-auto text-center text-light"></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div id="paraTextViewerModel" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog  modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Para Text</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    
                </button>
            </div>
            <div class="mt-3 modal-body">
                <form>
                    <div class="row mt-3 col-md-12">
                        <div class="col-md-12">
                            <div class="para-detail-label">Para Text</div>
                            <div id="paraTextDivField" style="max-width:100%; overflow-y:auto;" class="form-control container-clob"></div>
                        </div>
                        <div class="col-md-12 para-detail-field">
                            <div class="para-detail-label">Auditee Response</div>
                            <div id="auditeeResponseDivField" class="form-control container-clob"></div>
                        </div>
                        <div class="col-md-12 para-detail-field">
                            <div class="para-detail-label">Audit Recommendation</div>
                            <div id="auditRecommendationDivField" class="form-control container-clob"></div>
                        </div>

                    </div>


                </form>
            </div>

            <div class="mt-3 modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_Dashboard_entity_wise_obs_detail.js?v=2"></script>
