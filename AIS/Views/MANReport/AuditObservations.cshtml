@model AIS.Models.ManagementReport.ManagementReportObservationsViewModel

@{
    ViewData["Title"] = "Audit Observations";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    string FormatText(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Audit Observations</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ManReportNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to view audit observations.</div>
    }

    @if (hasEngagement)
    {
        if (Model.Observations == null || !Model.Observations.Any())
        {
            <div class="alert alert-info">No observations available for this engagement.</div>
        }
        else
        {
            foreach (var observation in Model.Observations)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Para No:</strong> @FormatText(observation.ParaNo) - @FormatText(observation.Title)
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Para Text:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(observation.ParaText)</div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <strong>Risk Category:</strong> @FormatText(observation.RiskCategory)
                            </div>
                            <div class="col-md-4">
                                <strong>Status:</strong> @FormatText(observation.Status)
                            </div>
                        </div>
                        <div class="mt-3">
                            <strong>Recommendation:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(observation.Recommendation)</div>
                        </div>
                        <div class="mt-3">
                            <strong>Management Reply:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(observation.ManagementReply)</div>
                        </div>
                        <div class="mt-3">
                            <strong>Audit Reply:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(observation.AuditReply)</div>
                        </div>
                    </div>
                </div>
            }
        }

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("StaffSnapshot", "MANReport")">Back</a>
            <a class="btn btn-primary" href="@Url.Action("ParasSettledDuringAudit", "MANReport")">Next: Paras Settled</a>
        </div>
    }
</div>
