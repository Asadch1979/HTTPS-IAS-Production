@model AIS.Models.ManagementReport.ManagementReportSettledParasViewModel

@{
    ViewData["Title"] = "Paras Settled During Audit";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    string FormatText(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Paras Settled During Audit</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ManReportNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to view settled paras.</div>
    }

    @if (hasEngagement)
    {
        if (Model.Paras == null || !Model.Paras.Any())
        {
            <div class="alert alert-info">No settled paras available for this engagement.</div>
        }
        else
        {
            foreach (var para in Model.Paras)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>@FormatText(para.Title)</strong>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Para Text:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(para.ParaText)</div>
                        </div>
                        <div class="mt-3">
                            <strong>Management Reply:</strong>
                            <div class="border rounded p-2 bg-light">@FormatText(para.ManagementReply)</div>
                        </div>
                    </div>
                </div>
            }
        }

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("AuditObservations", "MANReport")">Back</a>
            <a class="btn btn-primary" href="@Url.Action("Finalize", "MANReport")">Next: Finalize</a>
        </div>
    }
</div>
