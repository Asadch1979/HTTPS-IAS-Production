@model AIS.Models.ManagementReport.ManagementReportObjectiveScopeViewModel

@{
    ViewData["Title"] = "Audit Objective & Scope";
    Layout = "_Layout";
    var engagementSelector = ViewData["EngagementSelector"] as AIS.Models.FieldAuditReport.FieldAuditEngagementSelectorViewModel;
    var hasEngagement = engagementSelector?.HasActiveEngagement ?? false;
    ViewData["IsReadOnly"] = Model?.IsReadOnly ?? false;
    string FieldValue(string code) => Model?.Fields != null && Model.Fields.TryGetValue(code, out var value) ? value : string.Empty;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Audit Objective &amp; Scope</h3>
        </div>
    </div>

    @await Html.PartialAsync("_GetEngagementSelector", engagementSelector)
    @await Html.PartialAsync("_ManReportNav")

    @if (!hasEngagement)
    {
        <div class="alert alert-warning">Select an engagement to capture audit objective &amp; scope.</div>
    }

    @if (TempData["ManReportMessage"] != null)
    {
        <div class="alert alert-info">@TempData["ManReportMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">This report is FINAL and cannot be edited.</div>
    }

    @if (hasEngagement)
    {
        <form method="post" asp-action="AuditObjectiveScope">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EngagementId" value="@Model.EngagementId" />
            <div class="card mb-4">
                <div class="card-header">Objective &amp; Scope Details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="objective">Objective</label>
                        <textarea class="form-control" id="objective" name="Fields[@AIS.Models.ManagementReport.ManagementReportSectionCodes.Objective]" rows="4" @(Model.IsReadOnly ? "disabled" : string.Empty)>@FieldValue(AIS.Models.ManagementReport.ManagementReportSectionCodes.Objective)</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="scope">Scope</label>
                        <textarea class="form-control" id="scope" name="Fields[@AIS.Models.ManagementReport.ManagementReportSectionCodes.Scope]" rows="4" @(Model.IsReadOnly ? "disabled" : string.Empty)>@FieldValue(AIS.Models.ManagementReport.ManagementReportSectionCodes.Scope)</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="methodology">Methodology</label>
                        <textarea class="form-control" id="methodology" name="Fields[@AIS.Models.ManagementReport.ManagementReportSectionCodes.Methodology]" rows="4" @(Model.IsReadOnly ? "disabled" : string.Empty)>@FieldValue(AIS.Models.ManagementReport.ManagementReportSectionCodes.Methodology)</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="disclaimer">Disclaimer</label>
                        <textarea class="form-control" id="disclaimer" name="Fields[@AIS.Models.ManagementReport.ManagementReportSectionCodes.Disclaimer]" rows="3" @(Model.IsReadOnly ? "disabled" : string.Empty)>@FieldValue(AIS.Models.ManagementReport.ManagementReportSectionCodes.Disclaimer)</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="introduction">Introduction</label>
                        <textarea class="form-control" id="introduction" name="Fields[@AIS.Models.ManagementReport.ManagementReportSectionCodes.Introduction]" rows="4" @(Model.IsReadOnly ? "disabled" : string.Empty)>@FieldValue(AIS.Models.ManagementReport.ManagementReportSectionCodes.Introduction)</textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("Cover", "MANReport")">Back</a>
                <button type="submit" class="btn btn-primary" name="submitAction" value="save" @(Model.IsReadOnly ? "disabled" : string.Empty)>Save Draft</button>
                <button type="submit" class="btn btn-outline-success" name="submitAction" value="complete" @(Model.IsReadOnly ? "disabled" : string.Empty)>Mark Section Complete</button>
                <button type="submit" class="btn btn-primary" name="submitAction" value="next" @(Model.IsReadOnly ? "disabled" : string.Empty)>Next: Executive Summary</button>
            </div>
        </form>
    }
</div>
