@model AIS.Models.ExecutiveDashboardPageModel
<section id="cco-organizations" data-enabled="false" aria-label="Auditee organizational reporting">
    <p class="exec-note">Organizational figures remain unavailable pending verified authorization, mapping and API grants.</p>
    <label for="cco-org-search">Search organization</label><input id="cco-org-search" type="search" />
    <button type="button" id="cco-expand-all" class="org-button">Expand All</button>
    <button type="button" id="cco-collapse-all" class="org-button">Collapse All</button>
    <p id="cco-org-status" role="status">Organizational data unavailable pending verification.</p>
    <div id="cco-org-results" class="exec-table-wrap" tabindex="0" role="region" aria-label="Organization Structure"></div>
</section>
