@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model AIS.Models.ExecutiveDashboardPageModel
@{
    var enabled = Model.SelectedView.Id == "performance" && Configuration.GetValue<bool>("CcoReporting:PerformanceEnabled");
}
<section id="cco-organizations" data-enabled="@(enabled ? "true" : "false")" data-url="@Url.Content("~/api/CcoCompliance/GetOrgPerformance")" aria-label="Group Head organizational analysis">
    @if (enabled)
    {
        <p class="exec-note">Historical positions use available IAS dates and current organizational mapping. Field Audit (B) expands from GM Office to reporting entities. Management Audit (D) shows departments under their division.</p>
        <div class="exec-filters">
            <div><label for="cco-org-search">Search organizations</label><input id="cco-org-search" type="search" /></div>
            <button class="org-button" id="cco-expand-all" type="button">Expand all</button>
            <button class="org-button" id="cco-collapse-all" type="button">Collapse all</button>
        </div>
    }
    <p id="cco-org-status" role="status">@(enabled ? "Loading authorized performance data…" : "Detailed organizational comparisons are not yet available.")</p>
    <div id="cco-org-results" class="exec-table-wrap exec-report-table-wrap" tabindex="0" role="region" aria-label="Group Head organizational analysis"></div>
</section>
