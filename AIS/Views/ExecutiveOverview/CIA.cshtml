@model AIS.Models.ExecutiveDashboardPageModel
@{
    ViewData["Title"] = "CIA Audit Command Center · Executive Dashboard";
    Layout = "_Layout";
    ViewData["HideTopHeader"] = true;
    var selectedPeriod = Model.CiaPeriods.FirstOrDefault(p => p.AUDITPERIODID == Model.SelectedCiaPeriodId);
}
<link rel="stylesheet" href="~/css/organization-structure.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-themes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-dashboard-parents.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cia-command-center.css" asp-append-version="true" />
    @if (Model.IsSuperUser)
    {
        <nav class="exec-super-switcher" aria-label="Super User executive dashboard perspectives">
            <span>Super User dashboards</span>
            <a href="@Url.Action("TOP", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "TOP" ? "page" : null)">Top Management</a>
            <a href="@Url.Action("CIA", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "CIA" && !Model.IsAuditParaSnap ? "page" : null)">CIA Command Center</a>
            <a href="@Url.Action("AuditParaSnap", "ExecutiveOverview")" aria-current="@(Model.IsAuditParaSnap ? "page" : null)">Audit Para Snap</a>
            <a href="@Url.Action("CCO", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "CCO" ? "page" : null)">Compliance</a>
            <a href="@Url.Action("GROUP", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "GROUP" ? "page" : null)">Group Management</a>
            <a href="@Url.Action("RLM", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "RLM" ? "page" : null)">Division / GM / Region</a>
        </nav>
    }
<section class="org exec exec-cia" id="executive-dashboard" data-perspective="CIA" data-view="command"
         data-api-url="@Url.Content("~/api/ExecutiveDashboard/")" data-dashboard-type="CIA" aria-label="CIA Audit Command Center">
    <header class="cia-executive-header">
        <div class="dashboard-title cia-executive-title">
            <p class="cia-command-eyebrow">INTERNAL AUDIT GROUP</p>
            <h1>CIA Audit Command Center</h1>
            <p>@Model.ScopeLabel</p>
            <nav aria-label="Audit dashboards">
                <a href="@Url.Action("AuditParaSnap","ExecutiveOverview")">Audit Para Snap →</a>
                @if (Model.CanViewOrganization) { <a href="@Url.Action("Index","OrganizationStructure")">Organization Structure</a> }
            </nav>
        </div>
        <div class="cia-period-selection">
            <label for="cia-period">IAS audit year / period</label>
            <select id="cia-period" aria-label="Select audit period" disabled="@(Model.CiaPeriods.Count == 0)">
                @if (!Model.SelectedCiaPeriodId.HasValue)
                {
                    <option value="" selected>Select an IAS audit period</option>
                }
                @foreach (var period in Model.CiaPeriods)
                {
                    <option value="@period.AUDITPERIODID" selected="@(period.AUDITPERIODID == Model.SelectedCiaPeriodId)">@period.DESCRIPTION (@period.START_DATE.ToString("dd MMM yyyy") – @period.END_DATE.ToString("dd MMM yyyy"))</option>
                }
            </select>
            <p data-cia-selected-period>@(selectedPeriod == null ? "No started period available; choose a period." : "Selected: " + selectedPeriod.DESCRIPTION)</p>
        </div>
    </header>
    <partial name="_CiaCommandFilters" model="Model" />
    <p id="exec-status" class="org-status" role="status" aria-live="polite">Loading CIA Command Center…</p>
    <div id="exec-results" class="exec-view-command">
        <partial name="_CiaCommandCenter" model="Model" />
    </div>
    <noscript><p>Enable JavaScript to load CIA Command Center data.</p></noscript>
</section>
<partial name="_DashboardExportAssets" />
@section Scripts {
    <script src="~/js/cia-command-center.js" asp-append-version="true"></script>
}
