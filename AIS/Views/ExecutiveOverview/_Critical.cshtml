@model AIS.Models.ExecutiveDashboardPageModel
<article class="exec-panel" id="exec-critical-panel" tabindex="-1"><h2>Critical audit observations</h2><p class="exec-note" id="exec-critical-note"></p><label class="exec-risk-filter" for="exec-critical-risk">Risk <select id="exec-critical-risk">@if (Model.DashboardType == "CCO") { <option value="HIGH" selected>High Risk</option><option value="MEDIUM">Medium Risk</option><option value="LOW">Low Risk</option><option value="UNRATED">Unrated</option><option value="ALL">All Risks</option> } else { <option value="">All risks</option> }</select></label><div class="exec-table-wrap" tabindex="0" role="region" aria-label="Critical observations table"><table class="exec-table"><thead><tr>@if (Model.DashboardType == "CCO") { <th scope="col">Reporting Office</th> }<th scope="col">Entity</th><th scope="col">Audit period / Para</th><th scope="col">Risk</th><th scope="col">Cycles</th><th scope="col">Age</th><th scope="col">Days since movement</th><th scope="col">Observation</th></tr></thead><tbody id="exec-critical"></tbody></table></div>@if (Model.DashboardType == "CCO")
{
    <div class="exec-filters" aria-label="Observation pages">
        <button type="button" class="org-button" id="exec-critical-prev" disabled>Previous</button>
        <button type="button" class="org-button" id="exec-critical-next" disabled>Next</button>
    </div>
}
<p class="exec-critical-definition">Critical KPI = open High-Risk paras (ZTBL).</p></article>
