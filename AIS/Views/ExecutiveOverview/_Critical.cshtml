@model AIS.Models.ExecutiveDashboardPageModel
@{
    var isCco = Model.DashboardType == "CCO";
    var isAuditParas = Model.SelectedView.Id == "audit-paras" || Model.IsAuditParaSnap;
    var title = isCco || Model.IsAuditParaSnap ? "Audit Para’s"
        : isAuditParas ? "High-Risk Audit Para’s" : "High-Risk Audit Observations";
}
<article class="exec-panel" id="exec-critical-panel" tabindex="-1">
    <h2>@title</h2>
    <p class="exec-note" id="exec-critical-note" aria-live="polite"></p>
    @* CCO displays High, Medium and Low from its separately authorized, server-paged reader.
       Other perspectives use the approved High-Risk-only critical reader; a
       Risk selector here would misleadingly imply other risks are available. *@
    @if (isCco)
    {
        <label class="exec-risk-filter" for="exec-critical-risk">
            Risk
            <select id="exec-critical-risk" aria-label="Filter audit paras by risk">
                <option value="HIGH" selected>High Risk</option>
                <option value="MEDIUM">Medium Risk</option>
                <option value="LOW">Low Risk</option>
            </select>
        </label>
    }
    <div class="exec-table-wrap" tabindex="0" role="region" aria-label="Audit para observations table">
        <table class="exec-table">
            <thead><tr>
                @if (isCco) { <th scope="col">Reporting Office</th> }
                <th scope="col">Entity</th>
                <th scope="col">Audit period / Para</th>
                <th scope="col">Risk</th>
                <th scope="col">Cycles</th>
                <th scope="col">Age</th>
                <th scope="col">Days since movement</th>
                <th scope="col">Observation</th>
            </tr></thead>
            <tbody id="exec-critical"></tbody>
        </table>
    </div>
    @if (isCco)
    {
        <div class="exec-filters" aria-label="Observation pages">
            <button type="button" class="org-button" id="exec-critical-prev" disabled>Previous</button>
            <button type="button" class="org-button" id="exec-critical-next" disabled>Next</button>
        </div>
    }
</article>
