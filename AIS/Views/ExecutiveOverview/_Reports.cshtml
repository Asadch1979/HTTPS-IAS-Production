@model AIS.Models.ExecutiveDashboardPageModel
@{
    var needsGroup = Model.DashboardType == "GROUP" && !Model.GroupRootId.HasValue;
}
<section id="exec-reports" data-api-url="@Url.Content(Model.IsAuditParaSnap ? "~/api/AuditParaSnap/" : "~/api/ExecutiveReports/")" data-perspective="@Model.DashboardType" data-api-view="@(Model.DashboardType == "CCO" ? "reports" : null)" data-group-root="@Model.GroupRootId" data-needs-group="@(needsGroup ? "true" : "false")" aria-label="Executive reports">
    @if (Model.SelectedView.Reports.Length == 0)
    {
        <p class="exec-empty">Executive reports are not yet supported for Reporting Line Management.</p>
    }
    else
    {
        <nav class="exec-navigation exec-report-selector" aria-label="Choose an executive report">
            @foreach (var report in Model.SelectedView.Reports)
            {
                <button type="button" class="org-button" data-report="@report" data-title="@AIS.Models.ExecutiveDashboardViews.ReportTitle(report)" aria-pressed="false" disabled="@needsGroup">@report · @AIS.Models.ExecutiveDashboardViews.ReportTitle(report)</button>
            }
        </nav>
        @if (needsGroup)
        {
            <p class="exec-empty">Select a Group Head entity and choose Load Group to view its authorized reports.</p>
        }
        <article class="exec-panel exec-report-panel" id="exec-report-panel" hidden>
            <div class="exec-report-heading">
                <div>
                    <h2 id="exec-report-title"></h2>
                    <p class="exec-note" id="exec-report-period"></p>
                </div>
                @if (Model.IsSuperUser)
                {
                <div class="exec-report-actions" aria-label="Report export options">
                    <button type="button" class="org-button" id="exec-report-export-csv" title="Download all report tables, reporting period and notes as an Excel-compatible CSV" disabled>Export CSV (Excel)</button>
                    <button type="button" class="org-button" id="exec-report-export-print" title="Download the searchable A4 landscape IAS PDF with page numbers" disabled>Download PDF</button>
                </div>
                }
            </div>
            <div class="exec-report-cautions" id="exec-report-cautions"></div>
            <div id="exec-report-content"></div>
        </article>
    }
</section>
