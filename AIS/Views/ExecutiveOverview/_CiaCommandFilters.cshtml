@model AIS.Models.ExecutiveDashboardPageModel
<form id="exec-filters" class="cia-organization-filters" method="get" action="@Url.Action("CIA","ExecutiveOverview")" aria-label="Organizational filters">
    <input type="hidden" name="view" value="command" />
    <input type="hidden" name="auditPeriodId" value="@Model.SelectedCiaPeriodId" />
    <div><label for="exec-select-by">Select By</label><select id="exec-select-by" name="selectBy"><option value="entityType" selected="@(Model.Filters.SelectBy == "entityType")">Entity Type</option><option value="auditedBy" selected="@(Model.Filters.SelectBy == "auditedBy")">Audited By</option></select></div>
    <div><label for="exec-dimension">@(Model.Filters.SelectBy == "entityType" ? "Entity Type" : "Audited By")</label><select id="exec-dimension" name="dimensionId"><option value="">All in authorized scope</option>@foreach (var option in Model.FilterOptions.Dimensions) { <option value="@option.Id" selected="@(option.Id == Model.Filters.DimensionId)">@option.Name (@option.Id)</option> }</select></div>
    <div><label for="exec-office">Reporting Office</label><select id="exec-office" name="reportingOfficeId"><option value="">All matching offices</option>@foreach (var option in Model.FilterOptions.ReportingOffices) { <option value="@option.Id" selected="@(option.Id == Model.Filters.ReportingOfficeId)">@option.Name (@option.Id)</option> }</select></div>
    <div><label for="exec-entity">Entity</label><select id="exec-entity" name="entityId"><option value="">All matching entities</option>@foreach (var option in Model.FilterOptions.Entities) { <option value="@option.Id" selected="@(option.Id == Model.Filters.EntityId)">@option.Name (@option.Id)</option> }</select></div>
    <div class="cia-filter-actions">
        <button class="org-button" type="submit">Apply</button>
        <a class="org-button" data-cia-reset href="@Url.Action("CIA","ExecutiveOverview",new { auditPeriodId = Model.SelectedCiaPeriodId })">Reset filters</a>
    </div>
</form>
