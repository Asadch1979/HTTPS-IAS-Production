@model AIS.Models.ExecutiveDashboardPageModel
@{
    var selected = Model.CiaPeriods.FirstOrDefault(p => p.AUDITPERIODID == Model.SelectedCiaPeriodId);
    var today = AIS.Models.AuditParaSnapPolicy.Today;
    var maximum = selected == null || selected.END_DATE.Date > today ? today : selected.END_DATE.Date;
}
<form id="exec-filters" class="cia-organization-filters" method="get" action="@Url.Action("CIA","ExecutiveOverview")" aria-label="Audit portfolio filters">
    <input type="hidden" name="view" value="command" />
    <div><label for="cia-period">Audit Period</label><select id="cia-period" name="auditPeriodId" required>
        @foreach (var period in Model.CiaPeriods) { <option value="@period.AUDITPERIODID" data-start="@period.START_DATE.ToString("yyyy-MM-dd")" data-end="@period.END_DATE.ToString("yyyy-MM-dd")" selected="@(period.AUDITPERIODID == Model.SelectedCiaPeriodId)">@period.DESCRIPTION</option> }
    </select></div>
    <div><label for="cia-position">Position as on</label><input id="cia-position" name="positionAsOn" type="date" value="@Model.Filters.PositionAsOn" min="@(selected?.START_DATE.ToString("yyyy-MM-dd"))" max="@maximum.ToString("yyyy-MM-dd")" data-today="@today.ToString("yyyy-MM-dd")" data-yesterday="@today.AddDays(-1).ToString("yyyy-MM-dd")" required /></div>
    <div><label for="cia-division">Division</label><select id="cia-division" name="snapDivision">
        <option value="1" selected="@(Model.Filters.SnapDivision == "1")">All Divisions</option>
        <option value="FAD" selected="@(Model.Filters.SnapDivision == "FAD")">Field Audit Division</option>
        <option value="MAD" selected="@(Model.Filters.SnapDivision == "MAD")">Management Audit Division</option>
    </select></div>
    <div><label for="cia-department">Department / Cluster</label><select id="cia-department" name="snapDepartmentId" disabled="@(Model.Filters.SnapDivision == "1")"><option value="">All</option>
        @foreach (var item in Model.SnapDepartments) { <option value="@item.Id" selected="@(item.Id == Model.Filters.SnapDepartmentId)">@item.Name</option> }
    </select></div>
    <div class="cia-filter-actions"><button class="org-button" type="submit">Apply</button><a class="org-button" data-cia-reset href="@Url.Action("CIA","ExecutiveOverview",new { auditPeriodId = Model.SelectedCiaPeriodId })">Reset</a></div>
</form>
