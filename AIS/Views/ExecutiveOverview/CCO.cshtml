@model AIS.Models.ExecutiveDashboardPageModel
@{
    ViewData["Title"] = "Chief Compliance Officer · Executive Dashboard";
    Layout = "_Layout";
    ViewData["HideTopHeader"] = true;
    var needsRoot = false;
}
<link rel="stylesheet" href="~/css/organization-structure.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-dashboard.css" asp-append-version="true" />
@if (Model.ComparisonEntities.Any()) { <link rel="stylesheet" href="~/css/executive-entity-comparison.css" asp-append-version="true" /> }
@if (Model.SelectedView.Id == "regional") { <link rel="stylesheet" href="~/css/regional-audit-pulse.css" asp-append-version="true" /> }
@if (Model.SelectedView.Id == "management" || Model.RoleOracleEnabled && Model.SelectedView.Id == "regional") { <link rel="stylesheet" href="~/css/management-role-dashboard.css" asp-append-version="true" /> }
<link rel="stylesheet" href="~/css/executive-themes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-dashboard-parents.css" asp-append-version="true" />
    @if (Model.IsSuperUser)
    {
        <nav class="exec-super-switcher" aria-label="Super User executive dashboard perspectives">
            <span>Super User dashboards</span>
            <a href="@Url.Action("TOP", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "TOP" ? "page" : null)">Top Management</a>
            <a href="@Url.Action("CIA", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "CIA" && !Model.IsAuditParaSnap ? "page" : null)">CIA Command Center</a>
            <a href="@Url.Action("AuditParaSnap", "ExecutiveOverview")" aria-current="@(Model.IsAuditParaSnap ? "page" : null)">Audit Para Snap</a>
            <a href="@Url.Action("CCO", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "CCO" ? "page" : null)">Compliance</a>
            <a href="@Url.Action("GROUP", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "GROUP" ? "page" : null)">Group Management</a>
            <a href="@Url.Action("RLM", "ExecutiveOverview")" aria-current="@(Model.DashboardType == "RLM" ? "page" : null)">Division / GM / Region</a>
        </nav>
    }
<section class="org exec @(Model.SelectedView.Id == "regional" ? "exec-regional" : Model.SelectedView.Id == "management" ? "exec-management" : "")" id="executive-dashboard" data-scope-label="@Model.ScopeLabel" data-perspective="@Model.DashboardType" data-role-enabled="@(Model.RoleOracleEnabled ? "true" : "false")" data-view="@Model.SelectedView.Id" data-datasets="@string.Join(",", Model.SelectedView.Datasets)" data-api-url="@Url.Content("~/api/ExecutiveDashboard/")" data-dashboard-type="@(Model.DashboardType == "RLM" || Model.IsSuperUser ? Model.DashboardType : "")" data-group-root-id="@(Model.IsSuperUser ? Model.GroupRootId : null)" aria-label="Chief Compliance Officer">
    <header class="org-header"><div class="dashboard-title exec-title"><h1>Chief Compliance Officer</h1><p>@Model.ScopeLabel</p></div></header>
    <nav class="exec-navigation" data-view-navigation aria-label="Dashboard analysis views">
        @foreach (var view in Model.Views)
        {
            <a class="org-button" aria-current="@(view.Id == Model.SelectedView.Id ? "page" : null)" href="@Url.Action(Model.DashboardType, "ExecutiveOverview", new { view = view.Id, startDate = Model.Filters.StartDate, endDate = Model.Filters.EndDate, groupRootId = Model.IsSuperUser ? Model.GroupRootId : null })">@view.Title</a>
        }
    </nav>
    <form id="exec-filters" class="exec-filters" method="get" action="@Url.Action(Model.DashboardType, "ExecutiveOverview")">
        <input type="hidden" name="view" value="@Model.SelectedView.Id" />
        @if (Model.IsSuperUser && Model.GroupRootId.HasValue) { <input type="hidden" name="groupRootId" value="@Model.GroupRootId" /> }
        @if (Model.SelectedView.Id == "reports")
        {
            var report = Context.Request.Query["report"].ToString();
            <input type="hidden" id="exec-report-selection" name="report" value="@(Model.SelectedView.Reports.Contains(report) ? report : Model.SelectedView.Reports.FirstOrDefault())" />
        }
        @* All Compliance datasets share the selected period. *@
        @if (Model.DashboardType == "CCO")
        {
            <div><label for="exec-start-date">Start Date</label><input type="date" id="exec-start-date" max="@AIS.Models.AuditParaSnapPolicy.Today.ToString("yyyy-MM-dd")" name="startDate" value="@Model.Filters.StartDate" required /></div>
            <div><label for="exec-end-date">End Date</label><input type="date" id="exec-end-date" max="@AIS.Models.AuditParaSnapPolicy.Today.ToString("yyyy-MM-dd")" name="endDate" value="@Model.Filters.EndDate" required /></div>
        }
        <button class="org-button" id="exec-refresh" type="submit">Apply</button>
        <a class="org-button exec-reset" href="@Url.Action(Model.DashboardType, "ExecutiveOverview", new { view = Model.SelectedView.Id, groupRootId = Model.IsSuperUser ? Model.GroupRootId : null })">Reset</a>
    </form>

    <p class="exec-note">Activity uses the selected period; balances, risk, aging and critical items are as of End Date. Historical balances are estimates; unknown historical compliance cycles remain in the Unknown cycle category.</p>
    <p id="exec-status" class="org-status" role="status" aria-live="polite">@(Model.SelectedView.Id == "reports" ? Model.ScopeLabel : "Loading dashboard…")</p>
    <div id="exec-results" class="exec-view-@Model.SelectedView.Id" hidden="@(Model.SelectedView.Id != "reports")">
        <partial name="@Model.SelectedView.Partial" model="Model" />
    </div>
    <noscript><p>Enable JavaScript to load dashboard data.</p></noscript>
</section>
<partial name="_DashboardExportAssets" />
@section Scripts {
    @if (needsRoot)
    {
        // No data queries before the authorized reporting root is selected.
    }
    else if (Model.SelectedView.Id == "reports")
    {
        <script src="~/js/executive-reports.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/executive-dashboard.js" asp-append-version="true"></script>
        @if (Model.SelectedView.Id == "management") { <script src="~/js/executive-role-visuals.js" asp-append-version="true"></script> }
        @if (Model.ComparisonEntities.Any()) { <script src="~/js/executive-entity-comparison.js" asp-append-version="true"></script> }
        @if (Model.RoleOracleEnabled && (Model.SelectedView.Id == "management" || Model.SelectedView.Id == "regional")) { <script src="~/js/executive-role-reporting.js" asp-append-version="true"></script> }
    }
}
