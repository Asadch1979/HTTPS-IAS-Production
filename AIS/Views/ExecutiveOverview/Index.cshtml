@model AIS.Models.ExecutiveDashboardPageModel
@{
    var ciaCommandCenter = Model.DashboardType == "CIA" && Model.SelectedView.Id == "glance";
    ViewData["Title"] = ciaCommandCenter ? "Audit Command Center" : Model.SelectedView.Title + " · Executive Dashboard";
    Layout = ciaCommandCenter ? "_CiaDashboardLayout" : "_Layout";
    var roleName = Model.DashboardType switch { "TOP" => "Top Management", "GROUP" => "Group Head", "CCO" => "Chief Compliance Officer", "RLM" => "Reporting Line Management", _ => "Chief Internal Auditor" };
    var needsGroup = Model.DashboardType == "GROUP" && !Model.GroupRootId.HasValue;
}
<link rel="stylesheet" href="~/css/organization-structure.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/executive-dashboard.css" asp-append-version="true" />
<section class="org exec @(ciaCommandCenter ? "cia-dashboard" : "")" id="executive-dashboard" data-view="@Model.SelectedView.Id" data-datasets="@string.Join(",", Model.SelectedView.Datasets)" data-api-url="@Url.Content("~/api/ExecutiveDashboard/")" data-dashboard-type="@(Model.DashboardType == "RLM" || Model.IsSuperUser ? Model.DashboardType : "")" data-group-root-id="@(Model.IsSuperUser ? Model.GroupRootId : null)" aria-label="Executive Dashboard">
    <header class="org-header">
        @if (ciaCommandCenter)
        {
            <div class="cia-heading"><p class="cia-eyebrow">IAS · Chief Internal Auditor</p><h1>Audit Command Center</h1><p>@Model.ScopeLabel</p><p class="cia-as-of">As of <time id="exec-as-of">awaiting data</time> · Current-state position</p></div>
        }
        else
        {
            <div class="exec-title"><h1>@Model.SelectedView.Title <span>· @Model.ScopeLabel</span></h1><button type="button" class="exec-info" aria-label="About this view" title="@roleName · @Model.SelectedView.Description">i</button></div>
        }
        @if (Model.CanViewOrganization) { <a class="org-button" href="@Url.Action("Index", "OrganizationStructure")">Organization Structure</a> }
    </header>
    @if (Model.IsSuperUser && Model.DashboardType == "GROUP")
    {
        <form class="exec-filters" method="get" action="@Url.Action("GROUP", "ExecutiveOverview")">
            <div><label for="exec-group-root">Group Head entity</label><select id="exec-group-root" name="groupRootId" required><option value="">Select a Group Head entity</option>@foreach (var group in Model.Groups) { <option value="@group.EntityId" selected="@(group.EntityId == Model.GroupRootId)">@group.EntityName (@group.EntityId)</option> }</select></div>
            <input type="hidden" name="startDate" value="@Model.Filters.StartDate" />
            <input type="hidden" name="endDate" value="@Model.Filters.EndDate" />
            <input type="hidden" name="view" value="@Model.SelectedView.Id" />
            <button type="submit" class="org-button">Load Group</button>
        </form>
    }
    <nav class="exec-navigation" data-view-navigation aria-label="Executive Dashboard views">
        @foreach (var view in Model.Views)
        {
            <a class="org-button" aria-current="@(view.Id == Model.SelectedView.Id ? "page" : null)" href="@Url.Action(Model.DashboardType, "ExecutiveOverview", Model.Filters.RouteValues(view.Id, Model.IsSuperUser ? Model.GroupRootId : null))">@view.Title</a>
        }
    </nav>
    <partial name="_Filters" model="Model" />
    <p id="exec-status" class="org-status" role="status" aria-live="polite">@(Model.SelectedView.Id == "reports" ? Model.ScopeLabel : "Loading dashboard…")</p>
    <div id="exec-results" class="exec-view-@Model.SelectedView.Id" hidden="@(Model.SelectedView.Id != "reports")">
        <partial name="@Model.SelectedView.Partial" model="Model" />
    </div>
    <noscript><p>Enable JavaScript to load your Executive Dashboard.</p></noscript>
</section>
@section Scripts {
    @if (Model.SelectedView.Id == "reports")
    {
        <script src="~/js/executive-reports.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/executive-dashboard.js" asp-append-version="true"></script>
    }
}
