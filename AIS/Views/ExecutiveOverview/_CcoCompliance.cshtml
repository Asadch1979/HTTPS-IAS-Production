@model AIS.Models.ExecutiveDashboardPageModel
@if (Model.SelectedView.Id != "audit-paras") { <h2>@Model.SelectedView.Title</h2> }
@if (Model.SelectedView.Id == "org-position")
{
    <partial name="_CcoFunctionPosition" model="Model" />
}
else
{
    <partial name="_Sections" model="Model" />
    @if (Model.SelectedView.Id == "overview")
    {
        <div id="cco-summary" class="exec-kpis" aria-label="Compliance summary"></div>
    }
}
