@model AIS.Models.ExecutiveDashboardPageModel
<form id="exec-filters" class="snap-filters" method="get" action="@Url.Action("AuditParaSnap","ExecutiveOverview")">
    <input type="hidden" name="view" value="@Model.SelectedView.Id" />
    @if (Model.SelectedView.Id=="reports")
    {
        var report=Context.Request.Query["report"].ToString().ToUpperInvariant();
        <input type="hidden" id="exec-report-selection" name="report" value="@(Model.SelectedView.Reports.Contains(report) ? report : "A")" />
    }
    <div class="snap-period-toolbar" role="group" aria-label="Common reporting period">
        <div><label for="exec-start-date">Start Date</label><input type="date" id="exec-start-date" name="startDate" value="@Model.Filters.StartDate" max="@AIS.Models.AuditParaSnapPolicy.Today.ToString("yyyy-MM-dd")" required /></div>
        <div><label for="exec-end-date">End Date</label><input type="date" id="exec-end-date" name="endDate" value="@Model.Filters.EndDate" max="@AIS.Models.AuditParaSnapPolicy.Today.ToString("yyyy-MM-dd")" required /></div>
        <div><label for="snap-division">Division</label>
            <select id="snap-division" name="snapDivision" required>
                <option value="FAD" selected="@(Model.Filters.SnapDivision == "FAD")">Field Audit Division</option>
                <option value="MAD" selected="@(Model.Filters.SnapDivision == "MAD")">Management Audit Division</option>
            </select>
        </div>
        <div><label for="snap-department">Department / Cluster</label>
            <select id="snap-department" name="snapDepartmentId" aria-label="Department or Cluster">
                <option value="">All</option>
                @foreach (var item in Model.SnapDepartments)
                {
                    <option value="@item.Id" selected="@(Model.Filters.SnapDepartmentId == item.Id)">@item.Name</option>
                }
            </select>
        </div>
        <button class="org-button" id="exec-refresh" type="submit">Apply</button>
        <a class="org-button" href="@Url.Action("AuditParaSnap","ExecutiveOverview",new { view=Model.SelectedView.Id })">Reset</a>
        <small>Default: January 1 through yesterday (last complete Pakistan calendar day).</small>
    </div>
</form>
