@model AIS.Models.IID.ComplaintModel
@{
    ViewData["Title"] = "Submit Complaint";
    Layout = "_Layout";
}
<h4>Submit Complaint</h4>
<form id="complaintForm" asp-action="SubmitComplaint" asp-controller="IID" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Complainant Particulars</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Name of Complainant</label>
                        <input type="text" class="form-control" asp-for="ComplainantName" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">CNIC</label>
                        <input type="text" class="form-control" asp-for="CNIC" pattern="\d{5}-\d{7}-\d{1}" placeholder="12345-1234567-1" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Cellular Number</label>
                        <input type="text" class="form-control" asp-for="CellularNumber" pattern="03\d{9}" placeholder="03XXXXXXXXX" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Mailing Address</label>
                        <input type="text" class="form-control" asp-for="MailingAddress" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Gender</label>
                        <select class="form-select" asp-for="Gender" required>
                            <option value="">--Select Gender--</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Complaint Details</div>
                <div class="card-body">
                    <!-- Complaint No removed from UI; pass 0 so DB auto-generates -->
                    <input type="hidden" name="ComplaintNo" value="0" />
                    <div class="mb-2">
                        <label class="form-label">Received On</label>
                        <input type="date" class="form-control" id="ReceivedOn" name="ReceivedOn" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Nature of Complaint</label>
                        <select class="form-select" asp-for="Nature" required>
                            <option value="">--Select--</option>
                            <option>Fraud & Forgery</option>
                            <option>Embezzlement of loan/partial loan amount</option>
                            <option>Embezzlement of recovery amount</option>
                            <option>Embezzlement of deposits</option>
                            <option>Loan processing issues</option>
                            <option>Fake/disputed collaterals</option>
                            <option>Getting illegal gratification</option>
                            <option>NOC/ Redemption issues</option>
                            <option>Recovery/ Repayment issues</option>
                            <option>Service Charges issues</option>
                            <option>Misbehavior</option>
                            <option>Miscellaneous</option>
                            <option>Short payment of cash</option>
                            <option>Timings related issues</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Category</label>
                        <select class="form-select" asp-for="Category" required>
                            <option value="">--Select--</option>
                            <option>Complaint</option>
                            <option>Reference</option>
                            <option>Whistle Blow</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Source</label>
                        <select class="form-select" id="Source" asp-for="Source" required>
                            <option value="">--Select--</option>
                            <option>SQ&amp;CMD</option>
                            <option>President Office</option>
                            <option>Chairman Office</option>
                            <option>HO Department (Specify Manually)</option>
                            <option>NAB</option>
                            <option>FIA</option>
                            <option>SBP</option>
                            <option>Banking Muhtasib</option>
                            <option>Prime Minister Secretariat</option>
                            <option>Ministry of Finance</option>
                            <option>Others (Specify Manually)</option>
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="sourceOtherDiv">
                        <label class="form-label" id="sourceOtherLabel">Specify Source</label>
                        <input type="text" class="form-control" id="SourceOtherText" asp-for="SourceOtherText" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Pertains To</label>
                        <select class="form-select" id="PertainsTo" asp-for="PertainsTo" required>
                            <option value="">--Select--</option>
                            <option value="HO">HO</option>
                            <option value="FIELD">Field</option>
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="fieldTypeDiv">
                        <label class="form-label">Field Type</label>
                        <select class="form-select" id="FieldType" asp-for="FieldType">
                            <option value="">--Select--</option>
                            <option value="HO_UNIT">HO Units</option>
                            <option value="BRANCH">Branch</option>
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="hoUnitTypeDiv">
                        <label class="form-label">HO Unit Type</label>
                        <select class="form-select" id="HOUnitTypeId" asp-for="HOUnitTypeId">
                            <option value="">--Select HO Unit Type--</option>
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="hoUnitDiv">
                        <label class="form-label">HO Unit</label>
                        <select class="form-select" id="HOUnitId" asp-for="HOUnitId">
                            <option value="">--Select HO Unit--</option>
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="regionDiv">
                        <label class="form-label">Region</label>
                        <select class="form-select" id="RegionId" asp-for="RegionId">
                            <option value="">--Select Region--</option>
                            @{
                                if (ViewData["RegionList"] != null)
                                {
                                    foreach (var item in (dynamic)(ViewData["RegionList"]))
                                    {
                                        <option value="@item.CODE">@item.NAME</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-2 d-none" id="branchDiv">
                        <label class="form-label">Branch</label>
                        <select class="form-select" id="BranchId" asp-for="BranchId">
                            <option value="">--Select Branch--</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Contents of Complaint</label>
                        <textarea class="form-control" asp-for="Contents" required></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Upload Complaint (PDF)</label>
                        <input type="file" class="form-control" name="ComplaintFile" accept="application/pdf" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Upload FFR (PDF)</label>
                        <input type="file" class="form-control" id="FfrFile" name="FfrFile" accept="application/pdf" />
                        <small class="text-danger d-none" id="ffrValidationMessage">FFR upload is mandatory when Source is SQ&amp;CMD.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Upload Other Evidence</label>
                        <input type="file" class="form-control" name="OtherEvidence" multiple />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Action Required from I&ID</label>
                        <textarea class="form-control" asp-for="ActionRequired" maxlength="1000" required></textarea>
                        <small class="text-muted">Max 1000 characters.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

<div class="modal fade" id="iidAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="iidAlertTitle">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="iidAlertBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
    <script src="~/js/csp/Views_IID_SubmitComplaint.js?v=1"></script>

}
