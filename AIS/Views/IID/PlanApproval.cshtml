@{
    ViewData["Title"] = "Plan Approval";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
    var planId = ViewData["PlanId"];
}

<div class="container-fluid mt-3">
    <h4>Plan Approval</h4>
    @await Html.PartialAsync("_ComplaintSelector")

    <div class="card mb-3">
        <div class="card-header bg-light">
            Complaint &amp; Assessment Summary
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3">Complaint No</dt>
                <dd class="col-md-9" id="complaintNo"></dd>

                <dt class="col-md-3">Complainant Name</dt>
                <dd class="col-md-9" id="complainantName"></dd>

                <dt class="col-md-3">Assessment</dt>
                <dd class="col-md-9" id="assessmentText"></dd>
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light">
            Submitted Plan
        </div>
        <div class="card-body">
            <p id="planDetails" class="mb-0 text-break"></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            Approval Decision
        </div>
        <div class="card-body">
            <form id="approvalForm">
                <input type="hidden" name="PlanId" value="@planId" />
                <div class="mb-3">
                    <label class="form-label">Edited Plan (optional)</label>
                    <textarea class="form-control" name="EditedPlan" rows="4"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Further Actions (optional)</label>
                    <textarea class="form-control" name="FurtherActions" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Decision</label>
                    <select class="form-select" name="IsApproved">
                        <option value="Y">Approve</option>
                        <option value="N">Return</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Submit Decision</button>
            </form>
        </div>
    </div>
</div>

@section Scripts{
<script>
    $(function(){
        var complaintId = '@complaintId';
        var planId = '@planId';

        function showIidAlert(message, type){
            type = type || 'danger';
            $('#iidAlertHost').html(
                '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                (message || 'Unexpected error') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
        }

        function hideIidLoader(){
            $('#iidLoading, .iid-loading, .loading').hide();
        }

        function loadComplaintDropdown(onSelected){
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/GetComplaintsDropdown',
                type: 'POST',
                success: function(resp){
                    if(resp && resp.ok === false){
                        showIidAlert(resp.message, 'danger');
                        return;
                    }

                    var $dd = $('#iidComplaintSelect');
                    $dd.empty().append('<option value="">-- Select Complaint --</option>');

                    (resp || []).forEach(function(x){
                        // expect: complaintId, displayText
                        $dd.append('<option value="' + x.complaintId + '">' + x.displayText + '</option>');
                    });

                    if(typeof onSelected === 'function'){
                        $dd.off('change').on('change', function(){
                            var id = $(this).val();
                            $('#selectedComplaintId').val(id);
                            if(!id){
                                showIidAlert('Please select a complaint.', 'warning');
                                return;
                            }
                            onSelected(parseInt(id));
                        });
                    }

                    if(complaintId){
                        $dd.val(complaintId).trigger('change');
                    }
                },
                error: function(xhr){
                    showIidAlert('Failed to load complaints dropdown.', 'danger');
                },
                complete: function(){
                    hideIidLoader();
                }
            });
        }

        function loadPlanDetailsByPlanId(selectedPlanId){
            $.get(g_asiBaseURL + '/ApiCalls/GetIidPlanDetails', { planId: selectedPlanId }, function(d){
                var planRow = Array.isArray(d) ? d[0] : d;
                if(!planRow){
                    $('#planDetails').text('Plan details not available.');
                    return;
                }
                $('#complaintNo').text(planRow.COMPLAINT_NO || planRow.complaintNo || '');
                $('#complainantName').text(planRow.COMPLAINANT_NAME || planRow.complainantName || '');
                $('#assessmentText').text(planRow.ASSESSMENT || planRow.assessment || '');
                $('#planDetails').text(planRow.PLAN_DETAILS || planRow.planDetails || '');
            }).fail(function(){
                showIidAlert('Failed to load plan details.', 'danger');
            }).always(function(){
                hideIidLoader();
            });
        }

        function loadPlanApprovalByComplaintId(selectedComplaintId){
            complaintId = selectedComplaintId;
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/GetLatestPlanByComplaintId',
                type: 'POST',
                data: { complaintId: complaintId },
                success: function(resp){
                    if(resp && resp.ok === false){
                        $('#planDetails').text('Plan details not available.');
                        showIidAlert(resp.message, 'warning');
                        return;
                    }
                    planId = resp.planId;
                    $('#approvalForm [name="PlanId"]').val(planId);
                    $('#complaintNo').text(resp.complaintNo || '');
                    $('#complainantName').text(resp.complainantName || '');
                    $('#assessmentText').text(resp.assessment || '');
                    $('#planDetails').text(resp.planDetails || '');
                },
                error: function(){
                    showIidAlert('Failed to load plan details.', 'danger');
                },
                complete: function(){
                    hideIidLoader();
                }
            });
        }

        $('#approvalForm').on('submit', function(e){
            e.preventDefault();
            var data = {
                PlanId: $('#approvalForm [name="PlanId"]').val(),
                EditedPlan: $('#approvalForm [name="EditedPlan"]').val(),
                FurtherActions: $('#approvalForm [name="FurtherActions"]').val(),
                IsApproved: $('#approvalForm [name="IsApproved"]').val()
            };
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/AddPlanApproval',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response){
                    if(response && response.ok === false){
                        showIidAlert(response.message, 'danger');
                        return;
                    }
                    var approved = data.IsApproved === 'Y';
                    showIidAlert(approved ? 'Plan approved. Notification queued.' : 'Plan returned for updates.', approved ? 'success' : 'warning');
                    window.location.href = g_asiBaseURL + '/IID/TaskList';
                },
                error: function(){
                    showIidAlert('Failed to submit plan approval.', 'danger');
                }
            });
        });

        if(planId){
            $('#approvalForm [name="PlanId"]').val(planId);
            loadPlanDetailsByPlanId(planId);
        }

        loadComplaintDropdown(function(selectedId){
            loadPlanApprovalByComplaintId(selectedId);
        });
    });
</script>
}
