@model AIS.Models.IID.PlanApprovalModel
@{
    ViewData["Title"] = "Plan Approval";
    var dashboardMode = ViewData["DashboardMode"] as bool? == true;
    Layout = dashboardMode ? null : "_Layout";
    var complaintId = ViewData["ComplaintId"] is int cid ? cid : 0;
    var planId = ViewData["PlanId"] is int pid ? pid : 0;
}

<div class="container-fluid mt-3"
     id="iidPlanApprovalRoot"
     data-iid-page="plan-approval"
     data-dashboard-mode="@(dashboardMode ? "true" : "false")"
     data-complaint-id="@complaintId"
     data-plan-id="@planId">
    @if (!dashboardMode)
    {
        <h4>Plan Approval</h4>
        @await Html.PartialAsync("_ComplaintSelector")
    }

    <div id="iidComplaintDetailsRoot"></div>

    @await Html.PartialAsync("_InitialAssessmentSummary")

    <div class="card mb-3">
        <div class="card-header bg-light">
            Submitted Plan
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0" id="submittedPlanGrid">
                    <thead class="table-light">
                        <tr><th style="width:30%">Field</th><th>Value</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="2" class="text-muted">Select a complaint to load plan details.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            Approval Decision
        </div>
        <div class="card-body">
            <form id="approvalForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PlanId" value="@planId" />

                <div class="mb-2">
                    <label class="form-label">Edit Plan</label>
                    <textarea class="form-control" name="EditedPlan"></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">Further Line of Action</label>
                    <textarea class="form-control" name="FurtherActions"></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">Action</label>
                    <select class="form-select" name="IsApproved" required>
                        <option value="Y">Approve</option>
                        <option value="N">Reject</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="iidAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="iidAlertTitle">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="iidAlertBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

@if (dashboardMode)
{
    <script src="~/js/csp/Views_IID_PlanApproval.js" asp-append-version="true"></script>
    <script src="~/js/iid/complaintDetails.js" asp-append-version="true"></script>
}
else
{
@section Scripts{
    <script src="~/js/csp/Views_IID_PlanApproval.js" asp-append-version="true"></script>
<script src="~/js/iid/complaintDetails.js" asp-append-version="true"></script>

}
}
