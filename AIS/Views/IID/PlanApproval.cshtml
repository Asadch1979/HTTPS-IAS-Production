@model AIS.Models.IID.PlanApprovalModel
@{
    ViewData["Title"] = "Plan Approval";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
    var planId = ViewData["PlanId"];
}

<div class="container-fluid mt-3">
    <h4>Plan Approval</h4>
    @await Html.PartialAsync("_ComplaintSelector")

    <div id="iidComplaintDetailsRoot"></div>

    @await Html.PartialAsync("_InitialAssessmentSummary")

    <div class="card mb-3">
        <div class="card-header bg-light">
            Submitted Plan
        </div>
        <div class="card-body">
            <p id="planDetails" class="mb-0 text-break"></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            Approval Decision
        </div>
        <div class="card-body">
            <form id="approvalForm">
                <input type="hidden" name="PlanId" value="@planId" />

                <div class="mb-2">
                    <label class="form-label">Edit Plan</label>
                    <textarea class="form-control" name="EditedPlan" required></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">Further Line of Action</label>
                    <textarea class="form-control" name="FurtherActions" required></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">Action</label>
                    <select class="form-select" name="IsApproved" required>
                        <option value="Y">Approve</option>
                        <option value="N">Reject</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="iidAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="iidAlertTitle">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="iidAlertBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script src="~/js/iid/complaintDetails.js"></script>
<script>
    $(function(){
        var complaintId = '@complaintId';
        var planId = '@planId';
        var pageId = 4;

        function showIidAlert(title, message){
            $('#iidAlertTitle').text(title || 'Message');
            $('#iidAlertBody').text(message || '');
            $('#iidAlertModal').modal('show');
        }

        function hideIidLoader(){
            $('#iidLoading, .iid-loading, .loading').hide();
        }


        function loadComplaintDropdown(pageId){
            return $.post(g_asiBaseURL + '/ApiCalls/GetComplaintsDropdown', { pageId: pageId });
        }

        function loadPlanDetailsByPlanId(selectedPlanId){
            $.get(g_asiBaseURL + '/ApiCalls/GetIidPlanDetails', { planId: selectedPlanId }, function(d){
                var planRow = Array.isArray(d) ? d[0] : d;
                if(!planRow){
                    $('#planDetails').text('Plan details not available.');
                    return;
                }
                $('#assessmentText').text(planRow.ASSESSMENT || planRow.assessment || '');
                $('#assessmentRecommendation').text(planRow.RECOMMENDATION || planRow.recommendation || '');
                $('#assessmentUnit').text(planRow.ASSIGNED_UNIT_ID || planRow.assignedUnitId || '');
                $('#planDetails').text(planRow.PLAN_DETAILS || planRow.planDetails || '');
            }).fail(function(){
                showIidAlert('Failed', 'Failed to load plan details.');
            }).always(function(){
                hideIidLoader();
            });
        }

        function loadPlanApprovalByComplaintId(selectedComplaintId){
            complaintId = selectedComplaintId;
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/GetLatestPlanByComplaintId',
                type: 'POST',
                data: { complaintId: complaintId },
                success: function(resp){
                    if(resp && resp.ok === false){
                        $('#planDetails').text('Plan details not available.');
                        showIidAlert('Failed', resp.message || 'Operation failed.');
                        return;
                    }
                    planId = resp.planId;
                    $('#approvalForm [name="PlanId"]').val(planId);
                    var normalized = iidNormalizeComplaint(resp);
                    iidRenderComplaintDetails('#iidComplaintDetailsRoot', normalized);
                    $('#assessmentText').text(normalized.Assessment || '');
                    $('#assessmentRecommendation').text(normalized.Recommendation || '');
                    $('#assessmentUnit').text(normalized.AssignedUnit || '');
                    $('#planDetails').text(resp.planDetails || '');
                },
                error: function(){
                    showIidAlert('Failed', 'Failed to load plan details.');
                },
                complete: function(){
                    hideIidLoader();
                }
            });
        }

        $('#approvalForm').on('submit', function(e){
            e.preventDefault();

            // simple required check
            var ok = true;
            $('#approvalForm').find('[required]').each(function(){
                if (!$(this).val() || !$(this).val().toString().trim()) { ok = false; $(this).focus(); return false; }
            });
            if (!ok) { alert('Please fill all mandatory fields.'); return; }

            var data = $(this).serialize();

            var selectedComplaintId = $('#selectedComplaintId').val();
            if(!selectedComplaintId || selectedComplaintId === '0'){
                showIidAlert('Required', 'Please select a complaint.');
                return;
            }
            $.post(g_asiBaseURL + '/ApiCalls/AddPlanApproval', data, function(){
                alert('Action recorded');
            }).fail(function(){
                alert('Error saving approval');
            });
        });

        if(planId){
            $('#approvalForm [name="PlanId"]').val(planId);
            loadPlanDetailsByPlanId(planId);
        }

        loadComplaintDropdown(pageId)
            .done(function(resp){
                if(resp && resp.ok === false){
                    showIidAlert('Failed', resp.message || 'Operation failed.');
                    return;
                }

                var $dd = $('#iidComplaintSelect');
                $dd.empty().append('<option value="">-- Select Complaint --</option>');

                (resp || []).forEach(function(x){
                    $dd.append('<option value="' + x.complaintId + '">' + x.displayText + '</option>');
                });

                $dd.off('change').on('change', function(){
                    var id = $(this).val();
                    $('#selectedComplaintId').val(id);
                    if(!id || id === '0'){
                        $('#iidComplaintDetailsRoot').html('');
                        return;
                    }
                    loadPlanApprovalByComplaintId(parseInt(id));
                });

                if(complaintId){
                    $dd.val(complaintId).trigger('change');
                }
            })
            .fail(function(){
                showIidAlert('Failed', 'Failed to load complaints dropdown.');
            })
            .always(function(){
                hideIidLoader();
            });
    });
</script>
}
