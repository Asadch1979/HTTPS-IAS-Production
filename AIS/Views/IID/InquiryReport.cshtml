@model AIS.Models.IID.InquiryReportModel
@{
    ViewData["Title"] = "Inquiry Report";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div id="iidAlertHost" class="mb-2"></div>

<div class="inquiry-header card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h4 class="mb-1">Inquiry Report</h4>
                <div class="text-muted small">Mandatory sectioned wizard aligned with Wazirabad reporting standards.</div>
            </div>
            <span id="reportStatusBadge" class="badge bg-secondary">Draft</span>
        </div>
        <div class="row g-2 mt-2 small">
            <div class="col-md-4 col-12">
                <div class="snap-label">Complainant Name</div>
                <div id="headerComplainantName" class="snap-value">N/A</div>
            </div>
        </div>
        <div id="snapshotStrip" class="row g-2 mt-2 small"></div>
    </div>
</div>

<div id="iidComplaintHiddenCache" class="d-none" style="display:none;"></div>
<div id="iidAntiForgeryWrap" class="d-none">@Html.AntiForgeryToken()</div>

<div class="stepper-wrap sticky-top bg-white py-2 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong id="stepCounter">Step 1 of 8</strong>
        <span class="text-muted small">Click any step to navigate</span>
    </div>
    <div id="wizardStepper" class="wizard-stepper"></div>
</div>

<div class="wizard-section card mb-3" data-step="1"></div>
<div class="wizard-section card mb-3 d-none" data-step="2"></div>
<div class="wizard-section card mb-3 d-none" data-step="3"></div>
<div class="wizard-section card mb-3 d-none" data-step="4"></div>
<div class="wizard-section card mb-3 d-none" data-step="5"></div>
<div class="wizard-section card mb-3 d-none" data-step="6"></div>
<div class="wizard-section card mb-3 d-none" data-step="7"></div>
<div class="wizard-section card mb-3 d-none" data-step="8"></div>

@section Scripts {
<script src="~/js/iid/inquiryReportApi.js"></script>
<script>
$(function(){
    var complaintId = parseInt('@complaintId') || 0;
    var currentStep = 1;
    var isLocked = false;
    var userId = 0;
    var steps = [
        { id: 1, code: 'SNAPSHOT', title: 'Snapshot' },
        { id: 2, code: 'ACCUSATIONS', title: 'Accusations' },
        { id: 3, code: 'ACCUSED_LIST', title: 'Accused List' },
        { id: 4, code: 'RECORDS', title: 'Record Scrutinized' },
        { id: 5, code: 'STATEMENTS', title: 'Statement Register' },
        { id: 6, code: 'EVIDENCE', title: 'Evidence' },
        { id: 7, code: 'VIOLATIONS', title: 'Violations' },
        { id: 8, code: 'DSA', title: 'DSA / Finalize' }
    ];

    var state = {
        snapshot: {},
        complainantName: '',
        complainantCnic: '',
        accusations: [{ accusationId: 0, accusationText: '', sortOrder: 1 }],
        accused: [{ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: 1 }],
        records: [{ recId: 0, recordTitle: '', recordDetails: '', sortOrder: 1 }],
        statements: [{ statementId: 0, personName: '', roleType: 'Complainant', ppnoNumber: '', cnic: '', statementDatetime: '', place: '', modeType: 'In Person', keyPoints: '' }],
        evidence: [],
        violations: [{ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: 1 }],
        dsa: [{ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: 1 }],
        deleteQueue: { accusations: [], accused: [], records: [], statements: [], violations: [], dsa: [] }
    };

    function apiPostJson(path, payload){
        return $.ajax({
            url: g_asiBaseURL + path,
            method: 'POST',
            data: JSON.stringify(payload || {}),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json'
        });
    }

    function token(){ return $('#iidAntiForgeryWrap input[name="__RequestVerificationToken"]').val(); }
    function esc(v){ return $('<div/>').text(v || '').html(); }
    function showAlert(message, type){
        $('#iidAlertHost').html('<div class="alert alert-' + (type || 'danger') + ' alert-dismissible fade show">' +
            esc(message) + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }

    function renderStepper(){
        $('#stepCounter').text('Step ' + currentStep + ' of ' + steps.length);
        $('#wizardStepper').html(steps.map(function(s){
            return '<button type="button" class="step-pill ' + (s.id===currentStep?'active':'') + ' ' + (isStepCompleted(s.id)?'completed':'') + '" data-step-jump="' + s.id + '"><span class="num">' + s.id + '</span>' + esc(s.title) + '</button>';
        }).join(''));
    }

    function renderSnapshotStrip(){
        var s = state.snapshot;
        var badges = [
            ['Complaint No', s.complaintNo || 'N/A'], ['Submitted', s.submittedOn || 'N/A'], ['Region', s.region || 'N/A'], ['Branch', s.branch || 'N/A'], ['Category', s.category || 'N/A']
        ];
        $('#snapshotStrip').html(badges.map(function(b){ return '<div class="col-md-2 col-6"><div class="snap-label">' + esc(b[0]) + '</div><div class="snap-value">' + esc(b[1]) + '</div></div>'; }).join(''));
    }

    function rowInput(bind, value, type){
        return '<input ' + (type ? 'type="' + type + '"' : '') + ' class="form-control" data-bind="' + bind + '" value="' + esc(value) + '">';
    }

    function sectionActions(step){
        return '<div class="d-flex justify-content-between mt-4"><button type="button" class="btn btn-outline-secondary" data-prev ' + (step===1?'disabled':'') + '>Previous</button><div class="d-flex gap-2"><button type="button" class="btn btn-primary" data-save>Save Section</button><button type="button" class="btn btn-success" data-next>' + (step===steps.length?'Review':'Next') + '</button>' + (step===steps.length?'<button type="button" class="btn btn-danger" id="finalSubmitBtn">Final Submit</button>':'') + '</div></div>';
    }

    function renderSection(step){
        var h = $('.wizard-section[data-step="' + step + '"]');
        var html = '<div class="card-body"><div class="validation-summary alert alert-warning d-none"></div>';
        if(step === 1){
            var snap = state.snapshot || {};
            html += '<h5>Snapshot</h5><p class="text-muted">Complaint and complainant data loaded using <code>/ApiCalls/GetComplaint</code>.</p>';
            html += '<div class="row g-3">' +
                '<div class="col-lg-6"><div class="card border-0 bg-light"><div class="card-body">' +
                '<h6 class="mb-3">Complainant Details</h6>' +
                '<div class="row g-2 small">' +
                '<div class="col-6"><span class="text-muted">Name</span><div class="fw-semibold">' + esc(snap.complainantName || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">CNIC</span><div class="fw-semibold">' + esc(snap.cnic || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Cell No</span><div>' + esc(snap.cellularNumber || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Gender</span><div>' + esc(snap.gender || 'N/A') + '</div></div>' +
                '<div class="col-12"><span class="text-muted">Address</span><div>' + esc(snap.mailingAddress || 'N/A') + '</div></div>' +
                '<div class="col-12"><span class="text-muted">Received From</span><div>' + esc(snap.receivedFrom || 'N/A') + '</div></div>' +
                '</div></div></div></div>' +
                '<div class="col-lg-6"><div class="card border-0 bg-light"><div class="card-body">' +
                '<h6 class="mb-3">Complaint Details</h6>' +
                '<div class="row g-2 small">' +
                '<div class="col-6"><span class="text-muted">Complaint No</span><div class="fw-semibold">' + esc(snap.complaintNo || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Submitted On</span><div>' + esc(snap.submittedOn || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Nature</span><div>' + esc(snap.nature || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Category</span><div>' + esc(snap.category || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Region</span><div>' + esc(snap.region || 'N/A') + '</div></div>' +
                '<div class="col-6"><span class="text-muted">Branch</span><div>' + esc(snap.branch || 'N/A') + '</div></div>' +
                '<div class="col-12"><span class="text-muted">Action Required</span><div>' + esc(snap.actionRequired || 'N/A') + '</div></div>' +
                '<div class="col-12"><span class="text-muted">Contents</span><div>' + esc(snap.contents || 'N/A') + '</div></div>' +
                '</div></div></div></div>' +
                '</div>';
        }
        if(step === 2){
            var rowsA = state.accusations.map(function(r,i){
                return '<tr><td>' + rowInput('accusations['+i+'].accusationText', r.accusationText) + '</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="accusations" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Accusations</h5><table class="table table-sm"><thead><tr><th>Accusation</th><th></th></tr></thead><tbody>' + rowsA + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="accusations">Add Row</button>';
        }
        if(step === 3){
            var rowsAc = state.accused.map(function(r,i){
                return '<tr><td>'+rowInput('accused['+i+'].personName',r.personName)+'</td><td>'+rowInput('accused['+i+'].designation',r.designation)+'</td><td><select class="form-select" data-bind="accused['+i+'].roleType"><option value="Main" '+(r.roleType==='Main'?'selected':'')+'>Main</option><option value="Co" '+(r.roleType==='Co'?'selected':'')+'>Co</option></select></td><td>'+rowInput('accused['+i+'].ppnoNumber',r.ppnoNumber)+'</td><td>'+rowInput('accused['+i+'].cnic',r.cnic)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="accused" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Accused List</h5><table class="table table-sm"><thead><tr><th>Name</th><th>Designation</th><th>Role</th><th>PPNO</th><th>CNIC</th><th></th></tr></thead><tbody>'+rowsAc+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="accused">Add Row</button>';
        }
        if(step === 4){
            var rowsR = state.records.map(function(r,i){
                return '<tr><td>'+rowInput('records['+i+'].recordTitle',r.recordTitle)+'</td><td>'+rowInput('records['+i+'].recordDetails',r.recordDetails)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="records" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Record Scrutinized</h5><table class="table table-sm"><thead><tr><th>Title</th><th>Details</th><th></th></tr></thead><tbody>'+rowsR+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="records">Add Row</button>';
        }
        if(step === 5){
            var rowsS = state.statements.map(function(r,i){
                return '<tr><td>'+rowInput('statements['+i+'].personName',r.personName)+'</td><td>'+rowInput('statements['+i+'].roleType',r.roleType)+'</td><td>'+rowInput('statements['+i+'].ppnoNumber',r.ppnoNumber)+'</td><td>'+rowInput('statements['+i+'].cnic',r.cnic)+'</td><td>'+rowInput('statements['+i+'].statementDatetime',r.statementDatetime,'datetime-local')+'</td><td>'+rowInput('statements['+i+'].place',r.place)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="statements" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Statement Register</h5><div class="help-text mb-2">PPNO is mandatory. Complainant statement defaults PPNO to complainant CNIC.</div><table class="table table-sm"><thead><tr><th>Person</th><th>Role</th><th>PPNO</th><th>CNIC</th><th>Date/Time</th><th>Place</th><th></th></tr></thead><tbody>'+rowsS+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="statements">Add Row</button>';
        }
        if(step === 6){
            var rowsE = state.evidence.map(function(r){
                return '<tr><td>'+esc(r.fileName)+'</td><td>'+esc(r.evidenceType || 'N/A')+'</td><td>'+esc(r.uploadedOn || 'N/A')+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-delete-evidence="'+ r.evidenceId +'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Evidence</h5><div class="mb-3"><label class="form-label">Upload evidence files</label><input id="uploadedEvidence" type="file" class="form-control" multiple></div><table class="table table-sm"><thead><tr><th>File</th><th>Type</th><th>Uploaded On</th><th></th></tr></thead><tbody>' + (rowsE || '<tr><td colspan="4" class="text-muted">No evidence uploaded.</td></tr>') + '</tbody></table>';
        }
        if(step === 7){
            var rowsV = state.violations.map(function(r,i){
                return '<tr><td>'+rowInput('violations['+i+'].category',r.category)+'</td><td>'+rowInput('violations['+i+'].violationDetail',r.violationDetail)+'</td><td>'+rowInput('violations['+i+'].referenceText',r.referenceText)+'</td><td>'+rowInput('violations['+i+'].recommendation',r.recommendation)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="violations" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Violations (Annex-III)</h5><table class="table table-sm"><thead><tr><th>Category</th><th>Detail</th><th>Reference</th><th>Recommendation</th><th></th></tr></thead><tbody>'+rowsV+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="violations">Add Row</button>';
        }
        if(step === 8){
            var rowsD = state.dsa.map(function(r,i){
                return '<tr><td>'+rowInput('dsa['+i+'].personName',r.personName)+'</td><td>'+rowInput('dsa['+i+'].designation',r.designation)+'</td><td>'+rowInput('dsa['+i+'].ppnoNumber',r.ppnoNumber)+'</td><td>'+rowInput('dsa['+i+'].cnic',r.cnic)+'</td><td>'+rowInput('dsa['+i+'].dsaStatus',r.dsaStatus)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="dsa" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>DSA</h5><table class="table table-sm"><thead><tr><th>Person</th><th>Designation</th><th>PPNO</th><th>CNIC</th><th>Status</th><th></th></tr></thead><tbody>'+rowsD+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="dsa">Add Row</button>';
        }
        html += sectionActions(step) + '</div>';
        h.html(html);
        if(isLocked){ h.find('input,textarea,select,button').prop('disabled', true); }
    }

    function bindStepInputs(){
        $('.wizard-section[data-step="' + currentStep + '"] [data-bind]').off('input change').on('input change', function(){
            var key = $(this).data('bind');
            var m = key.match(/^(\w+)\[(\d+)\]\.(\w+)$/);
            if(!m){ return; }
            state[m[1]][parseInt(m[2],10)][m[3]] = $(this).val();
        });
    }

    function validateStep(step){
        var errs = [];
        var has = function(v){ return !!(v && String(v).trim()); };
        if(step === 2 && !state.accusations.some(function(x){ return has(x.accusationText); })) errs.push('At least one accusation is required.');
        if(step === 3 && !state.accused.some(function(x){ return has(x.personName); })) errs.push('At least one accused row is required.');
        if(step === 4 && !state.records.some(function(x){ return has(x.recordTitle) || has(x.recordDetails); })) errs.push('At least one record scrutinized row is required.');
        if(step === 5 && !state.statements.some(function(x){ return has(x.personName) && has(x.ppnoNumber) && has(x.place) && has(x.statementDatetime); })) errs.push('Statement register requires at least one complete row (including PPNO).');
        if(step === 6 && !state.evidence.length) errs.push('At least one evidence file is mandatory.');
        if(step === 7 && !state.violations.some(function(x){ return has(x.category) && has(x.violationDetail) && has(x.referenceText) && has(x.recommendation); })) errs.push('At least one complete violation row is required.');
        if(step === 8 && !state.dsa.some(function(x){ return has(x.personName) || has(x.dsaStatus); })) errs.push('At least one DSA row is required.');
        return errs;
    }

    function showValidation(step, errors){
        var host = $('.wizard-section[data-step="' + step + '"] .validation-summary');
        if(!errors.length){ host.addClass('d-none').html(''); return; }
        host.removeClass('d-none').html('<strong>Missing mandatory fields:</strong><ul class="mb-0">' + errors.map(function(e){ return '<li>' + esc(e) + '</li>'; }).join('') + '</ul>');
    }

    function isStepCompleted(step){ return step === 1 || validateStep(step).length === 0; }

    function ensureOneRow(section){
        if(state[section].length){ return; }
        if(section === 'accusations') state.accusations.push({ accusationId: 0, accusationText: '', sortOrder: 1 });
        if(section === 'accused') state.accused.push({ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: 1 });
        if(section === 'records') state.records.push({ recId: 0, recordTitle: '', recordDetails: '', sortOrder: 1 });
        if(section === 'statements') state.statements.push({ statementId: 0, personName: '', roleType: 'Complainant', ppnoNumber: state.complainantCnic || '', cnic: state.complainantCnic || '', statementDatetime: '', place: '', modeType: 'In Person', keyPoints: '' });
        if(section === 'violations') state.violations.push({ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: 1 });
        if(section === 'dsa') state.dsa.push({ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: 1 });
    }

    function markForDelete(section, row){
        var idKeyMap = { accusations: 'accusationId', accused: 'accusedRowId', records: 'recId', statements: 'statementId', violations: 'violationId', dsa: 'dsaId' };
        var id = row[idKeyMap[section]];
        if(id && id > 0){ state.deleteQueue[section].push(id); }
    }

    function saveCollection(opts){
        var queue = $.Deferred().resolve().promise();
        (state.deleteQueue[opts.section] || []).forEach(function(id){
            queue = queue.then(function(){ return opts.deleteFn(id, userId).then(function(resp){ return ensureApiSuccess(resp, 'Delete failed.'); }); });
        });
        state.deleteQueue[opts.section] = [];

        opts.rows.forEach(function(row, idx){
            var payload = opts.map(row, idx);
            queue = queue.then(function(){
                var request = row[opts.idKey] ? opts.updateFn(payload) : opts.addFn(payload);
                return request.then(function(resp){ return ensureApiSuccess(resp, 'Save failed.'); });
            });
        });
        return queue.then(function(){ return opts.loadFn(complaintId); }).done(function(resp){ ensureApiSuccess(resp, 'Load failed.'); opts.hydrate(resp); });
    }

    function extractData(resp){ return (resp && (resp.data || resp.Data)) || []; }

    function getResponseMessage(resp){
        if(!resp){ return ''; }
        if(resp.message){ return resp.message; }
        if(resp.data && resp.data.message){ return resp.data.message; }
        return '';
    }

    function ensureApiSuccess(resp, fallback){
        if(resp && resp.ok === false){
            throw new Error(getResponseMessage(resp) || fallback || 'Operation failed.');
        }
        return resp;
    }

    function saveStep(step){
        var errs = validateStep(step);
        showValidation(step, errs);
        if(errs.length){ return $.Deferred().reject().promise(); }

        if(step === 2){
            return saveCollection({
                section: 'accusations', rows: state.accusations.filter(function(x){ return x.accusationText && x.accusationText.trim(); }), idKey: 'accusationId',
                addFn: window.iidAddInqAccusation, updateFn: window.iidUpdateInqAccusation, deleteFn: window.iidDeleteInqAccusation, loadFn: window.iidGetInqAccusations,
                map: function(row, idx){ return { accusationId: row.accusationId || 0, complaintId: complaintId, accusationText: row.accusationText, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }; },
                hydrate: function(resp){ state.accusations = extractData(resp).map(function(x){ return { accusationId: x.accusationId, accusationText: x.accusationText, sortOrder: x.sortOrder || 1 }; }); ensureOneRow('accusations'); }
            }).done(function(){ showAlert('Accusations saved successfully.', 'success'); });
        }
        if(step === 3){
            return saveCollection({
                section: 'accused', rows: state.accused.filter(function(x){ return x.personName && x.personName.trim(); }), idKey: 'accusedRowId',
                addFn: window.iidAddInqAccused, updateFn: window.iidUpdateInqAccused, deleteFn: window.iidDeleteInqAccused, loadFn: window.iidGetInqAccusedList,
                map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); },
                hydrate: function(resp){ state.accused = extractData(resp); ensureOneRow('accused'); }
            }).done(function(){ showAlert('Accused list saved successfully.', 'success'); });
        }
        if(step === 4){
            return saveCollection({
                section: 'records', rows: state.records.filter(function(x){ return ((x.recordTitle || '') + (x.recordDetails || '')).trim(); }), idKey: 'recId',
                addFn: window.iidAddInqRecord, updateFn: window.iidUpdateInqRecord, deleteFn: window.iidDeleteInqRecord, loadFn: window.iidGetInqRecords,
                map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); },
                hydrate: function(resp){ state.records = extractData(resp); ensureOneRow('records'); }
            }).done(function(){ showAlert('Record scrutinized saved successfully.', 'success'); });
        }
        if(step === 5){
            return saveCollection({
                section: 'statements', rows: state.statements.filter(function(x){ return x.personName && x.ppnoNumber; }), idKey: 'statementId',
                addFn: window.iidAddInqStatement, updateFn: window.iidUpdateInqStatement, deleteFn: window.iidDeleteInqStatement, loadFn: window.iidGetInqStatements,
                map: function(row){ return $.extend({}, row, { complaintId: complaintId, status: 'A', createdBy: userId, updatedBy: userId }); },
                hydrate: function(resp){ state.statements = extractData(resp); ensureOneRow('statements'); }
            }).done(function(){ showAlert('Statement register saved successfully.', 'success'); });
        }
        if(step === 6){
            return window.iidGetInqEvidenceFiles(complaintId).done(function(resp){ ensureApiSuccess(resp, 'Failed to load evidence list.'); state.evidence = extractData(resp); showAlert('Evidence list refreshed from database.', 'success'); });
        }
        if(step === 7){
            return saveCollection({
                section: 'violations', rows: state.violations.filter(function(x){ return x.violationDetail && x.referenceText && x.recommendation; }), idKey: 'violationId',
                addFn: window.iidAddInqViolation, updateFn: window.iidUpdateInqViolation, deleteFn: window.iidDeleteInqViolation, loadFn: window.iidGetInqViolations,
                map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); },
                hydrate: function(resp){ state.violations = extractData(resp); ensureOneRow('violations'); }
            }).done(function(){ showAlert('Violations saved successfully.', 'success'); });
        }
        if(step === 8){
            return saveCollection({
                section: 'dsa', rows: state.dsa.filter(function(x){ return x.personName || x.dsaStatus; }), idKey: 'dsaId',
                addFn: window.iidAddInqDsa, updateFn: window.iidUpdateInqDsa, deleteFn: window.iidDeleteInqDsa, loadFn: window.iidGetInqDsa,
                map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); },
                hydrate: function(resp){ state.dsa = extractData(resp); ensureOneRow('dsa'); }
            }).done(function(){ showAlert('DSA saved successfully.', 'success'); });
        }
        return $.Deferred().resolve().promise();
    }

    function renderCurrent(){
        renderSection(currentStep);
        $('.wizard-section').addClass('d-none');
        $('.wizard-section[data-step="' + currentStep + '"]').removeClass('d-none');
        renderStepper();
        bindStepInputs();
    }

    function loadComplaint(){
        return $.post(g_asiBaseURL + '/ApiCalls/GetComplaint', { complaintId: complaintId }).done(function(resp){
            ensureApiSuccess(resp, 'Failed to load complaint snapshot.');
            var c = resp || {};
            state.complainantName = c.complainantName || '';
            state.complainantCnic = c.cnic || '';
            $('#headerComplainantName').text(state.complainantName || 'N/A');
            $('#iidComplaintHiddenCache').text(JSON.stringify(c));
            state.snapshot = {
                complaintNo: c.complaintNo,
                submittedOn: c.submittedOn,
                region: c.region,
                branch: c.branch,
                category: c.category,
                nature: c.nature,
                complainantName: c.complainantName,
                cnic: c.cnic,
                cellularNumber: c.cellularNumber,
                mailingAddress: c.mailingAddress,
                gender: c.gender,
                receivedFrom: c.receivedFrom,
                actionRequired: c.actionRequired,
                contents: c.contents
            };
            renderSnapshotStrip();
            if(state.statements.length && !state.statements[0].ppnoNumber){ state.statements[0].ppnoNumber = state.complainantCnic; state.statements[0].cnic = state.complainantCnic; }
        });
    }

    function hydrateFromWizardData(w){
        state.accusations = (w.accusations || []).map(function(x){ return { accusationId: x.accusationId, accusationText: x.accusationText, sortOrder: x.sortOrder || 1 }; });
        state.accused = w.accused || [];
        state.records = w.recordsScrutinized || [];
        state.statements = w.statementsRegister || [];
        state.evidence = w.evidenceFiles || [];
        state.violations = w.violations || [];
        state.dsa = w.dsa || [];
        ensureOneRow('accusations'); ensureOneRow('accused'); ensureOneRow('records'); ensureOneRow('statements'); ensureOneRow('violations'); ensureOneRow('dsa');
    }

    function loadWizardData(){
        return apiPostJson('/ApiCalls/GetIidInqWizardData', { complaintId: complaintId }).done(function(resp){
            ensureApiSuccess(resp, 'Failed to load wizard data.');
            hydrateFromWizardData(resp.data || {});
        });
    }

    function finalizeReport(){
        return apiPostJson('/ApiCalls/FinalizeIidInquiryReport', { complaintId: complaintId }).done(function(resp){
            if(!resp || resp.ok === false){ showAlert(getResponseMessage(resp) || 'Finalize failed.', 'danger'); return; }
            isLocked = true;
            $('#reportStatusBadge').removeClass('bg-secondary').addClass('bg-success').text('Submitted');
            showAlert(resp.message || 'Inquiry report finalized successfully.', 'success');
            renderCurrent();
        });
    }

    $(document).on('click', '[data-step-jump]', function(){ currentStep = parseInt($(this).data('step-jump'), 10); renderCurrent(); });
    $(document).on('click', '[data-prev]', function(){ if(currentStep > 1){ currentStep--; renderCurrent(); } });
    $(document).on('click', '[data-next]', function(){ var e = validateStep(currentStep); showValidation(currentStep, e); if(!e.length && currentStep < steps.length){ currentStep++; renderCurrent(); } });
    $(document).on('click', '[data-save]', function(){ saveStep(currentStep).always(renderCurrent); });

    $(document).on('click', '[data-add-row]', function(){
        var s = $(this).data('add-row');
        if(s==='accusations') state.accusations.push({ accusationId: 0, accusationText: '', sortOrder: state.accusations.length + 1 });
        if(s==='accused') state.accused.push({ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: state.accused.length + 1 });
        if(s==='records') state.records.push({ recId: 0, recordTitle: '', recordDetails: '', sortOrder: state.records.length + 1 });
        if(s==='statements') state.statements.push({ statementId: 0, personName: '', roleType: '', ppnoNumber: '', cnic: '', statementDatetime: '', place: '', modeType: '', keyPoints: '' });
        if(s==='violations') state.violations.push({ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: state.violations.length + 1 });
        if(s==='dsa') state.dsa.push({ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: state.dsa.length + 1 });
        renderCurrent();
    });

    $(document).on('click', '[data-remove-row]', function(){
        var section = $(this).data('remove-row');
        var idx = parseInt($(this).data('index'), 10);
        var row = state[section][idx];
        markForDelete(section, row);
        state[section].splice(idx, 1);
        ensureOneRow(section);
        renderCurrent();
    });

    $(document).on('change', '#uploadedEvidence', function(){
        var files = Array.prototype.slice.call(this.files || []);
        var chain = $.Deferred().resolve().promise();
        files.forEach(function(file){
            chain = chain.then(function(){
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token());
                fd.append('ComplaintId', complaintId);
                fd.append('EvidenceType', 'Document');
                fd.append('Description', file.name);
                fd.append('Status', 'A');
                fd.append('UploadedBy', userId || 0);
                fd.append('file', file);
                return window.iidAddInqEvidenceFile(fd).then(function(resp){ return ensureApiSuccess(resp, 'Evidence upload failed.'); });
            });
        });
        chain.then(function(){ return window.iidGetInqEvidenceFiles(complaintId); }).done(function(resp){
            ensureApiSuccess(resp, 'Failed to refresh evidence list.');
            state.evidence = extractData(resp);
            showAlert('Evidence uploaded and saved successfully.', 'success');
            renderCurrent();
        }).fail(function(){ showAlert('Evidence upload failed.', 'danger'); });
        this.value = '';
    });

    $(document).on('click', '[data-delete-evidence]', function(){
        var evidenceId = parseInt($(this).data('delete-evidence'), 10);
        window.iidDeleteInqEvidenceFile(evidenceId, userId || 0).then(function(resp){ ensureApiSuccess(resp, 'Failed to delete evidence file.'); return window.iidGetInqEvidenceFiles(complaintId); }).done(function(resp){
            ensureApiSuccess(resp, 'Failed to refresh evidence list.');
            state.evidence = extractData(resp);
            renderCurrent();
        }).fail(function(){ showAlert('Failed to delete evidence file.', 'danger'); });
    });

    $(document).on('click', '#finalSubmitBtn', function(){
        var errors = [];
        for(var i=2;i<=steps.length;i++){ errors = errors.concat(validateStep(i)); }
        if(errors.length){ showAlert('Complete all mandatory sections before final submit.', 'danger'); return; }
        finalizeReport();
    });

    if(!complaintId){
        showAlert('Complaint ID is missing. Open this page from Task List.', 'danger');
        return;
    }

    loadComplaint()
        .then(function(){ return loadWizardData(); })
        .done(function(){ renderCurrent(); })
        .fail(function(){ showAlert('Failed to load inquiry wizard data.', 'danger'); renderCurrent(); });
});
</script>
<style>
.wizard-stepper{display:grid;grid-template-columns:repeat(8,minmax(140px,1fr));gap:.4rem;overflow:auto}
.step-pill{border:1px solid #ced4da;background:#fff;border-radius:.5rem;padding:.35rem .5rem;text-align:left}
.step-pill .num{font-weight:700;margin-right:.35rem}
.step-pill.active{border-color:#0d6efd;box-shadow:0 0 0 2px rgba(13,110,253,.15)}
.step-pill.completed{background:#ecf9f0;border-color:#198754}
.snap-label{color:#6c757d}
.snap-value{font-weight:600}
.help-text{font-size:.8rem;color:#6c757d}
.validation-summary{font-size:.9rem}
</style>
}
