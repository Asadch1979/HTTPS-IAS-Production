            });
        }).fail(function(err){ showAlert((err && err.message) || 'Failed to delete evidence file.', 'danger'); });
    });

    $(document).on('change', '[data-findings-accusation-select]', function(){
        state.findingsRecomm.selectedAccusationId = $(this).val();
        markDirty(7);
        loadFindingsForSelection(state.findingsRecomm.selectedAccusationId).fail(function(err){
            showAlert((err && err.message) || 'Failed to load findings for selected accusation.', 'danger');
        });
    });

    $(document).on('click', '[data-findings-view-edit]', function(){
        var accusationId = String($(this).data('findings-view-edit') || '');
        state.findingsRecomm.selectedAccusationId = accusationId;
        $('#findingsAccusationSelect').val(accusationId);
        loadFindingsForSelection(accusationId).fail(function(err){
            showAlert((err && err.message) || 'Failed to load findings for selected accusation.', 'danger');
        });
    });

    $(document).on('click', '[data-save-findings-recomm]', function(){
        saveStep(7).done(function(result){
            showAlert((result && result.message) || 'Saved successfully.', 'success');
            renderCurrent(true);
        }).fail(function(err){
            showAlert((err && err.message) || 'Save failed.', 'danger');
        });
    });

    $(document).on('change', '.outcome-select', function(){
        var accusationId = parseInt($(this).data('accusation-id'), 10);
        if(isNaN(accusationId)){ return; }
        state.findingsRecomm.outcomes[accusationId] = $(this).val() || '';
        markDirty(7);
        updateDsaVisibility();
    });

    $(document).on('click', '#finalSubmitBtn', function(){
        var mandatorySteps = [2,3,4,5,6,7,8].concat(state.isDsaVisible ? [9] : []);
        var sectionValidators = mandatorySteps.map(function(stepId){
            var stepInfo = steps.filter(function(s){ return s.id === stepId; })[0] || { title: 'Step ' + stepId };
            return {
                stepId: stepId,
                stepTitle: stepInfo.title,
                validate: function(){ return validateStepForFinalSubmit(stepId); }
            };
        });

        var missingSections = [];
        var missingFieldsBySection = {};
        sectionValidators.forEach(function(validator){
            var result = validator.validate();
            if(!result.ok){
                missingSections.push(validator.stepTitle);
                missingFieldsBySection[validator.stepTitle] = result.missingFields;
            }
        });

        if(missingSections.length){
            showFinalSubmitErrors(missingSections, missingFieldsBySection);
            return;
        }
        finalizeReport();
    });

    if(!complaintId){ showAlert('Complaint ID is missing. Open this page from Task List.', 'danger'); return; }

    loadComplaint().done(function(){
        loadStepData(7).always(function(){ renderCurrent(); });
    }).fail(function(){ showAlert('Failed to load inquiry wizard data.', 'danger'); renderCurrent(true); });
});
</script>

<style>
.wizard-stepper{display:grid;grid-template-columns:repeat(9,minmax(140px,1fr));gap:.4rem;overflow:auto}
.step-pill{border:1px solid #ced4da;background:#fff;border-radius:.5rem;padding:.35rem .5rem;text-align:left}
.step-pill .num{font-weight:700;margin-right:.35rem}
.step-pill.active{border-color:#0d6efd;box-shadow:0 0 0 2px rgba(13,110,253,.15)}
.step-pill.completed{background:#ecf9f0;border-color:#198754}
.step-pill.not-saved{background:#fff5f5;border-color:#dc3545}
.step-state{font-size:.68rem;vertical-align:middle}
.snap-label{color:#6c757d}
.snap-value{font-weight:600}
.help-text{font-size:.8rem;color:#6c757d}
.validation-summary{font-size:.9rem}
</style>
}
