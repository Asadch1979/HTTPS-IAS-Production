@model AIS.Models.IID.InquiryReportModel
@{
    ViewData["Title"] = "Inquiry Report";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div id="iidAlertHost" class="mb-2"></div>

<div class="inquiry-header card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h4 class="mb-1">Inquiry Report</h4>
                <div class="text-muted small">Mandatory sectioned wizard aligned with Wazirabad reporting standards.</div>
            </div>
            <span id="reportStatusBadge" class="badge bg-secondary">Draft</span>
        </div>
        <div class="row g-2 mt-2 small">
            <div class="col-md-4 col-12">
                <div class="snap-label">Complainant Name</div>
                <div id="headerComplainantName" class="snap-value">N/A</div>
            </div>
        </div>
        <div id="snapshotStrip" class="row g-2 mt-2 small"></div>
    </div>
</div>

<div id="iidComplaintHiddenCache" class="d-none" style="display:none;"></div>

<div class="stepper-wrap sticky-top bg-white py-2 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong id="stepCounter">Step 1 of 9</strong>
        <span class="text-muted small">Click any step to navigate</span>
    </div>
    <div id="wizardStepper" class="wizard-stepper"></div>
</div>

<form id="reportForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ComplaintId" value="@complaintId" />

    <div class="wizard-section card mb-3" data-step="1"></div>
    <div class="wizard-section card mb-3 d-none" data-step="2"></div>
    <div class="wizard-section card mb-3 d-none" data-step="3"></div>
    <div class="wizard-section card mb-3 d-none" data-step="4"></div>
    <div class="wizard-section card mb-3 d-none" data-step="5"></div>
    <div class="wizard-section card mb-3 d-none" data-step="6"></div>
    <div class="wizard-section card mb-3 d-none" data-step="7"></div>
    <div class="wizard-section card mb-3 d-none" data-step="8"></div>
    <div class="wizard-section card mb-3 d-none" data-step="9"></div>
</form>

@section Scripts {
<script>
$(function(){
    var complaintId = parseInt('@complaintId') || 0;
    var currentStep = 1;
    var isLocked = false;
    var steps = [
        { id: 1, code: 'SNAPSHOT', title: 'Snapshot' },
        { id: 2, code: 'PARTIES', title: 'Parties' },
        { id: 3, code: 'ACCUSATIONS', title: 'Accusations' },
        { id: 4, code: 'PROCEEDINGS', title: 'Proceedings' },
        { id: 5, code: 'CRITICAL_POINTS', title: 'Critical Points' },
        { id: 6, code: 'EVIDENCE', title: 'Evidence' },
        { id: 7, code: 'FINDINGS', title: 'Findings' },
        { id: 8, code: 'VIOLATIONS', title: 'Violations Matrix' },
        { id: 9, code: 'RECOMMENDATIONS', title: 'Recommendations' }
    ];

    var state = {
        snapshot: {},
        parties: { complainantName: '', accusedName: '', accusedDesignation: '', backgroundIntro: '', gistOfComplaint: '', originReference: '' },
        accusations: { accusationItems: [''], accusedRows: [{ mainAccused: '', coAccused: '' }] },
        proceedings: { methodology: '', recordScrutinized: [''], statementRegister: [{ person: '', role: 'Complainant', ppno: '', dateTime: '', place: '' }] },
        criticalPoints: { complainantPoints: '', accusedPoints: '' },
        evidence: { materialEvidence: [''], circumstantialEvidence: [''], implications: '', evidenceUploads: [] },
        findings: { findingsList: [''], policyReferences: [{ reference: '', note: '' }] },
        violations: {
            internal: { na: false, justification: '', rows: [{ detail: '', reference: '', recommendation: '' }] },
            policy: { na: false, justification: '', rows: [{ detail: '', reference: '', recommendation: '' }] },
            control: { na: false, justification: '', rows: [{ detail: '', reference: '', recommendation: '' }] }
        },
        recommendations: { recommendationsList: [''], rootCause: '', reportedInAudit: '', auditDetails: '', dsaFramedAgainst: [''] },
        submittedOn: ''
    };

    function escapeHtml(v){ return $('<div/>').text(v || '').html(); }
    function showAlert(message, type){
        $('#iidAlertHost').html('<div class="alert alert-' + (type || 'danger') + ' alert-dismissible fade show">' +
            escapeHtml(message) + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }

    function normalizeComplaint(raw){
        if(window.iidNormalizeComplaint){ return window.iidNormalizeComplaint(raw || {}); }
        return raw || {};
    }

    function getComplaintValue(source, keys, fallback){
        for(var i = 0; i < keys.length; i++){
            var key = keys[i];
            if(source && source[key] !== undefined && source[key] !== null && String(source[key]).trim() !== ''){
                return source[key];
            }
        }
        return fallback || '';
    }

    function renderComplaintCache(complaint){
        var html = '';
        if(window.iidRenderComplaintDetails){
            window.iidRenderComplaintDetails('#iidComplaintHiddenCache', complaint);
            return;
        }
        html += '<div class="card"><div class="card-body">';
        html += '<h6>Complainant Particulars</h6>';
        html += '<div>Name: ' + escapeHtml(getComplaintValue(complaint, ['ComplainantName', 'NameComplainant', 'complainantName'], 'N/A')) + '</div>';
        html += '<div>CNIC: ' + escapeHtml(getComplaintValue(complaint, ['ComplainantCnic', 'CNIC', 'cnic'], 'N/A')) + '</div>';
        html += '<h6 class="mt-2">Complaint Details</h6>';
        html += '<div>Complaint No: ' + escapeHtml(getComplaintValue(complaint, ['ComplaintNo', 'complaintNo'], 'N/A')) + '</div>';
        html += '<div>Origin/Reference: ' + escapeHtml(getComplaintValue(complaint, ['OriginReference', 'FfrSource', 'ffrSource', 'source'], 'N/A')) + '</div>';
        html += '</div></div>';
        $('#iidComplaintHiddenCache').html(html);
    }

    function syncComplaintIntoState(){
        var c = window._iidComplaint || {};
        var complainantName = getComplaintValue(c, ['ComplainantName', 'NameComplainant', 'complainantName'], '');
        var originReference = getComplaintValue(c, ['OriginReference', 'FfrSource', 'ffrSource', 'source'], '');
        var complainantCnic = getComplaintValue(c, ['ComplainantCnic', 'CNIC', 'cnic'], '');

        state.parties.complainantName = complainantName || state.parties.complainantName;
        state.parties.originReference = originReference || state.parties.originReference;

        if(state.proceedings.statementRegister && state.proceedings.statementRegister.length){
            var first = state.proceedings.statementRegister[0];
            if(!first.role){ first.role = 'Complainant'; }
            if((first.role || '').toLowerCase() === 'complainant' || !first.person){
                first.person = state.parties.complainantName || first.person;
                if(!first.ppno){ first.ppno = complainantCnic; }
            }
        }

        $('#headerComplainantName').text(complainantName || 'N/A');
    }

    function renderStepper(){
        var html = steps.map(function(s){
            var done = isStepCompleted(s.id);
            var cls = 'step-pill ' + (s.id === currentStep ? 'active' : '') + (done ? ' completed' : '');
            return '<button type="button" class="' + cls + '" data-step-jump="' + s.id + '"><span class="num">' + s.id + '</span><span>' + s.title + '</span><small>' + (done ? 'Completed' : 'Incomplete') + '</small></button>';
        }).join('');
        $('#wizardStepper').html(html);
        $('#stepCounter').text('Step ' + currentStep + ' of ' + steps.length);
    }

    function renderSnapshotStrip(){
        var s = state.snapshot || {};
        var fields = [
            ['Complaint No', s.complaintNo || ('CID-' + complaintId)],
            ['Received On', s.submittedOn || 'N/A'],
            ['Branch/Region', [s.branch, s.region].filter(Boolean).join(' / ') || 'N/A'],
            ['Category/Nature', [s.category, s.nature].filter(Boolean).join(' / ') || 'N/A']
        ];
        $('#snapshotStrip').html(fields.map(function(f){
            return '<div class="col-md-3 col-6"><div class="snap-label">' + f[0] + '</div><div class="snap-value">' + escapeHtml(f[1]) + '</div></div>';
        }).join(''));
    }

    function parseJson(text){ if(!text){ return null; } try { return JSON.parse(text); } catch(e){ return null; } }

    function hydrateDraft(resp){
        if(!resp || !resp.ok){ return; }
        state.parties.complainantName = resp.nameComplainant || state.parties.complainantName;
        state.parties.accusedName = resp.nameAccused || '';
        state.submittedOn = resp.submittedOn || '';

        var gistObj = parseJson(resp.gist);
        if(gistObj){
            state.parties = $.extend(state.parties, gistObj.parties || {});
            state.accusations = $.extend(state.accusations, gistObj.accusations || {});
            state.criticalPoints = $.extend(state.criticalPoints, gistObj.criticalPoints || {});
            state.evidence = $.extend(state.evidence, gistObj.evidence || {});
        } else if(resp.gist){
            state.parties.gistOfComplaint = resp.gist;
        }

        var procObj = parseJson(resp.proceedings);
        if(procObj){ state.proceedings = $.extend(state.proceedings, procObj); }
        else if(resp.proceedings){ state.proceedings.methodology = resp.proceedings; }

        var findingObj = parseJson(resp.findings);
        if(findingObj){ state.findings = $.extend(state.findings, findingObj.findings || findingObj); state.violations = $.extend(state.violations, findingObj.violations || {}); }
        else if(resp.findings){ state.findings.findingsList = [resp.findings]; }

        var recObj = parseJson(resp.recommendation);
        if(recObj){ state.recommendations = $.extend(state.recommendations, recObj); }
        else if(resp.recommendation){ state.recommendations.recommendationsList = [resp.recommendation]; }

        if(resp.uploadedEvidence){
            state.evidence.evidenceUploads = String(resp.uploadedEvidence).split(';').filter(function(x){ return $.trim(x); }).map(function(name){
                return { name: $.trim(name), uploadedOn: '', existing: true };
            });
        }

        if(resp.submittedOn){
            isLocked = true;
            $('#reportStatusBadge').removeClass('bg-secondary').addClass('bg-success').text('Submitted');
        }
    }

    function listEditorHtml(section, key, label, hint){
        var arr = state[section][key] || [''];
        var rows = arr.map(function(v, i){
            return '<div class="d-flex gap-2 mb-2"><input class="form-control" data-bind="' + section + '.' + key + '[' + i + ']" value="' + escapeHtml(v) + '" placeholder="' + hint + '">' +
                '<button type="button" class="btn btn-outline-danger" data-remove-row="' + section + '.' + key + '" data-index="' + i + '">Remove</button></div>';
        }).join('');
        return '<div class="mb-3"><label class="form-label">' + label + '</label><div class="help-text">' + hint + '</div>' + rows + '<button type="button" class="btn btn-outline-primary btn-sm" data-add-row="' + section + '.' + key + '">Add Row</button></div>';
    }

    function evidenceListHtml(){
        var rows = (state.evidence.evidenceUploads || []).map(function(file, i){
            return '<tr><td>' + escapeHtml(file.name || '') + '</td><td>' + escapeHtml(file.uploadedOn || 'N/A') + '</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-evidence="' + i + '">Remove</button></td></tr>';
        }).join('');
        return '<div class="mb-3"><label class="form-label">Evidence Upload(s)</label><input type="file" id="uploadedEvidence" class="form-control" accept="application/pdf,image/*,.doc,.docx" multiple>' +
            '<div class="help-text">Upload at least one evidence file. Evidence is mandatory for final submission.</div></div>' +
            '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>File Name</th><th>Uploaded On</th><th></th></tr></thead><tbody>' + (rows || '<tr><td colspan="3" class="text-muted">No evidence uploaded yet.</td></tr>') + '</tbody></table></div>';
    }

    function renderSection(step){
        var host = $('.wizard-section[data-step="' + step + '"]');
        var html = '<div class="card-body"><div class="validation-summary alert alert-warning d-none"></div>';

        if(step === 1){
            html += '<h5>Snapshot</h5><p class="text-muted mb-0">Complaint particulars and complaint details are preloaded and cached for this wizard.</p>';
        }
        if(step === 2){
            html += '<h5>Parties</h5><div class="row g-3">' +
                '<div class="col-md-6"><label class="form-label">Complainant Name</label><input readonly class="form-control bg-light" data-bind="parties.complainantName" value="' + escapeHtml(state.parties.complainantName) + '"></div>' +
                '<div class="col-md-6"><label class="form-label">Origin/Reference (FFR/Source)</label><input readonly class="form-control bg-light" data-bind="parties.originReference" value="' + escapeHtml(state.parties.originReference) + '"></div>' +
                '<div class="col-md-6"><label class="form-label">Accused Name</label><input class="form-control" data-bind="parties.accusedName" value="' + escapeHtml(state.parties.accusedName) + '"></div>' +
                '<div class="col-md-6"><label class="form-label">Accused Designation/Posting</label><input class="form-control" data-bind="parties.accusedDesignation" value="' + escapeHtml(state.parties.accusedDesignation) + '"></div>' +
                '<div class="col-12"><label class="form-label">Background / Intro</label><textarea class="form-control" data-bind="parties.backgroundIntro">' + escapeHtml(state.parties.backgroundIntro) + '</textarea></div>' +
                '<div class="col-12"><label class="form-label">Gist of Complaint</label><textarea class="form-control" data-bind="parties.gistOfComplaint">' + escapeHtml(state.parties.gistOfComplaint) + '</textarea></div></div>';
        }
        if(step === 3){
            html += '<h5>Accusations</h5>' + listEditorHtml('accusations', 'accusationItems', 'Accusations List', 'Add allegation bullets in Annex-A style.');
            var aRows = (state.accusations.accusedRows || []).map(function(r, i){
                return '<tr><td><input class="form-control" data-bind="accusations.accusedRows[' + i + '].mainAccused" value="' + escapeHtml(r.mainAccused) + '"></td><td><input class="form-control" data-bind="accusations.accusedRows[' + i + '].coAccused" value="' + escapeHtml(r.coAccused) + '"></td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="accusations.accusedRows" data-index="' + i + '">Remove</button></td></tr>';
            }).join('');
            html += '<label class="form-label">Main/Co-Accused Mapping</label><table class="table table-sm"><thead><tr><th>Main Accused</th><th>Co-Accused</th><th></th></tr></thead><tbody>' + aRows + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="accusations.accusedRows">Add Row</button>';
        }
        if(step === 4){
            html += '<h5>Proceedings</h5><div class="mb-3"><label class="form-label">Inquiry Methodology / Proceedings</label><textarea class="form-control" data-bind="proceedings.methodology">' + escapeHtml(state.proceedings.methodology) + '</textarea></div>';
            html += listEditorHtml('proceedings', 'recordScrutinized', 'Record Scrutinized', 'Add records/documents scrutinized.');
            var sRows = (state.proceedings.statementRegister || []).map(function(r, i){
                return '<tr><td><input class="form-control" data-bind="proceedings.statementRegister[' + i + '].person" value="' + escapeHtml(r.person) + '"></td><td><input class="form-control" data-bind="proceedings.statementRegister[' + i + '].role" value="' + escapeHtml(r.role) + '"></td><td><input class="form-control" data-bind="proceedings.statementRegister[' + i + '].ppno" value="' + escapeHtml(r.ppno) + '"></td><td><input type="datetime-local" class="form-control" data-bind="proceedings.statementRegister[' + i + '].dateTime" value="' + escapeHtml(r.dateTime) + '"></td><td><input class="form-control" data-bind="proceedings.statementRegister[' + i + '].place" value="' + escapeHtml(r.place) + '"></td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="proceedings.statementRegister" data-index="' + i + '">Remove</button></td></tr>';
            }).join('');
            html += '<label class="form-label">Statement Register</label><table class="table table-sm"><thead><tr><th>Person</th><th>Role</th><th>PPNO</th><th>Date/Time</th><th>Place</th><th></th></tr></thead><tbody>' + sRows + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="proceedings.statementRegister">Add Row</button>';
        }
        if(step === 5){
            html += '<h5>Critical Points</h5><div class="row g-3"><div class="col-md-6"><label class="form-label">Critical points of Complainant</label><textarea class="form-control" data-bind="criticalPoints.complainantPoints">' + escapeHtml(state.criticalPoints.complainantPoints) + '</textarea></div><div class="col-md-6"><label class="form-label">Critical points of Accused</label><textarea class="form-control" data-bind="criticalPoints.accusedPoints">' + escapeHtml(state.criticalPoints.accusedPoints) + '</textarea></div></div>';
        }
        if(step === 6){
            html += '<h5>Evidence</h5>' + listEditorHtml('evidence', 'materialEvidence', 'Material Evidence', 'Add material evidence points.') + listEditorHtml('evidence', 'circumstantialEvidence', 'Circumstantial Evidence', 'Add circumstantial evidence points.') +
                '<div class="mb-3"><label class="form-label">Implications/Notes</label><textarea class="form-control" data-bind="evidence.implications">' + escapeHtml(state.evidence.implications) + '</textarea></div>' + evidenceListHtml();
        }
        if(step === 7){
            html += '<h5>Findings</h5>' + listEditorHtml('findings','findingsList','Findings List','Add concise findings.');
            var pRows = (state.findings.policyReferences || []).map(function(r, i){
                return '<tr><td><input class="form-control" data-bind="findings.policyReferences[' + i + '].reference" value="' + escapeHtml(r.reference) + '"></td><td><input class="form-control" data-bind="findings.policyReferences[' + i + '].note" value="' + escapeHtml(r.note) + '"></td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="findings.policyReferences" data-index="' + i + '">Remove</button></td></tr>';
            }).join('');
            html += '<label class="form-label">Policy / SOP / Circular References</label><table class="table table-sm"><thead><tr><th>Reference</th><th>Note</th><th></th></tr></thead><tbody>' + pRows + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="findings.policyReferences">Add Reference</button>';
        }
        if(step === 8){
            html += '<h5>Violations Matrix</h5>' + violationsBlock('internal','Internal / Procedural Violations') + violationsBlock('policy','Policy Gaps') + violationsBlock('control','Control Violations');
        }
        if(step === 9){
            html += '<h5>Recommendations</h5>' + listEditorHtml('recommendations','recommendationsList','Recommendations','Add actionable recommendation(s).') + listEditorHtml('recommendations','dsaFramedAgainst','DSA Framed Against','Add responsible party names/entries.') +
                '<div class="mb-3"><label class="form-label">Root Cause</label><textarea class="form-control" data-bind="recommendations.rootCause">' + escapeHtml(state.recommendations.rootCause) + '</textarea></div>' +
                '<div class="row g-3"><div class="col-md-6"><label class="form-label">Reported in audit report?</label><select class="form-select" data-bind="recommendations.reportedInAudit"><option value="">Select</option><option value="Yes" ' + (state.recommendations.reportedInAudit === 'Yes' ? 'selected' : '') + '>Yes</option><option value="No" ' + (state.recommendations.reportedInAudit === 'No' ? 'selected' : '') + '>No</option></select></div>' +
                '<div class="col-md-6"><label class="form-label">Audit report details (if Yes)</label><input class="form-control" data-bind="recommendations.auditDetails" value="' + escapeHtml(state.recommendations.auditDetails) + '"></div></div>';
        }

        html += actionButtons(step) + '</div>';
        host.html(html);
        if(isLocked){ host.find('input,textarea,select,button').prop('disabled', true); }
    }

    function violationsBlock(key, title){
        var b = state.violations[key];
        var rows = (b.rows || []).map(function(r, i){
            return '<tr><td><input class="form-control" data-bind="violations.' + key + '.rows[' + i + '].detail" value="' + escapeHtml(r.detail) + '"></td><td><input class="form-control" data-bind="violations.' + key + '.rows[' + i + '].reference" value="' + escapeHtml(r.reference) + '"></td><td><input class="form-control" data-bind="violations.' + key + '.rows[' + i + '].recommendation" value="' + escapeHtml(r.recommendation) + '"></td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="violations.' + key + '.rows" data-index="' + i + '">Remove</button></td></tr>';
        }).join('');
        return '<div class="mb-3"><h6>' + title + '</h6><div class="form-check mb-2"><input class="form-check-input" type="checkbox" data-bind="violations.' + key + '.na" ' + (b.na ? 'checked' : '') + '><label class="form-check-label">Not Applicable</label></div><input class="form-control mb-2" placeholder="Justification required when Not Applicable" data-bind="violations.' + key + '.justification" value="' + escapeHtml(b.justification) + '"><table class="table table-sm"><thead><tr><th>Violation detail</th><th>Reference</th><th>Recommendation</th><th></th></tr></thead><tbody>' + rows + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="violations.' + key + '.rows">Add Row</button></div>';
    }

    function actionButtons(step){
        return '<div class="d-flex justify-content-between mt-4"><div><button type="button" class="btn btn-outline-secondary" data-prev ' + (step === 1 ? 'disabled' : '') + '>Previous</button></div><div class="d-flex gap-2"><button type="button" class="btn btn-primary" data-save>Save Section</button><button type="button" class="btn btn-success" data-next>' + (step === steps.length ? 'Review' : 'Next') + '</button>' + (step === steps.length ? '<button type="button" class="btn btn-danger" id="finalSubmitBtn">Final Submit</button>' : '') + '</div></div>';
    }

    function getByPath(path){ return path.split('.').reduce(function(a, p){ var m = p.match(/(\w+)\[(\d+)\]/); return m ? (a[m[1]] || [])[parseInt(m[2])] : a[p]; }, state); }
    function setByPath(path, value){
        var parts = path.split('.'); var obj = state;
        for(var i=0;i<parts.length-1;i++){
            var m = parts[i].match(/(\w+)\[(\d+)\]/);
            if(m){ obj = obj[m[1]][parseInt(m[2])]; } else { obj = obj[parts[i]]; }
        }
        var last = parts[parts.length-1], lm = last.match(/(\w+)\[(\d+)\]/);
        if(lm){ obj[lm[1]][parseInt(lm[2])] = value; } else { obj[last] = value; }
    }

    function addRow(path){
        var arr = getByPath(path);
        if(path.indexOf('accusedRows')>0){ arr.push({ mainAccused:'', coAccused:'' }); }
        else if(path.indexOf('statementRegister')>0){ arr.push({ person:'', role:'', ppno:'', dateTime:'', place:'' }); }
        else if(path.indexOf('policyReferences')>0){ arr.push({ reference:'', note:'' }); }
        else if(path.indexOf('.rows')>0){ arr.push({ detail:'', reference:'', recommendation:'' }); }
        else { arr.push(''); }
    }

    function bindSectionEvents(){
        $('.wizard-section[data-step="' + currentStep + '"] [data-bind]').off('input change').on('input change', function(){
            var bind = $(this).data('bind');
            var val = this.type === 'checkbox' ? this.checked : $(this).val();
            setByPath(bind, val);
        });
    }

    function validateStep(step){
        var missing = [];
        function filled(v){ return !!(v && String(v).trim()); }
        function oneFilled(arr, fn){ return (arr || []).some(fn || filled); }

        if(step === 2){
            if(!filled(state.parties.complainantName)) missing.push('Complainant Name');
            if(!filled(state.parties.originReference)) missing.push('Origin/Reference');
            if(!filled(state.parties.accusedName)) missing.push('Accused Name');
            if(!filled(state.parties.backgroundIntro)) missing.push('Background / Intro');
            if(!filled(state.parties.gistOfComplaint)) missing.push('Gist of Complaint');
        }
        if(step === 3){
            if(!oneFilled(state.accusations.accusationItems)) missing.push('At least 1 accusation item');
            if(!oneFilled(state.accusations.accusedRows, function(r){ return filled(r.mainAccused) || filled(r.coAccused); })) missing.push('At least 1 accused mapping row');
        }
        if(step === 4){
            if(!filled(state.proceedings.methodology)) missing.push('Inquiry Methodology / Proceedings');
            if(!oneFilled(state.proceedings.recordScrutinized)) missing.push('Record scrutinized (at least 1)');
            if(!oneFilled(state.proceedings.statementRegister, function(r){ return filled(r.person)&&filled(r.role)&&filled(r.ppno)&&filled(r.dateTime)&&filled(r.place);} )) missing.push('Statement register (at least 1 complete entry)');
        }
        if(step === 5){
            if(!filled(state.criticalPoints.complainantPoints)) missing.push('Critical points of Complainant');
            if(!filled(state.criticalPoints.accusedPoints)) missing.push('Critical points of Accused');
        }
        if(step === 6){
            if(!oneFilled(state.evidence.materialEvidence)) missing.push('Material evidence');
            if(!oneFilled(state.evidence.circumstantialEvidence)) missing.push('Circumstantial evidence');
            if(!filled(state.evidence.implications)) missing.push('Implications/notes');
            if(!(state.evidence.evidenceUploads || []).length) missing.push('At least one evidence upload');
        }
        if(step === 7){
            if(!oneFilled(state.findings.findingsList)) missing.push('At least 1 finding');
            if(!oneFilled(state.findings.policyReferences, function(r){ return filled(r.reference);} )) missing.push('Policy/SOP/Circular reference');
        }
        if(step === 8){
            ['internal','policy','control'].forEach(function(k){
                var b = state.violations[k];
                var ok = b.na ? filled(b.justification) : oneFilled(b.rows, function(r){ return filled(r.detail)&&filled(r.reference)&&filled(r.recommendation); });
                if(!ok) missing.push('Violations matrix: ' + k);
            });
        }
        if(step === 9){
            if(!oneFilled(state.recommendations.recommendationsList)) missing.push('At least 1 recommendation');
            if(!filled(state.recommendations.rootCause)) missing.push('Root Cause');
            if(!filled(state.recommendations.reportedInAudit)) missing.push('Reported in audit report?');
            if(state.recommendations.reportedInAudit==='Yes' && !filled(state.recommendations.auditDetails)) missing.push('Audit details required when Yes');
            if(!oneFilled(state.recommendations.dsaFramedAgainst)) missing.push('DSA framed against');
        }
        return missing;
    }

    function isStepCompleted(step){ return step === 1 || validateStep(step).length === 0; }

    function showValidation(step, errors){
        var host = $('.wizard-section[data-step="' + step + '"] .validation-summary');
        if(!errors.length){ host.addClass('d-none').html(''); return; }
        host.removeClass('d-none').html('<strong>Missing mandatory fields:</strong><ul class="mb-0">' + errors.map(function(e){ return '<li>' + escapeHtml(e) + '</li>'; }).join('') + '</ul>');
    }

    function buildPayload(sectionCode){
        var fd = new FormData();
        fd.append('__RequestVerificationToken', $('#reportForm input[name="__RequestVerificationToken"]').val());
        fd.append('ComplaintId', complaintId);
        fd.append('sectionCode', sectionCode);
        fd.append('NameComplainant', state.parties.complainantName || '');
        fd.append('NameAccused', state.parties.accusedName || '');
        fd.append('Gist', JSON.stringify({ parties: state.parties, accusations: state.accusations, criticalPoints: state.criticalPoints, evidence: state.evidence }));
        fd.append('Proceedings', JSON.stringify(state.proceedings));
        fd.append('Findings', JSON.stringify({ findings: state.findings, violations: state.violations }));
        fd.append('Recommendation', JSON.stringify(state.recommendations));
        (state.evidence.evidenceUploads || []).forEach(function(file){ if(file.raw){ fd.append('UploadedEvidence', file.raw); } });
        return fd;
    }

    function saveSection(step, isFinal){
        var errs = validateStep(step);
        showValidation(step, errs);
        if(errs.length){ return $.Deferred().reject().promise(); }

        var sectionCode = steps[step - 1].code;
        return $.ajax({
            url: g_asiBaseURL + '/ApiCalls/AddInquiryReport',
            type: 'POST',
            data: buildPayload(sectionCode),
            processData: false,
            contentType: false
        }).done(function(resp){
            if(resp && resp.ok === false){ showAlert(resp.message || 'Save failed.', 'danger'); return; }
            showAlert(isFinal ? 'Final submit completed successfully.' : ('Section ' + sectionCode + ' saved successfully.'), 'success');
            state.evidence.evidenceUploads = (state.evidence.evidenceUploads || []).map(function(x){ return $.extend({}, x, { raw: null, existing: true }); });
            if(isFinal){
                isLocked = true;
                $('#reportStatusBadge').removeClass('bg-secondary').addClass('bg-success').text('Submitted');
                $('.wizard-section input, .wizard-section textarea, .wizard-section select, .wizard-section button').prop('disabled', true);
            }
            renderStepper();
            renderCurrent();
        }).fail(function(){
            showAlert('Failed to save section.', 'danger');
        });
    }

    function renderCurrent(){
        renderSection(currentStep);
        $('.wizard-section').addClass('d-none');
        $('.wizard-section[data-step="' + currentStep + '"]').removeClass('d-none');
        renderStepper();
        bindSectionEvents();
    }

    function loadAll(){
        if(!complaintId){
            showAlert('Complaint ID is missing. Open this page from Task List.', 'danger');
            $('button').prop('disabled', true);
            return;
        }

        $.post(g_asiBaseURL + '/ApiCalls/GetComplaint', { complaintId: complaintId }).done(function(c){
            var normalized = normalizeComplaint(c);
            window._iidComplaint = normalized;
            renderComplaintCache(normalized);

            state.snapshot = {
                complaintNo: getComplaintValue(normalized, ['ComplaintNo', 'complaintNo'], c.complaintNo),
                submittedOn: getComplaintValue(normalized, ['SubmittedOn', 'submittedOn'], c.submittedOn),
                region: getComplaintValue(normalized, ['Region', 'region'], c.region),
                branch: getComplaintValue(normalized, ['Branch', 'branch'], c.branch),
                category: getComplaintValue(normalized, ['Category', 'category'], c.category),
                nature: getComplaintValue(normalized, ['Nature', 'nature'], c.nature)
            };
            syncComplaintIntoState();
            renderSnapshotStrip();
        }).fail(function(){
            showAlert('Failed to load complaint details.', 'danger');
        }).always(function(){
            $.post(g_asiBaseURL + '/ApiCalls/GetLatestInquiryReportByComplaintId', { complaintId: complaintId }).done(function(resp){
                hydrateDraft(resp);
                syncComplaintIntoState();
                renderCurrent();
            }).fail(function(){
                syncComplaintIntoState();
                renderCurrent();
            });
        });
    }

    $(document).on('click', '[data-step-jump]', function(){ currentStep = parseInt($(this).data('step-jump')); renderCurrent(); });
    $(document).on('click', '[data-add-row]', function(){ addRow($(this).data('add-row')); renderCurrent(); });
    $(document).on('click', '[data-remove-row]', function(){
        var arr = getByPath($(this).data('remove-row'));
        arr.splice(parseInt($(this).data('index')), 1);
        if(!arr.length){ addRow($(this).data('remove-row')); }
        renderCurrent();
    });
    $(document).on('click', '[data-remove-evidence]', function(){
        state.evidence.evidenceUploads.splice(parseInt($(this).data('remove-evidence')), 1);
        renderCurrent();
    });
    $(document).on('change', '#uploadedEvidence', function(){
        var files = Array.prototype.slice.call(this.files || []);
        var stamp = new Date().toLocaleString();
        files.forEach(function(file){ state.evidence.evidenceUploads.push({ name: file.name, uploadedOn: stamp, raw: file, existing: false }); });
        this.value = '';
        renderCurrent();
    });
    $(document).on('click', '[data-prev]', function(){ if(currentStep > 1){ currentStep--; renderCurrent(); } });
    $(document).on('click', '[data-next]', function(){
        var errs = validateStep(currentStep);
        showValidation(currentStep, errs);
        if(errs.length){ return; }
        if(currentStep < steps.length){ currentStep++; renderCurrent(); }
    });
    $(document).on('click', '[data-save]', function(){ saveSection(currentStep, false); });
    $(document).on('click', '#finalSubmitBtn', function(){
        var allComplete = steps.every(function(s){ return isStepCompleted(s.id); });
        if(!allComplete){ showAlert('Complete all mandatory sections before final submit.', 'danger'); return; }
        saveSection(steps.length, true);
    });

    loadAll();
});
</script>
<style>
.wizard-stepper{display:grid;grid-template-columns:repeat(9,minmax(120px,1fr));gap:.4rem;overflow:auto}
.step-pill{border:1px solid #ced4da;background:#fff;border-radius:.5rem;padding:.35rem .5rem;text-align:left}
.step-pill .num{font-weight:700;margin-right:.35rem}
.step-pill small{display:block;color:#6c757d}
.step-pill.active{border-color:#0d6efd;box-shadow:0 0 0 2px rgba(13,110,253,.15)}
.step-pill.completed{background:#ecf9f0;border-color:#198754}
.snap-label{color:#6c757d}
.snap-value{font-weight:600}
.help-text{font-size:.8rem;color:#6c757d}
.validation-summary{font-size:.9rem}
</style>
}
