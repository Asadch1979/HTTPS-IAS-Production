@model AIS.Models.IID.InquiryReportModel
@{
    ViewData["Title"] = "Inquiry Report";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div id="iidAlertHost" class="mb-2"></div>

<div class="inquiry-header card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h4 class="mb-1">Inquiry Report</h4>
                <div class="text-muted small">Mandatory sectioned wizard aligned with Wazirabad reporting standards.</div>
            </div>
            <span id="reportStatusBadge" class="badge bg-secondary">Draft</span>
        </div>
        <div class="row g-2 mt-2 small">
            <div class="col-md-4 col-12">
                <div class="snap-label">Complainant Name</div>
                <div id="headerComplainantName" class="snap-value">N/A</div>
            </div>
        </div>
        <div id="snapshotStrip" class="row g-2 mt-2 small"></div>
    </div>
</div>

<div id="iidComplaintHiddenCache" class="d-none" style="display:none;"></div>
<div id="iidAntiForgeryWrap" class="d-none">@Html.AntiForgeryToken()</div>

<div class="stepper-wrap sticky-top bg-white py-2 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong id="stepCounter">Step 1 of 8</strong>
        <span class="text-muted small">Click any step to navigate</span>
    </div>
    <div id="wizardStepper" class="wizard-stepper"></div>
</div>

<div class="wizard-section card mb-3" data-step="1"></div>
<div class="wizard-section card mb-3 d-none" data-step="2"></div>
<div class="wizard-section card mb-3 d-none" data-step="3"></div>
<div class="wizard-section card mb-3 d-none" data-step="4"></div>
<div class="wizard-section card mb-3 d-none" data-step="5"></div>
<div class="wizard-section card mb-3 d-none" data-step="6"></div>
<div class="wizard-section card mb-3 d-none" data-step="7"></div>
<div class="wizard-section card mb-3 d-none" data-step="8"></div>

@section Scripts {
<script src="~/js/iid/inquiryReportApi.js"></script>
<script>
$(function(){
    var complaintId = parseInt('@complaintId') || 0;
    var currentStep = 1;
    var isLocked = false;
    var userId = 0;
    var alertTimer = null;
    var accusedRoleOptions = ['Main', 'Co'];
    var steps = [
        { id: 1, code: 'SNAPSHOT', title: 'Snapshot' },
        { id: 2, code: 'ACCUSATIONS', title: 'Accusations' },
        { id: 3, code: 'ACCUSED_LIST', title: 'Accused List' },
        { id: 4, code: 'RECORDS', title: 'Record Scrutinized' },
        { id: 5, code: 'STATEMENTS', title: 'Statement Register' },
        { id: 6, code: 'EVIDENCE', title: 'Evidence' },
        { id: 7, code: 'VIOLATIONS', title: 'Violations' },
        { id: 8, code: 'DSA', title: 'DSA / Finalize' }
    ];

    var state = {
        snapshot: {},
        complainantName: '',
        complainantCnic: '',
        accusations: [{ accusationId: 0, accusationText: '', sortOrder: 1 }],
        accused: [{ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: 1 }],
        records: [{ recId: 0, recordTitle: '', recordDetails: '', sortOrder: 1 }],
        statements: [],
        statementDrafts: { complainant: emptyStatementEntry('Complainant'), accused: emptyStatementEntry('Accused') },
        evidence: [],
        violations: [{ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: 1 }],
        dsa: [{ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: 1 }],
        deleteQueue: { accusations: [], accused: [], records: [], statements: [], violations: [], dsa: [] },
        savedSteps: { 1: true, 2: false, 3: false, 4: false, 5: false, 6: false, 7: false, 8: false },
        dirtySteps: {}
    };

    function token(){ return $('#iidAntiForgeryWrap input[name="__RequestVerificationToken"]').val(); }
    function esc(v){ return $('<div/>').text(v || '').html(); }
    function extractData(resp){ return (resp && (resp.data || resp.Data)) || []; }

    function getResponseMessage(resp){
        if(!resp){ return ''; }
        if(resp.message){ return resp.message; }
        if(resp.data && resp.data.message){ return resp.data.message; }
        return '';
    }

    function ensureApiSuccess(resp, fallback){
        if(resp && resp.ok === false){
            throw new Error(getResponseMessage(resp) || fallback || 'Operation failed.');
        }
        return resp;
    }

    function showAlert(message, type){
        clearTimeout(alertTimer);
        $('#iidAlertHost').html('<div class="alert alert-' + (type || 'danger') + ' alert-dismissible fade show">' +
            esc(message) + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        alertTimer = setTimeout(function(){ $('#iidAlertHost .alert').alert('close'); }, 4500);
    }

    function markDirty(step){
        if(step > 1){ state.dirtySteps[step] = true; state.savedSteps[step] = false; }
    }

    function hasUnsavedStep(step){ return !!state.dirtySteps[step]; }

    function isStepSaved(step){
        if(step === 1){ return true; }
        return !!state.savedSteps[step] && !state.dirtySteps[step];
    }

    function renderStepper(){
        $('#stepCounter').text('Step ' + currentStep + ' of ' + steps.length);
        $('#wizardStepper').html(steps.map(function(s){
            var saved = isStepSaved(s.id);
            return '<button type="button" class="step-pill ' + (s.id===currentStep?'active':'') + ' ' + (saved?'completed':'not-saved') + '" data-step-jump="' + s.id + '"><span class="num">' + s.id + '</span>' + esc(s.title) + '<span class="step-state ms-2 badge ' + (saved?'bg-success':'bg-secondary') + '">' + (saved?'Saved':'Not Saved') + '</span></button>';
        }).join(''));
    }

    function renderSnapshotStrip(){
        var s = state.snapshot;
        var badges = [
            ['Complaint No', s.complaintNo || 'N/A'], ['Submitted', s.submittedOn || 'N/A'], ['Region', s.region || 'N/A'], ['Branch', s.branch || 'N/A'], ['Category', s.category || 'N/A']
        ];
        $('#snapshotStrip').html(badges.map(function(b){ return '<div class="col-md-2 col-6"><div class="snap-label">' + esc(b[0]) + '</div><div class="snap-value">' + esc(b[1]) + '</div></div>'; }).join(''));
    }

    function rowInput(bind, value, type){
        return '<input ' + (type ? 'type="' + type + '"' : '') + ' class="form-control" data-bind="' + bind + '" value="' + esc(value) + '">';
    }

    function sectionActions(step){
        return '<div class="d-flex justify-content-between mt-4"><button type="button" class="btn btn-outline-secondary" data-prev ' + (step===1?'disabled':'') + '>Previous</button><div class="d-flex gap-2"><button type="button" class="btn btn-primary" data-save>Save Section</button><button type="button" class="btn btn-success" data-next>' + (step===steps.length?'Review':'Next') + '</button>' + (step===steps.length?'<button type="button" class="btn btn-danger" id="finalSubmitBtn">Final Submit</button>':'') + '</div></div>';
    }

    function roleOptionsHtml(selected){
        return accusedRoleOptions.map(function(opt){ return '<option value="' + esc(opt) + '" ' + (opt===selected?'selected':'') + '>' + esc(opt) + '</option>'; }).join('');
    }

    function emptyStatementEntry(role){
        return {
            statementId: 0,
            roleType: role,
            ppnoNumber: '',
            personName: '',
            fatherName: '',
            cnic: '',
            statementDatetime: '',
            place: '',
            modeType: 'In Person',
            keyPoints: ''
        };
    }

    function normalizeDigits(v, maxLen){
        var out = String(v || '').replace(/\D/g, '');
        if(maxLen){ out = out.substring(0, maxLen); }
        return out;
    }

    function toDateTimeLocal(v){
        if(!v){ return ''; }
        var raw = String(v);
        if(raw.indexOf('T') >= 0){ return raw.substring(0, 16); }
        var d = new Date(raw);
        if(isNaN(d.getTime())){ return ''; }
        var pad = function(n){ return n < 10 ? '0' + n : '' + n; };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function mapStatementRow(x){
        return {
            statementId: x.statementId || 0,
            roleType: x.roleType || 'Complainant',
            ppnoNumber: x.ppnoNumber || '',
            personName: x.personName || '',
            fatherName: x.fatherName || '',
            cnic: normalizeDigits(x.cnic || '', 13),
            statementDatetime: toDateTimeLocal(x.statementDatetime),
            place: x.place || '',
            modeType: x.modeType || 'In Person',
            keyPoints: x.keyPoints || ''
        };
    }

    function renderSection(step){
        var h = $('.wizard-section[data-step="' + step + '"]');
        var html = '<div class="card-body"><div class="validation-summary alert alert-warning d-none"></div>';
        if(step === 1){
            var snap = state.snapshot || {};
            html += '<h5>Snapshot</h5><p class="text-muted">Complaint and complainant data loaded.</p>';
            html += '<div class="row g-3"><div class="col-lg-6"><div class="card border-0 bg-light"><div class="card-body"><h6 class="mb-3">Complainant Details</h6><div class="row g-2 small"><div class="col-6"><span class="text-muted">Name</span><div class="fw-semibold">' + esc(snap.complainantName || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">CNIC</span><div class="fw-semibold">' + esc(snap.cnic || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Cell No</span><div>' + esc(snap.cellularNumber || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Gender</span><div>' + esc(snap.gender || 'N/A') + '</div></div><div class="col-12"><span class="text-muted">Address</span><div>' + esc(snap.mailingAddress || 'N/A') + '</div></div><div class="col-12"><span class="text-muted">Received From</span><div>' + esc(snap.receivedFrom || 'N/A') + '</div></div></div></div></div></div><div class="col-lg-6"><div class="card border-0 bg-light"><div class="card-body"><h6 class="mb-3">Complaint Details</h6><div class="row g-2 small"><div class="col-6"><span class="text-muted">Complaint No</span><div class="fw-semibold">' + esc(snap.complaintNo || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Submitted On</span><div>' + esc(snap.submittedOn || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Nature</span><div>' + esc(snap.nature || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Category</span><div>' + esc(snap.category || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Region</span><div>' + esc(snap.region || 'N/A') + '</div></div><div class="col-6"><span class="text-muted">Branch</span><div>' + esc(snap.branch || 'N/A') + '</div></div><div class="col-12"><span class="text-muted">Action Required</span><div>' + esc(snap.actionRequired || 'N/A') + '</div></div><div class="col-12"><span class="text-muted">Contents</span><div>' + esc(snap.contents || 'N/A') + '</div></div></div></div></div></div></div>';
        }
        if(step === 2){
            var rowsA = state.accusations.map(function(r,i){ return '<tr data-row-id="' + (r.accusationId || 0) + '"><td>' + rowInput('accusations['+i+'].accusationText', r.accusationText) + '</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="accusations" data-index="'+i+'">Remove</button></td></tr>'; }).join('');
            html += '<h5>Accusations</h5><table class="table table-sm"><thead><tr><th>Accusation</th><th></th></tr></thead><tbody>' + rowsA + '</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="accusations">Add Row</button>';
        }
        if(step === 3){
            var rowsAc = state.accused.map(function(r,i){
                return '<tr data-row-id="' + (r.accusedRowId || 0) + '"><td><input type="hidden" data-bind="accused['+i+'].accusedRowId" value="' + esc(r.accusedRowId || 0) + '">' + rowInput('accused['+i+'].personName',r.personName) + '</td><td>'+rowInput('accused['+i+'].designation',r.designation)+'</td><td><select class="form-select" data-bind="accused['+i+'].roleType">' + roleOptionsHtml(r.roleType || 'Main') + '</select></td><td>'+rowInput('accused['+i+'].ppnoNumber',r.ppnoNumber)+'</td><td>'+rowInput('accused['+i+'].cnic',r.cnic)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="accused" data-index="'+i+'">Remove</button></td></tr>';
            }).join('');
            html += '<h5>Accused List</h5><table class="table table-sm"><thead><tr><th>Name</th><th>Designation</th><th>Role</th><th>PPNO</th><th>CNIC</th><th></th></tr></thead><tbody>'+rowsAc+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="accused">Add Row</button>';
        }
        if(step === 4){
            var rowsR = state.records.map(function(r,i){ return '<tr data-row-id="' + (r.recId || 0) + '"><td>'+rowInput('records['+i+'].recordTitle',r.recordTitle)+'</td><td>'+rowInput('records['+i+'].recordDetails',r.recordDetails)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="records" data-index="'+i+'">Remove</button></td></tr>'; }).join('');
            html += '<h5>Record Scrutinized</h5><table class="table table-sm"><thead><tr><th>Record Title</th><th>Details</th><th></th></tr></thead><tbody>'+rowsR+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="records">Add Row</button>';
        }

        if(step === 5){
            var complainantRows = state.statements.filter(function(x){ return (x.roleType || '').toLowerCase() === 'complainant'; });
            var accusedRows = state.statements.filter(function(x){ return (x.roleType || '').toLowerCase() === 'accused'; });
            var cDraft = state.statementDrafts.complainant;
            var aDraft = state.statementDrafts.accused;
            var complainantGrid = complainantRows.map(function(r){
                return '<tr data-row-id="' + (r.statementId || 0) + '"><td>' + esc(r.cnic) + '</td><td>' + esc(r.personName) + '</td><td>' + esc(r.fatherName || '') + '</td><td>' + esc(r.statementDatetime) + '</td><td>' + esc(r.place) + '</td><td><button type="button" class="btn btn-outline-secondary btn-sm me-1" data-edit-statement="' + (r.statementId || 0) + '">Edit</button><button type="button" class="btn btn-outline-danger btn-sm" data-remove-statement="' + (r.statementId || 0) + '">Remove</button></td></tr>';
            }).join('');
            var accusedGrid = accusedRows.map(function(r){
                return '<tr data-row-id="' + (r.statementId || 0) + '"><td>' + esc(r.ppnoNumber || '') + '</td><td>' + esc(r.personName) + '</td><td>' + esc(r.fatherName || '') + '</td><td>' + esc(r.cnic) + '</td><td>' + esc(r.statementDatetime) + '</td><td>' + esc(r.place) + '</td><td><button type="button" class="btn btn-outline-secondary btn-sm me-1" data-edit-statement="' + (r.statementId || 0) + '">Edit</button><button type="button" class="btn btn-outline-danger btn-sm" data-remove-statement="' + (r.statementId || 0) + '">Remove</button></td></tr>';
            }).join('');

            html += '<h5>Statement Register</h5><div class="alert alert-info py-2">Grids below always show saved database records.</div>';
            html += '<div class="card mb-3"><div class="card-body"><h6 class="mb-3">Complainant Statement</h6><div class="row g-2">'
                + '<div class="col-md-3"><label class="form-label">CNIC <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="complainant.cnic" value="' + esc(cDraft.cnic) + '" maxlength="13" inputmode="numeric" placeholder="Digits only"></div>'
                + '<div class="col-md-3"><label class="form-label">Name <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="complainant.personName" value="' + esc(cDraft.personName) + '"></div>'
                + '<div class="col-md-3"><label class="form-label">Father Name <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="complainant.fatherName" value="' + esc(cDraft.fatherName || '') + '"></div>'
                + '<div class="col-md-3"><label class="form-label">Date/Time <span class="text-danger">*</span></label><input type="datetime-local" class="form-control" data-statement-entry="complainant.statementDatetime" value="' + esc(cDraft.statementDatetime) + '"></div>'
                + '<div class="col-md-9"><label class="form-label">Place of Statement <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="complainant.place" value="' + esc(cDraft.place) + '"></div>'
                + '<div class="col-md-3 d-flex align-items-end"><button type="button" class="btn btn-primary w-100" data-save-statement="complainant">Save Complainant</button></div>'
                + '</div><div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>CNIC</th><th>Name</th><th>Father Name</th><th>Date/Time</th><th>Place</th><th>Action</th></tr></thead><tbody>' + (complainantGrid || '<tr><td colspan="6" class="text-muted">No complainant statements found.</td></tr>') + '</tbody></table></div></div></div>';

            html += '<div class="card"><div class="card-body"><h6 class="mb-3">Accused Statement</h6><div class="row g-2 align-items-end mb-3">'
                + '<div class="col-md-3"><label class="form-label">PPNO</label><input class="form-control" data-accused-search-ppno value="" inputmode="numeric" placeholder="Numeric only"></div>'
                + '<div class="col-md-2"><button type="button" class="btn btn-outline-primary w-100" data-search-accused>Search</button></div>'
                + '</div><div class="row g-2">'
                + '<div class="col-md-2"><label class="form-label">PPNO</label><input class="form-control" data-statement-entry="accused.ppnoNumber" value="' + esc(aDraft.ppnoNumber) + '" inputmode="numeric"></div>'
                + '<div class="col-md-3"><label class="form-label">Name <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="accused.personName" value="' + esc(aDraft.personName) + '"></div>'
                + '<div class="col-md-3"><label class="form-label">Father Name <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="accused.fatherName" value="' + esc(aDraft.fatherName || '') + '"></div>'
                + '<div class="col-md-2"><label class="form-label">CNIC <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="accused.cnic" value="' + esc(aDraft.cnic) + '" maxlength="13" inputmode="numeric" placeholder="Digits only"></div>'
                + '<div class="col-md-2"><label class="form-label">Date/Time <span class="text-danger">*</span></label><input type="datetime-local" class="form-control" data-statement-entry="accused.statementDatetime" value="' + esc(aDraft.statementDatetime) + '"></div>'
                + '<div class="col-md-10"><label class="form-label">Place of Statement <span class="text-danger">*</span></label><input class="form-control" data-statement-entry="accused.place" value="' + esc(aDraft.place) + '"></div>'
                + '<div class="col-md-2 d-flex align-items-end"><button type="button" class="btn btn-primary w-100" data-save-statement="accused">Save Accused</button></div>'
                + '</div><div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>PPNO</th><th>Name</th><th>Father Name</th><th>CNIC</th><th>Date/Time</th><th>Place</th><th>Action</th></tr></thead><tbody>' + (accusedGrid || '<tr><td colspan="7" class="text-muted">No accused statements found.</td></tr>') + '</tbody></table></div></div></div>';
        }
        if(step === 6){
{
            var rowsE = state.evidence.map(function(r){ return '<tr><td>'+esc(r.fileName)+'</td><td>'+esc(r.evidenceType || 'N/A')+'</td><td>'+esc(r.uploadedOn || 'N/A')+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-delete-evidence="'+ r.evidenceId +'">Remove</button></td></tr>'; }).join('');
            html += '<h5>Evidence</h5><div class="mb-3"><label class="form-label">Upload evidence files</label><input id="uploadedEvidence" type="file" class="form-control" multiple></div><table class="table table-sm"><thead><tr><th>File</th><th>Type</th><th>Uploaded On</th><th></th></tr></thead><tbody>' + (rowsE || '<tr><td colspan="4" class="text-muted">No evidence uploaded.</td></tr>') + '</tbody></table>';
        }
        if(step === 7){
            var rowsV = state.violations.map(function(r,i){ return '<tr data-row-id="' + (r.violationId || 0) + '"><td>'+rowInput('violations['+i+'].category',r.category)+'</td><td>'+rowInput('violations['+i+'].violationDetail',r.violationDetail)+'</td><td>'+rowInput('violations['+i+'].referenceText',r.referenceText)+'</td><td>'+rowInput('violations['+i+'].recommendation',r.recommendation)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="violations" data-index="'+i+'">Remove</button></td></tr>'; }).join('');
            html += '<h5>Violations (Annex-III)</h5><table class="table table-sm"><thead><tr><th>Category</th><th>Detail</th><th>Reference</th><th>Recommendation</th><th></th></tr></thead><tbody>'+rowsV+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="violations">Add Row</button>';
        }
        if(step === 8){
            var rowsD = state.dsa.map(function(r,i){ return '<tr data-row-id="' + (r.dsaId || 0) + '"><td>'+rowInput('dsa['+i+'].personName',r.personName)+'</td><td>'+rowInput('dsa['+i+'].designation',r.designation)+'</td><td>'+rowInput('dsa['+i+'].ppnoNumber',r.ppnoNumber)+'</td><td>'+rowInput('dsa['+i+'].cnic',r.cnic)+'</td><td>'+rowInput('dsa['+i+'].dsaStatus',r.dsaStatus)+'</td><td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-row="dsa" data-index="'+i+'">Remove</button></td></tr>'; }).join('');
            html += '<h5>DSA</h5><table class="table table-sm"><thead><tr><th>Person</th><th>Designation</th><th>PPNO</th><th>CNIC</th><th>Status</th><th></th></tr></thead><tbody>'+rowsD+'</tbody></table><button type="button" class="btn btn-outline-primary btn-sm" data-add-row="dsa">Add Row</button>';
        }
        html += sectionActions(step) + '</div>';
        h.html(html);
        if(isLocked){ h.find('input,textarea,select,button').prop('disabled', true); }
    }

    function bindStepInputs(){
        $('.wizard-section[data-step="' + currentStep + '"] [data-bind]').off('input change').on('input change', function(){
            var key = $(this).data('bind');
            var m = key.match(/^(\w+)\[(\d+)\]\.(\w+)$/);
            if(!m){ return; }
            state[m[1]][parseInt(m[2],10)][m[3]] = $(this).val();
            markDirty(currentStep);
            renderStepper();
        });
    }


    function setStatementDraft(role, field, value){
        var draft = state.statementDrafts[role];
        if(!draft){ return; }
        var nextVal = value;
        if(field === 'cnic'){ nextVal = normalizeDigits(value, 13); }
        if(field === 'ppnoNumber'){ nextVal = normalizeDigits(value); }
        draft[field] = nextVal;
        markDirty(5);
    }

    function validateStatementEntry(role){
        var d = state.statementDrafts[role];
        var errors = [];
        if(!d){ return ['Invalid statement role.']; }
        if(!d.personName || !String(d.personName).trim()){ errors.push('Name is required.'); }
        if(!d.fatherName || !String(d.fatherName).trim()){ errors.push('Father Name is required.'); }
        if(!d.statementDatetime || !String(d.statementDatetime).trim()){ errors.push('Date/Time is required.'); }
        if(!d.place || !String(d.place).trim()){ errors.push('Place of Statement is required.'); }

        var cnic = normalizeDigits(d.cnic, 13);
        d.cnic = cnic;
        if(!cnic || cnic.length !== 13){ errors.push('CNIC must be 13 digits.'); }

        if(role === 'accused' && d.ppnoNumber && normalizeDigits(d.ppnoNumber) !== String(d.ppnoNumber)){
            errors.push('PPNO must be numeric only.');
        }
        return errors;
    }

    function statementPayload(role){
        var d = state.statementDrafts[role];
        return {
            statementId: d.statementId || 0,
            complaintId: complaintId,
            personName: d.personName,
            fatherName: d.fatherName,
            roleType: role === 'complainant' ? 'Complainant' : 'Accused',
            ppnoNumber: role === 'complainant' ? '' : (d.ppnoNumber || ''),
            cnic: normalizeDigits(d.cnic, 13),
            statementDatetime: d.statementDatetime,
            place: d.place,
            modeType: 'In Person',
            keyPoints: '',
            status: 'A',
            createdBy: userId,
            updatedBy: userId
        };
    }

    function saveStatement(role){
        var errors = validateStatementEntry(role);
        showValidation(5, errors);
        if(errors.length){ return $.Deferred().reject({ message: errors[0] }).promise(); }

        var payload = statementPayload(role);
        var req = payload.statementId > 0 ? window.iidUpdateInqStatement(payload) : window.iidAddInqStatement(payload);

        return req.then(function(resp){
            ensureApiSuccess(resp, 'Failed to save statement.');
            var msg = getResponseMessage(resp) || 'Statement saved successfully.';
            return window.iidGetInqStatements(complaintId).then(function(loadResp){
                ensureApiSuccess(loadResp, 'Failed to reload statements.');
                state.statements = extractData(loadResp).map(mapStatementRow);
                state.statementDrafts[role] = emptyStatementEntry(role === 'complainant' ? 'Complainant' : 'Accused');
                state.savedSteps[5] = true;
                state.dirtySteps[5] = false;
                showValidation(5, []);
                return { message: msg };
            });
        });
    }

    function validateStep(step){
        var errs = [];
        var has = function(v){ return !!(v && String(v).trim()); };
        if(step === 2 && !state.accusations.some(function(x){ return has(x.accusationText); })) errs.push('At least one accusation is required.');
        if(step === 3 && !state.accused.some(function(x){ return has(x.personName); })) errs.push('At least one accused row is required.');
        if(step === 4 && !state.records.some(function(x){ return has(x.recordTitle) || has(x.recordDetails); })) errs.push('At least one record scrutinized row is required.');
        if(step === 5 && !state.statements.length) errs.push('Add at least one statement record before final submit.');
        if(step === 6 && !state.evidence.length) errs.push('At least one evidence file is mandatory.');
        if(step === 7 && !state.violations.some(function(x){ return has(x.category) && has(x.violationDetail) && has(x.referenceText) && has(x.recommendation); })) errs.push('At least one complete violation row is required.');
        if(step === 8 && !state.dsa.some(function(x){ return has(x.personName) || has(x.dsaStatus); })) errs.push('At least one DSA row is required.');
        return errs;
    }

    function showValidation(step, errors){
        var host = $('.wizard-section[data-step="' + step + '"] .validation-summary');
        if(!errors.length){ host.addClass('d-none').html(''); return; }
        host.removeClass('d-none').html('<strong>Missing mandatory fields:</strong><ul class="mb-0">' + errors.map(function(e){ return '<li>' + esc(e) + '</li>'; }).join('') + '</ul>');
    }

    function ensureOneRow(section){
        if(state[section].length){ return; }
        if(section === 'accusations') state.accusations.push({ accusationId: 0, accusationText: '', sortOrder: 1 });
        if(section === 'accused') state.accused.push({ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: 1 });
        if(section === 'records') state.records.push({ recId: 0, recordTitle: '', recordDetails: '', sortOrder: 1 });
        if(section === 'violations') state.violations.push({ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: 1 });
        if(section === 'dsa') state.dsa.push({ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: 1 });
    }

    function saveCollection(opts){
        var queue = $.Deferred().resolve().promise();
        var lastMessage = '';

        (state.deleteQueue[opts.section] || []).forEach(function(id){
            queue = queue.then(function(){
                return opts.deleteFn(id, userId).then(function(resp){
                    ensureApiSuccess(resp, 'Delete failed.');
                    lastMessage = getResponseMessage(resp) || lastMessage;
                });
            });
        });
        state.deleteQueue[opts.section] = [];

        opts.rows.forEach(function(row, idx){
            var payload = opts.map(row, idx);
            queue = queue.then(function(){
                var request = row[opts.idKey] ? opts.updateFn(payload) : opts.addFn(payload);
                return request.then(function(resp){
                    ensureApiSuccess(resp, 'Save failed.');
                    lastMessage = getResponseMessage(resp) || lastMessage;
                });
            });
        });

        return queue.then(function(){ return opts.loadFn(complaintId); }).then(function(resp){
            ensureApiSuccess(resp, 'Load failed.');
            opts.hydrate(resp);
            return { message: lastMessage || opts.successMessage };
        });
    }

    function loadStepData(step){
        if(step < 2 || step > 8){ return $.Deferred().resolve().promise(); }
        var cfg = {
            2: { loadFn: window.iidGetInqAccusations, hydrate: function(resp){ state.accusations = extractData(resp).map(function(x){ return { accusationId: x.accusationId, accusationText: x.accusationText, sortOrder: x.sortOrder || 1 }; }); ensureOneRow('accusations'); }, section: 'accusations' },
            3: { loadFn: window.iidGetInqAccusedList, hydrate: function(resp){ state.accused = extractData(resp).map(function(x){ x.roleType = accusedRoleOptions.indexOf(x.roleType) >= 0 ? x.roleType : 'Main'; return x; }); ensureOneRow('accused'); }, section: 'accused' },
            4: { loadFn: window.iidGetInqRecords, hydrate: function(resp){ state.records = extractData(resp); ensureOneRow('records'); }, section: 'records' },
            5: { loadFn: window.iidGetInqStatements, hydrate: function(resp){ state.statements = extractData(resp).map(mapStatementRow); state.statementDrafts.complainant = emptyStatementEntry('Complainant'); state.statementDrafts.accused = emptyStatementEntry('Accused'); }, section: 'statements' },
            6: { loadFn: window.iidGetInqEvidenceFiles, hydrate: function(resp){ state.evidence = extractData(resp); }, section: 'evidence' },
            7: { loadFn: window.iidGetInqViolations, hydrate: function(resp){ state.violations = extractData(resp); ensureOneRow('violations'); }, section: 'violations' },
            8: { loadFn: window.iidGetInqDsa, hydrate: function(resp){ state.dsa = extractData(resp); ensureOneRow('dsa'); }, section: 'dsa' }
        }[step];

        return cfg.loadFn(complaintId).then(function(resp){
            ensureApiSuccess(resp, 'Failed to load saved step data.');
            cfg.hydrate(resp);
            state.dirtySteps[step] = false;
            var list = cfg.section === 'evidence' ? state.evidence : state[cfg.section];
            state.savedSteps[step] = (list || []).some(function(x){ return Object.keys(x || {}).some(function(k){ return k.toLowerCase().indexOf('id') >= 0 && Number(x[k] || 0) > 0; }); });
        });
    }

    function saveStep(step){
        var errs = validateStep(step);
        showValidation(step, errs);
        if(errs.length){ return $.Deferred().reject().promise(); }

        if(step === 2){
            return saveCollection({ section: 'accusations', rows: state.accusations.filter(function(x){ return x.accusationText && x.accusationText.trim(); }), idKey: 'accusationId', addFn: window.iidAddInqAccusation, updateFn: window.iidUpdateInqAccusation, deleteFn: window.iidDeleteInqAccusation, loadFn: window.iidGetInqAccusations, map: function(row, idx){ return { accusationId: row.accusationId || 0, complaintId: complaintId, accusationText: row.accusationText, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }; }, hydrate: function(resp){ state.accusations = extractData(resp).map(function(x){ return { accusationId: x.accusationId, accusationText: x.accusationText, sortOrder: x.sortOrder || 1 }; }); ensureOneRow('accusations'); }, successMessage: 'Accusations saved successfully.' });
        }
        if(step === 3){
            return saveCollection({ section: 'accused', rows: state.accused.filter(function(x){ return x.personName && x.personName.trim(); }), idKey: 'accusedRowId', addFn: window.iidAddInqAccused, updateFn: window.iidUpdateInqAccused, deleteFn: window.iidDeleteInqAccused, loadFn: window.iidGetInqAccusedList, map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); }, hydrate: function(resp){ state.accused = extractData(resp).map(function(x){ x.roleType = accusedRoleOptions.indexOf(x.roleType) >= 0 ? x.roleType : 'Main'; return x; }); ensureOneRow('accused'); }, successMessage: 'Accused list saved successfully.' });
        }
        if(step === 4){
            return saveCollection({ section: 'records', rows: state.records.filter(function(x){ return ((x.recordTitle || '') + (x.recordDetails || '')).trim(); }), idKey: 'recId', addFn: window.iidAddInqRecord, updateFn: window.iidUpdateInqRecord, deleteFn: window.iidDeleteInqRecord, loadFn: window.iidGetInqRecords, map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); }, hydrate: function(resp){ state.records = extractData(resp); ensureOneRow('records'); }, successMessage: 'Record scrutinized saved successfully.' });
        }
        if(step === 5){
            return window.iidGetInqStatements(complaintId).then(function(resp){
                ensureApiSuccess(resp, 'Failed to load statement register.');
                state.statements = extractData(resp).map(mapStatementRow);
                return { message: 'Statement register reloaded from database.' };
            });
        }
        if(step === 6){
            return window.iidGetInqEvidenceFiles(complaintId).then(function(resp){ ensureApiSuccess(resp, 'Failed to load evidence list.'); state.evidence = extractData(resp); return { message: 'Evidence list refreshed from database.' }; });
        }
        if(step === 7){
            return saveCollection({ section: 'violations', rows: state.violations.filter(function(x){ return x.violationDetail && x.referenceText && x.recommendation; }), idKey: 'violationId', addFn: window.iidAddInqViolation, updateFn: window.iidUpdateInqViolation, deleteFn: window.iidDeleteInqViolation, loadFn: window.iidGetInqViolations, map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); }, hydrate: function(resp){ state.violations = extractData(resp); ensureOneRow('violations'); }, successMessage: 'Violations saved successfully.' });
        }
        if(step === 8){
            return saveCollection({ section: 'dsa', rows: state.dsa.filter(function(x){ return x.personName || x.dsaStatus; }), idKey: 'dsaId', addFn: window.iidAddInqDsa, updateFn: window.iidUpdateInqDsa, deleteFn: window.iidDeleteInqDsa, loadFn: window.iidGetInqDsa, map: function(row, idx){ return $.extend({}, row, { complaintId: complaintId, sortOrder: idx + 1, status: 'A', createdBy: userId, updatedBy: userId }); }, hydrate: function(resp){ state.dsa = extractData(resp); ensureOneRow('dsa'); }, successMessage: 'DSA saved successfully.' });
        }
        return $.Deferred().resolve({ message: 'Saved.' }).promise();
    }

    function renderCurrent(skipLoad){
        var render = function(){
            renderSection(currentStep);
            $('.wizard-section').addClass('d-none');
            $('.wizard-section[data-step="' + currentStep + '"]').removeClass('d-none');
            renderStepper();
            bindStepInputs();
        };
        if(skipLoad){ render(); return; }
        loadStepData(currentStep).always(render);
    }

    function navigateToStep(nextStep){
        if(hasUnsavedStep(currentStep)){
            showAlert('You have unsaved changes. Save before moving.', 'warning');
            return;
        }
        currentStep = nextStep;
        renderCurrent();
    }

    function loadComplaint(){
        return $.post(g_asiBaseURL + '/ApiCalls/GetComplaint', { complaintId: complaintId }).done(function(resp){
            ensureApiSuccess(resp, 'Failed to load complaint snapshot.');
            var c = resp || {};
            state.complainantName = c.complainantName || '';
            state.complainantCnic = c.cnic || '';
            $('#headerComplainantName').text(state.complainantName || 'N/A');
            $('#iidComplaintHiddenCache').text(JSON.stringify(c));
            state.snapshot = { complaintNo: c.complaintNo, submittedOn: c.submittedOn, region: c.region, branch: c.branch, category: c.category, nature: c.nature, complainantName: c.complainantName, cnic: c.cnic, cellularNumber: c.cellularNumber, mailingAddress: c.mailingAddress, gender: c.gender, receivedFrom: c.receivedFrom, actionRequired: c.actionRequired, contents: c.contents };
            renderSnapshotStrip();
        });
    }

    function finalizeReport(){
        return $.ajax({ url: g_asiBaseURL + '/ApiCalls/FinalizeIidInquiryReport', method: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json', data: JSON.stringify({ complaintId: complaintId }) }).done(function(resp){
            if(!resp || resp.ok === false){ showAlert(getResponseMessage(resp) || 'Finalize failed.', 'danger'); return; }
            isLocked = true;
            $('#reportStatusBadge').removeClass('bg-secondary').addClass('bg-success').text('Submitted');
            showAlert(resp.message || 'Inquiry report finalized successfully.', 'success');
            renderCurrent(true);
        });
    }

    $(document).on('click', '[data-step-jump]', function(){ navigateToStep(parseInt($(this).data('step-jump'), 10)); });
    $(document).on('click', '[data-prev]', function(){ if(currentStep > 1){ navigateToStep(currentStep - 1); } });
    $(document).on('click', '[data-next]', function(){ var e = validateStep(currentStep); showValidation(currentStep, e); if(!e.length && currentStep < steps.length){ navigateToStep(currentStep + 1); } });
    $(document).on('click', '[data-save]', function(){ saveStep(currentStep).done(function(result){ state.savedSteps[currentStep] = true; state.dirtySteps[currentStep] = false; showAlert((result && result.message) || 'Saved successfully.', 'success'); renderCurrent(true); }).fail(function(err){ showAlert((err && err.message) || 'Save failed.', 'danger'); }); });

    $(document).on('click', '[data-add-row]', function(){
        var s = $(this).data('add-row');
        if(s==='accusations') state.accusations.push({ accusationId: 0, accusationText: '', sortOrder: state.accusations.length + 1 });
        if(s==='accused') state.accused.push({ accusedRowId: 0, personName: '', designation: '', roleType: 'Main', ppnoNumber: '', cnic: '', postingPlace: '', remarks: '', sortOrder: state.accused.length + 1 });
        if(s==='records') state.records.push({ recId: 0, recordTitle: '', recordDetails: '', sortOrder: state.records.length + 1 });
        if(s==='violations') state.violations.push({ violationId: 0, category: 'Internal', violationDetail: '', referenceText: '', recommendation: '', sortOrder: state.violations.length + 1 });
        if(s==='dsa') state.dsa.push({ dsaId: 0, personName: '', designation: '', ppnoNumber: '', cnic: '', dsaStatus: '', remarks: '', sortOrder: state.dsa.length + 1 });
        markDirty(currentStep);
        renderCurrent(true);
    });

    $(document).on('click', '[data-remove-row]', function(){
        var section = $(this).data('remove-row');
        var idx = parseInt($(this).data('index'), 10);
        var row = state[section][idx];

        if(section === 'accused' && row && row.accusedRowId > 0){
            window.iidDeleteInqAccused(row.accusedRowId, userId || 0).then(function(resp){
                ensureApiSuccess(resp, 'Failed to delete accused row.');
                showAlert(getResponseMessage(resp) || 'Accused row removed successfully.', 'success');
                return loadStepData(3);
            }).done(function(){ state.savedSteps[3] = true; state.dirtySteps[3] = false; renderCurrent(true); }).fail(function(err){ showAlert((err && err.message) || 'Failed to delete accused row.', 'danger'); });
            return;
        }

        if(row){
            var idKeyMap = { accusations: 'accusationId', records: 'recId', statements: 'statementId', violations: 'violationId', dsa: 'dsaId' };
            var idKey = idKeyMap[section];
            if(idKey && row[idKey] && row[idKey] > 0){ state.deleteQueue[section].push(row[idKey]); }
        }
        state[section].splice(idx, 1);
        ensureOneRow(section);
        markDirty(currentStep);
        renderCurrent(true);
    });

    $(document).on('change', '#uploadedEvidence', function(){
        var files = Array.prototype.slice.call(this.files || []);
        var chain = $.Deferred().resolve().promise();
        files.forEach(function(file){
            chain = chain.then(function(){
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token());
                fd.append('ComplaintId', complaintId);
                fd.append('EvidenceType', 'Document');
                fd.append('Description', file.name);
                fd.append('Status', 'A');
                fd.append('UploadedBy', userId || 0);
                fd.append('file', file);
                return window.iidAddInqEvidenceFile(fd).then(function(resp){ ensureApiSuccess(resp, 'Evidence upload failed.'); return getResponseMessage(resp) || 'Uploaded successfully'; });
            });
        });
        chain.then(function(msg){
            return window.iidGetInqEvidenceFiles(complaintId).then(function(resp){
                ensureApiSuccess(resp, 'Failed to refresh evidence list.');
                state.evidence = extractData(resp);
                state.savedSteps[6] = true;
                state.dirtySteps[6] = false;
                showAlert(msg || 'Uploaded successfully', 'success');
                renderCurrent(true);
            });
        }).fail(function(err){ showAlert((err && err.message) || 'Evidence upload failed.', 'danger'); });
        this.value = '';
    });

    $(document).on('click', '[data-delete-evidence]', function(){
        var evidenceId = parseInt($(this).data('delete-evidence'), 10);
        window.iidDeleteInqEvidenceFile(evidenceId, userId || 0).then(function(resp){
            ensureApiSuccess(resp, 'Failed to delete evidence file.');
            var msg = getResponseMessage(resp) || 'Evidence removed successfully.';
            return window.iidGetInqEvidenceFiles(complaintId).then(function(loadResp){
                ensureApiSuccess(loadResp, 'Failed to refresh evidence list.');
                state.evidence = extractData(loadResp);
                showAlert(msg, 'success');
                renderCurrent(true);
            });
        }).fail(function(err){ showAlert((err && err.message) || 'Failed to delete evidence file.', 'danger'); });
    });


    $(document).on('input change', '[data-statement-entry]', function(){
        var key = String($(this).data('statement-entry') || '');
        var m = key.match(/^(complainant|accused)\.(\w+)$/);
        if(!m){ return; }
        setStatementDraft(m[1], m[2], $(this).val());
        if(m[2] === 'cnic' || m[2] === 'ppnoNumber'){
            $(this).val(state.statementDrafts[m[1]][m[2]] || '');
        }
        renderStepper();
    });

    $(document).on('click', '[data-save-statement]', function(){
        var role = String($(this).data('save-statement') || '');
        saveStatement(role).done(function(result){
            showAlert((result && result.message) || 'Saved successfully.', 'success');
            renderCurrent(true);
        }).fail(function(err){
            showAlert((err && err.message) || 'Failed to save statement.', 'danger');
        });
    });

    $(document).on('click', '[data-remove-statement]', function(){
        var id = parseInt($(this).data('remove-statement'), 10) || 0;
        if(!id){ showAlert('Invalid statement row.', 'danger'); return; }
        window.iidDeleteInqStatement(id, userId || 0).then(function(resp){
            ensureApiSuccess(resp, 'Failed to delete statement row.');
            var msg = getResponseMessage(resp) || 'Statement row removed successfully.';
            return window.iidGetInqStatements(complaintId).then(function(loadResp){
                ensureApiSuccess(loadResp, 'Failed to reload statements.');
                state.statements = extractData(loadResp).map(mapStatementRow);
                state.savedSteps[5] = true;
                state.dirtySteps[5] = false;
                showAlert(msg, 'success');
                renderCurrent(true);
            });
        }).fail(function(err){ showAlert((err && err.message) || 'Failed to delete statement row.', 'danger'); });
    });

    $(document).on('click', '[data-edit-statement]', function(){
        var id = parseInt($(this).data('edit-statement'), 10) || 0;
        var row = state.statements.find(function(x){ return (x.statementId || 0) === id; });
        if(!row){ showAlert('Statement row not found.', 'danger'); return; }
        var role = ((row.roleType || '').toLowerCase() === 'accused') ? 'accused' : 'complainant';
        state.statementDrafts[role] = $.extend({}, emptyStatementEntry(role === 'complainant' ? 'Complainant' : 'Accused'), row, { roleType: role === 'complainant' ? 'Complainant' : 'Accused' });
        markDirty(5);
        renderCurrent(true);
    });

    $(document).on('click', '[data-search-accused]', function(){
        var ppno = normalizeDigits($('.wizard-section[data-step="5"] [data-accused-search-ppno]').val());
        if(!ppno){ showAlert('Enter numeric PPNO to search.', 'warning'); return; }
        window.iidGetEmployeeByPpno(ppno).then(function(resp){
            var item = (resp && resp[0]) ? resp[0] : resp;
            if(!item || !item.ppNo && !item.PPNo && !item.ppNumber && !item.PPNumber){
                showAlert('No employee record found for entered PPNO.', 'warning');
                return;
            }
            state.statementDrafts.accused.ppnoNumber = normalizeDigits(item.ppNo || item.PPNo || item.ppNumber || item.PPNumber || ppno);
            state.statementDrafts.accused.personName = item.empName || item.EmpName || item.name || item.Name || '';
            state.statementDrafts.accused.fatherName = item.fatherName || item.FatherName || '';
            state.statementDrafts.accused.cnic = normalizeDigits(item.cnic || item.CNIC || '', 13);
            markDirty(5);
            renderCurrent(true);
            showAlert('Employee details loaded. You can edit before save.', 'success');
        }).fail(function(){ showAlert('Failed to lookup employee by PPNO.', 'danger'); });
    });

    $(document).on('click', '#finalSubmitBtn', function(){
        var errors = [];
        for(var i=2;i<=steps.length;i++){ errors = errors.concat(validateStep(i)); }
        if(errors.length){ showAlert('Complete all mandatory sections before final submit.', 'danger'); return; }
        finalizeReport();
    });

    if(!complaintId){ showAlert('Complaint ID is missing. Open this page from Task List.', 'danger'); return; }

    loadComplaint().done(function(){ renderCurrent(); }).fail(function(){ showAlert('Failed to load inquiry wizard data.', 'danger'); renderCurrent(true); });
});
</script>

<style>
.wizard-stepper{display:grid;grid-template-columns:repeat(8,minmax(140px,1fr));gap:.4rem;overflow:auto}
.step-pill{border:1px solid #ced4da;background:#fff;border-radius:.5rem;padding:.35rem .5rem;text-align:left}
.step-pill .num{font-weight:700;margin-right:.35rem}
.step-pill.active{border-color:#0d6efd;box-shadow:0 0 0 2px rgba(13,110,253,.15)}
.step-pill.completed{background:#ecf9f0;border-color:#198754}
.step-pill.not-saved{background:#fff5f5;border-color:#dc3545}
.step-state{font-size:.68rem;vertical-align:middle}
.snap-label{color:#6c757d}
.snap-value{font-weight:600}
.help-text{font-size:.8rem;color:#6c757d}
.validation-summary{font-size:.9rem}
</style>
}
