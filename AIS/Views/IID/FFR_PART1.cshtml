@{
    ViewData["Title"] = "FFR Part I";
    Layout = "_Layout";
    var complaintIdQuery = Context.Request.Query["complaintId"].ToString();
    var ffrIdQuery = Context.Request.Query["ffrId"].ToString();
    var complaintIdValue = string.IsNullOrWhiteSpace(complaintIdQuery) ? "0" : complaintIdQuery;
    var ffrIdValue = string.IsNullOrWhiteSpace(ffrIdQuery) ? "0" : ffrIdQuery;
    var ffrModel = ViewData["FFRPart1"] as AIS.Models.IID.FFRPart1Model;
    if (ffrModel != null && complaintIdValue == "0" && ffrModel.ComplaintId > 0)
    {
        complaintIdValue = ffrModel.ComplaintId.ToString();
    }
    var queryString = $"?complaintId={complaintIdValue}&ffrId={ffrIdValue}";
    var natureList = ViewData["NatureList"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var sourceList = ViewData["SourceList"] as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<style>
    @@media print {
        .navbar,
        .sidebar,
        .no-print,
        .btn {
            display: none !important;
        }

        body {
            background: #fff;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0">FFR Part I</h4>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Print</button>
</div>

<div class="mb-3 no-print">
    <div class="d-flex gap-2">
        <span class="badge bg-primary">Part 1</span>
        <span class="badge bg-light text-dark">Part 2</span>
        <span class="badge bg-light text-dark">Part 3</span>
    </div>
    <div class="mt-2">
        <button type="submit" form="ffrPart1Form" class="btn btn-link p-0">Next → Part 2</button>
    </div>
</div>

<form id="ffrPart1Form" enctype="multipart/form-data" asp-action="FFR_PART1" asp-controller="IID" method="post">
    <input type="hidden" name="ComplaintId" value="@complaintIdValue" />
    <input type="hidden" name="FfrId" value="@ffrIdValue" />

    <div class="card mb-3">
        <div class="card-header">Routing Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Pertains To</label>
                <select class="form-select" id="PertainsTo" name="PertainsTo" required>
                    <option value="">--Select--</option>
                    <option value="HO" selected="@(ffrModel?.PertainsTo == "HO" ? "selected" : null)">HO</option>
                    <option value="FIELD" selected="@(ffrModel?.PertainsTo == "FIELD" ? "selected" : null)">Field</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="fieldTypeDiv">
                <label class="form-label">Field Type</label>
                <select class="form-select" id="FieldType" name="FieldType">
                    <option value="">--Select--</option>
                    <option value="HO_UNIT" selected="@(ffrModel?.FieldType == "HO_UNIT" ? "selected" : null)">HO Units</option>
                    <option value="BRANCH" selected="@(ffrModel?.FieldType == "BRANCH" ? "selected" : null)">Branch</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="hoUnitTypeDiv">
                <label class="form-label">HO Unit Type</label>
                <select class="form-select" id="HOUnitTypeId" name="HOUnitTypeId" data-selected="@ffrModel?.HOUnitTypeId">
                    <option value="">--Select HO Unit Type--</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="hoUnitDiv">
                <label class="form-label">HO Unit</label>
                <select class="form-select" id="HOUnitId" name="HOUnitId" data-selected="@ffrModel?.HOUnitId">
                    <option value="">--Select HO Unit--</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="regionDiv">
                <label class="form-label">Region</label>
                <select class="form-select" id="RegionId" name="RegionId">
                    <option value="">--Select Region--</option>
                    @{
                        if (ViewData["RegionList"] != null)
                        {
                            foreach (var item in (dynamic)(ViewData["RegionList"]))
                            {
                                <option value="@item.CODE" selected="@(ffrModel?.RegionId?.ToString() == item.CODE.ToString() ? "selected" : null)">@item.NAME</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="mb-2 d-none" id="branchDiv">
                <label class="form-label">Branch</label>
                <select class="form-select" id="BranchId" name="BranchId" data-selected="@ffrModel?.BranchId">
                    <option value="">--Select Branch--</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Originating Department</label>
                <select class="form-select" id="Source" name="Source" required>
                    <option value="">--Select--</option>
                    @foreach (var item in sourceList)
                    {
                        <option value="@item" selected="@(ffrModel?.Source == item ? "selected" : null)">@item</option>
                    }
                </select>
            </div>
            <div class="mb-2 d-none" id="sourceOtherDiv">
                <label class="form-label">Source (Other)</label>
                <input type="text" class="form-control" name="SourceOtherText" value="@ffrModel?.SourceOtherText" />
            </div>
            <div class="mb-2">
                <label class="form-label">Nature</label>
                <select class="form-select" name="Nature" required>
                    <option value="">--Select--</option>
                    @foreach (var item in natureList)
                    {
                        <option value="@item" selected="@(ffrModel?.Nature == item ? "selected" : null)">@item</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Reference No</label>
                <input type="text" class="form-control" name="ReferenceNo" value="@ffrModel?.ReferenceNo" />
            </div>
            <div class="mb-2">
                <label class="form-label">FFR Date</label>
                <input type="date" class="form-control" name="FFRDate" value="@ffrModel?.FFRDate" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Brief of Incident Reported</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Date of Incident</label>
                <input type="date" class="form-control" name="IncidentDate" value="@ffrModel?.IncidentDate" />
            </div>
            <div class="mb-2">
                <label class="form-label">Where/Venue</label>
                <input type="text" class="form-control" name="IncidentVenue" value="@ffrModel?.IncidentVenue" />
            </div>
            <div class="mb-2">
                <label class="form-label">How incident happened</label>
                <textarea class="form-control" name="IncidentNarrative">@ffrModel?.IncidentNarrative</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Complainant Particulars</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" name="ComplainantName" value="@ffrModel?.ComplainantName" />
            </div>
            <div class="mb-2">
                <label class="form-label">CNIC</label>
                <input type="text" class="form-control" name="ComplainantCNIC" value="@ffrModel?.ComplainantCNIC" />
            </div>
            <div class="mb-2">
                <label class="form-label">LC/Account No</label>
                <input type="text" class="form-control" name="AccountNo" value="@ffrModel?.AccountNo" />
            </div>
            <div class="mb-2">
                <label class="form-label">Mobile No</label>
                <input type="text" class="form-control" name="ComplainantMobile" value="@ffrModel?.ComplainantMobile" />
            </div>
            <div class="mb-2">
                <label class="form-label">Address</label>
                <textarea class="form-control" name="ComplainantAddress">@ffrModel?.ComplainantAddress</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Accused Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Main Accused Details</label>
                <textarea class="form-control" name="MainAccused">@ffrModel?.MainAccused</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Co-Accused Details</label>
                <textarea class="form-control" name="CoAccused">@ffrModel?.CoAccused</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Accusations</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Details of Accusations</label>
                <textarea class="form-control" name="Accusations">@ffrModel?.Accusations</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Narrative Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Approach Adopted</label>
                <textarea class="form-control" name="ApproachAdopted">@ffrModel?.ApproachAdopted</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Details of Record Scrutinized</label>
                <textarea class="form-control" name="RecordScrutinized">@ffrModel?.RecordScrutinized</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Root Cause / Why</label>
                <textarea class="form-control" name="RootCause">@ffrModel?.RootCause</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Key Findings</label>
                <textarea class="form-control" name="KeyFindings">@ffrModel?.KeyFindings</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Clear Recommendations</label>
                <textarea class="form-control" name="ClearRecommendations">@ffrModel?.ClearRecommendations</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Attachments</div>
        <div class="card-body">
            <label class="form-label">Upload Attachments</label>
            <input type="file" class="form-control" name="Attachments" multiple />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 no-print">
        <button type="button" class="btn btn-outline-secondary">Save Draft</button>
        <button type="submit" class="btn btn-primary">Next</button>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Print</button>
    </div>
</form>

@section Scripts{
<script>
    $(function(){
        function toggleSource(){
            var val = $('#Source').val();
            if(val === 'Other'){
                $('#sourceOtherDiv').removeClass('d-none');
                $('#sourceOtherDiv input').prop('disabled', false);
            } else {
                $('#sourceOtherDiv').addClass('d-none');
                $('#sourceOtherDiv input').prop('disabled', true).val('');
            }
        }

        function togglePertainsTo(){
            var pertainsTo = $('#PertainsTo').val();
            $('#fieldTypeDiv,#hoUnitTypeDiv,#hoUnitDiv,#regionDiv,#branchDiv').addClass('d-none');
            $('#FieldType,#HOUnitTypeId,#HOUnitId,#RegionId,#BranchId').prop('disabled', true);

            if(pertainsTo === 'FIELD'){
                $('#fieldTypeDiv').removeClass('d-none');
                $('#FieldType').prop('disabled', false);
                toggleFieldType();
            }
        }

        function toggleFieldType(){
            var fieldType = $('#FieldType').val();
            $('#hoUnitTypeDiv,#hoUnitDiv,#regionDiv,#branchDiv').addClass('d-none');
            $('#HOUnitTypeId,#HOUnitId,#RegionId,#BranchId').prop('disabled', true);

            if(fieldType === 'HO_UNIT'){
                $('#hoUnitTypeDiv,#hoUnitDiv').removeClass('d-none');
                $('#HOUnitTypeId,#HOUnitId').prop('disabled', false);
                loadHoUnitTypes();
            } else if(fieldType === 'BRANCH'){
                $('#regionDiv,#branchDiv').removeClass('d-none');
                $('#RegionId,#BranchId').prop('disabled', false);
            }
        }

        function loadHoUnitTypes(){
            if($('#HOUnitTypeId option').length > 1){
                return;
            }
            $.post(g_asiBaseURL + '/ApiCalls/get_ho_unit_types', {}, function(d){
                $('#HOUnitTypeId').empty().append('<option value="">--Select HO Unit Type--</option>');
                $.each(d, function(i,v){
                    var id = v.divisionid || v.DIVISIONID;
                    var name = v.name || v.NAME;
                    $('#HOUnitTypeId').append('<option value="'+id+'">'+name+'</option>');
                });
                var selectedType = $('#HOUnitTypeId').data('selected');
                if(selectedType){
                    $('#HOUnitTypeId').val(String(selectedType));
                    loadHoUnits();
                }
            });
        }

        function loadHoUnits(){
            var typeId = $('#HOUnitTypeId').val();
            $('#HOUnitId').empty().append('<option value="">--Select HO Unit--</option>');
            if(!typeId){
                return;
            }
            $.post(g_asiBaseURL + '/ApiCalls/get_ho_units', { divisionId: typeId }, function(d){
                $.each(d, function(i,v){
                    var id = v.id || v.ID;
                    var name = v.name || v.NAME;
                    $('#HOUnitId').append('<option value="'+id+'">'+name+'</option>');
                });
                var selectedUnit = $('#HOUnitId').data('selected');
                if(selectedUnit){
                    $('#HOUnitId').val(String(selectedUnit));
                }
            });
        }

        $('#Source').on('change', toggleSource);
        $('#PertainsTo').on('change', togglePertainsTo);
        $('#FieldType').on('change', toggleFieldType);
        $('#HOUnitTypeId').on('change', loadHoUnits);

        $('#RegionId').on('change', function(){
            if($(this).val()){
                $('#BranchId').empty().append('<option value="">--Select Branch--</option>');
                $.post(g_asiBaseURL + '/ApiCalls/get_zone_Branches', { ZONEID: $(this).val() }, function(d){
                    $.each(d, function(i,v){
                        $('#BranchId').append('<option value="'+v.branchid+'">'+v.branchname+'</option>');
                    });
                    var selectedBranch = $('#BranchId').data('selected');
                    if(selectedBranch){
                        $('#BranchId').val(String(selectedBranch));
                    }
                });
            }
        });

        toggleSource();
        togglePertainsTo();
        if($('#RegionId').val()){
            $('#RegionId').trigger('change');
        }
    });
</script>
}
