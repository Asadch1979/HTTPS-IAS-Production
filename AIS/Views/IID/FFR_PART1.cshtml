@model AIS.Models.IID.FFRPart1Model
@{
    ViewData["Title"] = "FFR Part I";
    Layout = "_Layout";
    var complaintIdQuery = Context.Request.Query["complaintId"].ToString();
    var ffrIdQuery = Context.Request.Query["ffrId"].ToString();
    var complaintIdValue = (Model?.ComplaintId ?? 0) > 0 ? Model.ComplaintId.ToString() : (string.IsNullOrWhiteSpace(complaintIdQuery) ? "0" : complaintIdQuery);
    var ffrIdValue = Model?.FfrId?.ToString() ?? (string.IsNullOrWhiteSpace(ffrIdQuery) ? "0" : ffrIdQuery);
    var queryString = $"?complaintId={complaintIdValue}&ffrId={ffrIdValue}";
}

<style>
    @@media print {
        .navbar,
        .sidebar,
        .no-print,
        .btn {
            display: none !important;
        }

        body {
            background: #fff;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0">FFR Part I</h4>
    <button type="button" class="btn btn-outline-secondary" data-click="window.print();">Print</button>
</div>

<div class="mb-3 no-print">
    <div class="d-flex gap-2">
        <span class="badge bg-primary">Part 1</span>
        <span class="badge bg-light text-dark">Part 2</span>
        <span class="badge bg-light text-dark">Part 3</span>
    </div>
    <div class="mt-2">
        <button class="btn btn-link p-0" type="submit" form="ffrPart1Form">Next → Part 2</button>
    </div>
</div>

<form id="ffrPart1Form" asp-action="FFR_PART1" asp-controller="IID" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ComplaintId" value="@complaintIdValue" />
    <input type="hidden" asp-for="FfrId" value="@ffrIdValue" />

    <div class="card mb-3">
        <div class="card-header">Routing Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Pertains To</label>
                <select class="form-select" id="PertainsTo" asp-for="PertainsTo" required>
                    <option value="">--Select--</option>
                    <option value="HO" selected="@(Model?.PertainsTo == "HO" ? "selected" : null)">HO</option>
                    <option value="FIELD" selected="@(Model?.PertainsTo == "FIELD" ? "selected" : null)">Field</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="fieldTypeDiv">
                <label class="form-label">Field Type</label>
                <select class="form-select" id="FieldType" asp-for="FieldType">
                    <option value="">--Select--</option>
                    <option value="HO_UNIT" selected="@(Model?.FieldType == "HO_UNIT" ? "selected" : null)">HO Units</option>
                    <option value="BRANCH" selected="@(Model?.FieldType == "BRANCH" ? "selected" : null)">Branch</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="hoUnitTypeDiv">
                <label class="form-label">HO Unit Type</label>
                <select class="form-select" id="HOUnitTypeId" asp-for="HOUnitTypeId">
                    <option value="">--Select HO Unit Type--</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="hoUnitDiv">
                <label class="form-label">HO Unit</label>
                <select class="form-select" id="HOUnitId" asp-for="HOUnitId">
                    <option value="">--Select HO Unit--</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="regionDiv">
                <label class="form-label">Region</label>
                <select class="form-select" id="RegionId" asp-for="RegionId">
                    <option value="">--Select Region--</option>
                    @{
                        if (ViewData["RegionList"] != null)
                        {
                            foreach (var item in (dynamic)(ViewData["RegionList"]))
                            {
                                <option value="@item.CODE" selected="@(Model?.RegionId?.ToString() == item.CODE?.ToString() ? "selected" : null)">@item.NAME</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="mb-2 d-none" id="branchDiv">
                <label class="form-label">Branch</label>
                <select class="form-select" id="BranchId" asp-for="BranchId">
                    <option value="">--Select Branch--</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Originating Department</label>
                <select class="form-select" id="Source" asp-for="Source" required>
                    <option value="">--Select--</option>
                    <option selected="@(Model?.Source == "Internal" ? "selected" : null)">Internal</option>
                    <option selected="@(Model?.Source == "External" ? "selected" : null)">External</option>
                    <option selected="@(Model?.Source == "Anonymous" ? "selected" : null)">Anonymous</option>
                    <option selected="@(Model?.Source == "Regulatory" ? "selected" : null)">Regulatory</option>
                    <option selected="@(Model?.Source == "Other" ? "selected" : null)">Other</option>
                </select>
            </div>
            <div class="mb-2 d-none" id="sourceOtherDiv">
                <label class="form-label">Source (Other)</label>
                <input type="text" class="form-control" asp-for="SourceOtherText" value="@Model?.SourceOtherText" />
            </div>
            <div class="mb-2">
                <label class="form-label">Nature</label>
                <select class="form-select" asp-for="Nature" required>
                    <option value="">--Select--</option>
                    <option selected="@(Model?.Nature == "Fraud & Forgery" ? "selected" : null)">Fraud &amp; Forgery</option>
                    <option selected="@(Model?.Nature == "Embezzlement of loan/partial loan amount" ? "selected" : null)">Embezzlement of loan/partial loan amount</option>
                    <option selected="@(Model?.Nature == "Embezzlement of recovery amount" ? "selected" : null)">Embezzlement of recovery amount</option>
                    <option selected="@(Model?.Nature == "Embezzlement of deposits" ? "selected" : null)">Embezzlement of deposits</option>
                    <option selected="@(Model?.Nature == "Loan processing issues" ? "selected" : null)">Loan processing issues</option>
                    <option selected="@(Model?.Nature == "Fake/disputed collaterals" ? "selected" : null)">Fake/disputed collaterals</option>
                    <option selected="@(Model?.Nature == "Getting illegal gratification" ? "selected" : null)">Getting illegal gratification</option>
                    <option selected="@(Model?.Nature == "NOC/ Redemption issues" ? "selected" : null)">NOC/ Redemption issues</option>
                    <option selected="@(Model?.Nature == "Recovery/ Repayment issues" ? "selected" : null)">Recovery/ Repayment issues</option>
                    <option selected="@(Model?.Nature == "Service Charges issues" ? "selected" : null)">Service Charges issues</option>
                    <option selected="@(Model?.Nature == "Misbehavior" ? "selected" : null)">Misbehavior</option>
                    <option selected="@(Model?.Nature == "Miscellaneous" ? "selected" : null)">Miscellaneous</option>
                    <option selected="@(Model?.Nature == "Short payment of cash" ? "selected" : null)">Short payment of cash</option>
                    <option selected="@(Model?.Nature == "Timings related issues" ? "selected" : null)">Timings related issues</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Reference No</label>
                <input type="text" class="form-control" asp-for="ReferenceNo" value="@Model?.ReferenceNo" />
            </div>
            <div class="mb-2">
                <label class="form-label">FFR Date</label>
                <input type="date" class="form-control" asp-for="FFRDate" value="@Model?.FFRDate" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Brief of Incident Reported</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Date of Incident</label>
                <input type="date" class="form-control" asp-for="IncidentDate" value="@Model?.IncidentDate" />
            </div>
            <div class="mb-2">
                <label class="form-label">Where/Venue</label>
                <input type="text" class="form-control" asp-for="IncidentVenue" value="@Model?.IncidentVenue" />
            </div>
            <div class="mb-2">
                <label class="form-label">How incident happened</label>
                <textarea class="form-control" asp-for="IncidentNarrative">@Model?.IncidentNarrative</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Complainant Particulars</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" asp-for="ComplainantName" value="@Model?.ComplainantName" />
            </div>
            <div class="mb-2">
                <label class="form-label">CNIC</label>
                <input type="text" class="form-control" asp-for="ComplainantCNIC" value="@Model?.ComplainantCNIC" />
            </div>
            <div class="mb-2">
                <label class="form-label">LC/Account No</label>
                <input type="text" class="form-control" asp-for="AccountNo" value="@Model?.AccountNo" />
            </div>
            <div class="mb-2">
                <label class="form-label">Mobile No</label>
                <input type="text" class="form-control" asp-for="ComplainantMobile" value="@Model?.ComplainantMobile" />
            </div>
            <div class="mb-2">
                <label class="form-label">Address</label>
                <textarea class="form-control" asp-for="ComplainantAddress">@Model?.ComplainantAddress</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Accused Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Main Accused Details</label>
                <textarea class="form-control" asp-for="MainAccused">@Model?.MainAccused</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Co-Accused Details</label>
                <textarea class="form-control" asp-for="CoAccused">@Model?.CoAccused</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Accusations</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Details of Accusations</label>
                <textarea class="form-control" asp-for="Accusations">@Model?.Accusations</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Narrative Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Approach Adopted</label>
                <textarea class="form-control" asp-for="ApproachAdopted">@Model?.ApproachAdopted</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Details of Record Scrutinized</label>
                <textarea class="form-control" asp-for="RecordScrutinized">@Model?.RecordScrutinized</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Root Cause / Why</label>
                <textarea class="form-control" asp-for="RootCause">@Model?.RootCause</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Key Findings</label>
                <textarea class="form-control" asp-for="KeyFindings">@Model?.KeyFindings</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Clear Recommendations</label>
                <textarea class="form-control" asp-for="ClearRecommendations">@Model?.ClearRecommendations</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Attachments</div>
        <div class="card-body">
            <label class="form-label">Upload Attachments</label>
            <input type="file" class="form-control" asp-for="Attachments" multiple />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 no-print">
        <button type="button" class="btn btn-outline-secondary">Save Draft</button>
        <button type="submit" class="btn btn-primary">Next</button>
        <button type="button" class="btn btn-outline-secondary" data-click="window.print();">Print</button>
    </div>
</form>

@section Scripts{
<script>
    $(function(){
        var initialHoUnitTypeId = '@(Model?.HOUnitTypeId?.ToString() ?? string.Empty)';
        var initialHoUnitId = '@(Model?.HOUnitId?.ToString() ?? string.Empty)';
        var initialRegionId = '@(Model?.RegionId?.ToString() ?? string.Empty)';
        var initialBranchId = '@(Model?.BranchId?.ToString() ?? string.Empty)';

        function toggleSource(){
            var val = $('#Source').val();
            if(val === 'Other'){
                $('#sourceOtherDiv').removeClass('d-none');
                $('#sourceOtherDiv input');
            } else {
                $('#sourceOtherDiv').addClass('d-none');
                $('#sourceOtherDiv input').val('');
            }
        }

        function togglePertainsTo(){
            var pertainsTo = $('#PertainsTo').val();
            $('#fieldTypeDiv,#hoUnitTypeDiv,#hoUnitDiv,#regionDiv,#branchDiv').addClass('d-none');
            $('#FieldType,#HOUnitTypeId,#HOUnitId,#RegionId,#BranchId');

            if(pertainsTo === 'FIELD'){
                $('#fieldTypeDiv').removeClass('d-none');
                $('#FieldType');
                toggleFieldType();
            }
        }

        function toggleFieldType(){
            var fieldType = $('#FieldType').val();
            $('#hoUnitTypeDiv,#hoUnitDiv,#regionDiv,#branchDiv').addClass('d-none');
            $('#HOUnitTypeId,#HOUnitId,#RegionId,#BranchId');

            if(fieldType === 'HO_UNIT'){
                $('#hoUnitTypeDiv,#hoUnitDiv').removeClass('d-none');
                $('#HOUnitTypeId,#HOUnitId');
                loadHoUnitTypes();
            } else if(fieldType === 'BRANCH'){
                $('#regionDiv,#branchDiv').removeClass('d-none');
                $('#RegionId,#BranchId');
            }
        }

        function loadHoUnitTypes(){
            if($('#HOUnitTypeId option').length > 1){
                return;
            }
            $.post(g_asiBaseURL + '/ApiCalls/get_ho_unit_types', {}, function(d){
                $('#HOUnitTypeId').empty().append('<option value="">--Select HO Unit Type--</option>');
                $.each(d, function(i,v){
                    var id = v.divisionid || v.DIVISIONID;
                    var name = v.name || v.NAME;
                    $('#HOUnitTypeId').append('<option value="'+id+'">'+name+'</option>');
                });
                if(initialHoUnitTypeId){
                    $('#HOUnitTypeId').val(initialHoUnitTypeId).trigger('change');
                }
            });
        }

        function loadHoUnits(){
            var typeId = $('#HOUnitTypeId').val();
            $('#HOUnitId').empty().append('<option value="">--Select HO Unit--</option>');
            if(!typeId){
                return;
            }
            $.post(g_asiBaseURL + '/ApiCalls/get_ho_units', { divisionId: typeId }, function(d){
                $.each(d, function(i,v){
                    var id = v.id || v.ID;
                    var name = v.name || v.NAME;
                    $('#HOUnitId').append('<option value="'+id+'">'+name+'</option>');
                });
                if(initialHoUnitId){
                    $('#HOUnitId').val(initialHoUnitId);
                }
            });
        }

        $('#Source').on('change', toggleSource);
        $('#PertainsTo').on('change', togglePertainsTo);
        $('#FieldType').on('change', toggleFieldType);
        $('#HOUnitTypeId').on('change', loadHoUnits);

        $('#RegionId').on('change', function(){
            if($(this).val()){
                $('#BranchId').empty().append('<option value="">--Select Branch--</option>');
                $.post(g_asiBaseURL + '/ApiCalls/get_zone_Branches', { ZONEID: $(this).val() }, function(d){
                    $.each(d, function(i,v){
                        $('#BranchId').append('<option value="'+v.branchid+'">'+v.branchname+'</option>');
                    });
                    if(initialBranchId){
                        $('#BranchId').val(initialBranchId);
                    }
                });
            }
        });

        toggleSource();
        togglePertainsTo();
        if(initialRegionId){
            $('#RegionId').val(initialRegionId).trigger('change');
        }
    });
</script>
}
