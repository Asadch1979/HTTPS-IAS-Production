@model List<AIS.Models.IID.ComplaintRowDto>
@{
    ViewData["Title"] = "Monitoring Dashboard";
    var dashboardMode = ViewData["DashboardMode"] as bool? == true;
    Layout = dashboardMode ? null : "_Layout";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-success mb-0">Monitoring Dashboard</h4>
    </div>

    <div id="monitoringAlertHost"></div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="iidMonitoringTable" class="table table-hover table-bordered table-striped table-sm mb-0 w-100">
                    <thead class="table-success">
                        <tr>
                            <th>Complaint No</th>
                            <th>Complainant Name</th>
                            <th>Nature</th>
                            <th>Source</th>
                            <th>I&amp;I Unit</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model ?? new List<AIS.Models.IID.ComplaintRowDto>())
                        {
                            <tr>
                                <td>@row.ComplaintNo</td>
                                <td>@row.ComplainantName</td>
                                <td>@row.Nature</td>
                                <td>@row.Source</td>
                                <td>@(row.AssignedUnit?.ToString() ?? "")</td>
                                <td>@row.Status</td>
                                <td>
                                    @if (row.ComplaintId > 0)
                                    {
                                        if (dashboardMode)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("IID_Dashboard", "IID", new { utilityCode = "READ_ONLY_REPORT", complaintId = row.ComplaintId })">View</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("InquiryReportReadOnly", "IID", new { complaintId = row.ComplaintId })">View</a>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>View</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (dashboardMode)
{
<script src="~/js/iid/monitoringDashboard.js" asp-append-version="true"></script>
}
else
{
@section Scripts{
<script src="~/js/iid/monitoringDashboard.js" asp-append-version="true"></script>
}
}
