@{
    ViewData["Title"] = "Initial Assessment";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div class="container-fluid mt-3">
    <h4>Initial Assessment</h4>

    <div class="card mb-3">
        <div class="card-header bg-light">
            Complaint Details
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3">Complaint ID</dt>
                <dd class="col-md-9" id="complaintIdDisplay"></dd>

                <dt class="col-md-3">Nature</dt>
                <dd class="col-md-9" id="complaintNature"></dd>

                <dt class="col-md-3">Submitted On</dt>
                <dd class="col-md-9" id="complaintSubmittedOn"></dd>

                <dt class="col-md-3">Action Required</dt>
                <dd class="col-md-9" id="complaintActionRequired"></dd>

                <dt class="col-md-3">Contents</dt>
                <dd class="col-md-9" id="complaintContents"></dd>

                <dt class="col-md-3">Attachments</dt>
                <dd class="col-md-9" id="complaintAttachments"></dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            Assessment Entry
        </div>
        <div class="card-body">
            <form id="assessmentForm">
                <input type="hidden" name="ComplaintId" value="@complaintId" />
                <div class="mb-3">
                    <label class="form-label">Assessment</label>
                    <textarea class="form-control" name="Assessment" rows="4"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Recommendation</label>
                    <select class="form-select" name="Recommendation">
                        <option value="">--Select--</option>
                        <option value="Qualify">Qualify</option>
                        <option value="Not Qualify">Not Qualify</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assigned I&amp;I Unit</label>
                    <select class="form-select" name="AssignedUnitId" id="AssignedUnitId" required></select>
                </div>
                <button type="submit" class="btn btn-primary">Save Assessment</button>
            </form>
        </div>
    </div>
</div>

@section Scripts{
<script>
    $(function(){
        var complaintId = '@complaintId';
        var referredBackStatus = 'REFERRED_BACK';

        function renderAttachments(data){
            var html = '';
            if(data.uploadedComplaint){
                html += '<a href="'+g_asiBaseURL+'/Uploads/'+data.uploadedComplaint+'" target="_blank">Complaint</a><br/>';
            }
            if(data.uploadedFFR){
                html += '<a href="'+g_asiBaseURL+'/Uploads/'+data.uploadedFFR+'" target="_blank">FFR</a><br/>';
            }
            if(data.uploadedEvidence){
                var arr = data.uploadedEvidence.split(';');
                $.each(arr,function(i,f){
                    if(f) html += '<a href="'+g_asiBaseURL+'/Uploads/'+f+'" target="_blank">Evidence '+(i+1)+'</a><br/>';
                });
            }
            return html || '<span class="text-muted">No attachments</span>';
        }

        function loadComplaint(){
            $.post(g_asiBaseURL + '/ApiCalls/GetComplaint',{ complaintId: complaintId },function(d){
                $('#complaintIdDisplay').text(d.complaintId || complaintId);
                $('#complaintNature').text(d.nature || '');
                $('#complaintSubmittedOn').text(d.submittedOn || '');
                $('#complaintActionRequired').text(d.actionRequired || '');
                $('#complaintContents').text(d.contents || '');
                $('#complaintAttachments').html(renderAttachments(d));

                if (d.status === referredBackStatus) {
                    $('#assessmentForm [name="Assessment"]').val(d.assessment || '');
                    $('#assessmentForm [name="Recommendation"]').val(d.recommendation || '');
                    if (d.assignedUnitId) {
                        $('#AssignedUnitId').val(d.assignedUnitId);
                    }
                }
            });
        }

        function loadUnits(){
            $('#AssignedUnitId').empty().append('<option value="">--Select--</option>');
            $.get(g_asiBaseURL + '/ApiCalls/GetIiUnits', function(d){
                $.each(d, function(i, unit){
                    $('#AssignedUnitId').append('<option value="'+unit.unitId+'">'+unit.unitName+'</option>');
                });
            });
        }

        $('#assessmentForm').on('submit', function(e){
            e.preventDefault();
            var data = {
                ComplaintId: $('#assessmentForm [name="ComplaintId"]').val(),
                Assessment: $('#assessmentForm [name="Assessment"]').val(),
                Recommendation: $('#assessmentForm [name="Recommendation"]').val(),
                AssignedUnitId: $('#assessmentForm [name="AssignedUnitId"]').val()
            };

            if(!data.AssignedUnitId){
                alert('Assigned I&I Unit is required.');
                return;
            }

            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/AddAssessment',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response){
                    var assessmentId = response.assessmentId || response.AssessmentId || 0;
                    window.location.href = g_asiBaseURL + '/IID/HeadReview?complaintId=' + complaintId + '&assessmentId=' + assessmentId;
                }
            });
        });

        loadUnits();
        loadComplaint();
    });
</script>
}
