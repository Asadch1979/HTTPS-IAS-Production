@model AIS.Models.IID.InitialAssessmentModel
@{
    ViewData["Title"] = "Initial Assessment";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div class="container-fluid mt-3">
    <h4>Initial Assessment</h4>
    @await Html.PartialAsync("_ComplaintSelector")

    <div id="iidComplaintDetailsRoot"></div>


    <div class="card">
        <div class="card-header bg-light">
            Assessment Entry
        </div>
        <div class="card-body">
            <form id="assessmentForm" asp-action="InitialAssessment" asp-controller="IID" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ComplaintId" value="@complaintId" />
                <div class="mb-3">
                    <label class="form-label">Assessment</label>
                    <textarea class="form-control" asp-for="Assessment" rows="4" maxlength="4000" data-validate="no-angle"></textarea>
                    <small class="text-muted">Note: Special characters like & and ( ) should be allowed. If saving fails, backend validation needs update.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Recommendation</label>
                    <select class="form-select" asp-for="Recommendation">
                        <option value="">--Select--</option>
                        <option value="Qualify">Qualify</option>
                        <option value="Not Qualify">Not Qualify</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assigned I&amp;I Unit</label>
                    <select class="form-select" asp-for="AssignedUnitId" id="AssignedUnitId" required></select>
                </div>
                <button type="submit" class="btn btn-primary">Save Assessment</button>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="iidAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="iidAlertTitle">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="iidAlertBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
    <script src="~/js/csp/Views_IID_InitialAssessment.js?v=1"></script>
<script src="~/js/iid/complaintDetails.js"></script>

}
