@{
    ViewData["Title"] = "IID Task List";
    Layout = "_Layout";
}

<div class="container-fluid mt-3">
    <h4 class="text-success">IID Task List</h4>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="iidTaskListTable" class="table table-hover table-bordered table-striped table-sm mb-0 w-100">
                    <thead class="table-success">
                        <tr>
                            <th>Complaint No</th>
                            <th>Complainant Name</th>
                            <th>Assigned On</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/csp/Views_IID_TaskListIID.js?v=1"></script>

}
