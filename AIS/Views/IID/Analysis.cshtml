@model AIS.Models.IID.AnalysisModel
@{
    ViewData["Title"] = "Analysis";
    ViewData["IidReportMode"] = "analysis";
    var dashboardMode = ViewData["DashboardMode"] as bool? == true;
    Layout = dashboardMode ? null : "_Layout";
}

@await Html.PartialAsync("_InquiryReportWorkspace")

@if (dashboardMode)
{
    <script src="~/js/csp/Views_IID_InquiryReport.js" asp-append-version="true"></script>
    <script src="~/js/iid/inquiryReportApi.js" asp-append-version="true"></script>
    <script src="~/js/iid/complaintDetails.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
}
else
{
@section Scripts {
    <script src="~/js/csp/Views_IID_InquiryReport.js" asp-append-version="true"></script>
    <script src="~/js/iid/inquiryReportApi.js" asp-append-version="true"></script>
    <script src="~/js/iid/complaintDetails.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
}
}
