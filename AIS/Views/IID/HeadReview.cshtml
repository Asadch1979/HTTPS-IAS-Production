@model AIS.Models.IID.HeadReviewModel
@{
    ViewData["Title"] = "Head Review";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
    var assessmentId = ViewData["AssessmentId"];
}

<div class="container-fluid mt-3">
    <h4>Head Review</h4>
    @await Html.PartialAsync("_ComplaintSelector")

    <div id="iidComplaintDetailsRoot"></div>


    @await Html.PartialAsync("_InitialAssessmentSummary")

    <div class="card">
        <div class="card-header bg-light">
            Decision
        </div>
        <div class="card-body">
            <form id="reviewForm" asp-action="HeadReview" asp-controller="IID" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ComplaintId" value="@complaintId" />
                <input type="hidden" name="AssessmentId" id="AssessmentId" value="@assessmentId" />
                
                <div class="mb-3">
                    <label class="form-label d-block">Action</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Action" id="approveAction" value="APPROVE" checked />
                        <label class="form-check-label" for="approveAction">Approve</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Action" id="referBackAction" value="REFER_BACK" />
                        <label class="form-check-label" for="referBackAction">Refer Back</label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Instructions/Comments</label>
                    <textarea class="form-control" asp-for="Directions" rows="4"></textarea>
                    <div class="form-text" id="commentsHint">Provide guidance for the unit or reasons for referral.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assigned On</label>
                    <input type="text" class="form-control" id="assignedOnDisplay" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">Assigned I&amp;I Unit</label>
                    <select class="form-select" asp-for="AssignedToUnit" id="AssignedToUnit" required>
                        <option value="">--Select--</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Submit Decision</button>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="iidAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="iidAlertTitle">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="iidAlertBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script src="~/js/iid/complaintDetails.js"></script>


    <script src="~/js/csp/Views_IID_HeadReview.js?v=1"></script>
}
