@{
    ViewData["Title"] = "Investigation Plan";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div class="container-fluid mt-3">
    <h4>Investigation Plan</h4>
    <div id="iidAlertHost"></div>

    <div class="card mb-3">
        <div class="card-header bg-light">
            Complaint &amp; Assessment Summary
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3">Complaint ID</dt>
                <dd class="col-md-9" id="complaintIdDisplay"></dd>

                <dt class="col-md-3">Nature</dt>
                <dd class="col-md-9" id="complaintNature"></dd>

                <dt class="col-md-3">Assessment</dt>
                <dd class="col-md-9" id="assessmentText"></dd>

                <dt class="col-md-3">Recommendation</dt>
                <dd class="col-md-9" id="assessmentRecommendation"></dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            Plan Details
        </div>
        <div class="card-body">
            <form id="planForm">
                <input type="hidden" name="ComplaintId" value="@complaintId" />
                <div class="mb-3">
                    <label class="form-label">Plan Details</label>
                    <textarea class="form-control" name="PlanDetails" rows="6"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Plan for Approval</button>
            </form>
        </div>
    </div>
</div>

@section Scripts{
<script>
    $(function(){
        var complaintId = '@complaintId';

        function showIidAlert(message, type){
            type = type || 'danger';
            $('#iidAlertHost').html(
                '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                (message || 'Unexpected error') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
        }

        function loadComplaint(){
            $.post(g_asiBaseURL + '/ApiCalls/GetComplaint',{ complaintId: complaintId },function(d){
                if(d && d.ok === false){
                    showIidAlert(d.message, 'danger');
                    return;
                }
                $('#complaintIdDisplay').text(d.complaintId || complaintId);
                $('#complaintNature').text(d.nature || '');
                $('#assessmentText').text(d.assessment || '');
                $('#assessmentRecommendation').text(d.recommendation || '');
            }).fail(function(){
                showIidAlert('Failed to load complaint details.', 'danger');
            });
        }

        $('#planForm').on('submit', function(e){
            e.preventDefault();
            var data = {
                ComplaintId: $('#planForm [name="ComplaintId"]').val(),
                PlanDetails: $('#planForm [name="PlanDetails"]').val()
            };
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/AddInvestigationPlan',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response){
                    if(response && response.ok === false){
                        showIidAlert(response.message, 'danger');
                        return;
                    }
                    showIidAlert('Plan submitted for approval.', 'success');
                    window.location.href = g_asiBaseURL + '/IID/TaskList';
                },
                error: function(){
                    showIidAlert('Failed to submit plan.', 'danger');
                }
            });
        });

        loadComplaint();
    });
</script>
}
