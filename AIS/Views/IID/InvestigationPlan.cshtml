@model AIS.Models.IID.InvestigationPlanModel
@{
    ViewData["Title"] = "Investigation Plan";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
}

<div class="container-fluid mt-3">
    <h4>Investigation Plan</h4>
    @await Html.PartialAsync("_ComplaintSelector")

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header bg-light">Complainant Particulars</div><div class="card-body"><dl class="row mb-0">
            <dt class="col-md-5">Complainant Name</dt><dd class="col-md-7" id="ctxComplainantName"></dd>
            <dt class="col-md-5">CNIC</dt><dd class="col-md-7" id="ctxCnic"></dd>
            <dt class="col-md-5">Cellular Number</dt><dd class="col-md-7" id="ctxCellularNumber"></dd>
            <dt class="col-md-5">Mailing Address</dt><dd class="col-md-7" id="ctxMailingAddress"></dd>
            <dt class="col-md-5">Gender</dt><dd class="col-md-7" id="ctxGender"></dd>
            <dt class="col-md-5">Received From</dt><dd class="col-md-7" id="ctxReceivedFrom"></dd>
            <dt class="col-md-5">Location Type</dt><dd class="col-md-7" id="ctxLocationType"></dd>
            <dt class="col-md-5">GM Office</dt><dd class="col-md-7" id="ctxGmOffice"></dd>
            <dt class="col-md-5">Region</dt><dd class="col-md-7" id="ctxRegion"></dd>
            <dt class="col-md-5">Branch</dt><dd class="col-md-7" id="ctxBranch"></dd>
        </dl></div></div></div>
        <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header bg-light">Complaint Details</div><div class="card-body"><dl class="row mb-0">
            <dt class="col-md-5">Complaint ID</dt><dd class="col-md-7" id="ctxComplaintId"></dd>
            <dt class="col-md-5">Complaint No</dt><dd class="col-md-7" id="ctxComplaintNo"></dd>
            <dt class="col-md-5">Nature</dt><dd class="col-md-7" id="ctxNature"></dd>
            <dt class="col-md-5">Category</dt><dd class="col-md-7" id="ctxCategory"></dd>
            <dt class="col-md-5">Contents</dt><dd class="col-md-7" id="ctxContents"></dd>
            <dt class="col-md-5">Action Required</dt><dd class="col-md-7" id="ctxActionRequired"></dd>
            <dt class="col-md-5">Uploaded Complaint</dt><dd class="col-md-7" id="ctxUploadedComplaint"></dd>
            <dt class="col-md-5">Uploaded Evidence</dt><dd class="col-md-7" id="ctxUploadedEvidence"></dd>
            <dt class="col-md-5">Submitted On</dt><dd class="col-md-7" id="ctxSubmittedOn"></dd>
            <dt class="col-md-5">Status</dt><dd class="col-md-7" id="ctxStatus"></dd>
            <dt class="col-md-5">Assigned Unit</dt><dd class="col-md-7" id="ctxAssignedUnit"></dd>
            <dt class="col-md-5">Assessment</dt><dd class="col-md-7" id="ctxAssessment"></dd>
            <dt class="col-md-5">Recommendation</dt><dd class="col-md-7" id="ctxRecommendation"></dd>
        </dl></div></div></div>
    </div>

    @await Html.PartialAsync("_InitialAssessmentSummary")

    <div class="card">
        <div class="card-header bg-light">
            Plan Details
        </div>
        <div class="card-body">
            <form id="planForm" asp-action="InvestigationPlan" asp-controller="IID" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ComplaintId" value="@complaintId" />
                <input type="hidden" asp-for="PlanDetails" id="PlanText" />

                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Investigation Risk</label>
                        <select class="form-select" id="InvestigationRisk" required>
                            <option value="">--Select--</option>
                            <option>High</option>
                            <option>Medium</option>
                            <option>Low</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Investigation Size</label>
                        <select class="form-select" id="InvestigationSize" required>
                            <option value="">--Select--</option>
                            <option>Small</option>
                            <option>Medium</option>
                            <option>Large</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">No of Days</label>
                        <input type="number" class="form-control" id="NoOfDays" min="0" step="1" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Travelling Day</label>
                        <input type="number" class="form-control" id="TravellingDay" min="0" step="1" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Investigation Tenure (From)</label>
                        <input type="date" class="form-control" id="TenureFrom" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Investigation Tenure (To)</label>
                        <input type="date" class="form-control" id="TenureTo" required />
                    </div>
                </div>

                <hr class="my-3"/>

                <div class="mb-2">
                    <label class="form-label">Investigation Activities</label>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Interview accused/ complainant" id="act1"><label class="form-check-label" for="act1">1. Interview accused/ complainant.</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Interview Other Branch Staff" id="act2"><label class="form-check-label" for="act2">2. Interview Other Branch Staff</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Scrutiny of Branch Operational Documents" id="act3"><label class="form-check-label" for="act3">3. Scrutiny of Branch Operational Documents.</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Loan Cases Scrutiny" id="act4"><label class="form-check-label" for="act4">4. Loan Cases Scrutiny</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="CCTV recording check" id="act5"><label class="form-check-label" for="act5">5. CCTV recording check</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Field Visit to meet Borrowers" id="act6"><label class="form-check-label" for="act6">6. Field Visit to meet Borrowers</label></div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Spot Verification" id="act7"><label class="form-check-label" for="act7">7. Spot Verification</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Revenue Office/Record verification" id="act8"><label class="form-check-label" for="act8">8. Revenue Office/Record verification</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Regional Office Visit" id="act9"><label class="form-check-label" for="act9">9. Regional Office Visit</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Visit of Other Organizations" id="act10"><label class="form-check-label" for="act10">10. Visit of Other Organizations.</label></div>
                            <div class="form-check"><input class="form-check-input act" type="checkbox" value="Other" id="act11"><label class="form-check-label" for="act11">11. Other</label></div>
                            <div class="mt-2">
                                <input type="text" class="form-control" id="OtherActivityText" placeholder="If Other, specify..." />
                            </div>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">At least one activity must be selected.</small>
                </div>

                <hr class="my-3"/>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Team Lead</label>
                        <input type="text" class="form-control" id="TeamLead" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Team Member</label>
                        <input type="text" class="form-control" id="TeamMember" required />
                        <small class="text-muted">If multiple, separate with comma.</small>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Submit Plan for Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
<script>
    $(function(){
        var complaintId = '@complaintId';
        var pageId = 3;

        function showIidAlert(message, type){
            type = type || 'danger';
            $('#iidAlertHost').html(
                '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                (message || 'Unexpected error') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
        }

        function hideIidLoader(){
            $('#iidLoading, .iid-loading, .loading').hide();
        }


        function renderSimpleLink(fileName, text){
            return fileName ? '<a href="'+g_asiBaseURL+'/Uploads/'+fileName+'" target="_blank">'+text+'</a>' : '<span class="text-muted">N/A</span>';
        }

        function renderEvidenceLinks(files){
            if(!files){ return '<span class="text-muted">N/A</span>'; }
            var out = [];
            files.split(';').forEach(function(f, i){ if(f){ out.push('<a href="'+g_asiBaseURL+'/Uploads/'+f+'" target="_blank">Evidence '+(i+1)+'</a>'); } });
            return out.length ? out.join('<br/>') : '<span class="text-muted">N/A</span>';
        }

        function fillComplaintContext(d, fallbackComplaintId){
            $('#ctxComplaintId').text(d.complaintId || fallbackComplaintId || '');
            $('#ctxComplaintNo').text(d.complaintNo || '');
            $('#ctxNature').text(d.nature || '');
            $('#ctxCategory').text(d.category || '');
            $('#ctxContents').text(d.contents || '');
            $('#ctxActionRequired').text(d.actionRequired || '');
            $('#ctxUploadedComplaint').html(renderSimpleLink(d.uploadedComplaint, 'Complaint'));
            $('#ctxUploadedEvidence').html(renderEvidenceLinks(d.uploadedEvidence));
            $('#ctxSubmittedOn').text(d.submittedOn || '');
            $('#ctxStatus').text(d.status || '');
            $('#ctxAssignedUnit').text(d.assignedUnit || d.assignedUnitId || '');
            $('#ctxAssessment').text(d.assessment || '');
            $('#ctxRecommendation').text(d.recommendation || '');
            $('#ctxComplainantName').text(d.complainantName || '');
            $('#ctxCnic').text(d.cnic || '');
            $('#ctxCellularNumber').text(d.cellularNumber || '');
            $('#ctxMailingAddress').text(d.mailingAddress || '');
            $('#ctxGender').text(d.gender || '');
            $('#ctxReceivedFrom').text(d.receivedFrom || '');
            $('#ctxLocationType').text(d.locationTypeText || d.locationTypeId || '');
            $('#ctxGmOffice').text(d.gmOffice || d.gmOfficeId || '');
            $('#ctxRegion').text(d.region || d.regionId || '');
            $('#ctxBranch').text(d.branch || d.branchId || '');
        }

        function loadComplaintDropdown(pageId){
            return $.post(g_asiBaseURL + '/ApiCalls/GetComplaintsDropdown', { pageId: pageId });
        }

        function loadComplaintSummary(selectedComplaintId){
            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/GetComplaint',
                type: 'POST',
                data: { complaintId: selectedComplaintId },
                success: function(d){
                    if(d && d.ok === false){
                        showIidAlert(d.message, 'danger');
                        return;
                    }
                    $('#assessmentText').text(d.assessment || '');
                    $('#assessmentRecommendation').text(d.recommendation || '');
                    $('#assessmentUnit').text(d.assignedUnit || d.assignedUnitId || '');
                },
                error: function(){
                    showIidAlert('Failed to load complaint details.', 'danger');
                },
                complete: function(){
                    hideIidLoader();
                }
            });
        }

        function loadInvestigationPlanByComplaintId(selectedComplaintId){
            complaintId = selectedComplaintId;
            $('#planForm [name="ComplaintId"]').val(complaintId);
            loadComplaintSummary(complaintId);

            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/GetLatestPlanByComplaintId',
                type: 'POST',
                data: { complaintId: complaintId },
                success: function(resp){
                    if(resp && resp.ok === false){
                        $('#planForm [name="PlanDetails"]').val('');
                        showIidAlert(resp.message, 'warning');
                        return;
                    }
                    $('#planForm [name="PlanDetails"]').val(resp.planDetails || '');
                },
                error: function(){
                    showIidAlert('Failed to load investigation plan.', 'danger');
                },
                complete: function(){
                    hideIidLoader();
                }
            });
        }

        function buildPlanText(){
            var risk = $('#InvestigationRisk').val();
            var size = $('#InvestigationSize').val();
            var days = $('#NoOfDays').val();
            var tDays = $('#TravellingDay').val();
            var from = $('#TenureFrom').val();
            var to = $('#TenureTo').val();
            var teamLead = $('#TeamLead').val();
            var teamMember = $('#TeamMember').val();

            var acts = [];
            $('.act:checked').each(function(){
                acts.push($(this).val());
            });

            var otherText = ($('#OtherActivityText').val() || '').trim();
            if (acts.indexOf('Other') >= 0 && otherText) {
                acts[acts.indexOf('Other')] = 'Other: ' + otherText;
            }

            var plan =
                'Investigation Risk: ' + risk + '\n' +
                'Investigation Size: ' + size + '\n' +
                'No of Days: ' + days + '\n' +
                'Investigation Tenure: From ' + from + ' To ' + to + '\n' +
                'Travelling Day: ' + tDays + '\n' +
                'Investigation Activities: ' + (acts.length ? acts.join(', ') : '') + '\n' +
                'Team Lead: ' + teamLead + '\n' +
                'Team Member(s): ' + teamMember;

            return { text: plan, activityCount: acts.length };
        }

        $('#planForm').on('submit', function(e){
            e.preventDefault();

            var missing = false;
            $('#planForm').find('input, select, textarea').each(function(){
                var $el = $(this);
                if ($el.prop('disabled')) return;
                if ($el.attr('type') === 'hidden') return;

                if ($el.prop('required')) {
                    if (!$el.val() || !$el.val().toString().trim()) {
                        missing = true;
                        $el.focus();
                        return false;
                    }
                }
            });

            var built = buildPlanText();
            if (missing) {
                alert('Please fill all mandatory fields.');
                return;
            }

            if (built.activityCount === 0) {
                alert('Please select at least one Investigation Activity.');
                return;
            }

            $('#PlanText').val(built.text);

            var data = {
                ComplaintId: $('#planForm [name="ComplaintId"]').val(),
                PlanDetails: $('#PlanText').val()
            };

            $.ajax({
                url: g_asiBaseURL + '/ApiCalls/AddInvestigationPlan',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response){
                    if(response && response.ok === false){
                        showIidAlert(response.message, 'danger');
                        return;
                    }
                    showIidAlert('Plan submitted for approval.', 'success');
                    window.location.href = g_asiBaseURL + '/IID/TaskList';
                },
                error: function(){
                    showIidAlert('Failed to submit plan.', 'danger');
                }
            });
        });

        loadComplaintDropdown(pageId)
            .done(function(resp){
                if(resp && resp.ok === false){
                    showIidAlert(resp.message, 'danger');
                    return;
                }

                var $dd = $('#iidComplaintSelect');
                $dd.empty().append('<option value="">-- Select Complaint --</option>');

                (resp || []).forEach(function(x){
                    $dd.append('<option value="' + x.complaintId + '">' + x.displayText + '</option>');
                });

                $dd.off('change').on('change', function(){
                    var id = $(this).val();
                    $('#selectedComplaintId').val(id);
                    if(!id){
                        showIidAlert('Please select a complaint.', 'warning');
                        return;
                    }
                    loadInvestigationPlanByComplaintId(parseInt(id));
                });

                if(complaintId){
                    $dd.val(complaintId).trigger('change');
                }
            })
            .fail(function(){
                showIidAlert('Failed to load complaints dropdown.', 'danger');
            })
            .always(function(){
                hideIidLoader();
            });
    });
</script>
}
