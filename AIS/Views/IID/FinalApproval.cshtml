@model AIS.Models.IID.FinalApprovalModel
@{
    ViewData["Title"] = "Final Approval";
    Layout = "_Layout";
    var complaintId = ViewData["ComplaintId"];
    var reportId = ViewData["ReportId"];
}
<h4>Final Approval</h4>
@await Html.PartialAsync("_ComplaintSelector")
<div class="mb-3" id="reportFiles">
    <h6>Report Downloads</h6>
    <div id="reportLinks" class="small text-muted">Loading...</div>
</div>
<form id="approvalForm" asp-action="FinalApproval" asp-controller="IID" method="post">
                @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReportId" value="@reportId" />
    <div class="mb-2">
        <label class="form-label">Comments</label>
        <textarea class="form-control" asp-for="Comments"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Decision</label>
        <select class="form-select" asp-for="Decision">
            <option value="APPROVE">Approve</option>
            <option value="REFER_BACK">Refer Back</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
@section Scripts{
    <script src="~/js/csp/Views_IID_FinalApproval.js?v=1"></script>

}
