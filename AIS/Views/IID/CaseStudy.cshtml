@model AIS.Models.IID.CaseStudyModel
@{
    ViewData["Title"] = "Case Study";
    var dashboardMode = ViewData["DashboardMode"] as bool? == true;
    Layout = dashboardMode ? null : "_Layout";
    var complaintId = ViewData["ComplaintId"];
}
<div id="iidCaseStudyRoot"
     data-iid-page="case-study"
     data-dashboard-mode="@(dashboardMode ? "true" : "false")"
     data-complaint-id="@complaintId">
@if (!dashboardMode)
{
    <h4>Case Study</h4>
    @await Html.PartialAsync("_ComplaintSelector")
}
<form id="caseForm" asp-action="CaseStudy" asp-controller="IID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ComplaintId" value="@complaintId" />
    <div class="mb-2">
        <label class="form-label">Originating Process Owner</label>
        <input class="form-control" asp-for="OriginProcessOwner" />
    </div>
    <div class="mb-2">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="NameComplainant" />
    </div>
    <div class="mb-2">
        <label class="form-label">Branch</label>
        <input class="form-control" asp-for="Branch" />
    </div>
    <div class="mb-2">
        <label class="form-label">Gist</label>
        <textarea class="form-control" asp-for="Gist"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Outcome</label>
        <textarea class="form-control" asp-for="Outcome"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Modus Operandi</label>
        <textarea class="form-control" asp-for="ModusOperandi"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Key Lessons / Controls Gaps Summary</label>
        <textarea class="form-control" asp-for="Gaps"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Root Cause</label>
        <textarea class="form-control" asp-for="RootCause"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Policy Gaps Identified</label>
        <textarea class="form-control" asp-for="PolicyGapsIdentified"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Violated Policy/SOP References</label>
        <textarea class="form-control" asp-for="ControlViolations"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Risk Identified</label>
        <textarea class="form-control" asp-for="RiskIdentified"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Regulatory Compliance Failure</label>
        <textarea class="form-control" asp-for="RegulatoryComplianceFailure"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Actions/Administrative Action Summary</label>
        <textarea class="form-control" asp-for="ActionsRec"></textarea>
    </div>
    <div class="mb-2">
        <label class="form-label">Status</label>
        <input class="form-control" asp-for="Status" />
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
 </div>
@if (dashboardMode)
{
    <script src="~/js/csp/Views_IID_CaseStudy.js" asp-append-version="true"></script>
}
else
{
@section Scripts{
    <script src="~/js/csp/Views_IID_CaseStudy.js" asp-append-version="true"></script>

}
}
