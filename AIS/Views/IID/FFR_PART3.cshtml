@model AIS.Models.IID.FFRPart3Model
@{
    ViewData["Title"] = "FFR Part III";
    Layout = "_Layout";
    var complaintIdQuery = Context.Request.Query["complaintId"].ToString();
    var ffrIdQuery = Context.Request.Query["ffrId"].ToString();
    var complaintIdValue = (Model?.ComplaintId ?? 0) > 0 ? Model.ComplaintId.ToString() : (string.IsNullOrWhiteSpace(complaintIdQuery) ? "0" : complaintIdQuery);
    var ffrIdValue = Model?.FfrId?.ToString() ?? (string.IsNullOrWhiteSpace(ffrIdQuery) ? "0" : ffrIdQuery);
    var queryString = $"?complaintId={complaintIdValue}&ffrId={ffrIdValue}";
}

<style>
    @@media print {
        .navbar,
        .sidebar,
        .no-print,
        .btn {
            display: none !important;
        }

        body {
            background: #fff;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0">FFR Part III</h4>
    <button type="button" class="btn btn-outline-secondary" data-click="window.print();">Print</button>
</div>

<div class="mb-3 no-print">
    <div class="d-flex gap-2">
        <span class="badge bg-light text-dark">Part 1</span>
        <span class="badge bg-light text-dark">Part 2</span>
        <span class="badge bg-primary">Part 3</span>
    </div>
    <div class="mt-2">
        <a class="btn btn-link p-0" href="@($"/IID/FFR_PART2{queryString}")">← Back to Part 2</a>
    </div>
</div>

<form id="ffrPart3Form" asp-action="FFR_PART3" asp-controller="IID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ComplaintId" value="@complaintIdValue" />
    <input type="hidden" asp-for="FfrId" value="@ffrIdValue" />

    <div class="card mb-3">
        <div class="card-header">Highlighted in Latest Audit Report?</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label d-block">Highlighted in latest audit report?</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="AuditHighlighted" id="AuditHighlightedYes" value="Yes" checked="@(Model?.AuditHighlighted == "Yes" ? "checked" : null)" />
                    <label class="form-check-label" for="AuditHighlightedYes">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="AuditHighlighted" id="AuditHighlightedNo" value="No" checked="@(Model?.AuditHighlighted == "No" ? "checked" : null)" />
                    <label class="form-check-label" for="AuditHighlightedNo">No</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="AuditHighlighted" id="AuditHighlightedNa" value="NA" checked="@(Model?.AuditHighlighted == "NA" ? "checked" : null)" />
                    <label class="form-check-label" for="AuditHighlightedNa">NA</label>
                </div>
            </div>
            <div class="mb-2 d-none" id="auditHighlightDetails">
                <label class="form-label">If Yes, provide details</label>
                <textarea class="form-control" asp-for="AuditHighlightDetails">@Model?.AuditHighlightDetails</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Probable Implications</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationReputational" asp-for="ImplicationReputational" checked="@(Model?.ImplicationReputational == true ? "checked" : null)" />
                <label class="form-check-label" for="ImplicationReputational">Reputational Loss</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationOperational" asp-for="ImplicationOperational" checked="@(Model?.ImplicationOperational == true ? "checked" : null)" />
                <label class="form-check-label" for="ImplicationOperational">Operational Risk</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationFinancial" asp-for="ImplicationFinancial" checked="@(Model?.ImplicationFinancial == true ? "checked" : null)" />
                <label class="form-check-label" for="ImplicationFinancial">Financial Risk/Loss</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationPrecedence" asp-for="ImplicationPrecedence" checked="@(Model?.ImplicationPrecedence == true ? "checked" : null)" />
                <label class="form-check-label" for="ImplicationPrecedence">Poor Precedence</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationOther" asp-for="ImplicationOther" checked="@(Model?.ImplicationOther == true ? "checked" : null)" />
                <label class="form-check-label" for="ImplicationOther">Other</label>
            </div>
            <div class="mt-2 d-none" id="ImplicationOtherDetails">
                <label class="form-label">Other (details)</label>
                <input type="text" class="form-control" asp-for="ImplicationOtherDetails" value="@Model?.ImplicationOtherDetails" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Violations / Gaps</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Policy/Circular/SOP violated</label>
                <textarea class="form-control" asp-for="PolicyViolated">@Model?.PolicyViolated</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Gaps in SOPs / Weak internal controls identified</label>
                <textarea class="form-control" asp-for="SopGaps">@Model?.SopGaps</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Action Recommended</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="ActionRecommended" id="ActionNoProbe" value="No further probe required" checked="@(Model?.ActionRecommended == "No further probe required" ? "checked" : null)" />
                <label class="form-check-label" for="ActionNoProbe">No further probe required</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="ActionRecommended" id="ActionFurtherProbe" value="Further probe required" checked="@(Model?.ActionRecommended == "Further probe required" ? "checked" : null)" />
                <label class="form-check-label" for="ActionFurtherProbe">Further probe required</label>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-outline-secondary" href="@($"/IID/FFR_PART2{queryString}")">Back</a>
        <button type="button" class="btn btn-outline-secondary">Save Draft</button>
        <button type="submit" class="btn btn-primary">Finish</button>
        <button type="button" class="btn btn-outline-secondary" data-click="window.print();">Print</button>
    </div>
</form>

@section Scripts{
    <script src="~/js/csp/Views_IID_FFR_PART3.js?v=1"></script>

}
