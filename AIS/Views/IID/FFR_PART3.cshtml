@{
    ViewData["Title"] = "FFR Part III";
    Layout = "_Layout";
    var complaintIdQuery = Context.Request.Query["complaintId"].ToString();
    var ffrIdQuery = Context.Request.Query["ffrId"].ToString();
    var complaintIdValue = string.IsNullOrWhiteSpace(complaintIdQuery) ? "0" : complaintIdQuery;
    var ffrIdValue = string.IsNullOrWhiteSpace(ffrIdQuery) ? "0" : ffrIdQuery;
    var queryString = $"?complaintId={complaintIdValue}&ffrId={ffrIdValue}";
}

<style>
    @@media print {
        .navbar,
        .sidebar,
        .no-print,
        .btn {
            display: none !important;
        }

        body {
            background: #fff;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0">FFR Part III</h4>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Print</button>
</div>

<div class="mb-3 no-print">
    <div class="d-flex gap-2">
        <span class="badge bg-light text-dark">Part 1</span>
        <span class="badge bg-light text-dark">Part 2</span>
        <span class="badge bg-primary">Part 3</span>
    </div>
    <div class="mt-2">
        <a class="btn btn-link p-0" href="@($"/IID/FFR_PART2{queryString}")">← Back to Part 2</a>
    </div>
</div>

<form id="ffrPart3Form" action="#" method="post">
    <input type="hidden" name="ComplaintId" value="@complaintIdValue" />
    <input type="hidden" name="FfrId" value="@ffrIdValue" />

    <div class="card mb-3">
        <div class="card-header">Highlighted in Latest Audit Report?</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label d-block">Highlighted in latest audit report?</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="AuditHighlighted" id="AuditHighlightedYes" value="Yes" />
                    <label class="form-check-label" for="AuditHighlightedYes">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="AuditHighlighted" id="AuditHighlightedNo" value="No" />
                    <label class="form-check-label" for="AuditHighlightedNo">No</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="AuditHighlighted" id="AuditHighlightedNa" value="NA" />
                    <label class="form-check-label" for="AuditHighlightedNa">NA</label>
                </div>
            </div>
            <div class="mb-2 d-none" id="auditHighlightDetails">
                <label class="form-label">If Yes, provide details</label>
                <textarea class="form-control" name="AuditHighlightDetails"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Probable Implications</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationReputational" name="ImplicationReputational" />
                <label class="form-check-label" for="ImplicationReputational">Reputational Loss</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationOperational" name="ImplicationOperational" />
                <label class="form-check-label" for="ImplicationOperational">Operational Risk</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationFinancial" name="ImplicationFinancial" />
                <label class="form-check-label" for="ImplicationFinancial">Financial Risk/Loss</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationPrecedence" name="ImplicationPrecedence" />
                <label class="form-check-label" for="ImplicationPrecedence">Poor Precedence</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ImplicationOther" name="ImplicationOther" />
                <label class="form-check-label" for="ImplicationOther">Other</label>
            </div>
            <div class="mt-2 d-none" id="ImplicationOtherDetails">
                <label class="form-label">Other (details)</label>
                <input type="text" class="form-control" name="ImplicationOtherDetails" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Violations / Gaps</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Policy/Circular/SOP violated</label>
                <textarea class="form-control" name="PolicyViolated"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Gaps in SOPs / Weak internal controls identified</label>
                <textarea class="form-control" name="SopGaps"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Action Recommended</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ActionRecommended" id="ActionNoProbe" value="No further probe required" />
                <label class="form-check-label" for="ActionNoProbe">No further probe required</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ActionRecommended" id="ActionFurtherProbe" value="Further probe required" />
                <label class="form-check-label" for="ActionFurtherProbe">Further probe required</label>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-outline-secondary" href="@($"/IID/FFR_PART2{queryString}")">Back</a>
        <button type="button" class="btn btn-outline-secondary">Save Draft</button>
        <a class="btn btn-primary" href="@($"/IID/FFR_PART3{queryString}&finish=1")">Finish</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Print</button>
    </div>
</form>

@section Scripts{
<script>
    $(function(){
        function toggleAuditDetails(){
            var isYes = $('#AuditHighlightedYes').is(':checked');
            if(isYes){
                $('#auditHighlightDetails').removeClass('d-none');
            } else {
                $('#auditHighlightDetails').addClass('d-none');
            }
        }

        function toggleOtherImplication(){
            if($('#ImplicationOther').is(':checked')){
                $('#ImplicationOtherDetails').removeClass('d-none');
            } else {
                $('#ImplicationOtherDetails').addClass('d-none');
                $('#ImplicationOtherDetails input').val('');
            }
        }

        $('input[name="AuditHighlighted"]').on('change', toggleAuditDetails);
        $('#ImplicationOther').on('change', toggleOtherImplication);

        toggleAuditDetails();
        toggleOtherImplication();
    });
</script>
}
