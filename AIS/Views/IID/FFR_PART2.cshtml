@model AIS.Models.IID.FFRPart2Model
@{
    ViewData["Title"] = "FFR Part II";
    Layout = "_Layout";
    var complaintIdQuery = Context.Request.Query["complaintId"].ToString();
    var ffrIdQuery = Context.Request.Query["ffrId"].ToString();
    var complaintIdValue = (Model?.ComplaintId ?? 0) > 0 ? Model.ComplaintId.ToString() : (string.IsNullOrWhiteSpace(complaintIdQuery) ? "0" : complaintIdQuery);
    var ffrIdValue = Model?.FfrId?.ToString() ?? (string.IsNullOrWhiteSpace(ffrIdQuery) ? "0" : ffrIdQuery);
    var queryString = $"?complaintId={complaintIdValue}&ffrId={ffrIdValue}";
}

<style>
    @@media print {
        .navbar,
        .sidebar,
        .no-print,
        .btn {
            display: none !important;
        }

        body {
            background: #fff;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0">FFR Part II</h4>
    <button type="button" class="btn btn-outline-secondary" data-onclick="window.print();">Print</button>
</div>

<div class="mb-3 no-print">
    <div class="d-flex gap-2">
        <span class="badge bg-light text-dark">Part 1</span>
        <span class="badge bg-primary">Part 2</span>
        <span class="badge bg-light text-dark">Part 3</span>
    </div>
    <div class="mt-2 d-flex gap-3">
        <a class="btn btn-link p-0" href="@($"/IID/FFR_PART1{queryString}")">← Back to Part 1</a>
        <button class="btn btn-link p-0" type="submit" form="ffrPart2Form">Next → Part 3</button>
    </div>
</div>

<form id="ffrPart2Form" asp-action="FFR_PART2" asp-controller="IID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ComplaintId" value="@complaintIdValue" />
    <input type="hidden" asp-for="FfrId" value="@ffrIdValue" />

    <div class="card mb-3">
        <div class="card-header">Statement of Complainant</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Time of recording</label>
                <input type="time" class="form-control" asp-for="ComplainantStatementTime" value="@Model?.ComplainantStatementTime" />
            </div>
            <div class="mb-2">
                <label class="form-label">Place</label>
                <input type="text" class="form-control" asp-for="ComplainantStatementPlace" value="@Model?.ComplainantStatementPlace" />
            </div>
            <div class="mb-2">
                <label class="form-label">Mode</label>
                <select class="form-select" asp-for="ComplainantStatementMode">
                    <option value="">--Select--</option>
                    <option selected="@(Model?.ComplainantStatementMode == "Written" ? "selected" : null)">Written</option>
                    <option selected="@(Model?.ComplainantStatementMode == "Audio" ? "selected" : null)">Audio</option>
                    <option selected="@(Model?.ComplainantStatementMode == "Video" ? "selected" : null)">Video</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Key points</label>
                <textarea class="form-control" asp-for="ComplainantStatementPoints">@Model?.ComplainantStatementPoints</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Statement of Accused</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Time of recording</label>
                <input type="time" class="form-control" asp-for="AccusedStatementTime" value="@Model?.AccusedStatementTime" />
            </div>
            <div class="mb-2">
                <label class="form-label">Place</label>
                <input type="text" class="form-control" asp-for="AccusedStatementPlace" value="@Model?.AccusedStatementPlace" />
            </div>
            <div class="mb-2">
                <label class="form-label">Mode</label>
                <select class="form-select" asp-for="AccusedStatementMode">
                    <option value="">--Select--</option>
                    <option selected="@(Model?.AccusedStatementMode == "Written" ? "selected" : null)">Written</option>
                    <option selected="@(Model?.AccusedStatementMode == "Audio" ? "selected" : null)">Audio</option>
                    <option selected="@(Model?.AccusedStatementMode == "Video" ? "selected" : null)">Video</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Key points</label>
                <textarea class="form-control" asp-for="AccusedStatementPoints">@Model?.AccusedStatementPoints</textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Evidence</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Primary evidence attached</label>
                <textarea class="form-control" asp-for="PrimaryEvidence">@Model?.PrimaryEvidence</textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Circumstantial/Secondary evidence</label>
                <textarea class="form-control" asp-for="SecondaryEvidence">@Model?.SecondaryEvidence</textarea>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-outline-secondary" href="@($"/IID/FFR_PART1{queryString}")">Back</a>
        <button type="button" class="btn btn-outline-secondary">Save Draft</button>
        <button type="submit" class="btn btn-primary">Next</button>
        <button type="button" class="btn btn-outline-secondary" data-onclick="window.print();">Print</button>
    </div>
</form>
