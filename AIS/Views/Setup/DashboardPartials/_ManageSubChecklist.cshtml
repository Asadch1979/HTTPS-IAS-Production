@{ Layout = null; }

<style type="text/css">
    .container {
        max-width: 100%;
    }

    .card-header {
        background-color: transparent !important;
        font-size: 20px;
        height: 100px;
    }

    .icon-card {
        margin: 10px;
    }
</style>

<div class="row text-center mt-3">
    <div class="col-md-6 text-left">
        <h3 style=" display:block;color: #be0e43">Audit Sub Checklist </h3>
    </div>
    <div class="col-md-6 text-right" style="padding-right:45px;">
        <button data-onclick="addNewSubCheckList(0);" class="btn btn-danger">Add New Sub Checklist</button>
    </div>
    
</div>
<div class="row col-md-12 mt-3">
    <table id="auditeeEntitiesList" class="table table-bordered table mb-0 mt-3 bg-white table-hover table-striped">
        <thead>
            <tr style="background-color: #19875478 !important; ">
                <th class="col-md-auto">Sr No.</th>
                <th class="col-md-auto">Process</th>
                <th class="col-md-auto">Sub Checklist</th>
                <th class="col-md-auto">Risk Sequence</th>
                <th class="col-md-auto">Weightage</th>
                <th class="col-md-auto">Remarks</th>
                <th class="col-md-auto">Action</th>
            </tr>
        </thead>
        <tbody></tbody>

    </table>
</div>


<div id="updateEntityModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Add/Update Sub Checklist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Checklist</label>
                        </div>
                        <div class="row col-md-8">
                            <select id="newChecklist" class="form-select form-control">
                                <option value="0" id="0" selected>--Select Checklist Type--</option>
                                @{
                                    if (ViewData["ChecklistTypes"] != null)
                                    {
                                        foreach (var item in (dynamic)(ViewData["ChecklistTypes"]))
                                        {
                                            <option value="@item.T_ID" id="@item.T_ID">@item.HEADING</option>

                                        }
                                    }
                                }

                            </select>
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Heading <small class="text-muted">(A-Z, 0-9, space, &amp;, ?)</small></label>
                        </div>
                        <div class="row col-md-8">
                            <input id="entCodeField" class="form-control alnum-only" type="text" data-allow-space="true" data-allow-amp="true" maxlength="150" title="Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?)" placeholder="Alphabets, numbers, spaces, ampersand (&amp;), comma (,), and question mark (?) only" />
                            <small class="form-text text-muted">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</small>
                            <div class="invalid-feedback">Enter only Alphabets (A-Z), numbers (0-9), spaces, ampersand (&amp;), comma (,), and question mark (?).</div>
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Risk Sequence</label>
                        </div>
                        <div class="row col-md-8">
                            <input id="entSeqField" min="0" oninput="validity.valid||(value='');" class="form-control" type="number" />
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Weightage</label>
                        </div>
                        <div class="row col-md-8">
                            <input id="entWeightField" class="form-control" type="number" />
                        </div>
                    </div>
                    <div class="row col-md-12 mt-3">
                        <div class="row col-md-4">
                            <label>Checklist Details</label>
                        </div>
                        <div class="row col-md-8">
                            <ul id="checklistDetailsList">

                            </ul>
                            
                        </div>
                    </div>
                 

                   

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button data-onclick="updateSubProcess();" type="button" data-bs-dismiss="modal" class="btn btn-success">Save Changes</button>

            </div>
        </div>
    </div>
</div>
<script src="~/js/csp/Views_Setup_manage_sub_checklist.js?v=1"></script>
