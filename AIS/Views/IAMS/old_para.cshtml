@{
    ViewData["Title"] = "Legacy Observations";
    Layout = "_Layout";
}





<div class="row">
    <div class="col-md-12 mt-3">
        <h3 style=" display:block;color: #be0e43">Old Audit Observations</h3>
    </div>
    <div class="row col-md-12">
        <div class="col-md-4">
            <label>Audit Branch</label>
        </div>
        <div class="col-md-8">
            <select id="legacypara_branch" class="form-select form-control">
                <option value="0" id="0">--Select Branch--</option>
                @{
                    if (ViewData["EntitiesList"] != null)
                    {
                        foreach (var item in (dynamic)(ViewData["EntitiesList"]))
                        {
                                <option value="@item.ENTITY_ID" id="@item.ENTITY_ID">@item.NAME &nbsp;&nbsp; -&nbsp;&nbsp; @item.CODE</option>
                        }
                    }
                }
            </select>
        </div>

    </div>
    <div class="row col-md-12 mt-3">
        <div class="col-md-4">
            <label>Audit Year</label>
        </div>
        <div class="col-md-8">
            <select id="legacypara_year" class="form-select form-control">
                <option value="0" id="0">--Select Audit Year--</option>
                @{
                    if (ViewData["AuditYearList"] != null)
                    {
                        foreach (var item in (dynamic)(ViewData["AuditYearList"]))
                        {
                            <option value="@item.AUDIT_PERIOD" id="@item.AUDIT_PERIOD">@item.AUDIT_PERIOD</option>
                        }
                    }
                }
            </select>
        </div>
        
    </div>
    <div class="row col-md-12 mt-3">
        <div class="w-100">
            <button onclick="getLegacyPara();" style="float:right; margin-right:15px;" class="btn btn-danger">Search Legacy Paras</button>
        </div>

    </div>

    <div class="row col-md-12 mt-3">
        <table id="manageObsPanel" class="table table-hover table-bordered table-hover mt-3 table-striped">
            <thead style="background-color: #19875478 !important; ">
                <tr>
                    <th class="col-md-2">Entity</th>
                    <th class="col-md-1">Audit Year</th>
                    <th class="col-md-1">Para No.</th>
                    <th class="col-md-3">Observation</th>
                    <th class="col-md-1">Amount</th>
                    <th class="col-md-2">VOL I II</th>
                    <th class="col-md-2">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
            <!-- <tbody>
                @{
                    if (ViewData["OldParas"] != null)
                    {
                        foreach (var item in (dynamic)(ViewData["OldParas"]))
                        {

                            <tr id="div_@item.ID">
