@{
    ViewData["Title"] = "Para Shifting";
    Layout = "_Layout";
}



<h3 style=" display:block;color: #be0e43" class="mt-3">@ViewData["Title"]</h3>
<div class="row col-md-12 mt-3">
    <div class="col-md-2">
        <label><b>Reporting Office:</b></label>
    </div>
    <div class="col-md-10">
        <select id="zoneSelectField" data-change="getZoneBranches()" class="form-control form-select">
            <option value="0" id="0">--Select Reporting Office--</option>
            @{
                if (ViewData["ZonesList"] != null)
                {
                    foreach (var item in (dynamic)(ViewData["ZonesList"]))
                    {
                        <option value="@item.ZONEID" id="@item.ZONEID">@item.ZONENAME</option>
                    }
                }
            }
        </select>
    </div>
</div>
<div class="row col-md-12 mt-3">
    <div class="col-md-2">
        <label><b>Entity:</b></label>
    </div>
    <div class="col-md-10">
        <select id="branchSelectField" data-change="getEntityObservation();" class="form-control form-select">
            <option value="0" id="0">--Select Entity--</option>
        </select>
    </div>
</div>
<div class="row col-md-12 mt-4">
    <table id="manageObsPanel" class="table table-hover table-bordered table-hover mt-3 table-striped">
        <thead style="background-color: #19875478 !important; ">
            <tr>
                <th class="col-md-1">Sr. No.</th>
                <th class="col-md-2">Entity Name</th>
                <th class="col-md-1">Audit Year</th>
                <th class="col-md-1">Para Number</th>
                <th class="col-md-6">Heading</th>
                <th class="col-md-1 text-center">
                    <input type="checkbox" id="selectAllShift" /> Select
                </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<div class="row col-md-12 mt-3">
    <div class="col-md-2">
        <label><b>Para to be shifted to:</b></label>
    </div>
    <div class="col-md-10">
        <div class="row">
            <div class="col-md-6 mb-2">
                <select id="shiftZoneSelect" data-change="getShiftZoneBranches();" class="form-control form-select">
                    <option value="0" id="0">--Select Reporting Office--</option>
                    @{
                        if (ViewData["ZonesList"] != null)
                        {
                            foreach (var item in (dynamic)(ViewData["ZonesList"]))
                            {
                                <option value="@item.ZONEID" id="@item.ZONEID">@item.ZONENAME</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <select id="shiftBranchSelect" class="form-control form-select">
                    <option value="0" id="0">--Select Entity--</option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="row col-md-12 mt-3">
    <div class="col-md-12 text-end">
        <button class="btn btn-danger" data-click="shiftParas();">Shift Para</button>
    </div>
</div>

<script src="~/js/csp/Views_FAD_FAD_TASK_para_shifting.js?v=1"></script>
