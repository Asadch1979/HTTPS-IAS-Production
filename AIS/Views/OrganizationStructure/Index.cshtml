@{
    ViewData["Title"] = "ZTBL Organization Structure";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/organization-structure.css" asp-append-version="true" />
<section id="organization-structure" class="org" data-nodes-url="@Url.Action("Data", "OrganizationStructure")" data-path-url="@Url.Action("EntityPath", "OrganizationStructure")" data-counts-url="@Url.Action("OpenParaCounts", "OrganizationStructure")" data-preview-url="@Url.Action("PreviewMove", "OrganizationStructure")" data-move-url="@Url.Action("Move", "OrganizationStructure")" data-can-move="@((ViewData["CanMoveEntity"] as bool? == true).ToString().ToLowerInvariant())" aria-label="ZTBL Organization Structure">
    <header class="org-header">
        <div class="org-brand"><span class="org-emblem" aria-hidden="true"><i class="fa fa-sitemap"></i></span><div><p class="org-eyebrow">ZTBL · EXECUTIVE DASHBOARD</p><h1>Organization Structure</h1><p class="org-subtitle">Explore offices and reporting relationships.</p></div></div>
        <span class="org-scope" id="org-scope">Organizational directory</span>
    </header>
    <div class="org-topbar">
        <div class="org-navigation" role="group" aria-label="Office navigation">
        <button id="org-back" type="button" class="org-icon-button" title="Back" aria-label="Back" disabled><i class="fa fa-arrow-left" aria-hidden="true"></i></button>
        <button id="org-home" type="button" class="org-button">Home</button>
        <button id="org-up" type="button" class="org-button" disabled>↑ Reporting authority</button>
        </div>
        <div class="org-zoom" role="group" aria-label="Chart view">
        <button id="org-zoom-out" type="button" class="org-icon-button" aria-label="Zoom out">−</button><output id="org-zoom-value" aria-label="Zoom level">100%</output><button id="org-zoom-in" type="button" class="org-icon-button" aria-label="Zoom in">+</button>
        <button id="org-fit" type="button" class="org-button">Fit chart</button><button id="org-actual" type="button" class="org-button">100%</button><button id="org-focus" type="button" class="org-button">Focus selected</button><button id="org-reset" type="button" class="org-button">Reset view</button>
        </div>
        <div class="org-panel-controls" role="group" aria-label="Panels">
        <button type="button" id="org-nav-toggle" class="org-button" aria-expanded="true" aria-controls="org-navigator"><i class="fa fa-bars" aria-hidden="true"></i> Navigator</button>
        <button type="button" id="org-details-toggle" class="org-button" aria-expanded="true" aria-controls="org-details">Details</button>
        <button type="button" id="org-expand-chart" class="org-button" aria-pressed="false">Expand chart</button>
        <button type="button" id="org-refresh-counts" class="org-button" disabled>Refresh structure &amp; counts</button>
        </div>
    </div>
    <nav id="org-breadcrumbs" class="org-breadcrumbs" aria-label="Reporting path"></nav>
    <div id="org-status" class="org-status" role="status" aria-live="polite">Loading your organizational directory…</div>
    <button type="button" id="org-retry" class="org-button" hidden>Try again</button>
    <div class="org-counts-feedback"><span id="org-counts-status" role="status" aria-live="polite"></span><button type="button" id="org-counts-retry" class="org-button" hidden>Retry structure &amp; counts</button></div>
    <div class="org-workspace" id="org-workspace" hidden>
        <button id="org-drawer-backdrop" class="org-drawer-backdrop" type="button" aria-label="Close panel" tabindex="-1" hidden></button>
        <aside id="org-navigator" class="org-navigator" aria-label="Organization navigator" tabindex="-1">
            <div class="org-panel-heading"><h2>Organization navigator</h2><button type="button" class="org-icon-button org-drawer-close" data-close-panel="navigator" aria-label="Close navigator">×</button></div>
            <p id="org-entity-count" class="org-count"></p>
            <label for="org-search" class="org-label">Find an entity</label>
            <div class="org-search"><i class="fa fa-search" aria-hidden="true"></i><input id="org-search" type="search" placeholder="Search name or entity ID" autocomplete="off" /></div>
            <label for="org-filter" class="org-label">Quick filter</label>
            <select id="org-filter"><option value="">All organizational levels</option><option value="18">Group Heads</option><option value="3">Divisions</option><option value="4">Departments</option><option value="21">GM Offices</option><option value="5">Regional Offices</option></select>
            <div id="org-tree" class="org-nav-tree" aria-label="Entities"></div>
            <div class="org-nav-footer"><span class="org-dot"></span> Select an office to explore its structure</div>
        </aside>
        <main class="org-main" aria-label="Interactive organization chart">
            <div class="org-chart-caption"><div><p class="org-eyebrow">REPORTING STRUCTURE</p><h2 id="org-chart-title"></h2></div><span class="org-selected-key"><span class="org-dot"></span> Selected entity</span></div>
            <div id="org-viewport" class="org-viewport" tabindex="0" aria-label="Organization chart. Scroll to explore; use zoom controls to resize."><div id="org-chart-space"><div id="org-chart" class="org-chart"></div></div></div>
            <div class="org-chart-footer"><span id="org-chart-note">Expand cards to reveal the next level.</span><span>Drag canvas to pan · Select a card to focus</span></div>
            <div class="org-legend" aria-label="Card categories"><span class="org-legend-executive">Institution</span><span class="org-legend-group">Group</span><span class="org-legend-division">Division</span><span class="org-legend-office">GM / Region</span><span>Department / Branch</span></div>
        </main>
        <aside id="org-details" class="org-details" aria-label="Selected entity information" tabindex="-1"><div class="org-panel-heading"><p class="org-eyebrow">ENTITY PROFILE</p><button type="button" class="org-icon-button org-drawer-close" data-close-panel="details" aria-label="Close details">×</button></div><div id="org-detail-content" aria-live="polite"></div></aside>
    </div>
    @if (ViewData["CanMoveEntity"] as bool? == true)
    {
        <dialog id="org-move-dialog" aria-labelledby="org-move-title">
            <form id="org-move-form">
                @Html.AntiForgeryToken()
                <h2 id="org-move-title">Move entity</h2>
                <p id="org-move-entity"></p><p id="org-move-current"></p>
                <label class="org-label" for="org-move-search">Search destinations by name or ID</label>
                <input id="org-move-search" type="search" autocomplete="off" />
                <label class="org-label" for="org-move-destination">Destination</label>
                <select id="org-move-destination" required></select>
                <label class="org-label" for="org-move-reason">Change reason (required, up to 1000 bytes)</label>
                <textarea id="org-move-reason" required maxlength="1000" rows="3"></textarea>
                <p id="org-move-feedback" role="status" aria-live="polite"></p>
                <button id="org-move-preview" type="button" class="org-button">Preview move</button>
                <button id="org-move-confirm" type="submit" class="org-button" disabled>Confirm move</button>
                <button id="org-move-cancel" type="button" class="org-button">Cancel</button>
            </form>
        </dialog>
    }
    <noscript><p class="org-status">Enable JavaScript to explore the organization structure.</p></noscript>
</section>
@section Scripts {
    <script src="~/js/organization-structure.js" asp-append-version="true"></script>
}
