@model AIS.Models.HeadAuditReview
@{
    Layout = "_Layout";
    ViewData["Title"] = "Head Audit Department | Review Work";
    string Value(string value) => string.IsNullOrWhiteSpace(value) ? "N/A" : value;
}
<link rel="stylesheet" href="~/css/engagement-workbench.css" asp-append-version="true" />
<section class="engagement-workbench wb-redesigned" aria-labelledby="review-title">
    <div class="wb-appbar"><div class="wb-brand"><span class="wb-brand-icon">IAS</span>
        <span><strong>Head Audit Department</strong><small>Head of Audit Dashboard</small></span></div>
        <span class="wb-appbar-meta">SUPERVISORY REVIEW · READ-ONLY</span></div>
    <header class="wb-hero"><div><span class="wb-eyebrow">ENGAGEMENT #@Model.Engagement.EngagementId</span>
        <h1 id="review-title">@Value(Model.Engagement.Entity)</h1>
        <p>@Value(Model.Engagement.Period) · @Value(Model.Engagement.Status)</p>
        <a class="wb-table-action" href="@Url.Action("AuditTeamsMonitoring", new { auditPeriodId=Model.AuditPeriodId, officeId=Model.OfficeId, statusId=Model.StatusId, exception=Model.Exception })">← All engagements</a></div></header>
    <section class="wb-overview">
        <nav class="wb-review-nav" aria-label="Review saved work">
            @foreach (var section in AIS.Models.HeadAuditMonitoringPolicy.Sections)
            {
                <a class="wb-state-badge" aria-current="@(section == Model.Section ? "page" : null)"
                   href="@Url.Action("Review", new { engId = Model.Engagement.EngagementId, section, auditPeriodId=Model.AuditPeriodId, officeId=Model.OfficeId, statusId=Model.StatusId, exception=Model.Exception })">@(section)</a>
            }
        </nav>
        <h2>@Model.Section</h2>
        @if (Model.Section == "History") { <p>Saved engagement movements, observation recommendations and auditee responses.</p> }
        @if (Model.Section == "Workpapers") { <p>Saved working papers. Completion and review state: N/A where the source does not record them.</p> }
        @if (Model.Records.Count == 0) { <div class="wb-panel"><p>N/A — no saved @Model.Section.ToLowerInvariant() records are available for this engagement.</p></div> }
        @foreach (var record in Model.Records)
        {
            <article class="wb-panel wb-review-record"><h3>@Value(record.Title)</h3>
                <p>Status: @Value(record.Status) · Saved by: @Value(record.Author) · @(record.SavedOn?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</p>
                @if (Model.Section == "Evidence" || Model.Section == "ResponseEvidence")
                {
                    <a class="wb-table-action" href="@Url.Action(Model.Section, new { engId = Model.Engagement.EngagementId, evidenceId = record.Id })">Download supporting evidence</a>
                }
                @if (Model.Section == "Reports")
                {
                    <a class="wb-table-action" href="@Url.Action("Report", new { engId = Model.Engagement.EngagementId, reportId = record.Id })">Download saved report</a>
                }
                <pre class="wb-saved-content">@Value(record.Content)</pre>
            </article>
        }
    </section>
</section>
