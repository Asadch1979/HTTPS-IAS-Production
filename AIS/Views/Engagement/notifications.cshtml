@{
    ViewData["Title"] = "Notification";
    Layout = "_Layout";
}



<div class="col-md-12 mt-3">
    <h3 style="display: block; color: #be0e43">Checklist</h3>
    <table id="checklistPanel" class="table table-bordered mb-0 mt-3 bg-white table-striped">
        <thead style="background-color: #19875478 !important;">
            <tr>
                <th class="col-md-2">Sr. No.</th>
                <th class="col-md-4">Name of Checklist</th>
                <th class="col-md-3">Yes/No</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                <td>
                    <select class="checklistaction form-select form-control" data-onchange="showObservationArea($(this).val(),'obs1');" aria-label="Default select example">
                        <option value="0" id="0" selected>No</option>
                        <option value="1" id="1">Yes</option>
                    </select>
                </td>
              
            </tr>
            <tr>
                <td id="obs1" class="d-none" colspan="3" style="height:300px; overflow-y:auto;">
                    <div class="page-wrapper box-content">
                        <textarea class="template_box content" name="example"></textarea>
                    </div>
                </td>
            </tr>        
        </tbody>
    </table>
</div>
  
<script src="~/js/csp/Views_Engagement_notifications.js?v=1"></script>
